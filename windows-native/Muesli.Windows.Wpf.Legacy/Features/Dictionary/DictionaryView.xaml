<features:FeatureViewBase x:Class="Muesli.Windows.Features.Dictionary.DictionaryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:features="clr-namespace:Muesli.Windows.Features">
  <Grid x:Name="DictionaryPage">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="0,0,12,0">
        <StackPanel MaxWidth="860" Margin="0,0,0,24">
          <DockPanel Margin="0,0,0,8">
            <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Click="ForwardClick" features:FeatureAction.Name="AddDictionaryEntry_Click">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="+" FontWeight="Bold" Margin="0,0,6,0" />
                <TextBlock Text="Add new" />
              </StackPanel>
            </Button>
            <StackPanel>
              <TextBlock Text="Dictionary" Style="{StaticResource PageTitle}" />
              <TextBlock Text="Add custom words for names, brands, and domain terms, and tune how aggressively each entry should fuzzy-match transcription errors." Style="{StaticResource PageSubtitle}" />
              <TextBlock Text="{Binding PreviewPageStateMessage}" Margin="0,6,0,0" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" />
            </StackPanel>
          </DockPanel>
          <Border Margin="0,0,0,18"
                  Background="{DynamicResource BackgroundRaisedBrush}"
                  BorderBrush="{DynamicResource BorderBrushSoft}"
                  BorderThickness="1"
                  CornerRadius="10"
                  Visibility="{Binding HasDictionarySuggestions, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel>
              <StackPanel Margin="16,16,16,12">
                <TextBlock Text="Suggested Corrections" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Margin="0,4,0,0" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap"
                           Text="Corrections Muesli noticed after you edited a dictation. Add them to apply on future transcripts." />
              </StackPanel>
              <ListBox ItemsSource="{Binding DictionarySuggestions}" Background="Transparent" BorderThickness="0"
                       Foreground="{DynamicResource TextPrimaryBrush}" ItemContainerStyle="{StaticResource MuesliListBoxItem}">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <DockPanel Margin="16,10">
                      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Style="{StaticResource GhostButton}" Content="Add" Click="ForwardClick"
                                features:FeatureAction.Name="AcceptDictionarySuggestion_Click"
                                AutomationProperties.Name="Add dictionary suggestion" />
                        <Button Margin="6,0,0,0" Style="{StaticResource GhostButton}" Content="Dismiss" Click="ForwardClick"
                                features:FeatureAction.Name="DismissDictionarySuggestion_Click"
                                AutomationProperties.Name="Dismiss dictionary suggestion" />
                      </StackPanel>
                      <StackPanel>
                        <TextBlock Text="{Binding Display}" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Margin="0,2,0,0" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}"
                                   Text="Pending dictionary correction" />
                      </StackPanel>
                    </DockPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </StackPanel>
          </Border>
          <Border Background="{DynamicResource BackgroundRaisedBrush}"
                  BorderBrush="{DynamicResource BorderBrushSoft}"
                  BorderThickness="1"
                  CornerRadius="10"
                  Padding="0">
            <StackPanel>
              <Grid Margin="16,16,16,8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Match" Style="{StaticResource SectionLabel}" />
                <TextBlock Grid.Column="1" Margin="12,0,0,0" Text="Replace" Style="{StaticResource SectionLabel}" />
              </Grid>
              <Grid Margin="16,0,16,12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid>
                  <TextBox x:Name="DictionaryPhraseBox" Height="36" Padding="10,7" Background="{DynamicResource BackgroundHoverBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrushSoft}" FontSize="14" />
                  <TextBlock Text="Word or phrase"
                             Margin="14,0,0,0"
                             VerticalAlignment="Center"
                             FontSize="14"
                             Foreground="{DynamicResource TextTertiaryBrush}"
                             IsHitTestVisible="False">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding Text, ElementName=DictionaryPhraseBox}" Value="">
                            <Setter Property="Visibility" Value="Visible" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </Grid>
                <Grid Grid.Column="1" Margin="12,0,0,0">
                  <TextBox x:Name="DictionaryReplacementBox" Height="36" Padding="10,7" Background="{DynamicResource BackgroundHoverBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrushSoft}" FontSize="14" />
                  <TextBlock Text="Replace with"
                             Margin="14,0,0,0"
                             VerticalAlignment="Center"
                             FontSize="14"
                             Foreground="{DynamicResource TextTertiaryBrush}"
                             IsHitTestVisible="False">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding Text, ElementName=DictionaryReplacementBox}" Value="">
                            <Setter Property="Visibility" Value="Visible" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </Grid>
              </Grid>
              <Grid Margin="16,0,16,16">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="160" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="48" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Matching threshold" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                <Slider x:Name="DictionaryThresholdSlider"
                        Grid.Column="1"
                        Minimum="0.85"
                        Maximum="0.98"
                        SmallChange="0.01"
                        LargeChange="0.05"
                        Value="0.90" />
                <TextBlock Grid.Column="2"
                           Text="{Binding ElementName=DictionaryThresholdSlider, Path=Value, StringFormat={}{0:0.00}}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center" />
              </Grid>
              <Border Height="1" Background="{DynamicResource BorderBrushSoft}" />
              <ListBox ItemsSource="{Binding DictionaryEntries}" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimaryBrush}" ItemContainerStyle="{StaticResource MuesliListBoxItem}" Visibility="{Binding HasDictionaryEntries, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Margin="16,16">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding Phrase, UpdateSourceTrigger=PropertyChanged}" Height="36" Padding="10,7" Background="{DynamicResource BackgroundHoverBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrushSoft}" />
                        <TextBox Grid.Column="1" Text="{Binding Replacement, UpdateSourceTrigger=PropertyChanged}" Margin="12,0,0,0" Height="36" Padding="10,7" Background="{DynamicResource BackgroundHoverBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrushSoft}" />
                      </Grid>
                      <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="160" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="48" />
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Matching threshold" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        <Slider Grid.Column="1" Minimum="0.85" Maximum="0.98" SmallChange="0.01" LargeChange="0.05" Value="{Binding MatchingThreshold, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Column="2" Text="{Binding ThresholdDisplay}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        <Button Grid.Column="3" Margin="12,0,0,0" Style="{StaticResource GhostButton}" Content="Delete" Foreground="{DynamicResource ErrorRedBrush}" Click="ForwardClick" features:FeatureAction.Name="DeleteDictionaryEntry_Click" />
                        <Button Grid.Column="4" Margin="6,0,0,0" Style="{StaticResource GhostButton}" Content="Save" Click="ForwardClick" features:FeatureAction.Name="SaveDictionaryEntry_Click" />
                      </Grid>
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <StackPanel Margin="0,32" Visibility="{Binding HasDictionaryEntries, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                <TextBlock Text="&#xE70F;" Style="{StaticResource EmptyStateIcon}" />
                <TextBlock Text="No custom dictionary entries yet" Style="{StaticResource EmptyStateTitle}" />
                <TextBlock Text="Add a word or phrase above to improve transcription accuracy." Style="{StaticResource EmptyStateBody}" />
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>
        </ScrollViewer>
      </Grid>
</features:FeatureViewBase>

<features:FeatureViewBase x:Class="Muesli.Windows.Features.Settings.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:features="clr-namespace:Muesli.Windows.Features"
             xmlns:settings="clr-namespace:Muesli.Windows.Features.Settings">
  <Grid x:Name="SettingsPage">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="0,0,12,0">
          <StackPanel MaxWidth="860" Margin="0,0,0,24">
            <TextBlock Text="Settings" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{Binding PreviewPageStateMessage}" Margin="0,4,0,0" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" />

            <TabControl x:Name="SettingsTabs"
                        Style="{StaticResource MuesliTabControl}"
                        SelectedIndex="{Binding SelectedSettingsTabIndex, Mode=TwoWay}">
              <TabItem Header="General" Style="{StaticResource MuesliTabItem}">
                <StackPanel>
                  <TextBlock Text="GENERAL" Style="{StaticResource SectionLabel}" />
                  <Border Style="{StaticResource ContentCard}">
                    <StackPanel>
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Your name" Style="{StaticResource SettingsRowLabel}" />
                        <TextBox Grid.Column="1"
                                 Style="{StaticResource MuesliTextBox}"
                                 Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" />
                      </Grid>
                      <Border Height="1" Background="{DynamicResource BorderBrushSoft}" Margin="0,12" />
                      <CheckBox Style="{StaticResource MuesliCheckBox}" Content="Launch at login" IsChecked="{Binding StartAtLogin}" />
                      <TextBlock Text="{Binding StartupRegistrationLabel}" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" AutomationProperties.LiveSetting="Polite" />
                      <Button Style="{StaticResource SecondaryButton}" Content="Repair startup registration" Click="ForwardClick" features:FeatureAction.Name="RepairStartup_Click" Margin="0,8,0,0" HorizontalAlignment="Left" AutomationProperties.Name="Repair Windows startup registration" />
                      <Border Height="1" Background="{DynamicResource BorderBrushSoft}" Margin="0,12" />
                      <Border Height="1" Background="{DynamicResource BorderBrushSoft}" Margin="0,12" />
                      <DockPanel><Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Resume setup" Click="ForwardClick" features:FeatureAction.Name="ResumeSetup_Click" AutomationProperties.Name="Resume setup"/><TextBlock Text="{Binding SetupResumeLabel}" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" /></DockPanel>
                      <CheckBox Style="{StaticResource MuesliCheckBox}" Content="Open dashboard on launch" IsChecked="{Binding OpenDashboardOnLaunch}" />
                    </StackPanel>
                  </Border>

                  <TextBlock Text="MICROPHONE" Style="{StaticResource SectionLabel}" />
                  <Border Style="{StaticResource ContentCard}">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="220" />
                      </Grid.ColumnDefinitions>
                      <ComboBox Style="{StaticResource MuesliComboBox}"
                                ItemsSource="{Binding MicrophoneDevices}"
                                SelectedItem="{Binding SelectedMicrophone}" />
                      <Button Grid.Column="1" Margin="16,0,0,0" Style="{StaticResource PrimaryButton}" Click="ForwardClick" features:FeatureAction.Name="TestMic_Click" Content="Test mic" />
                    </Grid>
                  </Border>
                </StackPanel>
              </TabItem>

              <TabItem Header="Dictation" Style="{StaticResource MuesliTabItem}">
                <StackPanel>
                  <TextBlock Text="TRANSCRIPTION" Style="{StaticResource SectionLabel}" />
                  <Border Style="{StaticResource ContentCard}">
                    <StackPanel>
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                          <TextBlock Text="Transcription" Style="{StaticResource SettingsRowLabel}" />
                          <TextBlock Text="{Binding SelectedModelDescription}" Margin="0,4,18,0" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding SelectedModelLanguages}" Margin="0,4,18,0" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding DictationModelRuntimeStatus, Mode=OneWay}" Margin="0,4,0,0" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ComboBox Grid.Column="1"
                                  Style="{StaticResource MuesliComboBox}"
                                  ItemsSource="{Binding TranscriptionModels}"
                                  SelectedItem="{Binding SelectedTranscriptionModel, Mode=TwoWay}"
                                  DisplayMemberPath="PickerLabel" />
                      </Grid>
                      <Border Height="1" Background="{DynamicResource BorderBrushSoft}" Margin="0,12" />
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                          <TextBlock Text="Remove filler words" Style="{StaticResource SettingsRowLabel}" />
                          <TextBlock Text="Remove common hesitations such as um, uh, and you know before dictionary correction." Margin="0,4,0,0" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource MuesliCheckBox}" Content="Enable" IsChecked="{Binding RemoveFillerWords}" HorizontalAlignment="Right" />
                      </Grid>
                      <Border Height="1" Background="{DynamicResource BorderBrushSoft}" Margin="0,12" />
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                          <TextBlock Text="Local cleanup" Style="{StaticResource SettingsRowLabel}" />
                          <TextBlock Text="Optional native Qwen/GGUF cleanup for meetings and imports. Dictation skips cleanup to keep paste latency under a second." Margin="0,4,0,0" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding QwenCleanupRuntimeStatus, Mode=OneWay}" Margin="0,4,0,0" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource MuesliCheckBox}" Content="Enable" IsChecked="{Binding EnableLocalCleanup}" HorizontalAlignment="Right" />
                      </Grid>
                      <Border Height="1" Background="{DynamicResource BorderBrushSoft}" Margin="0,12" />
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                          <TextBlock Text="Hands-Free Mode" Style="{StaticResource SettingsRowLabel}" />
                          <TextBlock Text="Double-tap the shortcut to start, tap again to stop." Margin="0,4,0,0" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource MuesliCheckBox}" IsChecked="{Binding EnableDoubleTapDictation}" HorizontalAlignment="Right" />
                      </Grid>
                    </StackPanel>
                  </Border>

                  <TextBlock Text="CONTROLS" Style="{StaticResource SectionLabel}" />
                  <Border Style="{StaticResource ContentCard}">
                    <StackPanel>
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Push to Talk" Style="{StaticResource SettingsRowLabel}" />
                        <ComboBox Grid.Column="1" Style="{StaticResource MuesliComboBox}" ItemsSource="{Binding HotkeyOptions}" SelectedItem="{Binding SelectedHotkey}" />
                      </Grid>
                      <Border Height="1" Background="{DynamicResource BorderBrushSoft}" Margin="0,12" />
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Paste behavior" Style="{StaticResource SettingsRowLabel}" />
                        <ComboBox Grid.Column="1" Style="{StaticResource MuesliComboBox}" ItemsSource="{Binding PasteBehaviors}" SelectedItem="{Binding SelectedPasteBehavior}" />
                      </Grid>
                      <TextBlock Grid.ColumnSpan="2" Text="Active-app insertion leaves your existing clipboard alone. Choose clipboard only when you want the transcript available for manual pasting." Margin="0,8,0,0" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" />
                      <Button Margin="0,16,0,0" HorizontalAlignment="Left" Style="{StaticResource PrimaryButton}" PreviewMouseDown="ForwardMouseButton" features:FeatureAction.Name="HoldToDictate_MouseDown" PreviewMouseUp="ForwardMouseButton" features:FeatureAction.MouseUpName="HoldToDictate_MouseUp" Content="Hold to dictate" />
                    </StackPanel>
                  </Border>
                </StackPanel>
              </TabItem>

              <TabItem Header="Meetings" Style="{StaticResource MuesliTabItem}">
                <StackPanel>
                  <TextBlock Text="RECORDING" Style="{StaticResource SectionLabel}" />
                  <Border Style="{StaticResource ContentCard}">
                    <StackPanel>
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                          <TextBlock Text="Final meeting and import model" Style="{StaticResource SettingsRowLabel}" />
                          <TextBlock Text="Used after recorded meetings and for imported audio/video. Selection never starts a download." Margin="0,4,18,0" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding FinalMeetingModelStatus}" Margin="0,4,18,0" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" Style="{StaticResource MuesliComboBox}"
                                  ItemsSource="{Binding TranscriptionModels}"
                                  SelectedItem="{Binding SelectedFinalMeetingModel, Mode=TwoWay}"
                                  DisplayMemberPath="PickerLabel" />
                      </Grid>
                      <Border Height="1" Background="{DynamicResource BorderBrushSoft}" Margin="0,12" />
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                          <TextBlock Text="Live meeting model" Style="{StaticResource SettingsRowLabel}" />
                          <TextBlock Text="{Binding LiveMeetingModelStatus}" Margin="0,4,18,0" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" Style="{StaticResource MuesliComboBox}" ItemsSource="{Binding LiveMeetingModels}" SelectedItem="{Binding SelectedLiveMeetingModel, Mode=TwoWay}" DisplayMemberPath="Label" />
                      </Grid>
                      <Border Height="1" Background="{DynamicResource BorderBrushSoft}" Margin="0,12" />
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
                        <StackPanel>
                          <TextBlock Text="Transcript ownership" Style="{StaticResource SettingsRowLabel}" />
                          <TextBlock Text="Preview-only saves the final model's transcript. Unified saves live output and uses the final model only for measured gaps." Margin="0,4,18,0" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" Style="{StaticResource MuesliComboBox}" ItemsSource="{Binding LiveTranscriptOwnershipModes}" SelectedItem="{Binding SelectedLiveTranscriptOwnership, Mode=TwoWay}" />
                      </Grid>
                      <Border Height="1" Background="{DynamicResource BorderBrushSoft}" Margin="0,12" />
                      <StackPanel>
                        <TextBlock Text="{Binding LivePreviewOwnerLabel, StringFormat=Live preview owner: {0}}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding FinalTranscriptOwnerLabel, StringFormat=Final transcript owner: {0}}" Margin="0,4,0,0" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding GapRecoveryOwnerLabel, StringFormat=Gap recovery: {0}}" Margin="0,4,0,0" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                      </StackPanel>
                      <CheckBox Margin="0,12,0,0" Style="{StaticResource MuesliCheckBox}" Content="Show microphone/system waveform levels when hovering the live transcript" IsChecked="{Binding ShowLiveWaveformOnHover}" />
                      <Border Height="1" Background="{DynamicResource BorderBrushSoft}" Margin="0,12" />
                      <CheckBox Style="{StaticResource MuesliCheckBox}" Content="Notify when meeting detected" IsChecked="{Binding AutoMeetingDetectionEnabled}" />
                      <Border Height="1" Background="{DynamicResource BorderBrushSoft}" Margin="0,12" />
                      <CheckBox Style="{StaticResource MuesliCheckBox}" Content="Save meeting recording" IsChecked="{Binding SaveMeetingRecordings}" />
                      <TextBlock Text="Windows checks active app titles, supported browser URLs where accessible, and meeting app process names." Margin="0,10,0,0" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" />
                      <Button Margin="0,12,0,0" HorizontalAlignment="Left" Style="{StaticResource SecondaryButton}" Content="Check meeting detection now" Click="ForwardClick" features:FeatureAction.Name="CheckMeetingDetection_Click" />
                      <TextBlock Text="{Binding MeetingDetectionStatus}" Margin="0,10,0,0" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>

                  <TextBlock Text="MEETING SUMMARIES" Style="{StaticResource SectionLabel}" />
                  <Border Style="{StaticResource ContentCard}">
                    <StackPanel>
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                          <TextBlock Text="Summary backend" Style="{StaticResource SettingsRowLabel}" />
                          <TextBlock Text="{Binding SummaryProviderDisclosureText}" Margin="0,5,18,0" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" Style="{StaticResource MuesliComboBox}" ItemsSource="{Binding SummaryProviders}" SelectedItem="{Binding SelectedSummaryProvider}" />
                      </Grid>
                      <Border Height="1" Background="{DynamicResource BorderBrushSoft}" Margin="0,12" />
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                          <TextBlock Text="Ollama server" Style="{StaticResource SettingsRowLabel}" />
                          <TextBlock Text="Used only when the summary backend is Ollama. A localhost address keeps the transcript on this machine." Margin="0,5,18,0" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBox Grid.Column="1" Style="{StaticResource MuesliTextBox}" Text="{Binding OllamaEndpoint, UpdateSourceTrigger=LostFocus}" />
                      </Grid>
                      <Border Height="1" Background="{DynamicResource BorderBrushSoft}" Margin="0,12" />
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                          <TextBlock Text="Ollama model" Style="{StaticResource SettingsRowLabel}" />
                          <TextBlock Text="Model tag as installed in Ollama, for example llama3.1:8b." Margin="0,5,18,0" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBox Grid.Column="1" Style="{StaticResource MuesliTextBox}" Text="{Binding OllamaModel, UpdateSourceTrigger=LostFocus}" />
                      </Grid>
                      <Border Height="1" Background="{DynamicResource BorderBrushSoft}" Margin="0,12" />
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Default template" Style="{StaticResource SettingsRowLabel}" />
                        <ComboBox Grid.Column="1" Style="{StaticResource MuesliComboBox}" ItemsSource="{Binding SummaryTemplates}" SelectedItem="{Binding SelectedSummaryTemplate}" />
                      </Grid>
                      <Border Height="1" Background="{DynamicResource BorderBrushSoft}" Margin="0,12" />
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="OpenAI API key" Style="{StaticResource SettingsRowLabel}" />
                        <StackPanel Grid.Column="1">
                          <PasswordBox x:Name="OpenAIApiKeyBox" Height="34" Padding="9,6" Background="{DynamicResource BackgroundRaisedBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrushMedium}" BorderThickness="1" PasswordChanged="ForwardPasswordChanged" features:FeatureAction.Name="OpenAIApiKeyBox_PasswordChanged" />
                          <DockPanel Margin="0,5,0,0">
                            <TextBlock Text="{Binding OpenAIApiKeyStatus}" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" />
                            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Clear" Click="ForwardClick" features:FeatureAction.Name="ClearOpenAIApiKey_Click" Padding="5,1" />
                          </DockPanel>
                        </StackPanel>
                      </Grid>
                      <Border Height="1" Background="{DynamicResource BorderBrushSoft}" Margin="0,12" />
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="OpenAI model" Style="{StaticResource SettingsRowLabel}" />
                        <TextBox Grid.Column="1" Style="{StaticResource MuesliTextBox}" Text="{Binding OpenAIModel, UpdateSourceTrigger=PropertyChanged}" />
                      </Grid>
                      <Border Height="1" Background="{DynamicResource BorderBrushSoft}" Margin="0,12" />
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="OpenRouter API key" Style="{StaticResource SettingsRowLabel}" />
                        <StackPanel Grid.Column="1">
                          <PasswordBox x:Name="OpenRouterApiKeyBox" Height="34" Padding="9,6" Background="{DynamicResource BackgroundRaisedBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrushMedium}" BorderThickness="1" PasswordChanged="ForwardPasswordChanged" features:FeatureAction.Name="OpenRouterApiKeyBox_PasswordChanged" />
                          <DockPanel Margin="0,5,0,0">
                            <TextBlock Text="{Binding OpenRouterApiKeyStatus}" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" />
                            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Clear" Click="ForwardClick" features:FeatureAction.Name="ClearOpenRouterApiKey_Click" Padding="5,1" />
                          </DockPanel>
                        </StackPanel>
                      </Grid>
                      <Border Height="1" Background="{DynamicResource BorderBrushSoft}" Margin="0,12" />
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="OpenRouter model" Style="{StaticResource SettingsRowLabel}" />
                        <TextBox Grid.Column="1" Style="{StaticResource MuesliTextBox}" Text="{Binding OpenRouterModel, UpdateSourceTrigger=PropertyChanged}" />
                      </Grid>
                    </StackPanel>
                  </Border>

                  <TextBlock Text="POST-MEETING AUTOMATION" Style="{StaticResource SectionLabel}" />
                  <Border Style="{StaticResource ContentCard}">
                    <StackPanel>
                      <CheckBox Style="{StaticResource MuesliCheckBox}"
                                Content="Run an executable after a newly completed meeting is saved"
                                IsChecked="{Binding PostMeetingHookEnabled}" />
                      <TextBlock Text="Disabled by default. Runs only after durable recording completion or successful recovery; opening or re-summarizing a meeting never runs it. The executable receives one versioned JSON document over standard input and no meeting-derived command-line arguments."
                                 Margin="0,7,0,12" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" />
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox Style="{StaticResource MuesliTextBox}"
                                 Text="{Binding PostMeetingHookExecutablePath, UpdateSourceTrigger=LostFocus}" />
                        <Button Grid.Column="1" Margin="10,0,0,0" Style="{StaticResource SecondaryButton}"
                                Content="Choose .exe…" Click="ForwardClick" features:FeatureAction.Name="BrowseHookExecutable_Click" />
                      </Grid>
                      <Border Height="1" Background="{DynamicResource BorderBrushSoft}" Margin="0,12" />
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
                        <StackPanel>
                          <TextBlock Text="Transcript exposure" Style="{StaticResource SettingsRowLabel}" />
                          <TextBlock Text="Metadata only sends neither transcript data nor a path. Inline is an explicit disclosure. Auto-export path is populated only when the Markdown export succeeds."
                                     Margin="0,4,18,0" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" Style="{StaticResource MuesliComboBox}"
                                  ItemsSource="{Binding HookTranscriptPolicies}" SelectedItem="{Binding SelectedHookTranscriptPolicy}" />
                      </Grid>
                      <Border Height="1" Background="{DynamicResource BorderBrushSoft}" Margin="0,12" />
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/><ColumnDefinition Width="20"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
                        <StackPanel>
                          <TextBlock Text="Limits and retry" Style="{StaticResource SettingsRowLabel}" />
                          <TextBlock Text="Each attempt is terminated after the timeout. Output is bounded and redacted in diagnostics."
                                     Margin="0,4,18,0" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                          <TextBlock Text="Timeout (sec)" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" />
                          <TextBox Style="{StaticResource MuesliTextBox}" Text="{Binding PostMeetingHookTimeoutSeconds, UpdateSourceTrigger=LostFocus}" />
                        </StackPanel>
                        <StackPanel Grid.Column="3">
                          <TextBlock Text="Attempts" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" />
                          <TextBox Style="{StaticResource MuesliTextBox}" Text="{Binding PostMeetingHookMaxAttempts, UpdateSourceTrigger=LostFocus}" />
                        </StackPanel>
                      </Grid>
                      <Button Margin="0,12,0,0" HorizontalAlignment="Left" Style="{StaticResource SecondaryButton}"
                              Content="Test hook safely" Click="ForwardClick" features:FeatureAction.Name="TestPostMeetingHook_Click" />
                    </StackPanel>
                  </Border>

                  <TextBlock Text="AUTOMATIC MARKDOWN EXPORT" Style="{StaticResource SectionLabel}" />
                  <Border Style="{StaticResource ContentCard}">
                    <StackPanel>
                      <CheckBox Style="{StaticResource MuesliCheckBox}"
                                Content="Export Markdown after a newly completed meeting is saved"
                                IsChecked="{Binding AutoExportMarkdownEnabled}" />
                      <TextBlock Text="The selected destination remains user-owned. Muesli creates collision-safe files there and never deletes or overwrites existing files."
                                 Margin="0,7,0,12" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" />
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox Style="{StaticResource MuesliTextBox}"
                                 Text="{Binding AutoExportMarkdownDirectory, UpdateSourceTrigger=LostFocus}" />
                        <Button Grid.Column="1" Margin="10,0,0,0" Style="{StaticResource SecondaryButton}"
                                Content="Choose folder…" Click="ForwardClick" features:FeatureAction.Name="BrowseAutoExportDirectory_Click" />
                      </Grid>
                      <Border Height="1" Background="{DynamicResource BorderBrushSoft}" Margin="0,12" />
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Content" Style="{StaticResource SettingsRowLabel}" />
                        <ComboBox Grid.Column="1" Style="{StaticResource MuesliComboBox}"
                                  ItemsSource="{Binding AutoExportContentOptions}" SelectedItem="{Binding SelectedAutoExportContent}" />
                      </Grid>
                    </StackPanel>
                  </Border>

                  <TextBlock Text="{Binding PostMeetingAutomationStatusText}" Margin="0,2,0,8"
                             FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
              </TabItem>

                            <TabItem Header="Computer Use" Style="{StaticResource MuesliTabItem}">
                <settings:ComputerUseSettingsView />
              </TabItem>

              <TabItem Header="Appearance" Style="{StaticResource MuesliTabItem}">
                <StackPanel>
                  <TextBlock Text="APPEARANCE" Style="{StaticResource SectionLabel}" />
                  <Border Style="{StaticResource ContentCard}">
                    <StackPanel>
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                          <TextBlock Text="Theme" Style="{StaticResource SettingsRowLabel}" />
                          <TextBlock Text="Switch between the OG light and dark palettes." Margin="0,6,0,0" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" Style="{StaticResource MuesliComboBox}" ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding SelectedTheme, Mode=TwoWay}" />
                      </Grid>
                      <Border Height="1" Background="{DynamicResource BorderBrushSoft}" Margin="0,12" />
                      <CheckBox Style="{StaticResource MuesliCheckBox}" Content="Show floating indicator" IsChecked="{Binding ShowFloatingIndicator}" />
                      <Border Height="1" Background="{DynamicResource BorderBrushSoft}" Margin="0,12" />
                      <CheckBox Style="{StaticResource MuesliCheckBox}" Content="Play sound effects" IsChecked="{Binding SoundEnabled}" />
                      <Border Height="1" Background="{DynamicResource BorderBrushSoft}" Margin="0,12" />
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                          <TextBlock Text="Floating indicator position" Style="{StaticResource SettingsRowLabel}" />
                          <TextBlock Text="Dragging the indicator saves a custom position until this anchor is changed." Margin="0,5,0,0" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" Style="{StaticResource MuesliComboBox}" ItemsSource="{Binding IndicatorPositions}" SelectedItem="{Binding SelectedIndicatorPosition}" />
                      </Grid>
                      <Border Height="1" Background="{DynamicResource BorderBrushSoft}" Margin="0,12" />
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                          <TextBlock Text="Hold-to-talk delay" Style="{StaticResource SettingsRowLabel}" />
                          <TextBlock Text="Milliseconds before capture starts. Accidental taps stay silent." Margin="0,5,0,0" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBox Grid.Column="1" Style="{StaticResource MuesliTextBox}" Text="{Binding HotkeyTriggerThresholdMs, UpdateSourceTrigger=LostFocus}" />
                      </Grid>
                      <Border Height="1" Background="{DynamicResource BorderBrushSoft}" Margin="0,12" />
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                          <TextBlock Text="Recording accent" Style="{StaticResource SettingsRowLabel}" />
                          <TextBlock Text="Hex color used by the floating recording pill (without #)." Margin="0,5,0,0" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBox Grid.Column="1" Style="{StaticResource MuesliTextBox}" Text="{Binding RecordingColorHex, UpdateSourceTrigger=LostFocus}" />
                      </Grid>
                    </StackPanel>
                  </Border>
                </StackPanel>
              </TabItem>
            </TabControl>
          </StackPanel>
        </ScrollViewer>
      </Grid>
</features:FeatureViewBase>

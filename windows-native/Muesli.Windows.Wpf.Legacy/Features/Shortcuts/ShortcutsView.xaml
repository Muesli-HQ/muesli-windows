<features:FeatureViewBase x:Class="Muesli.Windows.Features.Shortcuts.ShortcutsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:features="clr-namespace:Muesli.Windows.Features">
  <Grid x:Name="ShortcutsPage">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="0,0,12,0">
        <StackPanel MaxWidth="860" Margin="0,0,0,24">
          <TextBlock Text="Shortcuts" Style="{StaticResource PageTitle}" />
          <TextBlock Text="Choose your preferred shortcut for dictation." Style="{StaticResource PageSubtitle}" />
          <TextBlock Text="{Binding PreviewPageStateMessage}" Margin="0,6,0,0" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" />
          <Border Style="{StaticResource ContentCard}">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="Push to Talk" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                  <TextBlock Text="{Binding ShortcutModeLabel}" Margin="0,4,0,0" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
                <Border Grid.Column="1" Height="26" Padding="12,0" Background="{DynamicResource SurfacePrimaryBrush}" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1" CornerRadius="6">
                  <TextBlock Text="{Binding SelectedHotkey}" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                </Border>
              </Grid>
              <Border Height="1" Background="{DynamicResource BorderBrushSoft}" Margin="0,16" />
              <StackPanel Orientation="Horizontal">
                <ComboBox Width="220" HorizontalAlignment="Left" Style="{StaticResource MuesliComboBox}" ItemsSource="{Binding HotkeyOptions}" SelectedItem="{Binding SelectedHotkey}" />
                <Button Margin="10,0,0,0" Style="{StaticResource SecondaryButton}" Content="{Binding CaptureHotkeyButtonText}" Click="ForwardClick" features:FeatureAction.Name="CaptureHotkey_Click" />
              </StackPanel>
              <TextBlock Text="{Binding ShortcutCaptureLabel}" Margin="0,10,0,0" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource ContentCard}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="Hands-Free Mode" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="Double-tap the selected shortcut to start listening without holding the key." Margin="0,4,0,0" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
              </StackPanel>
              <CheckBox Grid.Column="1" Style="{StaticResource MuesliCheckBox}" IsChecked="{Binding EnableDoubleTapDictation}" VerticalAlignment="Center" />
            </Grid>
          </Border>
        </StackPanel>
        </ScrollViewer>
      </Grid>
</features:FeatureViewBase>

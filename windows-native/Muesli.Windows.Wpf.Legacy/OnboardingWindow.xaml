<Window x:Class="Muesli.Windows.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Set up Muesli" Icon="Assets/muesli.ico" Width="820" Height="700" MinWidth="760" MinHeight="560"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource BackgroundBaseBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}" Activated="Window_Activated" PreviewKeyDown="Window_PreviewKeyDown">
  <DockPanel Margin="28">
    <Grid DockPanel.Dock="Bottom" Margin="0,20,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Button x:Name="BackButton" Grid.Column="0" Style="{StaticResource GhostButton}" Content="Back" Click="Back_Click" AutomationProperties.Name="Previous setup step" />
      <StackPanel x:Name="StepDots" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" />
      <Button x:Name="SkipButton" Grid.Column="2" Style="{StaticResource GhostButton}" Content="Set up later" Click="Skip_Click" AutomationProperties.Name="Pause setup and resume later" />
      <Button x:Name="NextButton" Grid.Column="3" Margin="10,0,0,0" Style="{StaticResource SecondaryButton}" Content="Next" Click="Next_Click" AutomationProperties.Name="Next setup step" />
      <Button x:Name="FinishButton" Grid.Column="4" Margin="10,0,0,0" Style="{StaticResource PrimaryButton}" Content="Finish setup" Click="Finish_Click" AutomationProperties.Name="Finish setup" />
    </Grid>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
        <TextBlock x:Name="PreviewModeText" Style="{StaticResource SectionLabel}" Foreground="{DynamicResource WarningOrangeBrush}" Visibility="Collapsed" />
        <TextBlock x:Name="StepLabel" Style="{StaticResource SectionLabel}" AutomationProperties.LiveSetting="Polite" />
        <TextBlock x:Name="TitleText" Style="{StaticResource PageTitle}" />
        <TextBlock x:Name="DescriptionText" Style="{StaticResource PageSubtitle}" TextWrapping="Wrap" />
        <Border Style="{StaticResource ContentCard}"><StackPanel x:Name="ContentPanel" /></Border>
        <TextBlock x:Name="StatusText" Margin="0,12,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" AutomationProperties.LiveSetting="Polite" />
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>

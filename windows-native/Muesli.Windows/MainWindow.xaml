<Window x:Class="Muesli.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Muesli"
        Icon="Assets/muesli_app_icon.png"
        Width="1240"
        Height="820"
        MinWidth="980"
        MinHeight="620"
        WindowStyle="None"
        ResizeMode="CanResize"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        PreviewKeyDown="Window_PreviewKeyDown"
        WindowStartupLocation="CenterScreen">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="44"
                        ResizeBorderThickness="8"
                        GlassFrameThickness="0"
                        CornerRadius="0"
                        UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>

  <Grid Background="{DynamicResource BackgroundDeepBrush}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="260" MinWidth="240" MaxWidth="300" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Grid Grid.ColumnSpan="2" Height="36" VerticalAlignment="Top" Background="Transparent" Panel.ZIndex="10">
      <StackPanel Orientation="Horizontal"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Top"
                  Margin="0,3,8,0"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True">
        <Button Style="{StaticResource ChromeButton}" Content="-" Click="Minimize_Click" />
        <Button Style="{StaticResource ChromeButton}" Content="□" Click="MaximizeRestore_Click" />
        <Button Style="{StaticResource ChromeButton}" Content="x" Click="Close_Click" />
      </StackPanel>
    </Grid>

    <Border Grid.Column="0"
            Margin="0,44,0,0"
            Background="{DynamicResource BackgroundDeepBrush}"
            BorderBrush="{DynamicResource BorderBrushMedium}"
            BorderThickness="0,1,1,1"
            CornerRadius="0,14,14,0">
      <Grid Margin="0,24,0,16">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="16,0,16,20">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Border Width="22" Height="22" Background="{DynamicResource AccentBlueBrush}">
              <Border.OpacityMask>
                <ImageBrush ImageSource="Assets/menu_m_template@2x.png" Stretch="Uniform" />
              </Border.OpacityMask>
            </Border>
            <TextBlock Text="muesli" Margin="12,0,0,0" FontSize="22" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
          </StackPanel>
          <TextBlock Text="{Binding UserGreeting}" Margin="34,4,0,0" FontSize="12"
                     Foreground="{DynamicResource TextTertiaryBrush}" />
          <Border Margin="-8,18,-8,0"
                  Height="32"
                  Background="{DynamicResource BackgroundRaisedBrush}"
                  BorderBrush="{DynamicResource BorderBrushSoft}"
                  BorderThickness="1"
                  CornerRadius="6"
                  Padding="10,0">
            <DockPanel>
              <TextBlock Text="&#xE721;"
                         FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                         Foreground="{DynamicResource TextTertiaryBrush}"
                         VerticalAlignment="Center"
                         Margin="0,0,8,0" />
              <Grid>
                <TextBlock Text="Search..."
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           VerticalAlignment="Center"
                           FontSize="13"
                           IsHitTestVisible="False">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Visibility" Value="Collapsed" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding SearchQuery}" Value="">
                          <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
                <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         CaretBrush="{DynamicResource AccentBlueBrush}"
                         Margin="0,0,22,0"
                         VerticalContentAlignment="Center"
                         FontSize="13"
                         ToolTip="Search dictations and meetings" />
                <Button HorizontalAlignment="Right"
                        Width="18"
                        Height="18"
                        Padding="0"
                        Content="x"
                        Foreground="{DynamicResource TextTertiaryBrush}"
                        Click="ClearSearch_Click">
                  <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                      <Setter Property="Visibility" Value="Visible" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding SearchQuery}" Value="">
                          <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Button.Style>
                </Button>
              </Grid>
            </DockPanel>
          </Border>
        </StackPanel>

        <StackPanel Grid.Row="1">
          <Button x:Name="DictationsNav" Style="{StaticResource SidebarButton}" Background="{DynamicResource SurfaceSelectedBrush}" Click="ShowDictations_Click">
            <DockPanel LastChildFill="True">
              <TextBlock Text="&#xE720;" Style="{StaticResource NavIcon}" Foreground="{DynamicResource AccentBlueBrush}" />
              <TextBlock Text="Dictations" />
            </DockPanel>
          </Button>
          <Grid Margin="8,2">
            <Button x:Name="MeetingsNav" Style="{StaticResource SidebarButton}" Margin="0" Click="ToggleMeetings_Click">
              <DockPanel LastChildFill="False">
                <TextBlock Text="&#xE716;" Style="{StaticResource NavIcon}" />
                <TextBlock Text="Meetings" Width="146" />
                <TextBlock Text="{Binding MeetingsChevron}" Width="24" Foreground="{DynamicResource TextTertiaryBrush}" />
              </DockPanel>
            </Button>
            <Button Width="28"
                    Height="28"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Margin="0,0,10,0"
                    Style="{StaticResource GhostButton}"
                    Padding="0"
                    Content="&#xE8F4;"
                    FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                    Foreground="{DynamicResource TextTertiaryBrush}"
                    ToolTip="New Meeting Folder"
                    Click="AddMeetingFolder_Click" />
          </Grid>
          <StackPanel x:Name="MeetingsChildren" Visibility="Visible">
            <Button x:Name="AllMeetingsNav" Style="{StaticResource SidebarChildButton}" Click="ShowMeetings_Click">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="22" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="28" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="&#xE8A5;" Style="{StaticResource NavIcon}" Foreground="{DynamicResource TextTertiaryBrush}" />
                <TextBlock Grid.Column="1" Text="All Meetings" />
                <TextBlock Grid.Column="2" Text="{Binding MeetingCount}" HorizontalAlignment="Right" Foreground="{DynamicResource TextTertiaryBrush}" />
              </Grid>
            </Button>
            <ItemsControl ItemsSource="{Binding MeetingFolders}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid>
                    <Button Style="{StaticResource SidebarChildButton}" Click="SelectMeetingFolder_Click">
                      <Button.ContextMenu>
                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                          <MenuItem Header="Rename" Click="RenameMeetingFolder_Click" />
                          <MenuItem Header="Move Up" Click="MoveMeetingFolderUp_Click" />
                          <MenuItem Header="Move Down" Click="MoveMeetingFolderDown_Click" />
                          <Separator />
                          <MenuItem Header="Delete" Click="DeleteMeetingFolder_Click" />
                        </ContextMenu>
                      </Button.ContextMenu>
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="22" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="28" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE8B7;" Style="{StaticResource NavIcon}" Foreground="{DynamicResource TextTertiaryBrush}" />
                        <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock">
                              <Setter Property="Visibility" Value="Visible" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRenaming}" Value="True">
                                  <Setter Property="Visibility" Value="Hidden" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Grid.Column="2" Text="{Binding CountDisplay}" HorizontalAlignment="Right" Foreground="{DynamicResource TextTertiaryBrush}" />
                      </Grid>
                    </Button>
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                             Margin="46,3,38,3"
                             Padding="6,2"
                             Background="{DynamicResource BackgroundHoverBrush}"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             BorderBrush="{DynamicResource BorderBrushSoft}"
                             FontSize="13"
                             KeyDown="FolderNameBox_KeyDown"
                             LostFocus="FolderNameBox_LostFocus">
                      <TextBox.Style>
                        <Style TargetType="TextBox">
                          <Setter Property="Visibility" Value="Collapsed" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsRenaming}" Value="True">
                              <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBox.Style>
                    </TextBox>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
          <Button x:Name="DictionaryNav" Style="{StaticResource SidebarButton}" Click="ShowDictionary_Click">
            <DockPanel>
              <TextBlock Text="&#xE82D;" Style="{StaticResource NavIcon}" />
              <TextBlock Text="Dictionary" />
            </DockPanel>
          </Button>
          <Button x:Name="ModelsNav" Style="{StaticResource SidebarButton}" Click="ShowModels_Click">
            <DockPanel>
              <TextBlock Text="&#xE896;" Style="{StaticResource NavIcon}" />
              <TextBlock Text="Models" />
            </DockPanel>
          </Button>
          <Button x:Name="ShortcutsNav" Style="{StaticResource SidebarButton}" Click="ShowShortcuts_Click">
            <DockPanel>
              <TextBlock Text="&#xE765;" Style="{StaticResource NavIcon}" />
              <TextBlock Text="Shortcuts" />
            </DockPanel>
          </Button>
        </StackPanel>

        <StackPanel Grid.Row="2">
          <Button x:Name="SettingsNav" Style="{StaticResource SidebarButton}" Click="ShowSettings_Click">
            <DockPanel>
              <TextBlock Text="&#xE713;" Style="{StaticResource NavIcon}" />
              <TextBlock Text="Settings" />
            </DockPanel>
          </Button>
          <Button x:Name="AboutNav" Style="{StaticResource SidebarButton}" Click="ShowAbout_Click">
            <DockPanel>
              <TextBlock Text="&#xE946;" Style="{StaticResource NavIcon}" />
              <TextBlock Text="About" />
            </DockPanel>
          </Button>
          <Border Margin="24,12,0,0"
                  Width="60"
                  Height="26"
                  HorizontalAlignment="Left"
                  Background="{DynamicResource BackgroundRaisedBrush}"
                  CornerRadius="6"
                  Padding="2">
            <StackPanel Orientation="Horizontal">
              <Button x:Name="LightThemeButton"
                      Style="{StaticResource ThemeSegmentButton}"
                      Content="☀"
                      Click="SetLightTheme_Click" />
              <Button x:Name="DarkThemeButton"
                      Style="{StaticResource ThemeSegmentButton}"
                      Content="☾"
                      Click="SetDarkTheme_Click" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Column="1"
            Margin="0,44,0,0"
            Background="{DynamicResource BackgroundBaseBrush}" />

    <Grid Grid.Column="1" Margin="24,76,24,28">
      <Grid x:Name="DictationsPage">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <UniformGrid Grid.Row="0" Columns="4" Margin="0,0,0,28">
          <Border Style="{StaticResource StatCard}">
            <StackPanel HorizontalAlignment="Center">
              <Viewbox Width="20" Height="20" HorizontalAlignment="Center" Margin="0,2,0,8">
                <Path Fill="{DynamicResource WarningOrangeBrush}" Data="M10,1 C14,5 15,8 13,11 C15,10 16,8 16,6 C18,9 18,14 14,17 C11,20 6,19 4,15 C2,11 4,8 7,6 C7,9 9,10 10,12 C12,9 12,6 10,1 Z" />
              </Viewbox>
              <TextBlock Text="{Binding DayStreak}" Style="{StaticResource StatValue}" />
              <TextBlock Text="day streak" Style="{StaticResource StatLabel}" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource StatCard}">
            <StackPanel HorizontalAlignment="Center">
              <Viewbox Width="20" Height="20" HorizontalAlignment="Center" Margin="0,2,0,8">
                <Grid Width="20" Height="20">
                  <Path Stroke="{DynamicResource AccentBlueBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M4,17 L8,3 L12,17 M5.4,12 L10.6,12" />
                  <Path Stroke="{DynamicResource AccentBlueBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M15,4 L15,16 M13,4 L17,4 M13,16 L17,16" />
                </Grid>
              </Viewbox>
              <TextBlock Text="{Binding WordsDictatedDisplay}" Style="{StaticResource StatValue}" />
              <TextBlock Text="words dictated" Style="{StaticResource StatLabel}" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource StatCard}">
            <StackPanel HorizontalAlignment="Center">
              <Viewbox Width="20" Height="20" HorizontalAlignment="Center" Margin="0,2,0,8">
                <Grid Width="20" Height="20">
                  <Path Stroke="{DynamicResource SuccessGreenBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M3,13 A7,7 0 0 1 17,13" />
                  <Path Stroke="{DynamicResource SuccessGreenBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M10,13 L14,8" />
                  <Ellipse Width="2.8" Height="2.8" Fill="{DynamicResource SuccessGreenBrush}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8.6,11.6,0,0" />
                </Grid>
              </Viewbox>
              <TextBlock Text="{Binding AverageWpm}" Style="{StaticResource StatValue}" />
              <TextBlock Text="avg WPM" Style="{StaticResource StatLabel}" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource StatCard}">
            <StackPanel HorizontalAlignment="Center">
              <Viewbox Width="20" Height="20" HorizontalAlignment="Center" Margin="0,2,0,8">
                <Grid Width="20" Height="20">
                  <Ellipse Width="5" Height="5" Fill="{DynamicResource AccentBlueBrush}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5,4,0,0" />
                  <Ellipse Width="4" Height="4" Fill="{DynamicResource AccentBlueBrush}" Opacity="0.75" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12,5,0,0" />
                  <Path Fill="{DynamicResource AccentBlueBrush}" Data="M3,17 C3.3,13.8 5.5,12 8,12 C10.5,12 12.7,13.8 13,17 Z" />
                  <Path Fill="{DynamicResource AccentBlueBrush}" Opacity="0.75" Data="M11,17 C11.2,14.3 13,12.8 15,12.8 C16.8,12.8 18.5,14.3 18.8,17 Z" />
                </Grid>
              </Viewbox>
              <TextBlock Text="{Binding MeetingCount}" Style="{StaticResource StatValue}" />
              <TextBlock Text="meetings" Style="{StaticResource StatLabel}" />
            </StackPanel>
          </Border>
        </UniformGrid>

        <Grid Grid.Row="1">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <DockPanel Grid.Row="0" Margin="12,0,12,8" LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <TextBlock Text="{Binding DictationStatus}" MaxWidth="360"
                         Visibility="Collapsed"
                         TextTrimming="CharacterEllipsis"
                         FontSize="13" Foreground="{DynamicResource TextTertiaryBrush}" />
              <Button Margin="16,-6,0,0" Style="{StaticResource GhostButton}" Click="OpenButtonContextMenu_Click">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE71C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" />
                  <TextBlock Text="{Binding DictationFilterLabel}" Margin="6,0,0,0" />
                  <TextBlock Text="⌄" Margin="6,-1,0,0" />
                </StackPanel>
                <Button.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="All time" Tag="all" Click="SetDictationFilter_Click" />
                    <MenuItem Header="Last 2 days" Tag="last2Days" Click="SetDictationFilter_Click" />
                    <MenuItem Header="Last week" Tag="lastWeek" Click="SetDictationFilter_Click" />
                    <MenuItem Header="Last 2 weeks" Tag="last2Weeks" Click="SetDictationFilter_Click" />
                    <MenuItem Header="Last month" Tag="lastMonth" Click="SetDictationFilter_Click" />
                    <MenuItem Header="Last 3 months" Tag="last3Months" Click="SetDictationFilter_Click" />
                  </ContextMenu>
                </Button.ContextMenu>
              </Button>
            </StackPanel>
            <TextBlock Text="{Binding DictationHeaderLabel}" FontSize="13" FontWeight="Bold"
                       Foreground="{DynamicResource TextTertiaryBrush}" />
          </DockPanel>

          <Border Grid.Row="1"
                  Background="{DynamicResource BackgroundRaisedBrush}"
                  BorderBrush="{DynamicResource BorderBrushSoft}"
                  BorderThickness="1"
                  CornerRadius="10">
            <Grid>
              <ListBox ItemsSource="{Binding FilteredDictations}"
                       Background="Transparent"
                       BorderThickness="0"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       HorizontalContentAlignment="Stretch"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                       ItemContainerStyle="{StaticResource MuesliListBoxItem}"
                       MouseDoubleClick="DictationsList_MouseDoubleClick"
                       Visibility="{Binding HasDictations, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ListBox.GroupStyle>
                  <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Name}"
                                   Margin="20,18,20,2"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextTertiaryBrush}" />
                      </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                  </GroupStyle>
                </ListBox.GroupStyle>
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="20,16"
                          HorizontalAlignment="Stretch"
                          Background="Transparent"
                          PreviewMouseLeftButtonDown="DictationRow_Click">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding Time}" FontFamily="Consolas" FontSize="13" FontWeight="SemiBold"
                                 Foreground="{DynamicResource TextTertiaryBrush}" />
                      <TextBox Grid.Column="1"
                               Text="{Binding Text}"
                               TextWrapping="Wrap"
                               AcceptsReturn="True"
                               FontSize="14"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Background="Transparent"
                               BorderThickness="0"
                               IsReadOnly="True"
                               Cursor="IBeam"
                               Padding="0"
                               HorizontalScrollBarVisibility="Disabled"
                               VerticalScrollBarVisibility="Disabled"
                               SelectionBrush="{DynamicResource AccentBlueBrush}" />
                      <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="14,-4,0,0">
                        <StackPanel.Style>
                          <Style TargetType="StackPanel">
                            <Setter Property="Opacity" Value="0" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                <Setter Property="Opacity" Value="1" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </StackPanel.Style>
                        <Button Style="{StaticResource GhostButton}" Content="&#xE8C8;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" ToolTip="Copy" Click="CopyDictation_Click" />
                        <Button Margin="6,0,0,0" Style="{StaticResource GhostButton}" Content="&#xE74D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{DynamicResource ErrorRedTransparentBrush}" ToolTip="Delete" Click="DeleteDictation_Click" />
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <StackPanel Style="{StaticResource EmptyStatePanel}" Visibility="{Binding HasDictations, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                <TextBlock Text="&#xE70F;" Style="{StaticResource EmptyStateIcon}" />
                <TextBlock Text="No dictations yet" Style="{StaticResource EmptyStateTitle}" />
                <TextBlock Text="Hold your shortcut to dictate. Transcripts will appear here." Style="{StaticResource EmptyStateBody}" />
              </StackPanel>
            </Grid>
          </Border>
        </Grid>
      </Grid>

      <Grid x:Name="SearchPage" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,22">
          <TextBlock Text="{Binding SearchResultsTitle}" Style="{StaticResource PageTitle}" />
          <TextBlock Text="{Binding SearchResultsSummary}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" />
        </StackPanel>

         <Grid Grid.Row="1">
           <ScrollViewer VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Disabled"
                         Padding="0,0,12,0"
                         Visibility="{Binding HasSearchResults, Converter={StaticResource BooleanToVisibilityConverter}}">
             <StackPanel MaxWidth="980" Margin="0,0,0,24">
            <DockPanel Margin="0,0,0,12">
              <TextBlock Text="DICTATIONS" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" />
            </DockPanel>
            <Border Background="{DynamicResource BackgroundRaisedBrush}"
                    BorderBrush="{DynamicResource BorderBrushSoft}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Margin="0,0,0,24">
              <ListBox ItemsSource="{Binding SearchDictationResults}"
                       Background="Transparent"
                       BorderThickness="0"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       HorizontalContentAlignment="Stretch"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                       ItemContainerStyle="{StaticResource MuesliListBoxItem}"
                       MouseDoubleClick="DictationsList_MouseDoubleClick">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="20,14"
                          HorizontalAlignment="Stretch"
                          Background="Transparent"
                          PreviewMouseLeftButtonDown="DictationRow_Click">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding Time}" FontFamily="Consolas" FontSize="13" FontWeight="SemiBold"
                                 Foreground="{DynamicResource TextTertiaryBrush}" />
                      <TextBox Grid.Column="1"
                               Text="{Binding Text}"
                               TextWrapping="Wrap"
                               AcceptsReturn="True"
                               FontSize="14"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Background="Transparent"
                               BorderThickness="0"
                               IsReadOnly="True"
                               Cursor="IBeam"
                               Padding="0"
                               HorizontalScrollBarVisibility="Disabled"
                               VerticalScrollBarVisibility="Disabled"
                               SelectionBrush="{DynamicResource AccentBlueBrush}" />
                      <Button Grid.Column="2"
                              Margin="14,-4,0,0"
                              Style="{StaticResource GhostButton}"
                              Content="&#xE8C8;"
                              FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                              ToolTip="Copy"
                              Click="CopyDictation_Click" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Border>

            <DockPanel Margin="0,0,0,12">
              <TextBlock Text="MEETINGS" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" />
            </DockPanel>
            <ListBox ItemsSource="{Binding SearchMeetingResults}"
                     Background="Transparent"
                     BorderThickness="0"
                     Foreground="{DynamicResource TextPrimaryBrush}"
                     ItemContainerStyle="{StaticResource MuesliListBoxItem}">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Border Background="{DynamicResource BackgroundRaisedBrush}"
                          BorderBrush="{DynamicResource BorderBrushSoft}"
                          BorderThickness="1"
                          CornerRadius="10"
                          Padding="16"
                          Margin="0,0,0,10"
                          Cursor="Hand"
                          MouseLeftButtonUp="MeetingCard_Click">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Metadata}" Margin="0,6,0,0" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding PreviewText}"
                                   Margin="0,8,0,0"
                                   TextWrapping="Wrap"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="13"
                                   MaxHeight="38"
                                   LineHeight="19" />
                      </StackPanel>
                      <TextBlock Grid.Column="1"
                                 Text="&#xE8B7;"
                                 FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                 FontSize="14"
                                 Foreground="{DynamicResource AccentBlueBrush}"
                                 Margin="0,2,0,0" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
             </ListBox>
           </StackPanel>
         </ScrollViewer>
         <StackPanel Style="{StaticResource EmptyStatePanel}" Visibility="{Binding HasSearchResults, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
           <TextBlock Text="&#xE721;" Style="{StaticResource EmptyStateIcon}" />
           <TextBlock Text="No results found" Style="{StaticResource EmptyStateTitle}" />
           <TextBlock Text="Try a different search term." Style="{StaticResource EmptyStateBody}" />
          </StackPanel>
        </Grid>
      </Grid>

       <Grid x:Name="SettingsPage" Visibility="Collapsed">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="0,0,12,0">
          <StackPanel MaxWidth="860" Margin="0,0,0,24">
            <TextBlock Text="Settings" Style="{StaticResource PageTitle}" />

            <TabControl Style="{StaticResource MuesliTabControl}">
              <TabItem Header="General" Style="{StaticResource MuesliTabItem}">
                <StackPanel>
                  <TextBlock Text="GENERAL" Style="{StaticResource SectionLabel}" />
                  <Border Style="{StaticResource ContentCard}">
                    <StackPanel>
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Your name" Style="{StaticResource SettingsRowLabel}" />
                        <TextBox Grid.Column="1"
                                 Style="{StaticResource MuesliTextBox}"
                                 Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" />
                      </Grid>
                      <Border Height="1" Background="{DynamicResource BorderBrushSoft}" Margin="0,12" />
                      <CheckBox Style="{StaticResource MuesliCheckBox}" Content="Launch at login" IsChecked="{Binding StartAtLogin}" />
                      <Border Height="1" Background="{DynamicResource BorderBrushSoft}" Margin="0,12" />
                      <CheckBox Style="{StaticResource MuesliCheckBox}" Content="Open dashboard on launch" IsChecked="{Binding OpenDashboardOnLaunch}" />
                    </StackPanel>
                  </Border>

                  <TextBlock Text="MICROPHONE" Style="{StaticResource SectionLabel}" />
                  <Border Style="{StaticResource ContentCard}">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="220" />
                      </Grid.ColumnDefinitions>
                      <ComboBox Style="{StaticResource MuesliComboBox}"
                                ItemsSource="{Binding MicrophoneDevices}"
                                SelectedItem="{Binding SelectedMicrophone}" />
                      <Button Grid.Column="1" Margin="16,0,0,0" Style="{StaticResource PrimaryButton}" Click="TestMic_Click" Content="Test mic" />
                    </Grid>
                  </Border>
                </StackPanel>
              </TabItem>

              <TabItem Header="Dictation" Style="{StaticResource MuesliTabItem}">
                <StackPanel>
                  <TextBlock Text="TRANSCRIPTION" Style="{StaticResource SectionLabel}" />
                  <Border Style="{StaticResource ContentCard}">
                    <StackPanel>
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Dictation model" Style="{StaticResource SettingsRowLabel}" />
                        <ComboBox Grid.Column="1" Style="{StaticResource MuesliComboBox}" ItemsSource="{Binding ModelProfiles}" SelectedItem="{Binding SelectedModelProfile}" />
                      </Grid>
                      <Border Height="1" Background="{DynamicResource BorderBrushSoft}" Margin="0,12" />
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Transcription backend" Style="{StaticResource SettingsRowLabel}" />
                        <ComboBox Grid.Column="1" Style="{StaticResource MuesliComboBox}" ItemsSource="{Binding AsrEngines}" SelectedItem="{Binding SelectedAsrEngine}" />
                      </Grid>
                      <Border Height="1" Background="{DynamicResource BorderBrushSoft}" Margin="0,12" />
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Language hint" Style="{StaticResource SettingsRowLabel}" />
                        <ComboBox Grid.Column="1" Style="{StaticResource MuesliComboBox}" ItemsSource="{Binding LanguageOptions}" SelectedItem="{Binding SelectedDictationLanguage}" />
                      </Grid>
                      <Border Height="1" Background="{DynamicResource BorderBrushSoft}" Margin="0,12" />
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                          <TextBlock Text="Hands-Free Mode" Style="{StaticResource SettingsRowLabel}" />
                          <TextBlock Text="Double-tap the shortcut to start, tap again to stop." Margin="0,4,0,0" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource MuesliCheckBox}" IsChecked="{Binding EnableDoubleTapDictation}" HorizontalAlignment="Right" />
                      </Grid>
                      <Border Height="1" Background="{DynamicResource BorderBrushSoft}" Margin="0,12" />
                      <CheckBox Style="{StaticResource MuesliCheckBox}" Content="Remove filler words locally" IsChecked="{Binding RemoveFillerWords}" />
                      <TextBlock Text="Deterministically removes common speech fillers before dictionary correction; no model or network is used." Margin="0,10,0,0" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" />
                      <Border Height="1" Background="{DynamicResource BorderBrushSoft}" Margin="0,12" />
                      <CheckBox Style="{StaticResource MuesliCheckBox}" Content="AI transcript cleanup" IsChecked="{Binding PostProcessingEnabled}" />
                      <TextBlock Text="Uses Qwen post-processing for punctuation, grammar, casing, deletion cues, and spoken lists." Margin="0,10,0,0" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>

                  <TextBlock Text="CONTROLS" Style="{StaticResource SectionLabel}" />
                  <Border Style="{StaticResource ContentCard}">
                    <StackPanel>
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Push to Talk" Style="{StaticResource SettingsRowLabel}" />
                        <ComboBox Grid.Column="1" Style="{StaticResource MuesliComboBox}" ItemsSource="{Binding HotkeyOptions}" SelectedItem="{Binding SelectedHotkey}" />
                      </Grid>
                      <Border Height="1" Background="{DynamicResource BorderBrushSoft}" Margin="0,12" />
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                          <TextBlock Text="Delivery mode" Style="{StaticResource SettingsRowLabel}" />
                          <TextBlock Text="history-only saves a voice note without changing the clipboard or active app." Margin="0,4,12,0" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" Style="{StaticResource MuesliComboBox}" ItemsSource="{Binding PasteBehaviors}" SelectedItem="{Binding SelectedPasteBehavior}" />
                      </Grid>
                      <Button Margin="0,16,0,0" HorizontalAlignment="Left" Style="{StaticResource PrimaryButton}" PreviewMouseDown="HoldToDictate_MouseDown" PreviewMouseUp="HoldToDictate_MouseUp" Content="Hold to dictate" />
                    </StackPanel>
                  </Border>
                </StackPanel>
              </TabItem>

              <TabItem Header="Meetings" Style="{StaticResource MuesliTabItem}">
                <StackPanel>
                  <TextBlock Text="RECORDING" Style="{StaticResource SectionLabel}" />
                  <Border Style="{StaticResource ContentCard}">
                    <StackPanel>
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions>
                        <TextBlock Text="Meeting microphone" Style="{StaticResource SettingsRowLabel}" />
                        <ComboBox Grid.Column="1" Style="{StaticResource MuesliComboBox}" ItemsSource="{Binding MicrophoneDevices}" SelectedItem="{Binding SelectedMeetingMicrophone}" />
                      </Grid>
                      <Border Height="1" Background="{DynamicResource BorderBrushSoft}" Margin="0,12" />
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions>
                        <TextBlock Text="Meeting backend" Style="{StaticResource SettingsRowLabel}" />
                        <ComboBox Grid.Column="1" Style="{StaticResource MuesliComboBox}" ItemsSource="{Binding AsrEngines}" SelectedItem="{Binding SelectedMeetingAsrEngine}" />
                      </Grid>
                      <Border Height="1" Background="{DynamicResource BorderBrushSoft}" Margin="0,12" />
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions>
                        <TextBlock Text="Meeting model" Style="{StaticResource SettingsRowLabel}" />
                        <ComboBox Grid.Column="1" Style="{StaticResource MuesliComboBox}" ItemsSource="{Binding ModelProfiles}" SelectedItem="{Binding SelectedMeetingModelProfile}" />
                      </Grid>
                      <Border Height="1" Background="{DynamicResource BorderBrushSoft}" Margin="0,12" />
                      <CheckBox Style="{StaticResource MuesliCheckBox}" Content="Notify when meeting detected" IsChecked="{Binding AutoMeetingDetectionEnabled}" />
                      <Border Height="1" Background="{DynamicResource BorderBrushSoft}" Margin="0,12" />
                      <TextBlock Text="Temporary meeting audio is deleted after a complete transcript is safely saved. Recovery audio is kept only for failed or partial transcripts." Style="{StaticResource SettingsRowLabel}" TextWrapping="Wrap" />
                      <Border Height="1" Background="{DynamicResource BorderBrushSoft}" Margin="0,12" />
                      <CheckBox Style="{StaticResource MuesliCheckBox}" Content="Automatically export completed meetings as Markdown" IsChecked="{Binding AutoExportMeetings}" />
                      <TextBox Margin="0,10,0,0" Style="{StaticResource MuesliTextBox}" Text="{Binding AutoExportDirectory, UpdateSourceTrigger=LostFocus}" ToolTip="Leave blank to use Documents\Muesli Meetings" />
                      <TextBlock Text="Windows checks active app titles, supported browser URLs where accessible, and meeting app process names." Margin="0,10,0,0" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" />
                      <Button Margin="0,12,0,0" HorizontalAlignment="Left" Style="{StaticResource SecondaryButton}" Content="Check meeting detection now" Click="CheckMeetingDetection_Click" />
                      <TextBlock Text="{Binding MeetingDetectionStatus}" Margin="0,10,0,0" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>

                  <TextBlock Text="MEETING SUMMARIES" Style="{StaticResource SectionLabel}" />
                  <Border Style="{StaticResource ContentCard}">
                    <StackPanel>
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Summary backend" Style="{StaticResource SettingsRowLabel}" />
                        <ComboBox Grid.Column="1" Style="{StaticResource MuesliComboBox}" ItemsSource="{Binding SummaryProviders}" SelectedItem="{Binding SelectedSummaryProvider}" />
                      </Grid>
                      <Border Height="1" Background="{DynamicResource BorderBrushSoft}" Margin="0,12" />
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Default template" Style="{StaticResource SettingsRowLabel}" />
                        <ComboBox Grid.Column="1" Style="{StaticResource MuesliComboBox}" ItemsSource="{Binding SummaryTemplates}" SelectedItem="{Binding SelectedSummaryTemplate}" />
                      </Grid>
                      <Border Height="1" Background="{DynamicResource BorderBrushSoft}" Margin="0,12" />
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="OpenAI API key" Style="{StaticResource SettingsRowLabel}" />
                        <TextBox Grid.Column="1" Style="{StaticResource MuesliTextBox}" Text="{Binding OpenAIApiKey, UpdateSourceTrigger=PropertyChanged}" />
                      </Grid>
                      <Border Height="1" Background="{DynamicResource BorderBrushSoft}" Margin="0,12" />
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="OpenAI model" Style="{StaticResource SettingsRowLabel}" />
                        <TextBox Grid.Column="1" Style="{StaticResource MuesliTextBox}" Text="{Binding OpenAIModel, UpdateSourceTrigger=PropertyChanged}" />
                      </Grid>
                      <Border Height="1" Background="{DynamicResource BorderBrushSoft}" Margin="0,12" />
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="OpenRouter API key" Style="{StaticResource SettingsRowLabel}" />
                        <TextBox Grid.Column="1" Style="{StaticResource MuesliTextBox}" Text="{Binding OpenRouterApiKey, UpdateSourceTrigger=PropertyChanged}" />
                      </Grid>
                      <Border Height="1" Background="{DynamicResource BorderBrushSoft}" Margin="0,12" />
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="OpenRouter model" Style="{StaticResource SettingsRowLabel}" />
                        <TextBox Grid.Column="1" Style="{StaticResource MuesliTextBox}" Text="{Binding OpenRouterModel, UpdateSourceTrigger=PropertyChanged}" />
                      </Grid>
                      <Border Height="1" Background="{DynamicResource BorderBrushSoft}" Margin="0,12" />
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions>
                        <StackPanel>
                          <TextBlock Text="Compatible endpoint" Style="{StaticResource SettingsRowLabel}" />
                          <TextBlock Text="Used by custom; Ollama and LM Studio have standard local defaults." FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBox Grid.Column="1" Style="{StaticResource MuesliTextBox}" Text="{Binding CustomSummaryEndpoint, UpdateSourceTrigger=LostFocus}" />
                      </Grid>
                      <Border Height="1" Background="{DynamicResource BorderBrushSoft}" Margin="0,12" />
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions>
                        <TextBlock Text="Compatible model" Style="{StaticResource SettingsRowLabel}" />
                        <TextBox Grid.Column="1" Style="{StaticResource MuesliTextBox}" Text="{Binding CustomSummaryModel, UpdateSourceTrigger=LostFocus}" />
                      </Grid>
                      <Border Height="1" Background="{DynamicResource BorderBrushSoft}" Margin="0,12" />
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions>
                        <TextBlock Text="Compatible API key (optional)" Style="{StaticResource SettingsRowLabel}" />
                        <TextBox Grid.Column="1" Style="{StaticResource MuesliTextBox}" Text="{Binding CustomSummaryApiKey, UpdateSourceTrigger=LostFocus}" />
                      </Grid>
                    </StackPanel>
                  </Border>
                </StackPanel>
              </TabItem>

              <TabItem Header="Appearance" Style="{StaticResource MuesliTabItem}">
                <StackPanel>
                  <TextBlock Text="APPEARANCE" Style="{StaticResource SectionLabel}" />
                  <Border Style="{StaticResource ContentCard}">
                    <StackPanel>
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                          <TextBlock Text="Theme" Style="{StaticResource SettingsRowLabel}" />
                          <TextBlock Text="Switch between the OG light and dark palettes." Margin="0,6,0,0" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" Style="{StaticResource MuesliComboBox}" ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding SelectedTheme, Mode=TwoWay}" />
                      </Grid>
                      <Border Height="1" Background="{DynamicResource BorderBrushSoft}" Margin="0,12" />
                      <CheckBox Style="{StaticResource MuesliCheckBox}" Content="Show floating indicator" IsChecked="{Binding ShowFloatingIndicator}" />
                      <Border Height="1" Background="{DynamicResource BorderBrushSoft}" Margin="0,12" />
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                          <TextBlock Text="Floating indicator position" Style="{StaticResource SettingsRowLabel}" />
                          <TextBlock Text="Dragging the indicator saves a custom position until this anchor is changed." Margin="0,5,0,0" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" Style="{StaticResource MuesliComboBox}" ItemsSource="{Binding IndicatorPositions}" SelectedItem="{Binding SelectedIndicatorPosition}" />
                      </Grid>
                    </StackPanel>
                  </Border>

                  <TextBlock Text="SYSTEM PROMPT" Style="{StaticResource SectionLabel}" />
                  <Border Style="{StaticResource ContentCard}">
                    <StackPanel>
                      <TextBlock Text="Controls how Qwen cleans up transcriptions. Applies when AI transcript cleanup is enabled." FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                      <TextBox Text="{Binding PostProcessingPrompt, UpdateSourceTrigger=PropertyChanged}"
                               Margin="0,12,0,0"
                               MinHeight="118"
                               Padding="12"
                               AcceptsReturn="True"
                               TextWrapping="Wrap"
                               VerticalScrollBarVisibility="Auto"
                               Style="{StaticResource MuesliTextBox}"
                               FontFamily="Consolas"
                               FontSize="12" />
                    </StackPanel>
                  </Border>
                </StackPanel>
              </TabItem>
            </TabControl>
          </StackPanel>
        </ScrollViewer>
      </Grid>

      <Grid x:Name="ModelsPage" Visibility="Collapsed">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="0,0,12,0">
        <StackPanel MaxWidth="960" Margin="0,0,0,24">
          <TextBlock Text="Models" Style="{StaticResource PageTitle}" />
          <TextBlock Text="Download and manage transcription models. The active model is used for dictation." Style="{StaticResource PageSubtitle}" />

          <Border Style="{StaticResource ContentCard}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="Runtime status" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="{Binding SetupReadiness, Mode=OneWay}" Margin="0,6,0,12" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                <StackPanel>
                  <Border Margin="0,0,0,10" Padding="12,10" Background="{DynamicResource BackgroundHoverBrush}" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1" CornerRadius="8">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="Transcription worker" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                      <Border Grid.Column="1" Padding="10,4" Background="{DynamicResource SurfacePrimaryBrush}" CornerRadius="999" VerticalAlignment="Center">
                        <TextBlock Text="{Binding TranscriptionWorkerStatus, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                      </Border>
                    </Grid>
                  </Border>
                  <Border Margin="0,0,0,10" Padding="12,10" Background="{DynamicResource BackgroundHoverBrush}" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1" CornerRadius="8">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="Whisper" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                      <Border Grid.Column="1" Padding="10,4" Background="{DynamicResource SurfacePrimaryBrush}" CornerRadius="999" VerticalAlignment="Center">
                        <TextBlock Text="{Binding WhisperRuntimeStatus, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                      </Border>
                    </Grid>
                  </Border>
                  <Border Margin="0,0,0,10" Padding="12,10" Background="{DynamicResource BackgroundHoverBrush}" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1" CornerRadius="8">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="Selected model" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                      <Border Grid.Column="1" Padding="10,4" Background="{DynamicResource SurfacePrimaryBrush}" CornerRadius="999" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SelectedModelCacheStatus, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                      </Border>
                    </Grid>
                  </Border>
                  <Border Margin="0,0,0,10" Padding="12,10" Background="{DynamicResource BackgroundHoverBrush}" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1" CornerRadius="8">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="Speaker diarization" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                      <Border Grid.Column="1" Padding="10,4" Background="{DynamicResource SurfacePrimaryBrush}" CornerRadius="999" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SpeakerDiarizationStatusLabel, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                      </Border>
                    </Grid>
                  </Border>
                  <Border Padding="12,10" Background="{DynamicResource BackgroundHoverBrush}" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1" CornerRadius="8">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="GPU" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                      <Border Grid.Column="1" Padding="10,4" Background="{DynamicResource SurfacePrimaryBrush}" CornerRadius="999" VerticalAlignment="Center">
                        <TextBlock Text="{Binding GpuRuntimeStatus, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                      </Border>
                    </Grid>
                  </Border>
                </StackPanel>
                <TextBlock Margin="0,12,0,0" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap">
                  <Run Text="Optional backends: Qwen " />
                  <Run Text="{Binding QwenRuntimeStatus, Mode=OneWay}" />
                  <Run Text=" • Parakeet " />
                  <Run Text="{Binding ParakeetRuntimeStatus, Mode=OneWay}" />
                </TextBlock>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                  <Button Style="{StaticResource SecondaryButton}" Content="Check setup" Click="RefreshRuntimeDiagnostics_Click" />
                  <Button Margin="10,0,0,0" Style="{StaticResource PrimaryButton}" Content="Download selected" Click="DownloadWhisperModel_Click" />
                  <Button Margin="10,0,0,0" Style="{StaticResource GhostButton}" Content="Open cache" Click="OpenModelCache_Click" />
                  <Button Margin="10,0,0,0" Style="{StaticResource GhostButton}" Content="Open logs" Click="OpenLogs_Click" />
                  <Button Margin="10,0,0,0" Style="{StaticResource GhostButton}" Content="Clear cache" Foreground="{DynamicResource ErrorRedBrush}" Click="ClearModelCache_Click" />
                </StackPanel>
                <Expander Margin="0,12,0,0" Foreground="{DynamicResource TextSecondaryBrush}">
                  <Expander.Header>
                    <TextBlock Text="Advanced diagnostics" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                  </Expander.Header>
                  <TextBox Text="{Binding RuntimeDiagnostics, Mode=OneWay}"
                           Margin="0,10,0,0"
                           MinHeight="150"
                           Padding="12"
                           TextWrapping="Wrap"
                           AcceptsReturn="True"
                           Background="{DynamicResource BackgroundHoverBrush}"
                           BorderBrush="{DynamicResource BorderBrushSoft}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontFamily="Consolas"
                           FontSize="12"
                           IsReadOnly="True"
                           Cursor="IBeam" />
                </Expander>
              </StackPanel>
              <Border Grid.Column="1" Height="28" Padding="10,0" CornerRadius="5" Background="{DynamicResource SurfacePrimaryBrush}" VerticalAlignment="Top">
                <TextBlock Text="{Binding ModelCacheSize}" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextTertiaryBrush}" />
              </Border>
            </Grid>
          </Border>

          <Border Style="{StaticResource ContentCard}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <StackPanel Orientation="Horizontal">
                  <Image Source="Assets/cohere.png" Width="24" Height="24" Stretch="Uniform" Margin="0,0,10,0" />
                  <TextBlock Text="Cohere Transcribe" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                  <TextBlock Text="~3.8 GB" Margin="10,0,0,0" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="Mixed precision transcription model. High accuracy, heavier than Whisper, and retained in the Windows model catalog for parity with Muesli." Margin="0,8,0,12" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal">
                  <Button Style="{StaticResource GhostButton}" Content="Requires model runtime" IsEnabled="False" />
                </StackPanel>
              </StackPanel>
              <Border Grid.Column="1" Height="28" Padding="10,0" CornerRadius="5" Background="{DynamicResource SurfacePrimaryBrush}" VerticalAlignment="Top">
                <TextBlock Text="Catalog" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextTertiaryBrush}" />
              </Border>
            </Grid>
          </Border>

          <Border Style="{StaticResource ContentCard}" BorderBrush="#806BA3F7" BorderThickness="1.5">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <StackPanel Orientation="Horizontal">
                  <Image Source="Assets/nvidia.png" Width="24" Height="24" Stretch="Uniform" Margin="0,0,10,0" />
                  <TextBlock Text="Parakeet Family" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                  <Border Margin="10,0,0,0" Padding="8,3" CornerRadius="5" Background="{DynamicResource AccentBadgeBackgroundBrush}">
                    <TextBlock Text="Default: v3" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBlueBrush}" />
                  </Border>
                </StackPanel>
                <TextBlock Text="NVIDIA speech models for fast everyday dictation." Margin="0,8,0,12" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                  <TextBlock Text="Variant" Width="72" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextTertiaryBrush}" />
                  <Border Width="190" Height="36" Background="{DynamicResource SurfacePrimaryBrush}" CornerRadius="6">
                    <TextBlock Text="Parakeet slot" Margin="12,0" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                  </Border>
                  <TextBlock Text="~450 MB" Margin="120,0,0,0" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextTertiaryBrush}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                  <Button Style="{StaticResource PrimaryButton}" Content="Set Active" Click="SetParakeetActive_Click" />
                  <Button Margin="10,0,0,0" Style="{StaticResource SecondaryButton}" Content="Test Parakeet" Click="TestParakeet_Click" />
                </StackPanel>
                <TextBlock Text="Optional NVIDIA-optimized backend for high-end Windows laptops. Requires optional Parakeet Python dependencies and an NVIDIA CUDA runtime." FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
              </StackPanel>
              <Border Grid.Column="1" Height="28" Padding="10,0" CornerRadius="5" Background="{DynamicResource SuccessBadgeBackgroundBrush}" VerticalAlignment="Top">
                <TextBlock Text="{Binding ParakeetStatusLabel}" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SuccessGreenBrush}" />
              </Border>
            </Grid>
          </Border>

          <Border Style="{StaticResource ContentCard}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <StackPanel Orientation="Horizontal">
                  <Image Source="Assets/openai.png" Width="24" Height="24" Stretch="Uniform" Margin="0,0,10,0" />
                  <TextBlock Text="Whisper" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                  <Border Margin="10,0,0,0" Padding="8,3" CornerRadius="5" Background="{DynamicResource AccentBadgeBackgroundBrush}">
                    <TextBlock Text="Default: base" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBlueBrush}" />
                  </Border>
                </StackPanel>
                <TextBlock Text="OpenAI Whisper variants. Runs locally on CPU or NVIDIA CUDA via faster-whisper." Margin="0,8,0,12" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                  <TextBlock Text="Variant" Width="72" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextTertiaryBrush}" />
                  <ComboBox Width="220" Style="{StaticResource MuesliComboBox}" ItemsSource="{Binding ModelProfiles}" SelectedItem="{Binding SelectedModelProfile}" />
                  <TextBlock Text="~75 MB to ~1.6 GB" Margin="120,0,0,0" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextTertiaryBrush}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                  <Button Style="{StaticResource PrimaryButton}" Content="Download selected" Click="DownloadWhisperModel_Click" />
                  <Button Margin="10,0,0,0" Style="{StaticResource GhostButton}" Content="Open cache" Click="OpenModelCache_Click" />
                </StackPanel>
                <TextBlock Text="Use tiny/base on basic CPUs, small/medium on stronger CPUs, and large-v3-turbo on high-end NVIDIA laptops." FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
              </StackPanel>
              <Border Grid.Column="1" Height="28" Padding="10,0" CornerRadius="5" Background="{DynamicResource SuccessBadgeBackgroundBrush}" VerticalAlignment="Top">
                <TextBlock Text="{Binding WhisperStatusLabel}" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SuccessGreenBrush}" />
              </Border>
            </Grid>
          </Border>

          <Border Style="{StaticResource ContentCard}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <StackPanel Orientation="Horizontal">
                  <Image Source="Assets/qwen.png" Width="24" Height="24" Stretch="Uniform" Margin="0,0,10,0" />
                  <TextBlock Text="Post-Processing" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                  <TextBlock Text="~2 GB+" Margin="10,0,0,0" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="Optional Qwen cleanup layer after transcription. Removes filler words, fixes punctuation/casing, and formats spoken lists." Margin="0,8,0,12" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                <CheckBox Content="Clean up transcripts after Whisper"
                          IsChecked="{Binding PostProcessingEnabled}"
                          Foreground="{DynamicResource TextPrimaryBrush}"
                          FontSize="13" />
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                  <Button Style="{StaticResource PrimaryButton}" Content="Download Qwen" Click="DownloadQwenModel_Click" />
                  <Button Margin="10,0,0,0" Style="{StaticResource GhostButton}" Content="Open cache" Click="OpenModelCache_Click" />
                  <Button Margin="10,0,0,0" Style="{StaticResource SecondaryButton}" Content="Test cleanup" Click="TestQwenCleanup_Click" />
                </StackPanel>
              </StackPanel>
              <Border Grid.Column="1" Height="28" Padding="10,0" CornerRadius="5" Background="{DynamicResource SurfacePrimaryBrush}" VerticalAlignment="Top">
                <TextBlock Text="Toggleable" VerticalAlignment="Center" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource TextTertiaryBrush}" />
              </Border>
            </Grid>
          </Border>

          <Border Style="{StaticResource ContentCard}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <StackPanel Orientation="Horizontal">
                  <Image Source="Assets/openai.png" Width="24" Height="24" Stretch="Uniform" Margin="0,0,10,0" />
                <TextBlock Text="Speaker Diarization" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="Required for Speaker 1 / Speaker 2 labels in meeting transcripts. Uses pyannote.audio to identify individual speakers from system audio." Margin="0,8,0,12" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                  <TextBlock Text="Status" Width="90" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextTertiaryBrush}" />
                  <TextBlock Text="{Binding DiarizationDependencyStatus, Mode=OneWay}" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                  <TextBlock Text="Access" Width="90" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextTertiaryBrush}" />
                  <TextBlock Text="{Binding DiarizationTokenStatus, Mode=OneWay}" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                  <Button Style="{StaticResource PrimaryButton}" Content="Test diarization" Click="TestDiarization_Click" />
                  <Button Margin="10,0,0,0" Style="{StaticResource GhostButton}" Content="Check setup" Click="RefreshRuntimeDiagnostics_Click" />
                </StackPanel>
              </StackPanel>
              <Border Grid.Column="1" Height="28" Padding="10,0" CornerRadius="5" Background="{DynamicResource SurfacePrimaryBrush}" VerticalAlignment="Top">
                <TextBlock Text="Optional" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextTertiaryBrush}" />
              </Border>
            </Grid>
          </Border>

          <Border Style="{StaticResource ContentCard}">
            <DockPanel>
              <Border DockPanel.Dock="Right" Padding="10,5" CornerRadius="6" Background="{DynamicResource SurfacePrimaryBrush}">
                <TextBlock Text="Editable" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextTertiaryBrush}" />
              </Border>
              <StackPanel>
                <TextBlock Text="System Prompt" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="Controls how Qwen cleans up dictations and meeting transcripts." Margin="0,6,0,12" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                <TextBox Text="{Binding PostProcessingPrompt, UpdateSourceTrigger=PropertyChanged}"
                         MinHeight="118"
                         Padding="12"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         Background="{DynamicResource BackgroundHoverBrush}"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         BorderBrush="{DynamicResource BorderBrushSoft}"
                         FontFamily="Consolas"
                         FontSize="12" />
              </StackPanel>
            </DockPanel>
          </Border>

          <Border Style="{StaticResource ContentCard}">
            <DockPanel>
              <Border DockPanel.Dock="Right" Padding="8,4" CornerRadius="12" Background="{DynamicResource SurfacePrimaryBrush}">
                <TextBlock Text="IYKYK" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextTertiaryBrush}" />
              </Border>
              <StackPanel>
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="›" FontSize="16" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,-1,8,0" />
                  <TextBlock Text="Experimental" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
                <TextBlock Text="Qwen and streaming backends. Hidden by default because these are still slower and less polished." Margin="0,4,0,0" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
              </StackPanel>
            </DockPanel>
          </Border>
        </StackPanel>
        </ScrollViewer>
      </Grid>

      <Grid x:Name="MeetingsPage" Visibility="Collapsed">
        <Grid x:Name="MeetingsBrowserView">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <StackPanel Grid.Row="0" Visibility="{Binding HasUpcomingMeetings, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,0,22">
            <TextBlock Text="Coming Up" FontSize="22" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,16" />
            <ItemsControl ItemsSource="{Binding UpcomingMeetings}" Background="Transparent" BorderThickness="0">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Background="{DynamicResource BackgroundRaisedBrush}" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1" CornerRadius="12" Padding="20,16" Margin="0,0,0,10">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="72" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="{Binding DayNumber}" FontSize="24" FontWeight="Light" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding DayLabel}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding DayOfWeek}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding TimeRange}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                      </StackPanel>
                      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource PrimaryButton}" Click="JoinAndRecordUpcoming_Click" Visibility="{Binding HasUrl, Converter={StaticResource BooleanToVisibilityConverter}}">
                          <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE714;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="9" Margin="0,0,4,0" />
                            <TextBlock Text="Join &amp; Record" FontSize="10" />
                          </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SecondaryButton}" Click="RecordOnlyUpcoming_Click" Visibility="{Binding HasUrl, Converter={StaticResource InverseBooleanToVisibilityConverter}}" Content="Record meeting" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

           <Grid Grid.Row="1" Margin="0,0,0,22">
             <Grid.ColumnDefinitions>
               <ColumnDefinition Width="*" />
               <ColumnDefinition Width="Auto" />
             </Grid.ColumnDefinitions>
             <StackPanel>
               <TextBlock Text="{Binding CurrentMeetingFolderName}" Style="{StaticResource PageTitle}" />
               <StackPanel Orientation="Horizontal">
                 <TextBlock Text="{Binding VisibleMeetingCount}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" />
                 <TextBlock Text=" meetings" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" />
               </StackPanel>
             </StackPanel>
             <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
               <Button Style="{StaticResource GhostButton}" Click="ToggleMeetingSort_Click">
                 <StackPanel Orientation="Horizontal">
                   <TextBlock Text="↕" Margin="0,0,6,0" />
                   <TextBlock Text="{Binding MeetingSortLabel}" />
                 </StackPanel>
               </Button>
               <Button Margin="8,0,0,0" Style="{StaticResource GhostButton}" ToolTip="{Binding MeetingFilterLabel}" Click="OpenButtonContextMenu_Click">
                 <StackPanel Orientation="Horizontal">
                   <TextBlock Text="☰" />
                   <TextBlock Text="{Binding MeetingFilterLabel}" Margin="6,0,0,0" />
                   <TextBlock Text="⌄" Margin="6,-1,0,0" />
                 </StackPanel>
                 <Button.ContextMenu>
                   <ContextMenu>
                     <MenuItem Header="All time" Tag="all" Click="SetMeetingFilter_Click" />
                     <MenuItem Header="Last 2 days" Tag="last2Days" Click="SetMeetingFilter_Click" />
                     <MenuItem Header="Last week" Tag="lastWeek" Click="SetMeetingFilter_Click" />
                     <MenuItem Header="Last 2 weeks" Tag="last2Weeks" Click="SetMeetingFilter_Click" />
                     <MenuItem Header="Last month" Tag="lastMonth" Click="SetMeetingFilter_Click" />
                     <MenuItem Header="Last 3 months" Tag="last3Months" Click="SetMeetingFilter_Click" />
                   </ContextMenu>
                 </Button.ContextMenu>
               </Button>
               <Button Margin="8,0,0,0" Style="{StaticResource GhostButton}" Click="ManageTemplates_Click" Content="Manage Templates" />
               <Button Margin="8,0,0,0" Style="{StaticResource PrimaryButton}" Click="ToggleMeetingRecording_Click" Content="{Binding MeetingRecordingButtonText}" />
               <Button Margin="8,0,0,0" Style="{StaticResource SecondaryButton}" Click="ImportMeeting_Click" Content="Import media" />
             </StackPanel>
           </Grid>
           <Grid Grid.Row="2">
             <ListBox ItemsSource="{Binding FilteredMeetings}"
                      Background="Transparent"
                      BorderThickness="0"
                      Foreground="{DynamicResource TextPrimaryBrush}"
                      ItemContainerStyle="{StaticResource MuesliListBoxItem}"
                      Visibility="{Binding HasMeetings, Converter={StaticResource BooleanToVisibilityConverter}}">
               <ListBox.ItemTemplate>
                 <DataTemplate>
                   <Border Background="{DynamicResource BackgroundRaisedBrush}"
                           BorderBrush="{DynamicResource BorderBrushSoft}"
                           BorderThickness="1"
                           CornerRadius="10"
                           Padding="16"
                           Margin="0,0,0,10"
                           Cursor="Hand"
                           MouseLeftButtonUp="MeetingCard_Click">
                     <Grid>
                       <Grid.ColumnDefinitions>
                         <ColumnDefinition Width="*" />
                         <ColumnDefinition Width="Auto" />
                       </Grid.ColumnDefinitions>
                       <StackPanel>
                         <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                         <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                           <TextBlock Text="{Binding Metadata}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                         </StackPanel>
                         <TextBlock Text="{Binding PreviewText}"
                                    Margin="0,8,0,0"
                                    TextWrapping="Wrap"
                                    TextTrimming="CharacterEllipsis"
                                    Foreground="{DynamicResource TextSecondaryBrush}"
                                    FontSize="13"
                                    MaxHeight="38"
                                    LineHeight="19" />
                       </StackPanel>
                       <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                         <TextBlock Text="&#xE8B7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource AccentBlueBrush}" Margin="0,2,0,0" />
                         <Button Margin="6,-2,0,0" Content="&#xE74D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{DynamicResource ErrorRedTransparentBrush}" ToolTip="Delete" Click="DeleteMeeting_Click">
                           <Button.Style>
                             <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                               <Setter Property="Opacity" Value="0" />
                               <Style.Triggers>
                                 <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                   <Setter Property="Opacity" Value="1" />
                                 </DataTrigger>
                               </Style.Triggers>
                             </Style>
                           </Button.Style>
                         </Button>
                       </StackPanel>
                     </Grid>
                   </Border>
                 </DataTemplate>
               </ListBox.ItemTemplate>
             </ListBox>
             <StackPanel Style="{StaticResource EmptyStatePanel}" Visibility="{Binding HasMeetings, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
               <TextBlock Text="&#xE720;" Style="{StaticResource EmptyStateIcon}" />
               <TextBlock Text="No meetings yet" Style="{StaticResource EmptyStateTitle}" />
               <TextBlock Text="Click Record or Import to capture your first meeting." Style="{StaticResource EmptyStateBody}" />
             </StackPanel>
           </Grid>
        </Grid>

        <Grid x:Name="MeetingDetailView" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <StackPanel Grid.Row="0" MaxWidth="980" Margin="40,0,40,0">
            <Button Style="{StaticResource GhostButton}"
                    HorizontalAlignment="Left"
                    Click="BackToMeetings_Click">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="‹" Margin="0,0,6,0" />
                <TextBlock Text="Back to Meetings" />
              </StackPanel>
            </Button>

            <Grid Margin="0,18,0,18">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBox Text="{Binding SelectedMeetingTitle, UpdateSourceTrigger=LostFocus}"
                         FontSize="28" FontWeight="SemiBold"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         Background="Transparent" BorderThickness="0" Padding="0" />
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="{Binding SelectedMeetingMetadata}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" />
                  <Border Margin="10,-2,0,0" Padding="8,4" CornerRadius="12" Background="{DynamicResource AccentBadgeBackgroundBrush}">
                    <TextBlock Text="Auto Notes" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBlueBrush}" />
                  </Border>
                  <Border Margin="8,-2,0,0" Padding="8,4" CornerRadius="12" Background="{DynamicResource SurfacePrimaryBrush}">
                    <TextBlock Text="{Binding SelectedMeetingSpeakerIdentificationLabel}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                  </Border>
                </StackPanel>
              </StackPanel>

              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <Border Width="220" Height="32" Background="{DynamicResource BackgroundRaisedBrush}" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1" CornerRadius="8" Margin="0,0,12,0">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="MeetingNotesTab"
                            Margin="2"
                            Background="{DynamicResource SurfaceSelectedBrush}"
                            CornerRadius="6"
                            Cursor="Hand"
                            MouseLeftButtonUp="ShowMeetingNotesTab_Click">
                      <TextBlock x:Name="MeetingNotesTabLabel" Text="Notes" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                    </Border>
                    <Border x:Name="MeetingTranscriptTab"
                            Grid.Column="1"
                            Margin="2"
                            Background="Transparent"
                            CornerRadius="6"
                            Cursor="Hand"
                            MouseLeftButtonUp="ShowMeetingTranscriptTab_Click">
                      <TextBlock x:Name="MeetingTranscriptTabLabel" Text="Transcript" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </Border>
                  </Grid>
                </Border>
                <Button Style="{StaticResource GhostButton}" Click="MoreMeetingActions_Click">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE712;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,0,4,0" />
                    <TextBlock Text="More" />
                  </StackPanel>
                  <Button.ContextMenu>
                    <ContextMenu>
                      <MenuItem Header="Export Notes" Click="ExportMeetingNotes_Click" />
                      <MenuItem Header="Export Transcript" Click="ExportMeetingTranscript_Click" />
                      <MenuItem Header="Export Full Meeting" Click="ExportFullMeeting_Click" />
                      <Separator />
                      <MenuItem Header="Show Recording" Click="OpenSelectedMeetingAudio_Click" />
                      <MenuItem Header="Move to Folder" Click="MoveSelectedMeeting_Click" />
                      <Separator />
                      <MenuItem Header="Delete Meeting" Foreground="{DynamicResource ErrorRedBrush}" Click="DeleteSelectedMeeting_Click" />
                    </ContextMenu>
                  </Button.ContextMenu>
                </Button>
              </StackPanel>
            </Grid>
          </StackPanel>

          <Border Grid.Row="1" Height="1" Background="{DynamicResource BorderBrushSoft}" Margin="-24,0,-24,0" />

          <ScrollViewer Grid.Row="2"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled"
                        Padding="0,0,12,0">
            <StackPanel MaxWidth="980" Margin="0,0,0,24">
              <StackPanel x:Name="MeetingWarningsPanel" Visibility="Collapsed" Margin="0,14,0,0">
                <Border Background="#FFFDF0D5" BorderBrush="#FFF4D03F" BorderThickness="1" CornerRadius="8" Padding="12,10">
                  <StackPanel>
                    <TextBlock Text="Recording warnings" FontSize="12" FontWeight="SemiBold" Foreground="#FFB45309" Margin="0,0,0,6" />
                    <ItemsControl x:Name="MeetingWarningsItems">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="&#xE7BA;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" Foreground="#FFB45309" Margin="0,2,6,0" />
                            <TextBlock Text="{Binding}" FontSize="12" Foreground="#FFB45309" TextWrapping="Wrap" />
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>
              </StackPanel>

              <Border Margin="0,14,0,0" Padding="14" Style="{StaticResource ContentCard}"
                      Visibility="{Binding HasMeetingPlaybackTracks, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <ComboBox Style="{StaticResource MuesliComboBox}" ItemsSource="{Binding MeetingPlaybackTracks}" SelectedItem="{Binding SelectedPlaybackTrack}" />
                  <Button Grid.Column="1" Margin="10,0,0,0" Style="{StaticResource PrimaryButton}" Content="{Binding PlaybackButtonLabel}" Click="ToggleMeetingPlayback_Click" />
                  <Button Grid.Column="2" Margin="8,0,0,0" Style="{StaticResource SecondaryButton}" Content="Stop" Click="StopMeetingPlayback_Click" />
                  <Slider Grid.Column="3" Margin="14,0,0,0" Minimum="0" Maximum="{Binding PlaybackDurationSeconds}" Value="{Binding PlaybackPositionSeconds, Mode=TwoWay}" VerticalAlignment="Center" />
                </Grid>
              </Border>

              <StackPanel x:Name="MeetingNotesPanel">
                <DockPanel Margin="0,14,0,12">
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <ComboBox Width="210"
                              Margin="0,0,10,0"
                              Style="{StaticResource MuesliComboBox}"
                              ItemsSource="{Binding SummaryTemplates}"
                              SelectedItem="{Binding SelectedMeetingTemplate}" />
                    <Button Margin="0,0,10,0" Style="{StaticResource PrimaryButton}" Click="GenerateSelectedMeetingNotes_Click">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE70F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding SelectedMeetingNotesActionLabel}" />
                      </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SecondaryButton}" Click="CopySelectedMeetingNotes_Click">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8C8;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,0,6,0" />
                        <TextBlock Text="Copy Notes" />
                      </StackPanel>
                    </Button>
                  </StackPanel>
                  <TextBlock Text="NOTES" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" />
                </DockPanel>

                <Border Background="{DynamicResource BackgroundRaisedBrush}"
                        BorderBrush="{DynamicResource BorderBrushSoft}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="24"
                        Margin="0,0,0,24">
                  <StackPanel x:Name="MeetingNotesContent" />
                </Border>
                <TextBlock Text="MANUAL NOTES" Style="{StaticResource SectionLabel}" />
                <Border Background="{DynamicResource BackgroundRaisedBrush}"
                        BorderBrush="{DynamicResource BorderBrushSoft}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="18"
                        Margin="0,0,0,24">
                  <TextBox Text="{Binding SelectedMeetingManualNotes, UpdateSourceTrigger=LostFocus}"
                           TextWrapping="Wrap" AcceptsReturn="True" MinHeight="120"
                           Background="Transparent" BorderThickness="0"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           ToolTip="Your notes are stored separately and are never overwritten by generated notes." />
                </Border>
              </StackPanel>

              <StackPanel x:Name="MeetingTranscriptPanel" Visibility="Collapsed">
                <DockPanel Margin="0,14,0,12">
                  <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Click="CopySelectedMeetingTranscript_Click">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="&#xE8C8;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,0,6,0" />
                      <TextBlock Text="Copy Transcript" />
                    </StackPanel>
                  </Button>
                  <TextBlock Text="TRANSCRIPT" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" />
                </DockPanel>

                <StackPanel x:Name="SpeakerAliasPanel" Margin="0,0,0,12" />

                <Border Background="{DynamicResource BackgroundRaisedBrush}"
                        BorderBrush="{DynamicResource BorderBrushSoft}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="24">
                  <TextBox Text="{Binding SelectedMeetingTranscript, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                           TextWrapping="Wrap"
                           AcceptsReturn="True"
                           Background="Transparent"
                           BorderThickness="0"
                           IsReadOnly="False"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Cursor="IBeam"
                           FontFamily="Consolas"
                           FontSize="13"
                           MinHeight="420"
                           SelectionBrush="{DynamicResource AccentBlueBrush}" />
                </Border>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Grid>

      <Grid x:Name="DictionaryPage" Visibility="Collapsed">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="0,0,12,0">
        <StackPanel MaxWidth="860" Margin="0,0,0,24">
          <DockPanel Margin="0,0,0,8">
            <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Click="AddDictionaryEntry_Click">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="+" FontWeight="Bold" Margin="0,0,6,0" />
                <TextBlock Text="Add new" />
              </StackPanel>
            </Button>
            <Button DockPanel.Dock="Right" Margin="0,0,8,0" Style="{StaticResource SecondaryButton}" Content="Export JSON" Click="ExportDictionary_Click" />
            <Button DockPanel.Dock="Right" Margin="0,0,8,0" Style="{StaticResource SecondaryButton}" Content="Import JSON" Click="ImportDictionary_Click" />
            <StackPanel>
              <TextBlock Text="Dictionary" Style="{StaticResource PageTitle}" />
              <TextBlock Text="Add custom words for names, brands, and domain terms, and tune how aggressively each entry should fuzzy-match transcription errors." Style="{StaticResource PageSubtitle}" />
            </StackPanel>
          </DockPanel>
          <Border Background="{DynamicResource BackgroundRaisedBrush}"
                  BorderBrush="{DynamicResource BorderBrushSoft}"
                  BorderThickness="1"
                  CornerRadius="10"
                  Padding="0">
            <StackPanel>
              <Grid Margin="16,16,16,12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="DictionaryPhraseBox" Height="36" Padding="10,7" Background="{DynamicResource BackgroundHoverBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrushSoft}" FontSize="14" />
                <TextBox x:Name="DictionaryReplacementBox" Grid.Column="1" Margin="12,0,0,0" Height="36" Padding="10,7" Background="{DynamicResource BackgroundHoverBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrushSoft}" FontSize="14" />
              </Grid>
              <Grid Margin="16,0,16,16">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="160" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="48" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Matching threshold" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                <Slider x:Name="DictionaryThresholdSlider"
                        Grid.Column="1"
                        Minimum="0.70"
                        Maximum="0.95"
                        SmallChange="0.01"
                        LargeChange="0.05"
                        Value="0.85" />
                <TextBlock Grid.Column="2"
                           Text="{Binding ElementName=DictionaryThresholdSlider, Path=Value, StringFormat={}{0:0.00}}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center" />
              </Grid>
              <Border Height="1" Background="{DynamicResource BorderBrushSoft}" />
              <ListBox ItemsSource="{Binding DictionaryEntries}" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimaryBrush}" ItemContainerStyle="{StaticResource MuesliListBoxItem}" Visibility="{Binding HasDictionaryEntries, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Margin="16,16">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding Phrase, UpdateSourceTrigger=PropertyChanged}" Height="36" Padding="10,7" Background="{DynamicResource BackgroundHoverBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrushSoft}" />
                        <TextBox Grid.Column="1" Text="{Binding Replacement, UpdateSourceTrigger=PropertyChanged}" Margin="12,0,0,0" Height="36" Padding="10,7" Background="{DynamicResource BackgroundHoverBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrushSoft}" />
                      </Grid>
                      <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="160" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="48" />
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Matching threshold" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        <Slider Grid.Column="1" Minimum="0.70" Maximum="0.95" SmallChange="0.01" LargeChange="0.05" Value="{Binding MatchingThreshold, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Column="2" Text="{Binding ThresholdDisplay}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        <Button Grid.Column="3" Margin="12,0,0,0" Style="{StaticResource GhostButton}" Content="Delete" Foreground="{DynamicResource ErrorRedBrush}" Click="DeleteDictionaryEntry_Click" />
                        <Button Grid.Column="4" Margin="6,0,0,0" Style="{StaticResource GhostButton}" Content="Save" Click="SaveDictionaryEntry_Click" />
                      </Grid>
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <StackPanel Margin="0,32" Visibility="{Binding HasDictionaryEntries, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                <TextBlock Text="&#xE70F;" Style="{StaticResource EmptyStateIcon}" />
                <TextBlock Text="No custom dictionary entries yet" Style="{StaticResource EmptyStateTitle}" />
                <TextBlock Text="Add a word or phrase above to improve transcription accuracy." Style="{StaticResource EmptyStateBody}" />
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>
        </ScrollViewer>
      </Grid>

      <Grid x:Name="ShortcutsPage" Visibility="Collapsed">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="0,0,12,0">
        <StackPanel MaxWidth="860" Margin="0,0,0,24">
          <TextBlock Text="Shortcuts" Style="{StaticResource PageTitle}" />
          <TextBlock Text="Choose your preferred shortcut for dictation." Style="{StaticResource PageSubtitle}" />
          <Border Style="{StaticResource ContentCard}">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="Push to Talk" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                  <TextBlock Text="{Binding ShortcutModeLabel}" Margin="0,4,0,0" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
                <Border Grid.Column="1" Height="26" Padding="12,0" Background="{DynamicResource SurfacePrimaryBrush}" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1" CornerRadius="6">
                  <TextBlock Text="{Binding SelectedHotkey}" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                </Border>
              </Grid>
              <Border Height="1" Background="{DynamicResource BorderBrushSoft}" Margin="0,16" />
              <StackPanel Orientation="Horizontal">
                <ComboBox Width="220" HorizontalAlignment="Left" Style="{StaticResource MuesliComboBox}" ItemsSource="{Binding HotkeyOptions}" SelectedItem="{Binding SelectedHotkey}" />
                <Button Margin="10,0,0,0" Style="{StaticResource SecondaryButton}" Content="{Binding CaptureHotkeyButtonText}" Click="CaptureHotkey_Click" />
              </StackPanel>
              <TextBlock Text="{Binding ShortcutCaptureLabel}" Margin="0,10,0,0" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource ContentCard}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="Hands-Free Mode" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="Double-tap the selected shortcut to start listening without holding the key." Margin="0,4,0,0" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
              </StackPanel>
              <CheckBox Grid.Column="1" Style="{StaticResource MuesliCheckBox}" IsChecked="{Binding EnableDoubleTapDictation}" VerticalAlignment="Center" />
            </Grid>
          </Border>
        </StackPanel>
        </ScrollViewer>
      </Grid>

      <Grid x:Name="AboutPage" Visibility="Collapsed">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="0,0,12,0">
        <StackPanel MaxWidth="760" Margin="0,0,0,24">
          <TextBlock Text="About" Style="{StaticResource PageTitle}" />
          <TextBlock Text="APP INFO" Style="{StaticResource SectionLabel}" />
          <Border Style="{StaticResource ContentCard}">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Version" Style="{StaticResource SettingsRowLabel}" />
                <TextBlock Grid.Column="1" Text="{Binding AppVersion}" FontFamily="Consolas" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
              </Grid>
              <Border Height="1" Background="{DynamicResource BorderBrushSoft}" Margin="0,12" />
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Check for Updates" Style="{StaticResource SettingsRowLabel}" />
                <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="{Binding UpdateButtonLabel}" Click="CheckForUpdates_Click" />
              </Grid>
            </StackPanel>
          </Border>

          <TextBlock Text="PRIVACY" Style="{StaticResource SectionLabel}" />
          <Border Style="{StaticResource ContentCard}">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="Send anonymous crash reports" Style="{StaticResource SettingsRowLabel}" />
                  <TextBlock Text="Helps fix bugs faster. Only stack traces and app version are sent — never your transcripts, meeting recordings, or settings." Margin="0,4,0,0" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <CheckBox Grid.Column="1" Style="{StaticResource MuesliCheckBox}" IsChecked="{Binding CrashReportingEnabled}" VerticalAlignment="Center" />
              </Grid>
              <TextBlock Text="Restart Muesli to apply." Margin="0,8,0,0" FontSize="12" Foreground="{DynamicResource WarningOrangeBrush}" Visibility="{Binding CrashReportingRestartHintVisible}" />
            </StackPanel>
          </Border>

          <TextBlock Text="SUPPORT" Style="{StaticResource SectionLabel}" />
          <Border Style="{StaticResource ContentCard}">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Support Development" Style="{StaticResource SettingsRowLabel}" />
                <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Donate" Background="{DynamicResource SuccessGreenBrush}" Foreground="{DynamicResource DonateButtonForegroundBrush}" Click="Donate_Click" />
              </Grid>
              <Border Height="1" Background="{DynamicResource BorderBrushSoft}" Margin="0,12" />
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Source Code" Style="{StaticResource SettingsRowLabel}" />
                <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="View on GitHub" Click="ViewGitHub_Click" />
              </Grid>
              <Border Height="1" Background="{DynamicResource BorderBrushSoft}" Margin="0,12" />
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="Logs" Style="{StaticResource SettingsRowLabel}" />
                  <TextBlock Text="Attach these when reporting microphone, paste, meeting recording, or model setup issues." Margin="0,4,0,0" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Open Logs" Click="OpenLogs_Click" />
              </Grid>
            </StackPanel>
          </Border>

          <TextBlock Text="ACKNOWLEDGEMENTS" Style="{StaticResource SectionLabel}" />
          <Border Style="{StaticResource ContentCard}">
            <StackPanel>
              <TextBlock Text="faster-whisper" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
              <TextBlock Text="Local Whisper inference on Windows CPU and NVIDIA CUDA." Margin="0,4,0,12" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
              <Border Height="1" Background="{DynamicResource BorderBrushSoft}" Margin="0,0,0,12" />
              <TextBlock Text="NVIDIA Parakeet" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
              <TextBlock Text="Optional high-speed ASR path for supported NVIDIA laptops." Margin="0,4,0,0" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </StackPanel>
        </ScrollViewer>
      </Grid>
    </Grid>
  </Grid>
</Window>

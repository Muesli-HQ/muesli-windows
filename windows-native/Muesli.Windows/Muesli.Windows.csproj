<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Muesli</AssemblyName>
    <RootNamespace>Muesli.Windows</RootNamespace>
    <StartupObject>Muesli.Windows.App</StartupObject>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Custom ApplicationManifest replaces the SDK-generated Win32 manifest, so PerMonitorV2
         must be declared in app.manifest for the OS. WFO0003 wants those settings removed in
         favor of ApplicationHighDpiMode alone; that would drop the embedded dpiAware block. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <AssemblyTitle>Muesli for Windows</AssemblyTitle>
    <ApplicationIcon>Assets\muesli.ico</ApplicationIcon>
    <Product>Muesli</Product>
    <Description>Local-first dictation and meeting transcription for Windows.</Description>
    <Copyright>Copyright (c) Muesli HQ</Copyright>
    <Company>Muesli HQ</Company>
  </PropertyGroup>
  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="System.Windows.Controls.ContextMenu" Alias="ContextMenu" />
    <Using Include="System.Windows.Controls.MenuItem" Alias="MenuItem" />
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Muesli.Windows.Tests</_Parameter1>
    </AssemblyAttribute>
    <Content Include="..\..\docs\WINDOWS_PRIVACY.md">
      <Link>WINDOWS-PRIVACY.md</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\..\docs\POST_MEETING_AUTOMATION.md">
      <Link>POST-MEETING-AUTOMATION.md</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\..\docs\COMPUTER_USE.md">
      <Link>COMPUTER-USE.md</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <PackageReference Include="LLamaSharp" Version="0.27.0" />
    <PackageReference Include="LLamaSharp.Backend.Cpu" Version="0.27.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="org.k2fsa.sherpa.onnx" Version="1.13.4" />
    <PackageReference Include="QuestPDF" Version="2026.5.0" />
    <PackageReference Include="Sentry" Version="5.16.3" />
    <PackageReference Include="SharpCompress" Version="0.48.1" />
    <PackageReference Include="Velopack" Version="1.0.1" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Assets\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
</Project>

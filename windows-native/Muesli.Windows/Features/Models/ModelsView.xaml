<features:FeatureViewBase x:Class="Muesli.Windows.Features.Models.ModelsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:features="clr-namespace:Muesli.Windows.Features">
  <Grid x:Name="ModelsPage">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="0,0,12,0">
        <StackPanel MaxWidth="960" Margin="0,0,0,24">
          <TextBlock Text="Models" Style="{StaticResource PageTitle}" />
          <TextBlock Text="Assign separate offline models to dictation and final meeting/import transcription. Selecting a role never downloads or activates a recognizer." Style="{StaticResource PageSubtitle}" />
          <TextBlock Text="{Binding PreviewPageStateMessage}" Margin="0,6,0,0" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" />

          <Border Style="{StaticResource ContentCard}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <StackPanel Orientation="Horizontal">
                  <Image Source="Assets/nvidia.png" Width="24" Height="24" Stretch="Uniform" Margin="0,0,10,0" />
                  <TextBlock Text="Transcription roles" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                  <Border Margin="10,0,0,0" Padding="8,3" CornerRadius="5" Background="{DynamicResource AccentBadgeBackgroundBrush}">
                    <TextBlock Text="{Binding ActiveModelLabel}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBlueBrush}" />
                  </Border>
                </StackPanel>
                <TextBlock Text="{Binding SelectedModelDescription}" Margin="0,8,0,4" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding SelectedModelLanguages}" Margin="0,0,0,12" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" />
                <Grid Margin="0,0,0,12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="360" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="Dictation model" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextTertiaryBrush}" />
                  <ComboBox Grid.Column="1"
                            Style="{StaticResource MuesliComboBox}"
                            ItemsSource="{Binding TranscriptionModels}"
                            SelectedItem="{Binding SelectedTranscriptionModel, Mode=TwoWay}"
                            DisplayMemberPath="PickerLabel" />
                </Grid>
                <Grid Margin="0,0,0,12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="360" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="Final meeting" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextTertiaryBrush}" />
                  <ComboBox Grid.Column="1"
                            Style="{StaticResource MuesliComboBox}"
                            ItemsSource="{Binding TranscriptionModels}"
                            SelectedItem="{Binding SelectedFinalMeetingModel, Mode=TwoWay}"
                            DisplayMemberPath="PickerLabel" />
                </Grid>
                <Grid Margin="0,0,0,12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="360" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="Live meeting" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextTertiaryBrush}" />
                  <ComboBox Grid.Column="1" Style="{StaticResource MuesliComboBox}" ItemsSource="{Binding LiveMeetingModels}" SelectedItem="{Binding SelectedLiveMeetingModel, Mode=TwoWay}" DisplayMemberPath="Label" />
                </Grid>
                <TextBlock Text="{Binding LivePreviewOwnerLabel, StringFormat=Live preview owner: {0}}" Margin="120,0,0,4" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" />
                <TextBlock Text="{Binding FinalTranscriptOwnerLabel, StringFormat=Final transcript owner: {0}}" Margin="120,0,0,4" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" />
                <TextBlock Text="{Binding GapRecoveryOwnerLabel, StringFormat=Gap recovery: {0}}" Margin="120,0,0,12" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                  <TextBlock Text="Status" Width="72" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextTertiaryBrush}" />
                  <TextBlock Text="{Binding DictationModelRuntimeStatus, Mode=OneWay}" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                  <Button Margin="10,0,0,0" Style="{StaticResource SecondaryButton}" Content="Prepare all models" Click="ForwardClick" features:FeatureAction.Name="DownloadAllModels_Click" />
                  <Button Margin="10,0,0,0" Style="{StaticResource GhostButton}" Content="Open cache" Click="ForwardClick" features:FeatureAction.Name="OpenTranscriptionModelCache_Click" />
                </StackPanel>
              </StackPanel>
              <Border Grid.Column="1" Height="28" Padding="10,0" CornerRadius="5" Background="{DynamicResource SurfacePrimaryBrush}" VerticalAlignment="Top">
                <TextBlock Text="{Binding DictationModelStatusLabel}" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextTertiaryBrush}" />
              </Border>
            </Grid>
          </Border>

          <TextBlock Text="OFFLINE TRANSCRIPTION MODELS" Style="{StaticResource SectionLabel}" />
          <ItemsControl ItemsSource="{Binding TranscriptionModelItems}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Style="{StaticResource ContentCard}" Margin="0,0,0,10">
                  <StackPanel>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock Text="{Binding DisplayName}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="{Binding Summary}" Margin="0,5,20,0" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Languages}" Margin="0,4,20,0" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding StatusText}" HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding DiskSize, StringFormat=Installed: {0}}" Margin="0,4,0,0" HorizontalAlignment="Right" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" />
                        <TextBlock Text="{Binding DownloadSize, StringFormat=Catalog: {0}}" Margin="0,2,0,0" HorizontalAlignment="Right" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" />
                      </StackPanel>
                    </Grid>
                    <WrapPanel Margin="0,12,0,0">
                      <Button Style="{StaticResource PrimaryButton}" Content="Prepare" Click="ForwardClick" features:FeatureAction.Name="PrepareModelItem_Click" IsEnabled="{Binding CanPrepare}" />
                      <Button Margin="8,0,0,0" Style="{StaticResource SecondaryButton}" Content="Cancel" Click="ForwardClick" features:FeatureAction.Name="CancelModelItem_Click" IsEnabled="{Binding CanCancel}" />
                      <Button Margin="8,0,0,0" Style="{StaticResource SecondaryButton}" Content="Retry" Click="ForwardClick" features:FeatureAction.Name="RetryModelItem_Click" IsEnabled="{Binding CanRetry}" />
                      <Button Margin="8,0,0,0" Style="{StaticResource GhostButton}" Content="Verify" Click="ForwardClick" features:FeatureAction.Name="VerifyModelItem_Click" IsEnabled="{Binding CanVerify}" />
                      <Button Margin="8,0,0,0" Style="{StaticResource GhostButton}" Content="Diagnostics" Click="ForwardClick" features:FeatureAction.Name="ModelDiagnosticsItem_Click" />
                      <Button Margin="8,0,0,0" Style="{StaticResource GhostButton}" Content="Delete" Foreground="{DynamicResource ErrorRedBrush}" Click="ForwardClick" features:FeatureAction.Name="DeleteModelItem_Click" IsEnabled="{Binding CanDelete}" />
                    </WrapPanel>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Text="LIVE TRANSCRIPTION MODELS" Style="{StaticResource SectionLabel}" />
          <TextBlock Text="Preparing a live model never selects or enables it. Live transcription remains off until you explicitly choose it above." Margin="0,0,0,10" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" />
          <ItemsControl ItemsSource="{Binding StreamingModelItems}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Style="{StaticResource ContentCard}" Margin="0,0,0,10">
                  <StackPanel>
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock Text="{Binding DisplayName}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="{Binding Summary}" Margin="0,5,20,0" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Languages}" Margin="0,4,20,0" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" />
                      </StackPanel>
                      <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding StatusText}" HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding DiskSize, StringFormat=Installed: {0}}" Margin="0,4,0,0" HorizontalAlignment="Right" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" />
                        <TextBlock Text="{Binding DownloadSize, StringFormat=Catalog: {0}}" Margin="0,2,0,0" HorizontalAlignment="Right" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" />
                      </StackPanel>
                    </Grid>
                    <WrapPanel Margin="0,12,0,0">
                      <Button Style="{StaticResource PrimaryButton}" Content="Prepare" Click="ForwardClick" features:FeatureAction.Name="PrepareStreamingModelItem_Click" IsEnabled="{Binding CanPrepare}" />
                      <Button Margin="8,0,0,0" Style="{StaticResource SecondaryButton}" Content="Cancel" Click="ForwardClick" features:FeatureAction.Name="CancelStreamingModelItem_Click" IsEnabled="{Binding CanCancel}" />
                      <Button Margin="8,0,0,0" Style="{StaticResource SecondaryButton}" Content="Retry" Click="ForwardClick" features:FeatureAction.Name="RetryStreamingModelItem_Click" IsEnabled="{Binding CanRetry}" />
                      <Button Margin="8,0,0,0" Style="{StaticResource GhostButton}" Content="Verify" Click="ForwardClick" features:FeatureAction.Name="VerifyStreamingModelItem_Click" IsEnabled="{Binding CanVerify}" />
                      <Button Margin="8,0,0,0" Style="{StaticResource GhostButton}" Content="Diagnostics" Click="ForwardClick" features:FeatureAction.Name="StreamingModelDiagnosticsItem_Click" />
                      <Button Margin="8,0,0,0" Style="{StaticResource GhostButton}" Content="Delete" Foreground="{DynamicResource ErrorRedBrush}" Click="ForwardClick" features:FeatureAction.Name="DeleteStreamingModelItem_Click" IsEnabled="{Binding CanDelete}" />
                    </WrapPanel>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Border Style="{StaticResource ContentCard}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <StackPanel Orientation="Horizontal">
                  <Image Source="Assets/qwen.png" Width="24" Height="24" Stretch="Uniform" Margin="0,0,10,0" />
                  <TextBlock Text="Cleanup" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                  <Border Margin="10,0,0,0" Padding="8,3" CornerRadius="5" Background="{DynamicResource SurfacePrimaryBrush}">
                    <TextBlock Text="Qwen · optional" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextTertiaryBrush}" />
                  </Border>
                </StackPanel>
                <TextBlock Text="Optional native local cleanup for punctuation, casing, filler words, and repeated ASR fragments. If unavailable, Muesli keeps the original transcript." Margin="0,8,0,12" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                  <TextBlock Text="Status" Width="72" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextTertiaryBrush}" />
                  <TextBlock Text="{Binding QwenCleanupRuntimeStatus, Mode=OneWay}" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                  <Button Style="{StaticResource GhostButton}" Content="Open cache" Click="ForwardClick" features:FeatureAction.Name="OpenCleanupModelCache_Click" />
                </StackPanel>
              </StackPanel>
              <Border Grid.Column="1" Height="28" Padding="10,0" CornerRadius="5" Background="{DynamicResource SurfacePrimaryBrush}" VerticalAlignment="Top">
                <TextBlock Text="{Binding QwenCleanupStatusLabel}" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextTertiaryBrush}" />
              </Border>
            </Grid>
          </Border>

          <Border Style="{StaticResource ContentCard}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <StackPanel Orientation="Horizontal">
                  <Image Source="Assets/openai.png" Width="24" Height="24" Stretch="Uniform" Margin="0,0,10,0" />
                  <TextBlock Text="Speaker labels" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="Optional native ONNX speaker labeling for recorded meetings. Dictation does not require it." Margin="0,8,0,12" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                  <TextBlock Text="Status" Width="90" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextTertiaryBrush}" />
                  <TextBlock Text="{Binding DiarizationDependencyStatus, Mode=OneWay}" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                  <Button Style="{StaticResource GhostButton}" Content="Check setup" Click="ForwardClick" features:FeatureAction.Name="RefreshRuntimeDiagnostics_Click" />
                  <Button Margin="10,0,0,0" Style="{StaticResource GhostButton}" Content="Open cache" Click="ForwardClick" features:FeatureAction.Name="OpenDiarizationModelCache_Click" />
                </StackPanel>
              </StackPanel>
              <Border Grid.Column="1" Height="28" Padding="10,0" CornerRadius="5" Background="{DynamicResource SurfacePrimaryBrush}" VerticalAlignment="Top">
                <TextBlock Text="{Binding SpeakerDiarizationStatusLabel, Mode=OneWay}" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextTertiaryBrush}" />
              </Border>
            </Grid>
          </Border>

          <Border Style="{StaticResource ContentCard}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="Cache and benchmark" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="Manage local native model files and measure cached ASR models on recent captured audio." Margin="0,8,0,12" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                <WrapPanel Margin="0,0,0,12">
                  <Button Style="{StaticResource SecondaryButton}" Content="Run benchmark" Click="ForwardClick" features:FeatureAction.Name="RunBenchmark_Click" />
                  <Button Margin="10,0,0,0" Style="{StaticResource GhostButton}" Content="Open cache" Click="ForwardClick" features:FeatureAction.Name="OpenModelCache_Click" />
                  <Button Margin="10,0,0,0" Style="{StaticResource GhostButton}" Content="Open logs" Click="ForwardClick" features:FeatureAction.Name="OpenLogs_Click" />
                  <Button Margin="10,0,0,0" Style="{StaticResource GhostButton}" Content="Refresh" Click="ForwardClick" features:FeatureAction.Name="RefreshRuntimeDiagnostics_Click" />
                  <Button Margin="10,0,0,0" Style="{StaticResource GhostButton}" Content="Clear cache" Foreground="{DynamicResource ErrorRedBrush}" Click="ForwardClick" features:FeatureAction.Name="ClearModelCache_Click" />
                </WrapPanel>
                <TextBlock Text="{Binding BenchmarkSummary, Mode=OneWay}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                <TextBlock Text="Detailed setup and benchmark information is written to logs." Margin="0,8,0,0" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" />
              </StackPanel>
              <Border Grid.Column="1" Height="28" Padding="10,0" CornerRadius="5" Background="{DynamicResource SurfacePrimaryBrush}" VerticalAlignment="Top">
                <TextBlock Text="{Binding ModelCacheSize}" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextTertiaryBrush}" />
              </Border>
            </Grid>
          </Border>
        </StackPanel>
        </ScrollViewer>
      </Grid>
</features:FeatureViewBase>

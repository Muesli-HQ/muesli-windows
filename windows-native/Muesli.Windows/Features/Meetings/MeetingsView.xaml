<features:FeatureViewBase x:Class="Muesli.Windows.Features.Meetings.MeetingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:features="clr-namespace:Muesli.Windows.Features">
  <Grid x:Name="MeetingsBrowserView">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

           <Grid Grid.Row="1" Margin="0,0,0,22">
             <Grid.ColumnDefinitions>
               <ColumnDefinition Width="*" />
               <ColumnDefinition Width="Auto" />
             </Grid.ColumnDefinitions>
             <StackPanel>
               <TextBlock Text="{Binding CurrentMeetingFolderName}" Style="{StaticResource PageTitle}" />
               <StackPanel Orientation="Horizontal">
                 <TextBlock Text="{Binding VisibleMeetingCount}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" />
                 <TextBlock Text=" meetings" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" />
               </StackPanel>
               <TextBlock Text="{Binding MeetingSessionStatus}" Margin="0,4,0,0" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" />
               <TextBlock Text="{Binding PreviewPageStateMessage}" Margin="0,4,0,0" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" />
             </StackPanel>
             <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
               <Button Style="{StaticResource GhostButton}" Click="ForwardClick" features:FeatureAction.Name="ToggleMeetingSort_Click">
                 <StackPanel Orientation="Horizontal">
                   <TextBlock Text="↕" Margin="0,0,6,0" />
                   <TextBlock Text="{Binding MeetingSortLabel}" />
                 </StackPanel>
               </Button>
               <Button Margin="8,0,0,0" Style="{StaticResource GhostButton}" ToolTip="{Binding MeetingFilterLabel}" Click="ForwardClick" features:FeatureAction.Name="OpenButtonContextMenu_Click">
                 <StackPanel Orientation="Horizontal">
                   <TextBlock Text="☰" />
                   <TextBlock Text="{Binding MeetingFilterLabel}" Margin="6,0,0,0" />
                   <TextBlock Text="⌄" Margin="6,-1,0,0" />
                 </StackPanel>
                 <Button.ContextMenu>
                   <ContextMenu>
                     <MenuItem Header="All time" Tag="all" Click="ForwardClick" features:FeatureAction.Name="SetMeetingFilter_Click" />
                     <MenuItem Header="Last 2 days" Tag="last2Days" Click="ForwardClick" features:FeatureAction.Name="SetMeetingFilter_Click" />
                     <MenuItem Header="Last week" Tag="lastWeek" Click="ForwardClick" features:FeatureAction.Name="SetMeetingFilter_Click" />
                     <MenuItem Header="Last 2 weeks" Tag="last2Weeks" Click="ForwardClick" features:FeatureAction.Name="SetMeetingFilter_Click" />
                     <MenuItem Header="Last month" Tag="lastMonth" Click="ForwardClick" features:FeatureAction.Name="SetMeetingFilter_Click" />
                     <MenuItem Header="Last 3 months" Tag="last3Months" Click="ForwardClick" features:FeatureAction.Name="SetMeetingFilter_Click" />
                   </ContextMenu>
                 </Button.ContextMenu>
               </Button>
               <Button Margin="8,0,0,0" Style="{StaticResource GhostButton}" Click="ForwardClick" features:FeatureAction.Name="ManageTemplates_Click" Content="Manage Templates" />
               <Button Margin="8,0,0,0"
                       Style="{StaticResource SecondaryButton}"
                       Visibility="{Binding HasRecoverableMeetings, Converter={StaticResource BooleanToVisibilityConverter}}"
                       Click="ForwardClick" features:FeatureAction.Name="RecoverInterruptedMeetings_Click"
                       Content="{Binding RecoverInterruptedButtonText}" />
               <!-- Chosen before recording; this is the template finalization will use for the notes. -->
               <ComboBox Margin="8,0,0,0" Width="190"
                         Style="{StaticResource MuesliComboBox}"
                         ItemsSource="{Binding SummaryTemplates}"
                         SelectedItem="{Binding SelectedSummaryTemplate, Mode=TwoWay}"
                         ToolTip="Notes template used when this recording is finalized" />
               <Button Margin="8,0,0,0" Style="{StaticResource PrimaryButton}" Click="ForwardClick" features:FeatureAction.Name="ToggleMeetingRecording_Click" Content="{Binding MeetingRecordingButtonText}" />
               <Button Margin="8,0,0,0" Style="{StaticResource SecondaryButton}"
                       IsEnabled="{Binding IsNotImportingMeeting}"
                       Click="ForwardClick" features:FeatureAction.Name="ImportMeeting_Click" Content="Import media" />
               <StackPanel Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center"
                           Visibility="{Binding IsImportingMeeting, Converter={StaticResource BooleanToVisibilityConverter}}">
                 <ProgressBar Width="110" Height="6" VerticalAlignment="Center" Margin="0,0,8,0"
                              Minimum="0" Maximum="100"
                              Value="{Binding ImportProgressPercent, Mode=OneWay}"
                              IsIndeterminate="{Binding ImportProgressIsIndeterminate}" />
                 <TextBlock Text="{Binding ImportProgressLabel}" VerticalAlignment="Center" Margin="0,0,8,0"
                            FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                 <Button Style="{StaticResource SecondaryButton}" Click="ForwardClick" features:FeatureAction.Name="CancelImport_Click" Content="Cancel" />
               </StackPanel>
             </StackPanel>
           </Grid>
           <Grid Grid.Row="2">
             <ListBox ItemsSource="{Binding FilteredMeetings}"
                      Background="Transparent"
                      BorderThickness="0"
                      Foreground="{DynamicResource TextPrimaryBrush}"
                      ItemContainerStyle="{StaticResource MuesliListBoxItem}"
                      Visibility="{Binding HasMeetings, Converter={StaticResource BooleanToVisibilityConverter}}">
               <ListBox.ItemTemplate>
                 <DataTemplate>
                   <Border Background="{DynamicResource BackgroundRaisedBrush}"
                           BorderBrush="{DynamicResource BorderBrushSoft}"
                           BorderThickness="1"
                           CornerRadius="10"
                           Padding="16"
                           Margin="0,0,0,10"
                           Cursor="Hand"
                           AutomationProperties.AutomationId="MeetingCard"
                           AutomationProperties.Name="{Binding Title}"
                           MouseLeftButtonUp="ForwardMouseButton" features:FeatureAction.Name="MeetingCard_Click">
                     <Grid>
                       <Grid.ColumnDefinitions>
                         <ColumnDefinition Width="*" />
                         <ColumnDefinition Width="Auto" />
                       </Grid.ColumnDefinitions>
                       <StackPanel>
                         <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                         <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                           <TextBlock Text="{Binding Metadata}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                         </StackPanel>
                         <TextBlock Text="{Binding PreviewText}"
                                    Margin="0,8,0,0"
                                    TextWrapping="Wrap"
                                    TextTrimming="CharacterEllipsis"
                                    Foreground="{DynamicResource TextSecondaryBrush}"
                                    FontSize="13"
                                    MaxHeight="38"
                                    LineHeight="19" />
                       </StackPanel>
                       <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                         <TextBlock Text="&#xE8B7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource AccentBlueBrush}" Margin="0,2,0,0" />
                         <Button Margin="6,-2,0,0" Content="&#xE74D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{DynamicResource ErrorRedTransparentBrush}" ToolTip="Delete" Click="ForwardClick" features:FeatureAction.Name="DeleteMeeting_Click">
                           <Button.Style>
                             <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                               <Setter Property="Opacity" Value="0" />
                               <Style.Triggers>
                                 <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                   <Setter Property="Opacity" Value="1" />
                                 </DataTrigger>
                               </Style.Triggers>
                             </Style>
                           </Button.Style>
                         </Button>
                       </StackPanel>
                     </Grid>
                   </Border>
                 </DataTemplate>
               </ListBox.ItemTemplate>
             </ListBox>
             <StackPanel Style="{StaticResource EmptyStatePanel}" Visibility="{Binding HasMeetings, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
               <TextBlock Text="&#xE720;" Style="{StaticResource EmptyStateIcon}" />
               <TextBlock Text="No meetings yet" Style="{StaticResource EmptyStateTitle}" />
               <TextBlock Text="Click Record or Import to capture your first meeting." Style="{StaticResource EmptyStateBody}" />
             </StackPanel>
           </Grid>
        </Grid>
</features:FeatureViewBase>

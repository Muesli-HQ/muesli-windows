<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Muesli.Windows.Platform</RootNamespace>
    <AssemblyName>Muesli.Windows.Platform</AssemblyName>
    <IsPackable>false</IsPackable>
    <!-- FlaUI.Core and NAudio.WinForms each declare the Windows Forms framework, which would ship
         about 40 MB of desktop runtime. NAudio's own assemblies never touch it and FlaUI uses it
         only for its debug highlight overlay (DrawHighlight), which Muesli must not call. -->
    <DisableTransitiveFrameworkReferences>true</DisableTransitiveFrameworkReferences>
    <!-- Services/Pdf calls DirectWrite through raw vtables. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Assets\muesli-export-logo.png" LogicalName="Muesli.Windows.Platform.Assets.muesli-export-logo.png" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FlaUI.UIA3" Version="5.0.0" />
    <ProjectReference Include="..\Muesli.Windows.Core\Muesli.Windows.Core.csproj" />
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Muesli</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Muesli.Windows.Tests</_Parameter1>
    </AssemblyAttribute>
    <PackageReference Include="NAudio" Version="2.2.1" />
    <!-- GDI+ drawing for the insights share image. Referenced as a package so the project does not
         need the Windows Forms framework (about 40 MB installed) to get System.Drawing. -->
    <PackageReference Include="System.Drawing.Common" Version="10.0.11" />
  </ItemGroup>
</Project>

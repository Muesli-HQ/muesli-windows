<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Muesli.Windows.WinUI</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture.ToString().ToLowerInvariant())</RuntimeIdentifier>
    <PublishProfile Condition="Exists('Properties\PublishProfiles\win-$(Platform).pubxml')">win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>true</EnableMsixTooling>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Muesli.Windows.Core\Muesli.Windows.Core.csproj" />
    <ProjectReference Include="..\Muesli.Windows.Platform\Muesli.Windows.Platform.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\SplashScreen.scale-200.png" />
    <Content Include="Assets\LockScreenLogo.scale-200.png" />
    <Content Include="Assets\Square150x150Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-48_altform-lightunplated.png" />
    <Content Include="Assets\StoreLogo.png" />
    <Content Include="Assets\AppIcon.ico" />
    <!-- The floating indicator's Muesli mark, carried over from the retired WPF reference's
         Assets\menu_m_template@2x.png so the pill shows the real glyph, not a typographic "m". -->
    <Content Include="Assets\MuesliGlyph.png" />
    <!-- Inter is the product typeface for the shipping Windows app. -->
    <Content Include="Assets\fonts\*.ttf" />
    <Content Include="Assets\Wide310x150Logo.scale-200.png" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!--
    Defining the "Msix" ProjectCapability here allows the Single-project MSIX Packaging
    Tools extension to be activated for this project even if the Windows App SDK Nuget
    package has not yet been restored.
  -->
  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>

  <!--
    Microsoft.Windows.SDK.BuildTools.WinApp adds first-class support for
    `dotnet run` on packaged WinUI apps: it hooks the .NET CLI Run target to
    register a debug identity via the winapp CLI and launch the app with
    package identity (AUMID).
    Set <EnableWinAppRunSupport>false</EnableWinAppRunSupport> in a
    <PropertyGroup> above to opt out.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.4.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools.WinApp" Version="0.6.1" />
  </ItemGroup>

  <!--
    Defining the "HasPackageAndPublishMenuAddedByProject" property here allows the Solution
    Explorer "Package and Publish" context menu entry to be enabled for this project even if
    the Windows App SDK Nuget package has not yet been restored.
  -->
  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <!-- Publish Properties -->
  <PropertyGroup>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">True</PublishReadyToRun>
    <!--
      Trimming stays off. The template turns it on for Release, but the persistence layer
      round-trips settings and history through reflection-based System.Text.Json, and the
      loopback capture P/Invoke uses COM marshalling. The trimmer reports both (IL2026, IL2050)
      and would break them silently in a packaged build. Re-enable only alongside a
      JsonSerializerContext for every persisted type.
    -->
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <!--
    Builds the WPF indicator companion and stages its self-contained output into the packaged
    layout. The companion is copied to both the loose winapp layout (used by scripts\run-windows.ps1)
    and the nested AppX layout that the packaged application actually executes from. This is done
    with a direct copy rather than a ProjectReference so the companion's runtime does not leak,
    flattened and incomplete, into the package root.
  -->
  <Target Name="BuildIndicatorCompanion" BeforeTargets="StageIndicatorCompanion">
    <MSBuild Projects="$(MSBuildProjectDirectory)\..\Muesli.Windows.Indicator.Wpf\Muesli.Windows.Indicator.Wpf.csproj"
             Targets="Restore;Build"
             Properties="Configuration=$(Configuration)"
             BuildInParallel="false" />
  </Target>

  <Target Name="StageIndicatorCompanion" AfterTargets="Build">
    <ItemGroup>
      <_IndicatorCompanionFiles Include="$(MSBuildProjectDirectory)\..\Muesli.Windows.Indicator.Wpf\bin\$(Configuration)\net10.0-windows\win-x64\**\*.*"
                                Exclude="$(MSBuildProjectDirectory)\..\Muesli.Windows.Indicator.Wpf\bin\$(Configuration)\net10.0-windows\win-x64\**\*.pdb" />
    </ItemGroup>
    <Copy SourceFiles="@(_IndicatorCompanionFiles)"
          DestinationFiles="@(_IndicatorCompanionFiles->'$(OutDir)Indicator\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_IndicatorCompanionFiles)"
          DestinationFiles="@(_IndicatorCompanionFiles->'$(OutDir)AppX\Indicator\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <!--
    Stage the shared Swift MuesliCoreABI bridge and its native dependency closure
    beside the packaged application (loose winapp layout and nested AppX layout).
    The Swift toolchain and shared package are resolved by
    scripts\build-swift-core-bridge.ps1 from the developer environment, never at
    application startup. Set MuesliRequireSwiftBridge=true (packaging/release) to
    fail the build when the bridge cannot be produced; otherwise the bridge is
    skipped with a warning so shells that do not need it still build.
  -->
  <Target Name="StageSwiftCoreBridge" AfterTargets="Build" Condition="'$(MuesliSkipSwiftBridge)' != '1'">
    <PropertyGroup>
      <!-- Release/packaged builds fail hard when the bridge or a runtime dependency is missing.
           When the shared-core lock ships the managed fallback, the release passes
           MuesliRequireSwiftBridge=false so the script runs in quarantine mode and removes any
           stale bridge output instead of presenting an old bridge as current. -->
      <_SwiftBridgeRequireArg Condition="'$(MuesliRequireSwiftBridge)' == 'true'">-Require</_SwiftBridgeRequireArg>
      <_SwiftBridgeRequireArg Condition="'$(MuesliRequireSwiftBridge)' == '' and '$(Configuration)' == 'Release'">-Require</_SwiftBridgeRequireArg>
    </PropertyGroup>
    <Exec Command="powershell -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\scripts\build-swift-core-bridge.ps1&quot; -OutDir &quot;$(OutDir).&quot; -AppXDir &quot;$(OutDir)AppX&quot; $(_SwiftBridgeRequireArg)"
          IgnoreStandardErrorWarningFormat="true" />
  </Target>
</Project>

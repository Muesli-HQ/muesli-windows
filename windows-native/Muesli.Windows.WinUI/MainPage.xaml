<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Muesli.Windows.WinUI.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    KeyboardAcceleratorPlacementMode="Hidden">
    <!--
        P8-06: the stray 61x50 "Pop-upHost" left visible outside the window (seen by Prompts 5 and 6
        after a ComboBox, and reproduced here after a toggle + Save with no ComboBox involved) is the
        accelerator tooltip for the Escape accelerator below. PrintWindow on that HWND renders the
        word "Esc". Because the accelerator's owner is the Page rather than a button, Auto placement
        has no control rect to anchor to and parks the tooltip at a degenerate position — measured at
        99,485 against a window spanning x 160..1760, i.e. 61 px past its left edge — where it then
        stays. Hidden suppresses only this tooltip; per-button accelerators (Back/Next in setup) keep
        theirs, and the Escape gesture itself is unchanged.
    -->
    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="Escape" Invoked="TourEscape_Invoked" />
        <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="FocusSearch_Invoked" />
    </Page.KeyboardAccelerators>

    <Grid x:Name="ShellRoot" Background="{ThemeResource MuesliBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="NavigationColumn" Width="240" MinWidth="68" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--
            macOS SidebarView: a 240-wide rail on backgroundDeep with the brand header, a quiet
            search launcher, the scrolling destinations, and a pinned footer (download status,
            Models, Shortcuts, Settings, About, appearance). Rows are 36 tall with a 20-wide icon
            column, 12 to the label, radius 6; hover is backgroundHover, selection surfaceSelected.
            A hand-built rail rather than NavigationView, so meeting folders sit inside it.
        -->
        <Border x:Name="Navigation"
                Grid.Column="0"
                Background="{ThemeResource MuesliSidebarBrush}"
                BorderBrush="{ThemeResource MuesliBorderBrush}"
                BorderThickness="0,0,1,0"
                XYFocusKeyboardNavigation="Enabled"
                AutomationProperties.AutomationId="MainNavigation"
                AutomationProperties.Name="Muesli navigation">
            <Border.Resources>
                <!-- Rail rows hover with backgroundHover and never draw the button elevation border. -->
                <ResourceDictionary>
                    <ResourceDictionary.ThemeDictionaries>
                        <ResourceDictionary x:Key="Default">
                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#232528" />
                            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#2A2C30" />
                            <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
                            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
                            <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
                        </ResourceDictionary>
                        <ResourceDictionary x:Key="Light">
                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#E8E8EC" />
                            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#DFDFE3" />
                            <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
                            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
                            <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
                        </ResourceDictionary>
                        <ResourceDictionary x:Key="HighContrast" />
                    </ResourceDictionary.ThemeDictionaries>
                </ResourceDictionary>
            </Border.Resources>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="0" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header: below the 32-DIP caption strip plus pageTop 8, level with the page title. -->
                <StackPanel x:Name="NavigationHeader" Grid.Row="0" Margin="16,40,16,8">
                    <Grid x:Name="BrandRow" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="22" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <!--
                            The product brand mark: the 13 bars of the canonical app icon (macOS
                            MenuBarIconRenderer crops the same mark), 22 tall in the accent.
                            MainPage.DrawBrandMark snaps every bar and gap to whole pixels.
                        -->
                        <Path x:Name="BrandMark"
                              Stroke="{ThemeResource MuesliAccentBrush}"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              VerticalAlignment="Center"
                              AutomationProperties.Name="muesli"
                              AutomationProperties.AccessibilityView="Raw" />
                        <TextBlock x:Name="BrandNameText" Grid.Column="1"
                                   Text="muesli"
                                   Style="{StaticResource MuesliTitle2Style}"
                                   VerticalAlignment="Center" />
                        <!--
                            macOS SidebarToggleButton: a 36-pt circle (raised fallback), sidebar
                            glyph 16 in textSecondary. Collapsing reuses the compact rail; below
                            1008 DIP the rail is already compact and the toggle is hidden.
                        -->
                        <Button x:Name="SidebarCollapseButton"
                                Grid.Column="2"
                                Style="{StaticResource MuesliSidebarToggleButtonStyle}"
                                Click="ToggleSidebarCollapse_Click"
                                AutomationProperties.AutomationId="SidebarCollapseToggle"
                                AutomationProperties.Name="Collapse sidebar"
                                ToolTipService.ToolTip="Collapse sidebar">
                            <FontIcon x:Name="SidebarCollapseIcon"
                                      Glyph="&#xE8A0;"
                                      FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                      FontSize="15" />
                        </Button>
                    </Grid>
                    <!-- "Hi, name" under the wordmark (leading 34 = mark 22 + gap 12); hidden without a name. -->
                    <TextBlock x:Name="GreetingText"
                               Margin="34,2,0,0"
                               Style="{StaticResource MuesliCaptionStyle}"
                               Foreground="{ThemeResource MuesliTextTertiaryBrush}"
                               AutomationProperties.AutomationId="SidebarGreeting" />

                    <!--
                        macOS search launcher: chrome-less 32 tall, magnifier in the 20 column, "Search…"
                        in callout, the shortcut hint on the right; hover adds the quiet overlay. On
                        Windows the field types in place and routes the page to live results.
                    -->
                    <Border x:Name="SearchWell"
                            Height="32"
                            Margin="-8,20,-8,0"
                            Padding="10,0"
                            Background="Transparent"
                            CornerRadius="6"
                            PointerEntered="SearchWell_PointerEntered"
                            PointerExited="SearchWell_PointerExited">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon x:Name="SearchGlyph"
                                      Glyph="&#xE721;"
                                      FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                      FontSize="14"
                                      HorizontalAlignment="Left"
                                      Foreground="{ThemeResource MuesliTextSecondaryBrush}"
                                      VerticalAlignment="Center" />
                            <TextBox x:Name="SearchBox"
                                     Grid.Column="1"
                                     Style="{StaticResource MuesliSearchTextBoxStyle}"
                                     PlaceholderText="Search…"
                                     PlaceholderForeground="{ThemeResource MuesliTextSecondaryBrush}"
                                     TextChanged="SearchBox_TextChanged"
                                     GotFocus="SearchBox_GotFocus"
                                     LostFocus="SearchBox_LostFocus"
                                     AutomationProperties.AutomationId="HistorySearchBox"
                                     AutomationProperties.Name="Search dictations and meetings" />
                            <TextBlock x:Name="SearchShortcutHint"
                                       Grid.Column="2"
                                       Text="Ctrl+F"
                                       Style="{StaticResource MuesliCaptionStyle}"
                                       VerticalAlignment="Center"
                                       AutomationProperties.AccessibilityView="Raw" />
                            <Button x:Name="SearchClearButton"
                                    Grid.Column="2"
                                    Style="{StaticResource MuesliSidebarIconButtonStyle}"
                                    Visibility="Collapsed"
                                    Click="ClearSearch_Click"
                                    AutomationProperties.Name="Clear search"
                                    ToolTipService.ToolTip="Clear search">
                                <FontIcon Glyph="&#xE894;"
                                          FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                          FontSize="12" />
                            </Button>
                        </Grid>
                    </Border>
                </StackPanel>

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Padding="0,0,0,8">
                        <Button x:Name="TimelineNav"
                                Style="{StaticResource MuesliSidebarButtonStyle}"
                                Tag="timeline"
                                Click="NavButton_Click"
                                AutomationProperties.AutomationId="NavTimeline"
                                AutomationProperties.Name="Navigate to Timeline">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <FontIcon x:Name="TimelineIcon" Glyph="&#xE823;" Style="{StaticResource MuesliSidebarIconStyle}" />
                                <TextBlock Grid.Column="1" Text="Timeline" VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                        <Button x:Name="DictationsNav"
                                Style="{StaticResource MuesliSidebarButtonStyle}"
                                Tag="dictations"
                                Click="NavButton_Click"
                                AutomationProperties.AutomationId="NavDictations"
                                AutomationProperties.Name="Navigate to Dictations">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <!-- macOS "waveform": Segoe Fluent has no waveform glyph, so it is drawn. -->
                                <PathIcon x:Name="DictationsIcon"
                                          Width="15" Height="14"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Center"
                                          Foreground="{ThemeResource MuesliTextSecondaryBrush}"
                                          Data="M0,6 A0.75,0.75 0 0 1 1.5,6 V8 A0.75,0.75 0 0 1 0,8 Z M2.15,4.25 A0.75,0.75 0 0 1 3.65,4.25 V9.75 A0.75,0.75 0 0 1 2.15,9.75 Z M4.3,1.75 A0.75,0.75 0 0 1 5.8,1.75 V12.25 A0.75,0.75 0 0 1 4.3,12.25 Z M6.45,3.75 A0.75,0.75 0 0 1 7.95,3.75 V10.25 A0.75,0.75 0 0 1 6.45,10.25 Z M8.6,2.5 A0.75,0.75 0 0 1 10.1,2.5 V11.5 A0.75,0.75 0 0 1 8.6,11.5 Z M10.75,5 A0.75,0.75 0 0 1 12.25,5 V9 A0.75,0.75 0 0 1 10.75,9 Z M12.9,6.5 A0.75,0.75 0 0 1 14.4,6.5 V7.5 A0.75,0.75 0 0 1 12.9,7.5 Z" />
                                <TextBlock Grid.Column="1" Text="Dictations" VerticalAlignment="Center" />
                            </Grid>
                        </Button>

                        <!-- Meetings header: one row, with 36-wide disclosure and new-folder targets. -->
                        <Grid x:Name="MeetingsRow" Margin="8,2" Height="36">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="36" />
                                <ColumnDefinition Width="36" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="MeetingsNav"
                                    Grid.ColumnSpan="3"
                                    Margin="0"
                                    Style="{StaticResource MuesliSidebarButtonStyle}"
                                    Tag="meetings"
                                    Click="NavButton_Click"
                                    AutomationProperties.AutomationId="NavMeetings"
                                    AutomationProperties.Name="Navigate to Meetings">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <FontIcon x:Name="MeetingsIcon" Glyph="&#xE716;" Style="{StaticResource MuesliSidebarIconStyle}" />
                                    <TextBlock Grid.Column="1" Text="Meetings" VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                            <Button x:Name="MeetingChevronButton"
                                    Grid.Column="1"
                                    Style="{StaticResource MuesliSidebarRowActionButtonStyle}"
                                    Click="ToggleMeetingFolders_Click"
                                    AutomationProperties.Name="Expand or collapse meeting folders"
                                    AutomationProperties.AutomationId="MeetingFoldersChevron"
                                    ToolTipService.ToolTip="Show or hide meeting folders">
                                <FontIcon x:Name="MeetingChevronIcon"
                                          Glyph="&#xE96E;"
                                          FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                          FontSize="11" />
                            </Button>
                            <Button x:Name="CreateMeetingFolderButton"
                                    Grid.Column="2"
                                    Margin="0,0,4,0"
                                    Style="{StaticResource MuesliSidebarRowActionButtonStyle}"
                                    Click="CreateMeetingFolder_Click"
                                    AutomationProperties.Name="Create meeting folder"
                                    AutomationProperties.AutomationId="CreateMeetingFolderButton"
                                    ToolTipService.ToolTip="New folder">
                                <FontIcon Glyph="&#xE8F4;"
                                          FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                          FontSize="12" />
                            </Button>
                        </Grid>

                        <!-- Folder rows: leading 24 under Meetings, 16 per nesting level, 2 apart. -->
                        <StackPanel x:Name="MeetingChildrenHost"
                                    Margin="24,0,0,0"
                                    Spacing="2"
                                    AutomationProperties.Name="Meeting folders"
                                    AutomationProperties.AutomationId="MeetingFolderRail" />

                        <Button x:Name="DictionaryNav"
                                Style="{StaticResource MuesliSidebarButtonStyle}"
                                Tag="dictionary"
                                Click="NavButton_Click"
                                AutomationProperties.AutomationId="NavDictionary"
                                AutomationProperties.Name="Navigate to Dictionary">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <FontIcon x:Name="DictionaryIcon" Glyph="&#xE82D;" Style="{StaticResource MuesliSidebarIconStyle}" />
                                <TextBlock Grid.Column="1" Text="Dictionary" VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                    </StackPanel>
                </ScrollViewer>

                <!-- Pinned footer, as on macOS: it stays at the bottom while the destinations scroll. -->
                <StackPanel x:Name="NavigationFooter" Grid.Row="2" Padding="0,4,0,0">
                    <!--
                        macOS model-preparation status card: backgroundRaised, 1pt border, radius 6,
                        padding 10×8, 11 semibold title over a 10 medium detail. Selecting it opens
                        Models. It is not a nav item (no selection state), so it stays out of AllNavItems().
                    -->
                    <Button x:Name="DownloadStatusRow"
                            Style="{StaticResource MuesliSidebarStatusCardStyle}"
                            Tag="models"
                            Click="NavButton_Click"
                            Visibility="{x:Bind Downloads.IsVisible, Mode=OneWay}"
                            ToolTipService.ToolTip="{x:Bind Downloads.Title, Mode=OneWay}"
                            AutomationProperties.AutomationId="SidebarDownloadStatus"
                            AutomationProperties.Name="{x:Bind Downloads.AccessibleName, Mode=OneWay}"
                            AutomationProperties.LiveSetting="Polite">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Grid x:Name="DownloadStatusIcon" Width="20" Height="20" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <ProgressRing Width="16" Height="16"
                                              MinWidth="16" MinHeight="16"
                                              IsActive="{x:Bind Downloads.ShowRing, Mode=OneWay}"
                                              IsIndeterminate="{x:Bind Downloads.IsIndeterminate, Mode=OneWay}"
                                              Value="{x:Bind Downloads.ProgressValue, Mode=OneWay}"
                                              Maximum="100"
                                              Foreground="{ThemeResource MuesliAccentBrush}"
                                              Visibility="{x:Bind Downloads.ShowRing, Mode=OneWay}" />
                                <FontIcon Glyph="&#xEC61;" FontSize="15"
                                          Foreground="{ThemeResource MuesliSuccessBrush}"
                                          Visibility="{x:Bind Downloads.ShowCompleted, Mode=OneWay}" />
                                <FontIcon Glyph="&#xE7BA;" FontSize="14"
                                          Foreground="{ThemeResource MuesliDestructiveTextBrush}"
                                          Visibility="{x:Bind Downloads.ShowFailed, Mode=OneWay}" />
                                <FontIcon Glyph="&#xE769;" FontSize="14"
                                          Foreground="{ThemeResource MuesliTextTertiaryBrush}"
                                          Visibility="{x:Bind Downloads.ShowPaused, Mode=OneWay}" />
                            </Grid>
                            <StackPanel x:Name="DownloadStatusText" Grid.Column="1" Spacing="1" VerticalAlignment="Center" MinWidth="0">
                                <TextBlock Text="{x:Bind Downloads.Title, Mode=OneWay}"
                                           FontFamily="{StaticResource MuesliFontFamilySemiBold}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource MuesliTextSecondaryBrush}"
                                           MaxLines="1"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind Downloads.Detail, Mode=OneWay}"
                                           FontFamily="{StaticResource MuesliFontFamilyMedium}"
                                           FontSize="10"
                                           FontWeight="Medium"
                                           Foreground="{ThemeResource MuesliTextTertiaryBrush}"
                                           MaxLines="1"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </Button>
                    <Button x:Name="ModelsNav"
                            Style="{StaticResource MuesliSidebarButtonStyle}"
                            Tag="models"
                            Click="NavButton_Click"
                            AutomationProperties.AutomationId="NavModels"
                            AutomationProperties.Name="Navigate to Models">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <FontIcon x:Name="ModelsIcon" Glyph="&#xE950;" Style="{StaticResource MuesliSidebarIconStyle}" />
                            <TextBlock Grid.Column="1" Text="Models" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                    <Button x:Name="ShortcutsNav"
                            Style="{StaticResource MuesliSidebarButtonStyle}"
                            Tag="shortcuts"
                            Click="NavButton_Click"
                            AutomationProperties.AutomationId="NavShortcuts"
                            AutomationProperties.Name="Navigate to Shortcuts">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <FontIcon x:Name="ShortcutsIcon" Glyph="&#xE765;" Style="{StaticResource MuesliSidebarIconStyle}" />
                            <TextBlock Grid.Column="1" Text="Shortcuts" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                    <Button x:Name="SettingsNav"
                            Style="{StaticResource MuesliSidebarButtonStyle}"
                            Tag="settings"
                            Click="NavButton_Click"
                            AutomationProperties.AutomationId="NavSettings"
                            AutomationProperties.Name="Navigate to Settings">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <FontIcon x:Name="SettingsIcon" Glyph="&#xE713;" Style="{StaticResource MuesliSidebarIconStyle}" />
                            <TextBlock Grid.Column="1" Text="Settings" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                    <Button x:Name="AboutNav"
                            Style="{StaticResource MuesliSidebarButtonStyle}"
                            Tag="about"
                            Click="NavButton_Click"
                            AutomationProperties.AutomationId="NavAbout"
                            AutomationProperties.Name="Navigate to About">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <FontIcon x:Name="AboutIcon" Glyph="&#xE946;" Style="{StaticResource MuesliSidebarIconStyle}" />
                            <TextBlock Grid.Column="1" Text="About" VerticalAlignment="Center" />
                        </Grid>
                    </Button>

                    <!--
                        macOS appearance toggle: Light / System / Dark icon segments, 28 wide in a
                        raised well; the selected one is tinted with an outline.
                    -->
                    <Border x:Name="AppearanceToggle"
                            Margin="18,12,0,20"
                            Padding="2"
                            HorizontalAlignment="Left"
                            Background="{ThemeResource MuesliBackgroundRaisedBrush}"
                            CornerRadius="6"
                            AutomationProperties.Name="Appearance">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <Button x:Name="AppearanceLight" Tag="light" Style="{StaticResource MuesliAppearanceSegmentStyle}"
                                    Click="AppearanceSegment_Click" ToolTipService.ToolTip="Light"
                                    AutomationProperties.Name="Light appearance">
                                <FontIcon Glyph="&#xE706;" FontSize="12" />
                            </Button>
                            <Button x:Name="AppearanceSystem" Tag="system" Style="{StaticResource MuesliAppearanceSegmentStyle}"
                                    Click="AppearanceSegment_Click" ToolTipService.ToolTip="Use Windows setting"
                                    AutomationProperties.Name="System appearance">
                                <FontIcon Glyph="&#xE7F4;" FontSize="12" />
                            </Button>
                            <Button x:Name="AppearanceDark" Tag="dark" Style="{StaticResource MuesliAppearanceSegmentStyle}"
                                    Click="AppearanceSegment_Click" ToolTipService.ToolTip="Dark"
                                    AutomationProperties.Name="Dark appearance">
                                <FontIcon Glyph="&#xE708;" FontSize="12" />
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!--
            Horizontal gutters belong to the page (MuesliPageGutter* / page Padding). The shell
            only reserves the 32-DIP caption strip so page titles sit below the native buttons
            instead of under them, and so ContentFrame receives the full remaining width.
        -->
        <Grid x:Name="ContentHost"
              Grid.Column="1"
              Background="{ThemeResource MuesliBackgroundBrush}"
              Padding="0,32,0,0">
            <Frame x:Name="ContentFrame"
                   AutomationProperties.AutomationId="ContentFrame" />
        </Grid>

        <Grid x:Name="TourOverlay"
              Grid.ColumnSpan="2"
              Visibility="Collapsed"
              Background="{ThemeResource MuesliOverlayBrush}"
              TabFocusNavigation="Cycle"
              AutomationProperties.AutomationId="FeatureTourOverlay">
            <Border x:Name="TourCard"
                    Style="{StaticResource MuesliCardStyle}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="40"
                    MaxWidth="520"
                    Padding="22">
                <StackPanel Spacing="12">
                    <TextBlock x:Name="TourStepLabel" Style="{StaticResource MuesliSectionLabelStyle}" />
                    <TextBlock x:Name="TourTitle"
                               FontFamily="{StaticResource MuesliFontFamilySemiBold}"
                               FontSize="20"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource MuesliTextPrimaryBrush}" />
                    <TextBlock x:Name="TourBody"
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource MuesliTextSecondaryBrush}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                        <Button Content="Skip tour"
                                Click="TourSkip_Click"
                                AutomationProperties.AutomationId="FeatureTourSkip"
                                AutomationProperties.Name="Skip feature tour" />
                        <Button x:Name="TourNextButton"
                                Content="Next"
                                Style="{StaticResource MuesliPrimaryButtonStyle}"
                                Click="TourNext_Click"
                                AutomationProperties.AutomationId="FeatureTourNext"
                                AutomationProperties.Name="Next feature tour step" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>

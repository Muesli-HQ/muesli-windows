<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Muesli.Windows.WinUI.OnboardingWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Muesli.Windows.WinUI"
    xmlns:vm="using:Muesli.Windows.WinUI.ViewModels"
    Title="Set up Muesli">
    <!-- macOS OnboardingView: one centred step at a time, progress dots and Back/Continue at the bottom. -->
    <Grid
        x:Name="RootGrid"
        Background="{ThemeResource MuesliBackgroundBrush}"
        PreviewKeyDown="RootGrid_PreviewKeyDown">
        <Grid.Resources>
            <Style x:Key="OnboardingChoiceCardStyle" TargetType="Button">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="14,12" />
                <Setter Property="BorderThickness" Value="1.5" />
                <Setter Property="CornerRadius" Value="10" />
            </Style>
            <Style x:Key="OnboardingTabStyle" TargetType="Button">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="8,7" />
                <Setter Property="BorderThickness" Value="1.5" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="AppTitleBar"
            Height="{StaticResource MuesliTitleBarHeight}"
            Background="Transparent"
            AutomationProperties.Name="Muesli setup window title bar">
            <TextBlock
                Margin="16,0,0,0"
                VerticalAlignment="Center"
                Style="{StaticResource MuesliBodyStyle}"
                FontSize="12"
                Text="Set up Muesli"
                IsHitTestVisible="False" />
        </Grid>

        <!-- macOS modelDownloadIndicator: the download keeps going while later steps are filled in. -->
        <Border
            Grid.Row="1"
            Canvas.ZIndex="1"
            Margin="0,4,16,0"
            Padding="12,8"
            MaxWidth="260"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            CornerRadius="8"
            Background="{ThemeResource MuesliSurfaceRaisedBrush}"
            BorderBrush="{ThemeResource MuesliBorderSoftBrush}"
            BorderThickness="1"
            Visibility="{x:Bind ViewModel.ShowDownloadIndicator, Mode=OneWay}"
            AutomationProperties.AutomationId="OnboardingDownloadIndicator">
            <StackPanel Spacing="4">
                <TextBlock Text="{x:Bind ViewModel.DownloadIndicatorTitle, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource MuesliTextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                <ProgressBar
                    Width="200"
                    Maximum="100"
                    Value="{x:Bind ViewModel.DownloadPercent, Mode=OneWay}"
                    IsIndeterminate="{x:Bind ViewModel.IsDownloadIndeterminate, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.IsDownloading, Mode=OneWay}" />
                <TextBlock Text="{x:Bind ViewModel.DownloadIndicatorDetail, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource MuesliTextSecondaryBrush}" TextWrapping="Wrap" />
                <HyperlinkButton
                    Padding="0"
                    FontSize="11"
                    Content="Retry"
                    Command="{x:Bind ViewModel.RetryDownloadCommand}"
                    Visibility="{x:Bind local:OnboardingWindow.HasText(ViewModel.DownloadError), Mode=OneWay}" />
            </StackPanel>
        </Border>

        <ScrollViewer x:Name="ContentScroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
            <Grid x:Name="ContentColumn" Padding="24,12,24,16" HorizontalAlignment="Center" VerticalAlignment="Center">

                <!-- Step 0: welcome, name, and what Muesli is for -->
                <StackPanel Spacing="18" Visibility="{x:Bind ViewModel.ShowWelcome, Mode=OneWay}">
                    <Image Width="56" Height="56" Source="ms-appx:///Assets/MuesliGlyph.png" HorizontalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
                    <StackPanel Spacing="6">
                        <TextBlock Text="Welcome to Muesli" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{ThemeResource MuesliTextPrimaryBrush}" />
                        <TextBlock Text="Local-first dictation and meeting transcription for Windows." Style="{StaticResource MuesliBodyStyle}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                    <TextBox
                        Header="Your name"
                        PlaceholderText="Your name"
                        Text="{x:Bind ViewModel.UserName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        AutomationProperties.AutomationId="OnboardingNameBox" />
                    <TextBlock Text="What will you use Muesli for?" FontWeight="SemiBold" Foreground="{ThemeResource MuesliTextPrimaryBrush}" />
                    <Grid ColumnSpacing="10" RowSpacing="10" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto">
                        <Button
                            Style="{StaticResource OnboardingChoiceCardStyle}"
                            BorderBrush="{x:Bind local:OnboardingWindow.CardBorder(ViewModel.VoiceNotesSelected), Mode=OneWay}"
                            Background="{x:Bind local:OnboardingWindow.CardBackground(ViewModel.VoiceNotesSelected), Mode=OneWay}"
                            Command="{x:Bind ViewModel.ToggleCapabilityCommand}"
                            CommandParameter="VoiceNotes"
                            AutomationProperties.AutomationId="OnboardingUseVoiceNotes"
                            AutomationProperties.Name="Voice Notes">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                <FontIcon Glyph="&#xE720;" FontSize="18" Foreground="{ThemeResource MuesliAccentBrush}" />
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="Voice Notes" FontWeight="SemiBold" Foreground="{ThemeResource MuesliTextPrimaryBrush}" />
                                    <TextBlock Text="Record in Muesli" FontSize="12" Foreground="{ThemeResource MuesliTextSecondaryBrush}" />
                                </StackPanel>
                                <FontIcon Grid.Column="2" Glyph="&#xE73E;" FontSize="12" Foreground="{ThemeResource MuesliAccentBrush}" Visibility="{x:Bind ViewModel.VoiceNotesSelected, Mode=OneWay}" />
                            </Grid>
                        </Button>
                        <Button
                            Grid.Column="1"
                            Style="{StaticResource OnboardingChoiceCardStyle}"
                            BorderBrush="{x:Bind local:OnboardingWindow.CardBorder(ViewModel.DictationSelected), Mode=OneWay}"
                            Background="{x:Bind local:OnboardingWindow.CardBackground(ViewModel.DictationSelected), Mode=OneWay}"
                            Command="{x:Bind ViewModel.ToggleCapabilityCommand}"
                            CommandParameter="Dictation"
                            AutomationProperties.AutomationId="OnboardingUseDictation"
                            AutomationProperties.Name="Dictation">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                <FontIcon Glyph="&#xE765;" FontSize="18" Foreground="{ThemeResource MuesliAccentBrush}" />
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="Dictation" FontWeight="SemiBold" Foreground="{ThemeResource MuesliTextPrimaryBrush}" />
                                    <TextBlock Text="Paste into apps" FontSize="12" Foreground="{ThemeResource MuesliTextSecondaryBrush}" />
                                </StackPanel>
                                <FontIcon Grid.Column="2" Glyph="&#xE73E;" FontSize="12" Foreground="{ThemeResource MuesliAccentBrush}" Visibility="{x:Bind ViewModel.DictationSelected, Mode=OneWay}" />
                            </Grid>
                        </Button>
                        <Button
                            Grid.Row="1"
                            Style="{StaticResource OnboardingChoiceCardStyle}"
                            BorderBrush="{x:Bind local:OnboardingWindow.CardBorder(ViewModel.MeetingsSelected), Mode=OneWay}"
                            Background="{x:Bind local:OnboardingWindow.CardBackground(ViewModel.MeetingsSelected), Mode=OneWay}"
                            Command="{x:Bind ViewModel.ToggleCapabilityCommand}"
                            CommandParameter="Meetings"
                            AutomationProperties.AutomationId="OnboardingUseMeetings"
                            AutomationProperties.Name="Meetings">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                <FontIcon Glyph="&#xE716;" FontSize="18" Foreground="{ThemeResource MuesliAccentBrush}" />
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="Meetings" FontWeight="SemiBold" Foreground="{ThemeResource MuesliTextPrimaryBrush}" />
                                    <TextBlock Text="Notes and summaries" FontSize="12" Foreground="{ThemeResource MuesliTextSecondaryBrush}" />
                                </StackPanel>
                                <FontIcon Grid.Column="2" Glyph="&#xE73E;" FontSize="12" Foreground="{ThemeResource MuesliAccentBrush}" Visibility="{x:Bind ViewModel.MeetingsSelected, Mode=OneWay}" />
                            </Grid>
                        </Button>
                        <Button
                            Grid.Row="1"
                            Grid.Column="1"
                            Style="{StaticResource OnboardingChoiceCardStyle}"
                            BorderBrush="{x:Bind local:OnboardingWindow.CardBorder(ViewModel.EverythingSelected), Mode=OneWay}"
                            Background="{x:Bind local:OnboardingWindow.CardBackground(ViewModel.EverythingSelected), Mode=OneWay}"
                            Command="{x:Bind ViewModel.ToggleCapabilityCommand}"
                            CommandParameter="Everything"
                            AutomationProperties.AutomationId="OnboardingUseEverything"
                            AutomationProperties.Name="Everything">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                <FontIcon Glyph="&#xE734;" FontSize="18" Foreground="{ThemeResource MuesliAccentBrush}" />
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="Everything" FontWeight="SemiBold" Foreground="{ThemeResource MuesliTextPrimaryBrush}" />
                                    <TextBlock Text="All workflows" FontSize="12" Foreground="{ThemeResource MuesliTextSecondaryBrush}" />
                                </StackPanel>
                                <FontIcon Grid.Column="2" Glyph="&#xE73E;" FontSize="12" Foreground="{ThemeResource MuesliAccentBrush}" Visibility="{x:Bind ViewModel.EverythingSelected, Mode=OneWay}" />
                            </Grid>
                        </Button>
                    </Grid>
                </StackPanel>

                <!-- Step 1: transcription model -->
                <StackPanel Spacing="16" Visibility="{x:Bind ViewModel.ShowModel, Mode=OneWay}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Choose your transcription model" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Foreground="{ThemeResource MuesliTextPrimaryBrush}" />
                        <TextBlock Text="Start with a fast local model. Larger models can download while you continue setup." Style="{StaticResource MuesliBodyStyle}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button
                        Style="{StaticResource OnboardingChoiceCardStyle}"
                        BorderBrush="{x:Bind local:OnboardingWindow.CardBorder(ViewModel.RecommendedModel.IsSelected), Mode=OneWay}"
                        Background="{x:Bind local:OnboardingWindow.CardBackground(ViewModel.RecommendedModel.IsSelected), Mode=OneWay}"
                        Command="{x:Bind ViewModel.ChooseModelCommand}"
                        CommandParameter="{x:Bind ViewModel.RecommendedModel}"
                        AutomationProperties.AutomationId="OnboardingRecommendedModel"
                        AutomationProperties.Name="{x:Bind ViewModel.RecommendedModel.Title}">
                        <StackPanel Spacing="2">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{x:Bind ViewModel.RecommendedModel.Title}" FontWeight="SemiBold" Foreground="{ThemeResource MuesliTextPrimaryBrush}" />
                                <Border Style="{StaticResource MuesliAccentBadgeStyle}" Visibility="{x:Bind ViewModel.RecommendedModel.IsRecommended}">
                                    <TextBlock Style="{StaticResource MuesliAccentBadgeTextStyle}" Text="Recommended" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{x:Bind ViewModel.RecommendedModel.Description}" FontSize="12" Foreground="{ThemeResource MuesliTextSecondaryBrush}" TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind ViewModel.RecommendedModel.Size}" FontSize="12" Foreground="{ThemeResource MuesliTextTertiaryBrush}" />
                        </StackPanel>
                    </Button>
                    <HyperlinkButton
                        Padding="0"
                        Command="{x:Bind ViewModel.ToggleMoreModelsCommand}"
                        AutomationProperties.AutomationId="OnboardingOtherModels">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="10" Glyph="{x:Bind local:OnboardingWindow.Chevron(ViewModel.ShowMoreModels), Mode=OneWay}" />
                            <TextBlock Text="Other models" />
                        </StackPanel>
                    </HyperlinkButton>
                    <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.ShowMoreModels, Mode=OneWay}">
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.OtherModels}">
                            <ItemsRepeater.Layout>
                                <StackLayout Spacing="8" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:OnboardingModelCard">
                                    <Button
                                        Style="{StaticResource OnboardingChoiceCardStyle}"
                                        BorderBrush="{x:Bind local:OnboardingWindow.CardBorder(IsSelected), Mode=OneWay}"
                                        Background="{x:Bind local:OnboardingWindow.CardBackground(IsSelected), Mode=OneWay}"
                                        Click="ModelCard_Click"
                                        AutomationProperties.Name="{x:Bind Title}">
                                        <StackPanel Spacing="2">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" Foreground="{ThemeResource MuesliTextPrimaryBrush}" />
                                                <Border Style="{StaticResource MuesliAccentBadgeStyle}" Visibility="{x:Bind IsRecommended}">
                                                    <TextBlock Style="{StaticResource MuesliAccentBadgeTextStyle}" Text="Recommended" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{x:Bind Description}" FontSize="12" Foreground="{ThemeResource MuesliTextSecondaryBrush}" TextWrapping="Wrap" />
                                            <TextBlock Text="{x:Bind Size}" FontSize="12" Foreground="{ThemeResource MuesliTextTertiaryBrush}" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                        <TextBlock Text="More models are available after onboarding." Style="{StaticResource MuesliBodyStyle}" FontSize="12" />
                    </StackPanel>
                </StackPanel>

                <!-- Step 2: dictation shortcut -->
                <StackPanel Spacing="18" Visibility="{x:Bind ViewModel.ShowHotkey, Mode=OneWay}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Dictation Shortcut" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{ThemeResource MuesliTextPrimaryBrush}" />
                        <TextBlock Text="Hold this key to dictate. Release it to transcribe and paste." Style="{StaticResource MuesliBodyStyle}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                    <Border
                        MinWidth="160"
                        Padding="28,18"
                        HorizontalAlignment="Center"
                        CornerRadius="12"
                        BorderThickness="1"
                        BorderBrush="{x:Bind local:OnboardingWindow.CardBorder(ViewModel.IsRecordingHotkey), Mode=OneWay}"
                        Background="{x:Bind local:OnboardingWindow.CardBackground(ViewModel.IsRecordingHotkey), Mode=OneWay}">
                        <TextBlock
                            Text="{x:Bind ViewModel.HotkeyLabel, Mode=OneWay}"
                            FontSize="30"
                            FontWeight="SemiBold"
                            HorizontalAlignment="Center"
                            Foreground="{ThemeResource MuesliTextPrimaryBrush}"
                            AutomationProperties.AutomationId="OnboardingHotkeyLabel" />
                    </Border>
                    <Button
                        x:Name="ChangeShortcutButton"
                        HorizontalAlignment="Center"
                        Style="{StaticResource MuesliSecondaryButtonStyle}"
                        Content="{x:Bind ViewModel.HotkeyButtonLabel, Mode=OneWay}"
                        Command="{x:Bind ViewModel.ToggleHotkeyRecordingCommand}"
                        AutomationProperties.AutomationId="OnboardingChangeShortcut" />
                    <TextBlock
                        Text="{x:Bind ViewModel.HotkeyError, Mode=OneWay}"
                        Foreground="{ThemeResource MuesliErrorBrush}"
                        HorizontalAlignment="Center"
                        TextAlignment="Center"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind local:OnboardingWindow.HasText(ViewModel.HotkeyError), Mode=OneWay}" />
                    <TextBlock
                        Text="Function keys, letters, and digits work, alone or with Ctrl, Shift, Alt, or Win. Escape is kept for cancelling a dictation."
                        Style="{StaticResource MuesliBodyStyle}"
                        FontSize="12"
                        HorizontalAlignment="Center"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </StackPanel>

                <!-- Step 3: permissions (Windows only needs the microphone) -->
                <StackPanel Spacing="16" Visibility="{x:Bind ViewModel.ShowPermissions, Mode=OneWay}">
                    <StackPanel Spacing="16" Visibility="{x:Bind ViewModel.ShowMicrophoneRequest, Mode=OneWay}">
                        <TextBlock Text="Permission 1 of 1" Style="{StaticResource MuesliSectionLabelStyle}" HorizontalAlignment="Center" />
                        <FontIcon Glyph="&#xE720;" FontSize="40" Foreground="{ThemeResource MuesliAccentBrush}" />
                        <StackPanel Spacing="6">
                            <TextBlock Text="Microphone" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{ThemeResource MuesliTextPrimaryBrush}" />
                            <TextBlock Text="Record audio for voice notes, dictation, and meetings" Style="{StaticResource MuesliBodyStyle}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="6"
                            HorizontalAlignment="Center"
                            Visibility="{x:Bind ViewModel.IsConfirmingGrant, Mode=OneWay}">
                            <FontIcon Glyph="&#xE73E;" FontSize="14" Foreground="{ThemeResource MuesliSuccessBrush}" />
                            <TextBlock Text="Granted" FontWeight="SemiBold" Foreground="{ThemeResource MuesliSuccessBrush}" />
                        </StackPanel>
                        <Button
                            MinWidth="180"
                            HorizontalAlignment="Center"
                            Visibility="{x:Bind local:OnboardingWindow.Not(ViewModel.IsConfirmingGrant), Mode=OneWay}"
                            Style="{StaticResource MuesliPrimaryButtonStyle}"
                            Content="{x:Bind ViewModel.PermissionButtonLabel, Mode=OneWay}"
                            IsEnabled="{x:Bind ViewModel.PermissionButtonEnabled, Mode=OneWay}"
                            Click="GrantMicrophone_Click"
                            AutomationProperties.AutomationId="OnboardingGrantMicrophone" />
                        <TextBlock
                            Text="{x:Bind ViewModel.MicrophoneError, Mode=OneWay}"
                            Foreground="{ThemeResource MuesliErrorBrush}"
                            HorizontalAlignment="Center"
                            TextAlignment="Center"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind local:OnboardingWindow.HasText(ViewModel.MicrophoneError), Mode=OneWay}" />
                        <HyperlinkButton
                            HorizontalAlignment="Center"
                            Content="Not seeing a prompt? Open Windows Settings"
                            Command="{x:Bind ViewModel.OpenMicrophoneSettingsCommand}" />
                    </StackPanel>
                    <StackPanel Spacing="10" Visibility="{x:Bind ViewModel.ShowAllGranted, Mode=OneWay}">
                        <FontIcon Glyph="&#xE73E;" FontSize="40" Foreground="{ThemeResource MuesliSuccessBrush}" />
                        <TextBlock Text="All permissions granted" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{ThemeResource MuesliTextPrimaryBrush}" />
                    </StackPanel>
                </StackPanel>

                <!-- Step 4: try the shortcut for real; nothing is saved or pasted -->
                <StackPanel Spacing="16" Visibility="{x:Bind ViewModel.ShowDictationTest, Mode=OneWay}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="{x:Bind ViewModel.TestTitle, Mode=OneWay}" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{ThemeResource MuesliTextPrimaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.TestSubtitle, Mode=OneWay}" Style="{StaticResource MuesliBodyStyle}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.ShowTestPreparing, Mode=OneWay}">
                        <ProgressBar
                            Maximum="100"
                            Value="{x:Bind ViewModel.DownloadPercent, Mode=OneWay}"
                            IsIndeterminate="{x:Bind ViewModel.IsDownloadIndeterminate, Mode=OneWay}" />
                        <TextBlock Text="{x:Bind ViewModel.TestPreparingStatus, Mode=OneWay}" Style="{StaticResource MuesliBodyStyle}" FontSize="12" HorizontalAlignment="Center" />
                        <TextBlock Text="The dictation test is disabled until download and warmup complete." Style="{StaticResource MuesliBodyStyle}" FontSize="12" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.ShowTestReady, Mode=OneWay}">
                        <TextBlock HorizontalAlignment="Center" Style="{StaticResource MuesliBodyStyle}" FontSize="12">
                            <Run Text="Try saying:" />
                            <Run Text="&quot;testing this one out&quot;" FontStyle="Italic" />
                        </TextBlock>
                        <Border
                            MinHeight="90"
                            Padding="14"
                            CornerRadius="10"
                            BorderThickness="1"
                            BorderBrush="{x:Bind local:OnboardingWindow.CardBorder(ViewModel.HasTestResult), Mode=OneWay}"
                            Background="{ThemeResource MuesliSurfaceRaisedBrush}">
                            <StackPanel Spacing="8" VerticalAlignment="Center">
                                <TextBlock
                                    Text="Dictation is working!"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource MuesliSuccessBrush}"
                                    Visibility="{x:Bind ViewModel.HasTestResult, Mode=OneWay}" />
                                <TextBlock
                                    Text="{x:Bind ViewModel.TestPlaceholder, Mode=OneWay}"
                                    Foreground="{x:Bind local:OnboardingWindow.ResultForeground(ViewModel.HasTestResult), Mode=OneWay}"
                                    TextWrapping="Wrap"
                                    AutomationProperties.AutomationId="OnboardingTestResult"
                                    AutomationProperties.LiveSetting="Polite" />
                            </StackPanel>
                        </Border>
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Visibility="{x:Bind ViewModel.ShowListening, Mode=OneWay}">
                            <ProgressRing Width="14" Height="14" IsActive="{x:Bind ViewModel.ShowListening, Mode=OneWay}" />
                            <TextBlock Text="{x:Bind ViewModel.ListeningText, Mode=OneWay}" Style="{StaticResource MuesliBodyStyle}" FontSize="12" />
                        </StackPanel>
                        <TextBlock
                            Text="{x:Bind ViewModel.TestHint, Mode=OneWay}"
                            Style="{StaticResource MuesliBodyStyle}"
                            FontSize="12"
                            HorizontalAlignment="Center"
                            Visibility="{x:Bind ViewModel.ShowTestHint, Mode=OneWay}" />
                        <TextBlock
                            Text="{x:Bind ViewModel.TestError, Mode=OneWay}"
                            Foreground="{ThemeResource MuesliErrorBrush}"
                            HorizontalAlignment="Center"
                            TextAlignment="Center"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind local:OnboardingWindow.HasText(ViewModel.TestError), Mode=OneWay}" />
                    </StackPanel>
                </StackPanel>

                <!-- Step 5: meeting summaries -->
                <StackPanel Spacing="16" Visibility="{x:Bind ViewModel.ShowMeetingSummary, Mode=OneWay}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Meeting Summaries" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{ThemeResource MuesliTextPrimaryBrush}" />
                        <TextBlock
                            Text="Connect an LLM provider for AI-powered meeting notes.&#x0a;Remote summaries may send transcripts to the provider you choose."
                            Style="{StaticResource MuesliBodyStyle}"
                            HorizontalAlignment="Center"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <Grid ColumnSpacing="6" ColumnDefinitions="*,*,*,*">
                        <Button Style="{StaticResource OnboardingTabStyle}" Content="ChatGPT"
                                BorderBrush="{x:Bind local:OnboardingWindow.CardBorder(ViewModel.ChatGptSelected), Mode=OneWay}"
                                Background="{x:Bind local:OnboardingWindow.CardBackground(ViewModel.ChatGptSelected), Mode=OneWay}"
                                Command="{x:Bind ViewModel.ChooseSummaryBackendCommand}" CommandParameter="chatgpt"
                                AutomationProperties.AutomationId="OnboardingSummaryChatGpt" />
                        <Button Grid.Column="1" Style="{StaticResource OnboardingTabStyle}" Content="OpenAI"
                                BorderBrush="{x:Bind local:OnboardingWindow.CardBorder(ViewModel.OpenAISelected), Mode=OneWay}"
                                Background="{x:Bind local:OnboardingWindow.CardBackground(ViewModel.OpenAISelected), Mode=OneWay}"
                                Command="{x:Bind ViewModel.ChooseSummaryBackendCommand}" CommandParameter="openai"
                                AutomationProperties.AutomationId="OnboardingSummaryOpenAI" />
                        <Button Grid.Column="2" Style="{StaticResource OnboardingTabStyle}" Content="OpenRouter"
                                BorderBrush="{x:Bind local:OnboardingWindow.CardBorder(ViewModel.OpenRouterSelected), Mode=OneWay}"
                                Background="{x:Bind local:OnboardingWindow.CardBackground(ViewModel.OpenRouterSelected), Mode=OneWay}"
                                Command="{x:Bind ViewModel.ChooseSummaryBackendCommand}" CommandParameter="openrouter"
                                AutomationProperties.AutomationId="OnboardingSummaryOpenRouter" />
                        <Button Grid.Column="3" Style="{StaticResource OnboardingTabStyle}" Content="Ollama"
                                BorderBrush="{x:Bind local:OnboardingWindow.CardBorder(ViewModel.OllamaSelected), Mode=OneWay}"
                                Background="{x:Bind local:OnboardingWindow.CardBackground(ViewModel.OllamaSelected), Mode=OneWay}"
                                Command="{x:Bind ViewModel.ChooseSummaryBackendCommand}" CommandParameter="ollama"
                                AutomationProperties.AutomationId="OnboardingSummaryOllama" />
                    </Grid>
                    <Border Padding="16" CornerRadius="10" Background="{ThemeResource MuesliSurfaceRaisedBrush}" BorderBrush="{ThemeResource MuesliBorderSoftBrush}" BorderThickness="1">
                        <StackPanel Spacing="10">
                            <StackPanel Spacing="10" Visibility="{x:Bind ViewModel.ChatGptSelected, Mode=OneWay}">
                                <TextBlock Text="Use your ChatGPT subscription. Muesli signs in with the same account it uses for Computer Use. No API key needed." Style="{StaticResource MuesliBodyStyle}" TextWrapping="Wrap" />
                                <Button
                                    Style="{StaticResource MuesliPrimaryButtonStyle}"
                                    Content="Sign in with ChatGPT"
                                    Command="{x:Bind ViewModel.SignInWithChatGptCommand}"
                                    Visibility="{x:Bind ViewModel.ShowChatGptSignIn, Mode=OneWay}"
                                    AutomationProperties.AutomationId="OnboardingChatGptSignIn" />
                                <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind ViewModel.ShowChatGptSigningIn, Mode=OneWay}">
                                    <ProgressRing Width="14" Height="14" IsActive="{x:Bind ViewModel.ShowChatGptSigningIn, Mode=OneWay}" />
                                    <TextBlock Text="Finish signing in from your browser…" Style="{StaticResource MuesliBodyStyle}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind ViewModel.ShowChatGptSignedIn, Mode=OneWay}">
                                    <FontIcon Glyph="&#xE73E;" FontSize="14" Foreground="{ThemeResource MuesliSuccessBrush}" />
                                    <TextBlock Text="Signed in with ChatGPT" Foreground="{ThemeResource MuesliTextPrimaryBrush}" />
                                </StackPanel>
                                <TextBlock
                                    Text="{x:Bind ViewModel.SignInError, Mode=OneWay}"
                                    Foreground="{ThemeResource MuesliErrorBrush}"
                                    TextWrapping="Wrap"
                                    Visibility="{x:Bind local:OnboardingWindow.HasText(ViewModel.SignInError), Mode=OneWay}" />
                            </StackPanel>
                            <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.ShowKeyEntry, Mode=OneWay}">
                                <TextBlock Text="{x:Bind ViewModel.KeyCaption, Mode=OneWay}" Style="{StaticResource MuesliBodyStyle}" TextWrapping="Wrap" />
                                <PasswordBox
                                    x:Name="ApiKeyBox"
                                    PlaceholderText="{x:Bind ViewModel.KeyPlaceholder, Mode=OneWay}"
                                    PasswordChanged="ApiKeyBox_PasswordChanged"
                                    AutomationProperties.Name="API key"
                                    AutomationProperties.AutomationId="OnboardingApiKey" />
                                <TextBlock Text="{x:Bind ViewModel.KeyStatus, Mode=OneWay}" Style="{StaticResource MuesliBodyStyle}" FontSize="12" />
                            </StackPanel>
                            <TextBlock
                                Text="Run Ollama on this PC and pick a model in Settings › Meetings. Transcripts stay on your computer."
                                Style="{StaticResource MuesliBodyStyle}"
                                TextWrapping="Wrap"
                                Visibility="{x:Bind ViewModel.OllamaSelected, Mode=OneWay}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Bottom bar: Back, progress dots, then Skip and the primary action. -->
        <Grid
            Grid.Row="2"
            Padding="24,12,24,18"
            BorderBrush="{ThemeResource MuesliBorderSoftBrush}"
            BorderThickness="0,1,0,0"
            ColumnDefinitions="*,Auto,*">
            <Button
                HorizontalAlignment="Left"
                Style="{StaticResource MuesliGhostButtonStyle}"
                Content="Back"
                Command="{x:Bind ViewModel.BackCommand}"
                Visibility="{x:Bind ViewModel.CanGoBack, Mode=OneWay}"
                AutomationProperties.AutomationId="OnboardingBack" />
            <ItemsRepeater Grid.Column="1" VerticalAlignment="Center" ItemsSource="{x:Bind ViewModel.Dots, Mode=OneWay}" AutomationProperties.AccessibilityView="Raw">
                <ItemsRepeater.Layout>
                    <StackLayout Orientation="Horizontal" Spacing="8" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="vm:OnboardingDot">
                        <Ellipse Width="7" Height="7" Fill="{x:Bind local:OnboardingWindow.DotFill(IsCurrent)}" />
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
            <StackPanel Grid.Column="2" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                <Button
                    Style="{StaticResource MuesliSecondaryButtonStyle}"
                    Content="Skip"
                    Command="{x:Bind ViewModel.SkipCommand}"
                    Visibility="{x:Bind ViewModel.ShowSkip, Mode=OneWay}"
                    AutomationProperties.AutomationId="OnboardingSkip" />
                <Button
                    x:Name="PrimaryButton"
                    MinWidth="110"
                    Style="{StaticResource MuesliPrimaryButtonStyle}"
                    Content="{x:Bind ViewModel.PrimaryLabel, Mode=OneWay}"
                    IsEnabled="{x:Bind ViewModel.PrimaryEnabled, Mode=OneWay}"
                    Click="Primary_Click"
                    AutomationProperties.AutomationId="OnboardingPrimary" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>

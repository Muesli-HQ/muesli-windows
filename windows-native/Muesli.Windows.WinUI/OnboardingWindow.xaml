<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Muesli.Windows.WinUI.OnboardingWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Muesli.Windows.WinUI"
    Title="Welcome to muesli">
    <!-- macOS onboarding is always dark (NSAppearance darkAqua) on backgroundBase. -->
    <Grid
        x:Name="RootGrid"
        RequestedTheme="Dark"
        Background="{ThemeResource MuesliBackgroundBrush}"
        XYFocusKeyboardNavigation="Enabled"
        SizeChanged="RootGrid_SizeChanged">
        <Grid.Resources>
            <local:OnboardingBoolVisConverter x:Key="BoolVis" />
            <local:OnboardingBoolVisConverter x:Key="InvertBoolVis" Invert="True" />
            <!-- macOS permission / test action: 14 semibold, padding 24×12, accent fill, radius 6. -->
            <Style x:Key="OnboardingHeroButtonStyle" TargetType="Button" BasedOn="{StaticResource MuesliPrimaryButtonStyle}">
                <Setter Property="Padding" Value="24,12" />
                <Setter Property="MinHeight" Value="0" />
            </Style>
            <!-- A Ready checklist row: the whole row opens its step. -->
            <Style x:Key="OnboardingChecklistRowStyle" TargetType="Button" BasedOn="{StaticResource MuesliGhostButtonStyle}">
                <Setter Property="Padding" Value="8,0" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Foreground" Value="{ThemeResource MuesliTextPrimaryBrush}" />
            </Style>
            <!-- A model radio card's chrome: the card is the whole button. -->
            <Style x:Key="OnboardingModelCardButtonStyle" TargetType="Button" BasedOn="{StaticResource MuesliGhostButtonStyle}">
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Foreground" Value="{ThemeResource MuesliTextPrimaryBrush}" />
            </Style>
            <!--
                macOS onboarding model card: padding 12, backgroundRaised, radius 10, 1pt border
                (1.5pt accent when selected), a 16-pt radio, headline name with a "Recommended"
                badge (9 semibold on the accent, radius 3), caption size and description.
            -->
            <DataTemplate x:Key="OnboardingModelChoiceTemplate">
                <Button Style="{StaticResource OnboardingModelCardButtonStyle}"
                        Tag="{Binding}"
                        Click="ModelChoice_Click"
                        AutomationProperties.Name="{Binding AccessibleName}">
                    <Grid>
                        <Border Background="{ThemeResource MuesliBackgroundRaisedBrush}" BorderBrush="{ThemeResource MuesliBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12">
                            <Grid ColumnDefinitions="16,*" ColumnSpacing="12">
                                <Grid Width="16" Height="16" VerticalAlignment="Top" Margin="0,2,0,0">
                                    <Ellipse Stroke="{ThemeResource MuesliTextTertiaryBrush}" StrokeThickness="1.5" Visibility="{Binding IsSelected, Converter={StaticResource InvertBoolVis}}" />
                                    <Ellipse Fill="{ThemeResource MuesliAccentBrush}" Visibility="{Binding IsSelected, Converter={StaticResource BoolVis}}" />
                                    <Ellipse Width="6" Height="6" Fill="{ThemeResource MuesliOnAccentBrush}" Visibility="{Binding IsSelected, Converter={StaticResource BoolVis}}" />
                                </Grid>
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource MuesliHeadlineStyle}" />
                                        <Border Background="{ThemeResource MuesliAccentBrush}" CornerRadius="3" Padding="5,1" VerticalAlignment="Center" Visibility="{Binding IsRecommended, Converter={StaticResource BoolVis}}">
                                            <TextBlock Text="Recommended" FontFamily="{StaticResource MuesliFontFamilySemiBold}" FontSize="9" FontWeight="SemiBold" Foreground="{ThemeResource MuesliOnAccentBrush}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding SizeLabel}" Style="{StaticResource MuesliCaptionStyle}" Foreground="{ThemeResource MuesliTextTertiaryBrush}" />
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource MuesliCaptionStyle}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border BorderBrush="{ThemeResource MuesliAccentBrush}" BorderThickness="1.5" CornerRadius="10" IsHitTestVisible="False" Visibility="{Binding IsSelected, Converter={StaticResource BoolVis}}" />
                    </Grid>
                </Button>
            </DataTemplate>
        </Grid.Resources>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="RailColumn" Width="236" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <!--
                P8-03: the caption strip is a real row, not an overlay, so nothing in the setup
                content can slide under the OS caption buttons. ExtendsContentIntoTitleBar is set in
                the constructor and AppTitleBar is registered as the drag region, which is what makes
                this window's chrome match the dashboard instead of showing the DWM system-accent
                title bar (measured #459BAC) with a second app icon and title.
            -->
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="AppTitleBar"
            Grid.ColumnSpan="2"
            Height="{StaticResource MuesliTitleBarHeight}"
            Background="Transparent"
            IsHitTestVisible="True"
            AutomationProperties.Name="Muesli setup window title bar">
            <!-- macOS hides the setup window title; the strip only carries the caption buttons. -->
        </Grid>

        <Border
            x:Name="StepRail"
            Grid.Row="1"
            Grid.RowSpan="2"
            Background="{ThemeResource MuesliSurfaceRaisedBrush}"
            BorderBrush="{ThemeResource MuesliBorderSoftBrush}"
            BorderThickness="0,0,1,0"
            Padding="16,22,16,20"
            AutomationProperties.Name="Setup steps">
            <Grid RowDefinitions="Auto,*">
                <StackPanel Spacing="6" Margin="4,0,4,18">
                    <TextBlock Text="MUESLI" Style="{StaticResource MuesliSectionLabelStyle}" Foreground="{ThemeResource MuesliAccentBrush}" />
                    <TextBlock Text="Private local setup" FontSize="18" FontWeight="SemiBold" Foreground="{ThemeResource MuesliTextPrimaryBrush}" TextWrapping="Wrap" />
                    <TextBlock Text="Pause anytime. Progress is saved on this PC." Style="{StaticResource MuesliBodyStyle}" FontSize="12" />
                </StackPanel>
                <ItemsRepeater Grid.Row="1" ItemsSource="{x:Bind ViewModel.StepNavItems, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="4" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate>
                            <Grid MinHeight="38" Margin="0,0,0,2" AutomationProperties.Name="{Binding Title}">
                                <Border
                                    CornerRadius="8"
                                    Background="{ThemeResource MuesliSelectedBrush}"
                                    Visibility="{Binding IsCurrent, Converter={StaticResource BoolVis}}" />
                                <Grid ColumnDefinitions="28,*" ColumnSpacing="8" Padding="10,7">
                                    <Border
                                        Width="22"
                                        Height="22"
                                        CornerRadius="11"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Background="{ThemeResource MuesliAccentMutedBrush}">
                                        <Grid>
                                            <FontIcon
                                                Glyph="&#xE73E;"
                                                FontSize="11"
                                                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                                Foreground="{ThemeResource MuesliSuccessBrush}"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding IsComplete, Converter={StaticResource BoolVis}}" />
                                            <TextBlock
                                                Text="{Binding Number}"
                                                FontSize="11"
                                                FontWeight="SemiBold"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Foreground="{ThemeResource MuesliAccentBrush}"
                                                Visibility="{Binding ShowCurrentNumber, Converter={StaticResource BoolVis}}" />
                                            <TextBlock
                                                Text="{Binding Number}"
                                                FontSize="11"
                                                FontWeight="SemiBold"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Foreground="{ThemeResource MuesliTextTertiaryBrush}"
                                                Visibility="{Binding ShowUpcomingNumber, Converter={StaticResource BoolVis}}" />
                                        </Grid>
                                    </Border>
                                    <TextBlock
                                        Grid.Column="1"
                                        Text="{Binding Title}"
                                        VerticalAlignment="Center"
                                        TextWrapping="Wrap"
                                        FontSize="13"
                                        Foreground="{ThemeResource MuesliTextPrimaryBrush}" />
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </Grid>
        </Border>
        <Border x:Name="RailSplitter" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Left" Width="1" Background="{ThemeResource MuesliBorderSoftBrush}" Grid.RowSpan="2" />

        <!--
            P8-02: the permissions step is taller than any window this display's work area can hold,
            so its last row is always cut by the footer bar. The ScrollViewer was already here; what
            was missing is any *cue* that it scrolls — a WinUI ScrollBar stays in its NoIndicator
            visual state until the pointer enters the region, and ScrollBarVisibility="Visible" does
            not change that. MoreBelowButton is an explicit, focusable, screen-reader-visible
            affordance shown only while content really does continue past the fold.
        -->
        <Grid Grid.Row="1" Grid.Column="1">
        <ScrollViewer
            x:Name="ContentScroller"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled"
            ViewChanged="ContentScroller_ViewChanged"
            SizeChanged="ContentScroller_SizeChanged"
            TabNavigation="Cycle">
            <StackPanel x:Name="ContentColumn" Padding="{StaticResource MuesliPageContentPadding}" Spacing="16">
                <!--
                    P8-04: "SETUP · n OF 7" used to be printed twice on the same line — once as this
                    eyebrow and once as an accent badge in a second column. The eyebrow is the one
                    that carries the automation id and the polite live region, so the badge went.
                -->
                <!--
                    macOS step header: centred title1 over a 14pt secondary line; Welcome leads with
                    the 64-pt app icon. There is no eyebrow or progress bar: the dots in the bottom
                    bar carry progress. The step label stays as an off-screen live region so screen
                    readers still hear "step n of m".
                -->
                <StackPanel Spacing="8" MinWidth="0" HorizontalAlignment="Center" MaxWidth="480" Margin="0,8,0,8">
                    <Image Source="ms-appx:///Assets/Square44x44Logo.targetsize-256_altform-unplated.png"
                           Width="64" Height="64"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,8"
                           Visibility="{x:Bind local:OnboardingWindow.ToVisibility(ViewModel.ShowName), Mode=OneWay}"
                           AutomationProperties.AccessibilityView="Raw" />
                    <TextBlock Text="{x:Bind ViewModel.StepLabel, Mode=OneWay}" Height="0" Opacity="0" IsHitTestVisible="False" AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="OnboardingStepBadge" />
                    <TextBlock x:Name="TitleText" Text="{x:Bind ViewModel.Title, Mode=OneWay}" Style="{StaticResource MuesliPageTitleStyle}" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" />
                    <TextBlock Text="{x:Bind ViewModel.Description, Mode=OneWay}" Style="{StaticResource MuesliPageSubtitleStyle}" TextAlignment="Center" HorizontalAlignment="Center" />
                </StackPanel>

                <!-- Welcome: macOS "Your name" label over a 280-wide field, centred. -->
                <StackPanel Spacing="8" Width="280" HorizontalAlignment="Center" Visibility="{x:Bind local:OnboardingWindow.ToVisibility(ViewModel.ShowName), Mode=OneWay}">
                    <TextBlock Text="Your name" Style="{StaticResource MuesliCaptionStyle}" Foreground="{ThemeResource MuesliTextTertiaryBrush}" />
                    <TextBox
                        PlaceholderText="Enter your name"
                        Text="{x:Bind ViewModel.UserName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        HorizontalAlignment="Stretch"
                        AutomationProperties.AutomationId="OnboardingUserName"
                        AutomationProperties.Name="Your name" />
                </StackPanel>

                <!--
                    macOS "What will you use muesli for?": 132 x 74 cards, radius 6. Selected cards fill
                    with the accent and show a check; Dictation and Meetings toggle, Everything picks both.
                -->
                <StackPanel Spacing="8" HorizontalAlignment="Center" Visibility="{x:Bind local:OnboardingWindow.ToVisibility(ViewModel.ShowName), Mode=OneWay}">
                    <TextBlock Text="What will you use muesli for?" Style="{StaticResource MuesliCaptionStyle}" Foreground="{ThemeResource MuesliTextTertiaryBrush}" HorizontalAlignment="Center" />
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.UseCaseCards}" AutomationProperties.Name="What will you use muesli for?">
                        <ItemsRepeater.Layout>
                            <StackLayout Orientation="Horizontal" Spacing="8" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource OnboardingModelCardButtonStyle}"
                                        CornerRadius="6"
                                        Width="132"
                                        Height="74"
                                        Tag="{Binding Id}"
                                        Click="UseCase_Click"
                                        AutomationProperties.Name="{Binding Title}">
                                    <Grid>
                                        <Border Background="{ThemeResource MuesliBackgroundRaisedBrush}" BorderBrush="{ThemeResource MuesliBorderBrush}" BorderThickness="1" CornerRadius="6" Visibility="{Binding IsSelected, Converter={StaticResource InvertBoolVis}}">
                                            <StackPanel Spacing="3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <FontIcon Glyph="{Binding Glyph}" FontSize="20" Foreground="{ThemeResource MuesliTextSecondaryBrush}" />
                                                <TextBlock Text="{Binding Title}" FontFamily="{StaticResource MuesliFontFamilySemiBold}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource MuesliTextSecondaryBrush}" HorizontalAlignment="Center" />
                                                <TextBlock Text="{Binding Subtitle}" FontSize="10" Foreground="{ThemeResource MuesliTextTertiaryBrush}" HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                        <Border Background="{ThemeResource MuesliAccentBrush}" CornerRadius="6" Visibility="{Binding IsSelected, Converter={StaticResource BoolVis}}">
                                            <Grid>
                                                <FontIcon Glyph="&#xEC61;" FontSize="14" Foreground="{ThemeResource MuesliOnAccentBrush}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="7" />
                                                <StackPanel Spacing="3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <FontIcon Glyph="{Binding Glyph}" FontSize="20" Foreground="{ThemeResource MuesliOnAccentBrush}" />
                                                    <TextBlock Text="{Binding Title}" FontFamily="{StaticResource MuesliFontFamilySemiBold}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource MuesliOnAccentBrush}" HorizontalAlignment="Center" />
                                                    <TextBlock Text="{Binding Subtitle}" FontSize="10" Foreground="{ThemeResource MuesliOnAccentBrush}" HorizontalAlignment="Center" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>

                <!--
                    Microphone: the macOS one-permission screen. A large icon (accent, success once
                    granted), the big accent action that turns into a green "Granted" pill, the device
                    picker, and a quiet link to Windows settings.
                -->
                <StackPanel Spacing="20" HorizontalAlignment="Center" MaxWidth="440" Visibility="{x:Bind local:OnboardingWindow.ToVisibility(ViewModel.ShowMicrophone), Mode=OneWay}">
                    <Grid Height="64" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE720;" FontSize="48" Foreground="{ThemeResource MuesliAccentBrush}" Visibility="{x:Bind local:OnboardingWindow.ToInvertedVisibility(ViewModel.MicrophoneReady), Mode=OneWay}" />
                        <FontIcon Glyph="&#xE720;" FontSize="48" Foreground="{ThemeResource MuesliSuccessBrush}" Visibility="{x:Bind local:OnboardingWindow.ToVisibility(ViewModel.MicrophoneReady), Mode=OneWay}" />
                    </Grid>
                    <Button
                        Style="{StaticResource OnboardingHeroButtonStyle}"
                        HorizontalAlignment="Center"
                        Command="{x:Bind ViewModel.TestMicrophoneCommand}"
                        Content="Test Microphone"
                        Visibility="{x:Bind local:OnboardingWindow.ToInvertedVisibility(ViewModel.MicrophoneReady), Mode=OneWay}"
                        AutomationProperties.AutomationId="OnboardingTestMicrophone"
                        AutomationProperties.Name="Test microphone" />
                    <Border
                        HorizontalAlignment="Center"
                        Background="{ThemeResource MuesliSuccessBrush}"
                        CornerRadius="6"
                        Padding="24,12"
                        Visibility="{x:Bind local:OnboardingWindow.ToVisibility(ViewModel.MicrophoneReady), Mode=OneWay}"
                        AutomationProperties.Name="Microphone granted">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE73E;" FontSize="12" Foreground="#FF000000" />
                            <TextBlock Text="Granted" FontFamily="{StaticResource MuesliFontFamilySemiBold}" FontSize="14" FontWeight="SemiBold" Foreground="#FF000000" />
                        </StackPanel>
                    </Border>
                    <StackPanel Spacing="8" Width="280" HorizontalAlignment="Center">
                        <TextBlock Text="Microphone" Style="{StaticResource MuesliCaptionStyle}" Foreground="{ThemeResource MuesliTextTertiaryBrush}" />
                        <ComboBox
                            ItemsSource="{x:Bind ViewModel.Microphones, Mode=OneWay}"
                            SelectedItem="{x:Bind ViewModel.SelectedMicrophone, Mode=TwoWay}"
                            HorizontalAlignment="Stretch"
                            AutomationProperties.AutomationId="OnboardingMicrophone"
                            AutomationProperties.Name="Microphone" />
                    </StackPanel>
                    <TextBlock
                        Text="You can change this later in Settings. Dictation and meetings stay unavailable until Windows lets muesli hear you."
                        Style="{StaticResource MuesliCaptionStyle}"
                        TextAlignment="Center"
                        HorizontalAlignment="Center" />
                    <HyperlinkButton
                        HorizontalAlignment="Center"
                        Padding="0"
                        FontSize="11"
                        Foreground="{ThemeResource MuesliAccentTextBrush}"
                        Command="{x:Bind ViewModel.OpenMicrophonePrivacyCommand}"
                        Content="Not working? Open Windows microphone settings"
                        AutomationProperties.AutomationId="OnboardingOpenMicrophonePrivacy"
                        AutomationProperties.Name="Open Windows microphone privacy settings" />
                </StackPanel>

                <!--
                    Model: macOS radio cards. The recommended model first, the rest behind "Other
                    models". The choice sets both dictation and meetings; the primary button reads
                    "Download &amp; Continue" and the download carries on through the next steps.
                -->
                <StackPanel Spacing="8" MaxWidth="520" HorizontalAlignment="Stretch" Visibility="{x:Bind local:OnboardingWindow.ToVisibility(ViewModel.ShowModels), Mode=OneWay}">
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.RecommendedModelChoices}" ItemTemplate="{StaticResource OnboardingModelChoiceTemplate}" AutomationProperties.Name="Recommended model" />
                    <Button
                        Style="{StaticResource MuesliGhostButtonStyle}"
                        HorizontalAlignment="Left"
                        Padding="8,4"
                        MinHeight="28"
                        Margin="0,4,0,0"
                        Command="{x:Bind ViewModel.ToggleOtherModelsCommand}"
                        AutomationProperties.AutomationId="OnboardingOtherModels"
                        AutomationProperties.Name="Other models">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Other models" Style="{StaticResource MuesliCaptionStyle}" Foreground="{ThemeResource MuesliTextTertiaryBrush}" />
                            <FontIcon Glyph="{x:Bind ViewModel.OtherModelsGlyph, Mode=OneWay}" FontSize="9" Foreground="{ThemeResource MuesliTextTertiaryBrush}" />
                        </StackPanel>
                    </Button>
                    <StackPanel Spacing="8" Visibility="{x:Bind local:OnboardingWindow.ToVisibility(ViewModel.ShowOtherModels), Mode=OneWay}">
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.OtherModelChoices}" ItemTemplate="{StaticResource OnboardingModelChoiceTemplate}" AutomationProperties.Name="Other models">
                            <ItemsRepeater.Layout>
                                <StackLayout Spacing="8" />
                            </ItemsRepeater.Layout>
                        </ItemsRepeater>
                        <TextBlock Text="More models are available after setup, on the Models page." Style="{StaticResource MuesliMetadataStyle}" />
                    </StackPanel>
                    <!-- The chosen model's download state, while it downloads or if it needs a retry. -->
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.ModelRoles, Mode=OneWay}" Margin="0,8,0,0" AutomationProperties.Name="Selected model download">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="8" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Spacing="6" AutomationProperties.Name="{Binding AccessibleName}">
                                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource MuesliCaptionStyle}" AutomationProperties.LiveSetting="Polite" />
                                    <ProgressBar
                                        Value="{Binding ProgressValue}"
                                        Maximum="100"
                                        IsIndeterminate="{Binding IsProgressIndeterminate}"
                                        Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}"
                                        AutomationProperties.Name="{Binding ProgressLabel}" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button
                                            Content="Retry"
                                            Style="{StaticResource MuesliTintedButtonStyle}"
                                            Padding="12,4"
                                            MinHeight="0"
                                            FontSize="12"
                                            Click="RetryModel_Click"
                                            Visibility="{Binding CanRetry, Converter={StaticResource BoolVis}}"
                                            AutomationProperties.Name="Retry model download"
                                            AutomationProperties.AutomationId="OnboardingRetryModel" />
                                        <Button
                                            Content="Pause"
                                            Style="{StaticResource MuesliGhostButtonStyle}"
                                            Padding="12,4"
                                            MinHeight="0"
                                            FontSize="12"
                                            Click="CancelModel_Click"
                                            Visibility="{Binding CanCancel, Converter={StaticResource BoolVis}}"
                                            AutomationProperties.Name="Pause model download"
                                            AutomationProperties.AutomationId="OnboardingCancelModel" />
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>

                <!--
                    Shortcut: the macOS key cap (24 semibold in a raised 10-radius frame), a "Change
                    Shortcut" control that listens for the next key, and the supported keys. The
                    recorded key is checked at once.
                -->
                <StackPanel Spacing="20" HorizontalAlignment="Center" Visibility="{x:Bind local:OnboardingWindow.ToVisibility(ViewModel.ShowHotkey), Mode=OneWay}">
                    <Border
                        x:Name="ShortcutKeyCap"
                        HorizontalAlignment="Center"
                        Background="{ThemeResource MuesliBackgroundRaisedBrush}"
                        BorderBrush="{ThemeResource MuesliBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="32,16"
                        AutomationProperties.Name="Current dictation shortcut">
                        <TextBlock Text="{x:Bind ViewModel.SelectedHotkey, Mode=OneWay}" FontFamily="{StaticResource MuesliFontFamilySemiBold}" FontSize="24" FontWeight="SemiBold" Foreground="{ThemeResource MuesliTextPrimaryBrush}" />
                    </Border>
                    <Button
                        x:Name="ChangeShortcutButton"
                        HorizontalAlignment="Center"
                        Style="{StaticResource MuesliSecondaryButtonStyle}"
                        Padding="16,8"
                        Command="{x:Bind ViewModel.ToggleHotkeyRecordingCommand}"
                        Content="{x:Bind ViewModel.ChangeShortcutLabel, Mode=OneWay}"
                        AutomationProperties.AutomationId="OnboardingHotkey"
                        AutomationProperties.Name="{x:Bind ViewModel.ChangeShortcutLabel, Mode=OneWay}" />
                    <TextBlock Text="{x:Bind ViewModel.SupportedHotkeysLabel}" Style="{StaticResource MuesliCaptionStyle}" Foreground="{ThemeResource MuesliTextTertiaryBrush}" TextAlignment="Center" HorizontalAlignment="Center" MaxWidth="420" />
                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" Visibility="{x:Bind local:OnboardingWindow.ToVisibility(ViewModel.HotkeyReady), Mode=OneWay}">
                        <FontIcon Glyph="&#xEC61;" FontSize="14" Foreground="{ThemeResource MuesliSuccessBrush}" />
                        <TextBlock Text="Shortcut ready" Foreground="{ThemeResource MuesliSuccessTextBrush}" />
                    </StackPanel>
                    <HyperlinkButton
                        HorizontalAlignment="Center"
                        Padding="0"
                        FontSize="11"
                        Foreground="{ThemeResource MuesliAccentTextBrush}"
                        Command="{x:Bind ViewModel.CheckHotkeyCommand}"
                        Content="Check this shortcut"
                        Visibility="{x:Bind local:OnboardingWindow.ToInvertedVisibility(ViewModel.HotkeyReady), Mode=OneWay}"
                        AutomationProperties.AutomationId="OnboardingCheckHotkey"
                        AutomationProperties.Name="Check shortcut" />
                </StackPanel>

                <!--
                    Test: the macOS dictation test, run with the real shortcut. A hint, a result box
                    (max 400, raised, radius 10; green border once a result arrives), the
                    hold/listening prompt, and the success line.
                -->
                <StackPanel Spacing="16" HorizontalAlignment="Center" Width="400" Visibility="{x:Bind local:OnboardingWindow.ToVisibility(ViewModel.ShowPipeline), Mode=OneWay}">
                    <TextBlock Text="Try saying: “testing this one out”" FontFamily="{StaticResource MuesliFontFamilyMedium}" FontSize="13" FontWeight="Medium" Foreground="{ThemeResource MuesliAccentTextBrush}" HorizontalAlignment="Center" />
                    <Grid MinHeight="60" AutomationProperties.AutomationId="OnboardingTestResult" AutomationProperties.Name="Dictation test result">
                        <Border Background="{ThemeResource MuesliBackgroundRaisedBrush}" BorderBrush="{ThemeResource MuesliBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16">
                            <Grid>
                                <TextBlock Text="Your transcription will appear here…" FontFamily="{StaticResource MuesliFontFamilyItalic}" FontSize="13" FontStyle="Italic" Foreground="{ThemeResource MuesliTextTertiaryBrush}" Visibility="{x:Bind local:OnboardingWindow.ToInvertedVisibility(ViewModel.HasPipelineTranscript), Mode=OneWay}" />
                                <TextBlock Text="{x:Bind ViewModel.PipelineTranscript, Mode=OneWay}" FontFamily="{StaticResource MuesliMonoFontFamily}" FontSize="14" Foreground="{ThemeResource MuesliTextPrimaryBrush}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                            </Grid>
                        </Border>
                        <Border BorderBrush="{ThemeResource MuesliSuccessBrush}" BorderThickness="1" CornerRadius="10" Opacity="0.5" IsHitTestVisible="False" Visibility="{x:Bind local:OnboardingWindow.ToVisibility(ViewModel.HasPipelineTranscript), Mode=OneWay}" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" AutomationProperties.AutomationId="OnboardingPipelineTest">
                        <ProgressRing
                            Width="16"
                            Height="16"
                            IsActive="{x:Bind ViewModel.IsPipelineRunning, Mode=OneWay}"
                            Visibility="{x:Bind local:OnboardingWindow.ToVisibility(ViewModel.IsPipelineRunning), Mode=OneWay}" />
                        <FontIcon Glyph="&#xE765;" FontSize="14" Foreground="{ThemeResource MuesliTextTertiaryBrush}" Visibility="{x:Bind local:OnboardingWindow.ToInvertedVisibility(ViewModel.IsPipelineRunning), Mode=OneWay}" />
                        <TextBlock Text="{x:Bind ViewModel.PipelineHint, Mode=OneWay}" Foreground="{ThemeResource MuesliTextTertiaryBrush}" AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" Visibility="{x:Bind local:OnboardingWindow.ToVisibility(ViewModel.PipelineReady), Mode=OneWay}">
                        <FontIcon Glyph="&#xEC61;" FontSize="14" Foreground="{ThemeResource MuesliSuccessBrush}" />
                        <TextBlock Text="Dictation is working!" Foreground="{ThemeResource MuesliSuccessTextBrush}" />
                    </StackPanel>
                    <TextBlock Text="{x:Bind ViewModel.PipelineMicrophoneLabel, Mode=OneWay}" Style="{StaticResource MuesliMetadataStyle}" HorizontalAlignment="Center" TextAlignment="Center" AutomationProperties.Name="Microphone used by the dictation test" />
                </StackPanel>

                <!--
                    Meeting summaries: the provider choice and where transcripts go, centred, then the
                    two Windows-only choices that need setup (launch at login, floating indicator).
                -->
                <StackPanel Spacing="16" HorizontalAlignment="Center" Width="420" Visibility="{x:Bind local:OnboardingWindow.ToVisibility(ViewModel.ShowOptional), Mode=OneWay}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Summary provider" Style="{StaticResource MuesliCaptionStyle}" Foreground="{ThemeResource MuesliTextTertiaryBrush}" />
                        <ComboBox
                            ItemsSource="{x:Bind ViewModel.SummaryProviders, Mode=OneWay}"
                            SelectedItem="{x:Bind ViewModel.SelectedSummaryProvider, Mode=TwoWay}"
                            DisplayMemberPath="DisplayName"
                            HorizontalAlignment="Stretch"
                            AutomationProperties.AutomationId="OnboardingSummaryProvider"
                            AutomationProperties.Name="Meeting summary provider" />
                        <TextBlock Text="{x:Bind ViewModel.SummaryDisclosure, Mode=OneWay}" Style="{StaticResource MuesliCaptionStyle}" AutomationProperties.Name="Summary provider transcript disclosure" />
                        <TextBlock Text="{x:Bind ViewModel.CloudKeyStatus, Mode=OneWay}" Style="{StaticResource MuesliMetadataStyle}" TextWrapping="Wrap" AutomationProperties.Name="Cloud provider key configuration status" />
                        <HyperlinkButton
                            Padding="0"
                            FontSize="11"
                            Foreground="{ThemeResource MuesliAccentTextBrush}"
                            Command="{x:Bind ViewModel.OpenSummaryProviderSettingsCommand}"
                            Content="Add an API key in Settings"
                            AutomationProperties.AutomationId="OnboardingOpenSummarySettings"
                            AutomationProperties.Name="Configure summary provider in Settings" />
                    </StackPanel>
                    <InfoBar
                        IsOpen="{x:Bind ViewModel.ShowStartupNotice, Mode=OneWay}"
                        Severity="Warning"
                        Title="Startup unavailable"
                        Message="{x:Bind ViewModel.StartupAvailabilityNotice, Mode=OneWay}"
                        IsClosable="False"
                        AutomationProperties.AutomationId="OnboardingStartupNotice" />
                    <Border Style="{StaticResource MuesliCardStyle}" Padding="16,8">
                        <StackPanel>
                            <Grid ColumnDefinitions="*,Auto" MinHeight="40">
                                <TextBlock Text="Launch at login" VerticalAlignment="Center" />
                                <ToggleSwitch
                                    Grid.Column="1"
                                    IsOn="{x:Bind ViewModel.StartAtLogin, Mode=TwoWay}"
                                    IsEnabled="{x:Bind ViewModel.IsStartupAvailable, Mode=OneWay}"
                                    OffContent=""
                                    OnContent=""
                                    MinWidth="40"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="Launch at login" />
                            </Grid>
                            <Border Height="1" Background="{ThemeResource MuesliBorderSoftBrush}" />
                            <Grid ColumnDefinitions="*,Auto" MinHeight="40">
                                <TextBlock Text="Show the floating indicator" VerticalAlignment="Center" />
                                <ToggleSwitch
                                    Grid.Column="1"
                                    IsOn="{x:Bind ViewModel.ShowIndicator, Mode=TwoWay}"
                                    OffContent=""
                                    OnContent=""
                                    MinWidth="40"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="Show floating indicator" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Ready: what is set up, as a centred checklist. -->
                <Border Style="{StaticResource MuesliCardStyle}" Width="400" HorizontalAlignment="Center" Padding="8,4" Visibility="{x:Bind local:OnboardingWindow.ToVisibility(ViewModel.ShowReady), Mode=OneWay}">
                    <StackPanel>
                        <Button Style="{StaticResource OnboardingChecklistRowStyle}" Command="{x:Bind ViewModel.GoToStepCommand}" CommandParameter="3" AutomationProperties.AutomationId="OnboardingReadyMicrophone" AutomationProperties.Name="Microphone, go to step">
                            <Grid ColumnDefinitions="24,*,Auto" MinHeight="44">
                                <FontIcon Glyph="{x:Bind local:OnboardingWindow.CheckGlyph(ViewModel.MicrophoneReady), Mode=OneWay}" FontSize="14" Foreground="{x:Bind local:OnboardingWindow.CheckBrush(ViewModel.MicrophoneReady), Mode=OneWay}" HorizontalAlignment="Left" />
                                <TextBlock Grid.Column="1" Text="Microphone" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="Ready" Style="{StaticResource MuesliCaptionStyle}" VerticalAlignment="Center" Visibility="{x:Bind local:OnboardingWindow.ToVisibility(ViewModel.MicrophoneReady), Mode=OneWay}" />
                                <TextBlock Grid.Column="2" Text="{x:Bind local:OnboardingWindow.ActionText(ViewModel.MicrophoneGateLabel), Mode=OneWay}" Foreground="{ThemeResource MuesliAccentTextBrush}" Style="{StaticResource MuesliCaptionMediumStyle}" VerticalAlignment="Center" Visibility="{x:Bind local:OnboardingWindow.ToInvertedVisibility(ViewModel.MicrophoneReady), Mode=OneWay}" />
                            </Grid>
                        </Button>
                        <Border Height="1" Margin="8,0" Background="{ThemeResource MuesliBorderSoftBrush}" />
                        <Button Style="{StaticResource OnboardingChecklistRowStyle}" Command="{x:Bind ViewModel.GoToStepCommand}" CommandParameter="1" AutomationProperties.AutomationId="OnboardingReadyModel" AutomationProperties.Name="Transcription model, go to step">
                            <Grid ColumnDefinitions="24,*,Auto" MinHeight="44">
                                <FontIcon Glyph="{x:Bind local:OnboardingWindow.CheckGlyph(ViewModel.ModelsReady), Mode=OneWay}" FontSize="14" Foreground="{x:Bind local:OnboardingWindow.CheckBrush(ViewModel.ModelsReady), Mode=OneWay}" HorizontalAlignment="Left" />
                                <TextBlock Grid.Column="1" Text="Transcription model" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="Ready" Style="{StaticResource MuesliCaptionStyle}" VerticalAlignment="Center" Visibility="{x:Bind local:OnboardingWindow.ToVisibility(ViewModel.ModelsReady), Mode=OneWay}" />
                                <TextBlock Grid.Column="2" Text="{x:Bind local:OnboardingWindow.ActionText(ViewModel.ModelsGateLabel), Mode=OneWay}" Foreground="{ThemeResource MuesliAccentTextBrush}" Style="{StaticResource MuesliCaptionMediumStyle}" VerticalAlignment="Center" Visibility="{x:Bind local:OnboardingWindow.ToInvertedVisibility(ViewModel.ModelsReady), Mode=OneWay}" />
                            </Grid>
                        </Button>
                        <Border Height="1" Margin="8,0" Visibility="{x:Bind local:OnboardingWindow.ToVisibility(ViewModel.UsesDictation), Mode=OneWay}" Background="{ThemeResource MuesliBorderSoftBrush}" />
                        <Button Style="{StaticResource OnboardingChecklistRowStyle}" Visibility="{x:Bind local:OnboardingWindow.ToVisibility(ViewModel.UsesDictation), Mode=OneWay}" Command="{x:Bind ViewModel.GoToStepCommand}" CommandParameter="2" AutomationProperties.AutomationId="OnboardingReadyShortcut" AutomationProperties.Name="Dictation shortcut, go to step">
                            <Grid ColumnDefinitions="24,*,Auto" MinHeight="44">
                                <FontIcon Glyph="{x:Bind local:OnboardingWindow.CheckGlyph(ViewModel.HotkeyReady), Mode=OneWay}" FontSize="14" Foreground="{x:Bind local:OnboardingWindow.CheckBrush(ViewModel.HotkeyReady), Mode=OneWay}" HorizontalAlignment="Left" />
                                <TextBlock Grid.Column="1" Text="Dictation shortcut" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="Ready" Style="{StaticResource MuesliCaptionStyle}" VerticalAlignment="Center" Visibility="{x:Bind local:OnboardingWindow.ToVisibility(ViewModel.HotkeyReady), Mode=OneWay}" />
                                <TextBlock Grid.Column="2" Text="{x:Bind local:OnboardingWindow.ActionText(ViewModel.HotkeyGateLabel), Mode=OneWay}" Foreground="{ThemeResource MuesliAccentTextBrush}" Style="{StaticResource MuesliCaptionMediumStyle}" VerticalAlignment="Center" Visibility="{x:Bind local:OnboardingWindow.ToInvertedVisibility(ViewModel.HotkeyReady), Mode=OneWay}" />
                            </Grid>
                        </Button>
                        <Border Height="1" Margin="8,0" Visibility="{x:Bind local:OnboardingWindow.ToVisibility(ViewModel.UsesDictation), Mode=OneWay}" Background="{ThemeResource MuesliBorderSoftBrush}" />
                        <Button Style="{StaticResource OnboardingChecklistRowStyle}" Visibility="{x:Bind local:OnboardingWindow.ToVisibility(ViewModel.UsesDictation), Mode=OneWay}" Command="{x:Bind ViewModel.GoToStepCommand}" CommandParameter="4" AutomationProperties.AutomationId="OnboardingReadyTest" AutomationProperties.Name="Dictation test, go to step">
                            <Grid ColumnDefinitions="24,*,Auto" MinHeight="44">
                                <FontIcon Glyph="{x:Bind local:OnboardingWindow.CheckGlyph(ViewModel.PipelineReady), Mode=OneWay}" FontSize="14" Foreground="{x:Bind local:OnboardingWindow.CheckBrush(ViewModel.PipelineReady), Mode=OneWay}" HorizontalAlignment="Left" />
                                <TextBlock Grid.Column="1" Text="Dictation test" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="Ready" Style="{StaticResource MuesliCaptionStyle}" VerticalAlignment="Center" Visibility="{x:Bind local:OnboardingWindow.ToVisibility(ViewModel.PipelineReady), Mode=OneWay}" />
                                <TextBlock Grid.Column="2" Text="{x:Bind local:OnboardingWindow.ActionText(ViewModel.PipelineGateLabel), Mode=OneWay}" Foreground="{ThemeResource MuesliAccentTextBrush}" Style="{StaticResource MuesliCaptionMediumStyle}" VerticalAlignment="Center" Visibility="{x:Bind local:OnboardingWindow.ToInvertedVisibility(ViewModel.PipelineReady), Mode=OneWay}" />
                            </Grid>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Status: one centred line, red for problems (macOS shows inline text, not a banner). -->
                <TextBlock
                    x:Name="StatusBar"
                    Text="{x:Bind ViewModel.Status, Mode=OneWay}"
                    Style="{StaticResource MuesliCaptionStyle}"
                    TextAlignment="Center"
                    HorizontalAlignment="Center"
                    MaxWidth="440"
                    Visibility="{x:Bind local:OnboardingWindow.ToVisibility(ViewModel.ShowStatusInfo), Mode=OneWay}"
                    AutomationProperties.LiveSetting="Polite"
                    AutomationProperties.AutomationId="OnboardingStatus" />
                <TextBlock
                    Text="{x:Bind ViewModel.Status, Mode=OneWay}"
                    Style="{StaticResource MuesliCaptionMediumStyle}"
                    Foreground="{ThemeResource MuesliDestructiveTextBrush}"
                    TextAlignment="Center"
                    HorizontalAlignment="Center"
                    MaxWidth="440"
                    Visibility="{x:Bind local:OnboardingWindow.ToVisibility(ViewModel.ShowStatusError), Mode=OneWay}"
                    AutomationProperties.LiveSetting="Assertive"
                    AutomationProperties.AutomationId="OnboardingStatusError" />
            </StackPanel>
        </ScrollViewer>
            <Button
                x:Name="MoreBelowButton"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,10"
                Padding="12,4"
                MinHeight="30"
                Visibility="Collapsed"
                Style="{StaticResource MuesliSecondaryButtonStyle}"
                Click="MoreBelow_Click"
                AutomationProperties.AutomationId="OnboardingScrollForMore"
                AutomationProperties.Name="Scroll down for more of this step">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="More below" FontSize="12" VerticalAlignment="Center" />
                    <FontIcon Glyph="&#xE70D;" FontSize="10" FontFamily="{ThemeResource SymbolThemeFontFamily}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>

        <Border
            x:Name="FooterBar"
            Grid.Row="2"
            Grid.Column="1"
            Background="{ThemeResource MuesliBackgroundBrush}"
            BorderBrush="{ThemeResource MuesliBorderSoftBrush}"
            BorderThickness="0,1,0,0"
            Padding="32,16,32,16">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <ItemsRepeater
                    ItemsSource="{x:Bind ViewModel.StepNavItems, Mode=OneWay}"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Setup step indicator">
                    <ItemsRepeater.Layout>
                        <StackLayout Orientation="Horizontal" Spacing="6" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate>
                            <Grid Width="7" Height="7">
                                <Ellipse Fill="{ThemeResource MuesliAccentBrush}" Visibility="{Binding IsCurrent, Converter={StaticResource BoolVis}}" />
                                <Ellipse Fill="{ThemeResource MuesliTextTertiaryBrush}" Visibility="{Binding IsCurrent, Converter={StaticResource InvertBoolVis}}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12">
                    <Button
                        x:Name="BackButton"
                        Style="{StaticResource MuesliSecondaryButtonStyle}"
                        Padding="16,8"
                        Foreground="{ThemeResource MuesliTextSecondaryBrush}"
                        Command="{x:Bind ViewModel.BackCommand}"
                        Content="Back"
                        MinHeight="0"
                        IsEnabled="{x:Bind ViewModel.CanGoBack, Mode=OneWay}"
                        AutomationProperties.AutomationId="OnboardingBackButton"
                        AutomationProperties.Name="Previous setup step">
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Key="Left" Modifiers="Menu" />
                        </Button.KeyboardAccelerators>
                    </Button>
                    <StackPanel
                        x:Name="FooterActions"
                        Orientation="Horizontal"
                        Spacing="12"
                        HorizontalAlignment="Right">
                        <Button
                            x:Name="SkipButton"
                            Style="{StaticResource MuesliSecondaryButtonStyle}"
                            Padding="16,8"
                            Foreground="{ThemeResource MuesliTextSecondaryBrush}"
                            Command="{x:Bind ViewModel.SkipCommand}"
                            Content="Set up later"
                            MinHeight="0"
                            AutomationProperties.AutomationId="OnboardingSkipButton"
                            AutomationProperties.Name="Pause setup and resume later" />
                        <Button
                            x:Name="NextButton"
                            Style="{StaticResource MuesliPrimaryButtonStyle}"
                            FontFamily="{StaticResource MuesliFontFamilyMedium}"
                            FontWeight="Medium"
                            Padding="20,8"
                            Command="{x:Bind ViewModel.NextCommand}"
                            Content="Continue"
                            MinHeight="0"
                            Visibility="{x:Bind local:OnboardingWindow.ToVisibility(ViewModel.CanGoNext), Mode=OneWay}"
                            AutomationProperties.AutomationId="OnboardingNextButton"
                            AutomationProperties.Name="Next setup step">
                            <Button.KeyboardAccelerators>
                                <KeyboardAccelerator Key="Right" Modifiers="Menu" />
                            </Button.KeyboardAccelerators>
                        </Button>
                        <Button
                            x:Name="FinishButton"
                            Style="{StaticResource MuesliPrimaryButtonStyle}"
                            FontFamily="{StaticResource MuesliFontFamilyMedium}"
                            FontWeight="Medium"
                            Padding="20,8"
                            Command="{x:Bind ViewModel.FinishCommand}"
                            Content="Finish"
                            MinHeight="0"
                            Visibility="{x:Bind local:OnboardingWindow.ToVisibility(ViewModel.CanFinish), Mode=OneWay}"
                            AutomationProperties.AutomationId="OnboardingFinishButton"
                            AutomationProperties.Name="Finish setup" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>

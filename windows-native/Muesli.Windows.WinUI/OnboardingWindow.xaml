<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Muesli.Windows.WinUI.OnboardingWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Muesli.Windows.WinUI"
    Title="Set up Muesli">
    <Grid
        x:Name="RootGrid"
        Background="{ThemeResource MuesliBackgroundBrush}"
        XYFocusKeyboardNavigation="Enabled"
        KeyDown="RootGrid_KeyDown"
        SizeChanged="RootGrid_SizeChanged">
        <Grid.Resources>
            <local:OnboardingBoolVisConverter x:Key="BoolVis" />
            <local:OnboardingBoolVisConverter x:Key="InvertBoolVis" Invert="True" />
        </Grid.Resources>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="RailColumn" Width="236" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <!--
                P8-03: the caption strip is a real row, not an overlay, so nothing in the setup
                content can slide under the OS caption buttons. ExtendsContentIntoTitleBar is set in
                the constructor and AppTitleBar is registered as the drag region, which is what makes
                this window's chrome match the dashboard instead of showing the DWM system-accent
                title bar (measured #459BAC) with a second app icon and title.
            -->
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="AppTitleBar"
            Grid.ColumnSpan="2"
            Height="{StaticResource MuesliTitleBarHeight}"
            Background="Transparent"
            IsHitTestVisible="True"
            AutomationProperties.Name="Muesli setup window title bar">
            <TextBlock
                Margin="16,0,0,0"
                VerticalAlignment="Center"
                Style="{StaticResource MuesliBodyStyle}"
                FontSize="12"
                Text="Set up Muesli"
                IsHitTestVisible="False" />
        </Grid>

        <Border
            x:Name="StepRail"
            Grid.Row="1"
            Grid.RowSpan="2"
            Background="{ThemeResource MuesliSurfaceRaisedBrush}"
            BorderBrush="{ThemeResource MuesliBorderSoftBrush}"
            BorderThickness="0,0,1,0"
            Padding="16,22,16,20"
            AutomationProperties.Name="Setup steps">
            <Grid RowDefinitions="Auto,*">
                <StackPanel Spacing="6" Margin="4,0,4,18">
                    <TextBlock Text="MUESLI" Style="{StaticResource MuesliSectionLabelStyle}" Foreground="{ThemeResource MuesliAccentBrush}" />
                    <TextBlock Text="Private local setup" FontSize="18" FontWeight="SemiBold" Foreground="{ThemeResource MuesliTextPrimaryBrush}" TextWrapping="Wrap" />
                    <TextBlock Text="Pause anytime. Progress is saved on this PC." Style="{StaticResource MuesliBodyStyle}" FontSize="12" />
                </StackPanel>
                <ItemsRepeater Grid.Row="1" ItemsSource="{x:Bind ViewModel.StepNavItems, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="4" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate>
                            <Grid MinHeight="38" Margin="0,0,0,2" AutomationProperties.Name="{Binding Title}">
                                <Border
                                    CornerRadius="8"
                                    Background="{ThemeResource MuesliSelectedBrush}"
                                    Visibility="{Binding IsCurrent, Converter={StaticResource BoolVis}}" />
                                <Grid ColumnDefinitions="28,*" ColumnSpacing="8" Padding="10,7">
                                    <Border
                                        Width="22"
                                        Height="22"
                                        CornerRadius="11"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Background="{ThemeResource MuesliAccentMutedBrush}">
                                        <Grid>
                                            <FontIcon
                                                Glyph="&#xE73E;"
                                                FontSize="11"
                                                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                                Foreground="{ThemeResource MuesliSuccessBrush}"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding IsComplete, Converter={StaticResource BoolVis}}" />
                                            <TextBlock
                                                Text="{Binding Number}"
                                                FontSize="11"
                                                FontWeight="SemiBold"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Foreground="{ThemeResource MuesliAccentBrush}"
                                                Visibility="{Binding ShowCurrentNumber, Converter={StaticResource BoolVis}}" />
                                            <TextBlock
                                                Text="{Binding Number}"
                                                FontSize="11"
                                                FontWeight="SemiBold"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Foreground="{ThemeResource MuesliTextTertiaryBrush}"
                                                Visibility="{Binding ShowUpcomingNumber, Converter={StaticResource BoolVis}}" />
                                        </Grid>
                                    </Border>
                                    <TextBlock
                                        Grid.Column="1"
                                        Text="{Binding Title}"
                                        VerticalAlignment="Center"
                                        TextWrapping="Wrap"
                                        FontSize="13"
                                        Foreground="{ThemeResource MuesliTextPrimaryBrush}" />
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </Grid>
        </Border>
        <Border x:Name="RailSplitter" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Left" Width="1" Background="{ThemeResource MuesliBorderSoftBrush}" Grid.RowSpan="2" />

        <!--
            P8-02: the permissions step is taller than any window this display's work area can hold,
            so its last row is always cut by the footer bar. The ScrollViewer was already here; what
            was missing is any *cue* that it scrolls — a WinUI ScrollBar stays in its NoIndicator
            visual state until the pointer enters the region, and ScrollBarVisibility="Visible" does
            not change that. MoreBelowButton is an explicit, focusable, screen-reader-visible
            affordance shown only while content really does continue past the fold.
        -->
        <Grid Grid.Row="1" Grid.Column="1">
        <ScrollViewer
            x:Name="ContentScroller"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled"
            ViewChanged="ContentScroller_ViewChanged"
            SizeChanged="ContentScroller_SizeChanged"
            TabNavigation="Cycle">
            <StackPanel x:Name="ContentColumn" Padding="{StaticResource MuesliPageContentPadding}" Spacing="16">
                <!--
                    P8-04: "SETUP · n OF 7" used to be printed twice on the same line — once as this
                    eyebrow and once as an accent badge in a second column. The eyebrow is the one
                    that carries the automation id and the polite live region, so the badge went.
                -->
                <StackPanel Spacing="6" MinWidth="0">
                    <TextBlock Text="{x:Bind ViewModel.StepLabel, Mode=OneWay}" Style="{StaticResource MuesliSectionLabelStyle}" AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="OnboardingStepBadge" />
                    <TextBlock x:Name="TitleText" Text="{x:Bind ViewModel.Title, Mode=OneWay}" Style="{StaticResource MuesliPageTitleStyle}" TextWrapping="Wrap" />
                    <TextBlock Text="{x:Bind ViewModel.Description, Mode=OneWay}" Style="{StaticResource MuesliPageSubtitleStyle}" />
                </StackPanel>

                <ProgressBar
                    Value="{x:Bind ViewModel.ProgressValue, Mode=OneWay}"
                    Maximum="{x:Bind ViewModel.ProgressMaximum, Mode=OneWay}"
                    Height="4"
                    AutomationProperties.Name="Setup progress"
                    AutomationProperties.AutomationId="OnboardingProgressBar" />

                <!-- Welcome -->
                <Border Style="{StaticResource MuesliSettingsGroupStyle}" Visibility="{x:Bind local:OnboardingWindow.ToVisibility(ViewModel.ShowName), Mode=OneWay}">
                    <StackPanel>
                        <Border Style="{StaticResource MuesliSettingsRowStyle}">
                            <Grid ColumnDefinitions="*,1.2*" ColumnSpacing="16">
                                <StackPanel MinWidth="0" VerticalAlignment="Center">
                                    <TextBlock Text="Your name" Style="{StaticResource MuesliRowTitleStyle}" />
                                    <TextBlock Text="Used to personalize this Windows workspace. You can change it later." Style="{StaticResource MuesliBodyStyle}" FontSize="12" />
                                </StackPanel>
                                <TextBox
                                    Grid.Column="1"
                                    Header=""
                                    PlaceholderText="Your name"
                                    Text="{x:Bind ViewModel.UserName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Center"
                                    AutomationProperties.AutomationId="OnboardingUserName"
                                    AutomationProperties.Name="Your name" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource MuesliSettingsRowLastStyle}">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Local-first" Style="{StaticResource MuesliRowTitleStyle}" />
                                <TextBlock Text="Dictation, meetings, and models stay on this PC. Setup can be paused and resumed without losing these choices." Style="{StaticResource MuesliBodyStyle}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Microphone / permissions -->
                <StackPanel Spacing="14" Visibility="{x:Bind local:OnboardingWindow.ToVisibility(ViewModel.ShowMicrophone), Mode=OneWay}">
                    <Border Style="{StaticResource MuesliSettingsGroupStyle}">
                        <Border Style="{StaticResource MuesliSettingsRowLastStyle}">
                            <Grid ColumnDefinitions="*,1.1*" ColumnSpacing="16">
                                <StackPanel MinWidth="0" VerticalAlignment="Center">
                                    <TextBlock Text="Microphone" Style="{StaticResource MuesliRowTitleStyle}" />
                                    <TextBlock Text="The device dictation and meetings record from. Settings can change it later." Style="{StaticResource MuesliBodyStyle}" FontSize="12" />
                                </StackPanel>
                                <ComboBox
                                    Grid.Column="1"
                                    ItemsSource="{x:Bind ViewModel.Microphones, Mode=OneWay}"
                                    SelectedItem="{x:Bind ViewModel.SelectedMicrophone, Mode=TwoWay}"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Center"
                                    AutomationProperties.AutomationId="OnboardingMicrophone"
                                    AutomationProperties.Name="Microphone" />
                            </Grid>
                        </Border>
                    </Border>
                    <Grid
                        x:Name="PermissionsHeader"
                        ColumnDefinitions="*,Auto"
                        RowDefinitions="Auto,Auto"
                        ColumnSpacing="12"
                        RowSpacing="8">
                        <TextBlock Text="PERMISSIONS" Style="{StaticResource MuesliSectionLabelStyle}" VerticalAlignment="Center" />
                        <StackPanel
                            x:Name="PermissionsToolbar"
                            Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8"
                            HorizontalAlignment="Right">
                            <Button
                                Style="{StaticResource MuesliSecondaryButtonStyle}"
                                Command="{x:Bind ViewModel.TestMicrophoneCommand}"
                                Content="Test microphone"
                                MinHeight="36"
                                AutomationProperties.AutomationId="OnboardingTestMicrophone"
                                AutomationProperties.Name="Test microphone" />
                            <Button
                                Style="{StaticResource MuesliGhostButtonStyle}"
                                Command="{x:Bind ViewModel.OpenMicrophonePrivacyCommand}"
                                Padding="8"
                                MinWidth="36"
                                MinHeight="36"
                                ToolTipService.ToolTip="Open Windows microphone privacy settings"
                                AutomationProperties.AutomationId="OnboardingOpenMicrophonePrivacy"
                                AutomationProperties.Name="Open Windows microphone privacy settings">
                                <FontIcon Glyph="&#xE8A7;" FontSize="12" FontFamily="{ThemeResource SymbolThemeFontFamily}" Foreground="{ThemeResource MuesliTextTertiaryBrush}" />
                            </Button>
                        </StackPanel>
                    </Grid>
                    <Border Style="{StaticResource MuesliSettingsGroupStyle}" AutomationProperties.AutomationId="OnboardingPermissionList">
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.Permissions, Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <StackLayout Spacing="0" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid ColumnDefinitions="16,*,Auto" Padding="16,12" ColumnSpacing="10">
                                            <Ellipse Width="8" Height="8" Fill="{ThemeResource MuesliSuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding Granted, Converter={StaticResource BoolVis}}" />
                                            <Ellipse Width="8" Height="8" Fill="{ThemeResource MuesliTextTertiaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding Granted, Converter={StaticResource InvertBoolVis}}" />
                                            <StackPanel Grid.Column="1" Spacing="2" MinWidth="0">
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource MuesliRowTitleStyle}" />
                                                <TextBlock Text="{Binding Help}" Style="{StaticResource MuesliBodyStyle}" FontSize="12" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <TextBlock Text="Granted" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{ThemeResource MuesliSuccessBrush}" Visibility="{Binding ShowGranted, Converter={StaticResource BoolVis}}" />
                                                <TextBlock Text="{Binding Status}" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{ThemeResource MuesliTextTertiaryBrush}" Visibility="{Binding ShowUnavailable, Converter={StaticResource BoolVis}}" />
                                                <Button
                                                    Content="Grant"
                                                    Style="{StaticResource MuesliPrimaryButtonStyle}"
                                                    Padding="12,5"
                                                    FontSize="13"
                                                    MinHeight="32"
                                                    Click="GrantPermission_Click"
                                                    Visibility="{Binding ShowGrant, Converter={StaticResource BoolVis}}"
                                                    AutomationProperties.Name="{Binding Name}"
                                                    AutomationProperties.AutomationId="OnboardingGrantPermission" />
                                            </StackPanel>
                                        </Grid>
                                        <Border Grid.Row="1" Height="1" Margin="16,0" Background="{ThemeResource MuesliBorderSoftBrush}" Visibility="{Binding IsLast, Converter={StaticResource InvertBoolVis}}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </Border>
                </StackPanel>

                <!-- Models -->
                <StackPanel Spacing="14" Visibility="{x:Bind local:OnboardingWindow.ToVisibility(ViewModel.ShowModels), Mode=OneWay}">
                    <Border Style="{StaticResource MuesliSettingsGroupStyle}">
                        <StackPanel>
                            <Border Style="{StaticResource MuesliSettingsRowStyle}">
                                <Grid ColumnDefinitions="*,1.2*" ColumnSpacing="16">
                                    <StackPanel MinWidth="0" VerticalAlignment="Center">
                                        <TextBlock Text="Dictation offline model" Style="{StaticResource MuesliRowTitleStyle}" />
                                        <TextBlock Text="Runs hold-to-talk dictation on this PC." Style="{StaticResource MuesliBodyStyle}" FontSize="12" />
                                    </StackPanel>
                                    <ComboBox
                                        Grid.Column="1"
                                        ItemsSource="{x:Bind ViewModel.DictationModels, Mode=OneWay}"
                                        SelectedItem="{x:Bind ViewModel.SelectedDictationModel, Mode=TwoWay}"
                                        DisplayMemberPath="PickerLabel"
                                        HorizontalAlignment="Stretch"
                                        AutomationProperties.AutomationId="OnboardingDictationModel"
                                        AutomationProperties.Name="Dictation offline model" />
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource MuesliSettingsRowStyle}">
                                <Grid ColumnDefinitions="*,1.2*" ColumnSpacing="16">
                                    <TextBlock Text="Final meeting and import offline model" Style="{StaticResource MuesliRowTitleStyle}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    <ComboBox
                                        Grid.Column="1"
                                        ItemsSource="{x:Bind ViewModel.MeetingModels, Mode=OneWay}"
                                        SelectedItem="{x:Bind ViewModel.SelectedMeetingModel, Mode=TwoWay}"
                                        DisplayMemberPath="PickerLabel"
                                        HorizontalAlignment="Stretch"
                                        AutomationProperties.AutomationId="OnboardingMeetingModel"
                                        AutomationProperties.Name="Final meeting and import offline model" />
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource MuesliSettingsRowLastStyle}">
                                <Grid ColumnDefinitions="*,1.2*" ColumnSpacing="16">
                                    <TextBlock Text="Live preview model" Style="{StaticResource MuesliRowTitleStyle}" VerticalAlignment="Center" />
                                    <ComboBox
                                        Grid.Column="1"
                                        ItemsSource="{x:Bind ViewModel.LiveModels, Mode=OneWay}"
                                        SelectedItem="{x:Bind ViewModel.SelectedLiveModel, Mode=TwoWay}"
                                        DisplayMemberPath="Label"
                                        HorizontalAlignment="Stretch"
                                        AutomationProperties.AutomationId="OnboardingLiveModel"
                                        AutomationProperties.Name="Live preview model" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.ModelRoles, Mode=OneWay}" AutomationProperties.Name="Selected model roles">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="10" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource MuesliCardStyle}" Padding="16" AutomationProperties.Name="{Binding AccessibleName}">
                                    <StackPanel Spacing="8">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="{Binding Heading}" Style="{StaticResource MuesliRowTitleStyle}" TextWrapping="Wrap" />
                                            <Border Grid.Column="1" Style="{StaticResource MuesliSuccessBadgeStyle}" Visibility="{Binding IsReady, Converter={StaticResource BoolVis}}">
                                                <TextBlock Text="Ready" Style="{StaticResource MuesliSuccessBadgeTextStyle}" />
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource MuesliBodyStyle}" AutomationProperties.LiveSetting="Polite" />
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}">
                                            <ProgressBar
                                                Value="{Binding ProgressValue}"
                                                Maximum="100"
                                                IsIndeterminate="{Binding IsProgressIndeterminate}"
                                                VerticalAlignment="Center"
                                                AutomationProperties.Name="{Binding ProgressLabel}" />
                                            <TextBlock Grid.Column="1" Text="{Binding ProgressLabel}" Style="{StaticResource MuesliBodyStyle}" VerticalAlignment="Center" />
                                        </Grid>
                                        <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{Binding HasActions, Converter={StaticResource BoolVis}}">
                                            <Button
                                                Content="Prepare"
                                                Style="{StaticResource MuesliPrimaryButtonStyle}"
                                                MinHeight="32"
                                                Click="PrepareModel_Click"
                                                Visibility="{Binding CanPrepare, Converter={StaticResource BoolVis}}"
                                                AutomationProperties.Name="Prepare model"
                                                AutomationProperties.AutomationId="OnboardingPrepareModel" />
                                            <Button
                                                Content="Verify"
                                                Style="{StaticResource MuesliSecondaryButtonStyle}"
                                                MinHeight="32"
                                                Click="VerifyModel_Click"
                                                Visibility="{Binding CanVerify, Converter={StaticResource BoolVis}}"
                                                AutomationProperties.Name="Verify model"
                                                AutomationProperties.AutomationId="OnboardingVerifyModel" />
                                            <Button
                                                Content="Retry"
                                                Style="{StaticResource MuesliSecondaryButtonStyle}"
                                                MinHeight="32"
                                                Click="RetryModel_Click"
                                                Visibility="{Binding CanRetry, Converter={StaticResource BoolVis}}"
                                                AutomationProperties.Name="Retry model"
                                                AutomationProperties.AutomationId="OnboardingRetryModel" />
                                            <Button
                                                Content="Cancel"
                                                Style="{StaticResource MuesliGhostButtonStyle}"
                                                MinHeight="32"
                                                Click="CancelModel_Click"
                                                Visibility="{Binding CanCancel, Converter={StaticResource BoolVis}}"
                                                AutomationProperties.Name="Cancel model operation"
                                                AutomationProperties.AutomationId="OnboardingCancelModel" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>

                <!-- Hotkey -->
                <Border Style="{StaticResource MuesliSettingsGroupStyle}" Visibility="{x:Bind local:OnboardingWindow.ToVisibility(ViewModel.ShowHotkey), Mode=OneWay}">
                    <StackPanel>
                        <Border Style="{StaticResource MuesliSettingsRowStyle}">
                            <Grid ColumnDefinitions="*,1.1*" ColumnSpacing="16">
                                <StackPanel MinWidth="0" VerticalAlignment="Center">
                                    <TextBlock Text="Hold-to-talk shortcut" Style="{StaticResource MuesliRowTitleStyle}" />
                                    <TextBlock Text="Hold this key to dictate, then release to transcribe." Style="{StaticResource MuesliBodyStyle}" FontSize="12" />
                                </StackPanel>
                                <ComboBox
                                    Grid.Column="1"
                                    ItemsSource="{x:Bind ViewModel.Hotkeys, Mode=OneWay}"
                                    SelectedItem="{x:Bind ViewModel.SelectedHotkey, Mode=TwoWay}"
                                    HorizontalAlignment="Stretch"
                                    AutomationProperties.AutomationId="OnboardingHotkey"
                                    AutomationProperties.Name="Hold-to-talk shortcut" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource MuesliSettingsRowLastStyle}">
                            <Button
                                Style="{StaticResource MuesliSecondaryButtonStyle}"
                                Command="{x:Bind ViewModel.CheckHotkeyCommand}"
                                Content="Check shortcut"
                                HorizontalAlignment="Left"
                                MinHeight="36"
                                AutomationProperties.AutomationId="OnboardingCheckHotkey"
                                AutomationProperties.Name="Check shortcut" />
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Pipeline -->
                <Border Style="{StaticResource MuesliSettingsGroupStyle}" Visibility="{x:Bind local:OnboardingWindow.ToVisibility(ViewModel.ShowPipeline), Mode=OneWay}">
                    <StackPanel>
                        <!--
                            P8-05: this card used to open by repeating the step subtitle word for
                            word. It now reads back the microphone, model and gate the test will
                            actually use, which is information the subtitle does not carry.
                        -->
                        <Border Style="{StaticResource MuesliSettingsRowStyle}">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <StackPanel MinWidth="0" VerticalAlignment="Center">
                                    <TextBlock Text="Microphone" Style="{StaticResource MuesliRowTitleStyle}" />
                                    <TextBlock Text="{x:Bind ViewModel.PipelineMicrophoneLabel, Mode=OneWay}" Style="{StaticResource MuesliBodyStyle}" FontSize="12" TextWrapping="Wrap" AutomationProperties.Name="Microphone used by the dictation test" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource MuesliSettingsRowStyle}">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <StackPanel MinWidth="0" VerticalAlignment="Center">
                                    <TextBlock Text="Dictation model" Style="{StaticResource MuesliRowTitleStyle}" />
                                    <TextBlock Text="{x:Bind ViewModel.PipelineModelLabel, Mode=OneWay}" Style="{StaticResource MuesliBodyStyle}" FontSize="12" TextWrapping="Wrap" AutomationProperties.Name="Model used by the dictation test" />
                                </StackPanel>
                                <Border Grid.Column="1" Style="{StaticResource MuesliSuccessBadgeStyle}" VerticalAlignment="Center" Visibility="{x:Bind local:OnboardingWindow.ToVisibility(ViewModel.PipelineReady), Mode=OneWay}">
                                    <TextBlock Text="passed" Style="{StaticResource MuesliSuccessBadgeTextStyle}" />
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource MuesliBadgeStyle}" VerticalAlignment="Center" Visibility="{x:Bind local:OnboardingWindow.ToInvertedVisibility(ViewModel.PipelineReady), Mode=OneWay}">
                                    <TextBlock Text="{x:Bind ViewModel.PipelineGateLabel, Mode=OneWay}" Style="{StaticResource MuesliBadgeTextStyle}" />
                                </Border>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource MuesliSettingsRowLastStyle}">
                            <StackPanel Spacing="12">
                                <TextBlock Text="The recording runs for three seconds on this PC. Nothing is pasted, nothing is added to history, and the audio is not retained." Style="{StaticResource MuesliBodyStyle}" />
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button
                                        Style="{StaticResource MuesliSecondaryButtonStyle}"
                                        Command="{x:Bind ViewModel.RunPipelineTestCommand}"
                                        Content="{x:Bind ViewModel.PipelineActionLabel, Mode=OneWay}"
                                        MinHeight="36"
                                        AutomationProperties.AutomationId="OnboardingPipelineTest"
                                        AutomationProperties.Name="{x:Bind ViewModel.PipelineActionLabel, Mode=OneWay}" />
                                    <ProgressRing
                                        Width="22"
                                        Height="22"
                                        IsActive="{x:Bind ViewModel.IsPipelineRunning, Mode=OneWay}"
                                        Visibility="{x:Bind local:OnboardingWindow.ToVisibility(ViewModel.IsPipelineRunning), Mode=OneWay}"
                                        AutomationProperties.Name="Recording local dictation test" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Optional -->
                <StackPanel Spacing="14" Visibility="{x:Bind local:OnboardingWindow.ToVisibility(ViewModel.ShowOptional), Mode=OneWay}">
                    <InfoBar
                        IsOpen="{x:Bind ViewModel.ShowStartupNotice, Mode=OneWay}"
                        Severity="Warning"
                        Title="Startup unavailable"
                        Message="{x:Bind ViewModel.StartupAvailabilityNotice, Mode=OneWay}"
                        IsClosable="False"
                        AutomationProperties.AutomationId="OnboardingStartupNotice" />
                    <Border Style="{StaticResource MuesliSettingsGroupStyle}">
                        <StackPanel>
                            <Border Style="{StaticResource MuesliSettingsRowStyle}">
                                <Grid ColumnDefinitions="*,1.2*" ColumnSpacing="16">
                                    <StackPanel MinWidth="0" VerticalAlignment="Center">
                                        <TextBlock Text="Meeting summary provider" Style="{StaticResource MuesliRowTitleStyle}" />
                                        <TextBlock Text="{x:Bind ViewModel.SummaryDisclosure, Mode=OneWay}" Style="{StaticResource MuesliBodyStyle}" FontSize="12" AutomationProperties.Name="Summary provider transcript disclosure" />
                                    </StackPanel>
                                    <ComboBox
                                        Grid.Column="1"
                                        ItemsSource="{x:Bind ViewModel.SummaryProviders, Mode=OneWay}"
                                        SelectedItem="{x:Bind ViewModel.SelectedSummaryProvider, Mode=TwoWay}"
                                        DisplayMemberPath="DisplayName"
                                        HorizontalAlignment="Stretch"
                                        AutomationProperties.AutomationId="OnboardingSummaryProvider"
                                        AutomationProperties.Name="Meeting summary provider" />
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource MuesliSettingsRowStyle}">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="{x:Bind ViewModel.CloudKeyStatus, Mode=OneWay}" Style="{StaticResource MuesliBodyStyle}" AutomationProperties.Name="Cloud provider key configuration status" />
                                    <Button
                                        Style="{StaticResource MuesliSecondaryButtonStyle}"
                                        Command="{x:Bind ViewModel.OpenSummaryProviderSettingsCommand}"
                                        Content="Configure summary provider in Settings"
                                        HorizontalAlignment="Left"
                                        MinHeight="36"
                                        AutomationProperties.AutomationId="OnboardingOpenSummarySettings"
                                        AutomationProperties.Name="Configure summary provider in Settings" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource MuesliSettingsRowStyle}">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel MinWidth="0" VerticalAlignment="Center">
                                        <TextBlock Text="Launch at login" Style="{StaticResource MuesliRowTitleStyle}" />
                                        <TextBlock Text="Uses the Windows startup task when this build has package identity." Style="{StaticResource MuesliBodyStyle}" FontSize="12" />
                                    </StackPanel>
                                    <ToggleSwitch
                                        Grid.Column="1"
                                        IsOn="{x:Bind ViewModel.StartAtLogin, Mode=TwoWay}"
                                        IsEnabled="{x:Bind ViewModel.IsStartupAvailable, Mode=OneWay}"
                                        OffContent=""
                                        OnContent=""
                                        MinWidth="40"
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="Launch at login" />
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource MuesliSettingsRowStyle}">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="Show floating indicator" Style="{StaticResource MuesliRowTitleStyle}" VerticalAlignment="Center" />
                                    <ToggleSwitch
                                        Grid.Column="1"
                                        IsOn="{x:Bind ViewModel.ShowIndicator, Mode=TwoWay}"
                                        OffContent=""
                                        OnContent=""
                                        MinWidth="40"
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="Show floating indicator" />
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource MuesliSettingsRowStyle}">
                                <Grid ColumnDefinitions="*,1.1*" ColumnSpacing="16">
                                    <TextBlock Text="Floating indicator position" Style="{StaticResource MuesliRowTitleStyle}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    <ComboBox
                                        Grid.Column="1"
                                        ItemsSource="{x:Bind ViewModel.IndicatorPositionChoices, Mode=OneWay}"
                                        SelectedItem="{x:Bind ViewModel.SelectedIndicatorPosition, Mode=TwoWay}"
                                        HorizontalAlignment="Stretch"
                                        AutomationProperties.AutomationId="OnboardingIndicatorPosition"
                                        AutomationProperties.Name="Floating indicator position" />
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource MuesliSettingsRowLastStyle}">
                                <StackPanel x:Name="IndicatorPreviewActions" Orientation="Horizontal" Spacing="8">
                                    <Button
                                        Style="{StaticResource MuesliSecondaryButtonStyle}"
                                        Command="{x:Bind ViewModel.PreviewIndicatorCommand}"
                                        Content="Save indicator position"
                                        MinHeight="36"
                                        HorizontalAlignment="Left"
                                        AutomationProperties.AutomationId="OnboardingPreviewIndicator"
                                        AutomationProperties.Name="Save indicator position" />
                                    <Button
                                        Style="{StaticResource MuesliGhostButtonStyle}"
                                        Command="{x:Bind ViewModel.ResetIndicatorPositionCommand}"
                                        Content="Reset custom indicator position"
                                        MinHeight="36"
                                        HorizontalAlignment="Left"
                                        AutomationProperties.AutomationId="OnboardingResetIndicator"
                                        AutomationProperties.Name="Reset custom indicator position" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Ready -->
                <Border Style="{StaticResource MuesliSettingsGroupStyle}" Visibility="{x:Bind local:OnboardingWindow.ToVisibility(ViewModel.ShowReady), Mode=OneWay}">
                    <StackPanel>
                        <Border Style="{StaticResource MuesliSettingsRowStyle}">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Microphone" Style="{StaticResource MuesliRowTitleStyle}" />
                                <Border Grid.Column="1" Style="{StaticResource MuesliSuccessBadgeStyle}" Visibility="{x:Bind local:OnboardingWindow.ToVisibility(ViewModel.MicrophoneReady), Mode=OneWay}">
                                    <TextBlock Text="ready" Style="{StaticResource MuesliSuccessBadgeTextStyle}" />
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource MuesliBadgeStyle}" Visibility="{x:Bind local:OnboardingWindow.ToInvertedVisibility(ViewModel.MicrophoneReady), Mode=OneWay}">
                                    <TextBlock Text="{x:Bind ViewModel.MicrophoneGateLabel, Mode=OneWay}" Style="{StaticResource MuesliBadgeTextStyle}" />
                                </Border>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource MuesliSettingsRowStyle}">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Models" Style="{StaticResource MuesliRowTitleStyle}" />
                                <Border Grid.Column="1" Style="{StaticResource MuesliSuccessBadgeStyle}" Visibility="{x:Bind local:OnboardingWindow.ToVisibility(ViewModel.ModelsReady), Mode=OneWay}">
                                    <TextBlock Text="ready" Style="{StaticResource MuesliSuccessBadgeTextStyle}" />
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource MuesliBadgeStyle}" Visibility="{x:Bind local:OnboardingWindow.ToInvertedVisibility(ViewModel.ModelsReady), Mode=OneWay}">
                                    <TextBlock Text="{x:Bind ViewModel.ModelsGateLabel, Mode=OneWay}" Style="{StaticResource MuesliBadgeTextStyle}" />
                                </Border>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource MuesliSettingsRowStyle}">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Shortcut" Style="{StaticResource MuesliRowTitleStyle}" />
                                <Border Grid.Column="1" Style="{StaticResource MuesliSuccessBadgeStyle}" Visibility="{x:Bind local:OnboardingWindow.ToVisibility(ViewModel.HotkeyReady), Mode=OneWay}">
                                    <TextBlock Text="ready" Style="{StaticResource MuesliSuccessBadgeTextStyle}" />
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource MuesliBadgeStyle}" Visibility="{x:Bind local:OnboardingWindow.ToInvertedVisibility(ViewModel.HotkeyReady), Mode=OneWay}">
                                    <TextBlock Text="{x:Bind ViewModel.HotkeyGateLabel, Mode=OneWay}" Style="{StaticResource MuesliBadgeTextStyle}" />
                                </Border>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource MuesliSettingsRowLastStyle}">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Dictation test" Style="{StaticResource MuesliRowTitleStyle}" />
                                <Border Grid.Column="1" Style="{StaticResource MuesliSuccessBadgeStyle}" Visibility="{x:Bind local:OnboardingWindow.ToVisibility(ViewModel.PipelineReady), Mode=OneWay}">
                                    <TextBlock Text="passed" Style="{StaticResource MuesliSuccessBadgeTextStyle}" />
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource MuesliBadgeStyle}" Visibility="{x:Bind local:OnboardingWindow.ToInvertedVisibility(ViewModel.PipelineReady), Mode=OneWay}">
                                    <TextBlock Text="{x:Bind ViewModel.PipelineGateLabel, Mode=OneWay}" Style="{StaticResource MuesliBadgeTextStyle}" />
                                </Border>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <InfoBar
                    x:Name="StatusBar"
                    IsOpen="{x:Bind ViewModel.ShowStatus, Mode=OneWay}"
                    Message="{x:Bind ViewModel.Status, Mode=OneWay}"
                    IsClosable="False"
                    Severity="Informational"
                    AutomationProperties.LiveSetting="Polite"
                    AutomationProperties.AutomationId="OnboardingStatus" />
            </StackPanel>
        </ScrollViewer>
            <Button
                x:Name="MoreBelowButton"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,10"
                Padding="12,4"
                MinHeight="30"
                Visibility="Collapsed"
                Style="{StaticResource MuesliSecondaryButtonStyle}"
                Click="MoreBelow_Click"
                AutomationProperties.AutomationId="OnboardingScrollForMore"
                AutomationProperties.Name="Scroll down for more of this step">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="More below" FontSize="12" VerticalAlignment="Center" />
                    <FontIcon Glyph="&#xE70D;" FontSize="10" FontFamily="{ThemeResource SymbolThemeFontFamily}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>

        <Border
            x:Name="FooterBar"
            Grid.Row="2"
            Grid.Column="1"
            Background="{ThemeResource MuesliBackgroundBrush}"
            BorderBrush="{ThemeResource MuesliBorderSoftBrush}"
            BorderThickness="0,1,0,0"
            Padding="32,14,32,18">
            <Grid RowDefinitions="Auto,Auto" RowSpacing="12">
                <ItemsRepeater
                    ItemsSource="{x:Bind ViewModel.StepNavItems, Mode=OneWay}"
                    HorizontalAlignment="Center"
                    AutomationProperties.Name="Setup step indicator">
                    <ItemsRepeater.Layout>
                        <StackLayout Orientation="Horizontal" Spacing="8" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate>
                            <Grid Width="8" Height="8">
                                <Ellipse Fill="{ThemeResource MuesliAccentBrush}" Visibility="{Binding IsCurrent, Converter={StaticResource BoolVis}}" />
                                <Ellipse Fill="{ThemeResource MuesliTextTertiaryBrush}" Opacity="0.45" Visibility="{Binding IsCurrent, Converter={StaticResource InvertBoolVis}}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
                <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto">
                    <Button
                        x:Name="BackButton"
                        Style="{StaticResource MuesliGhostButtonStyle}"
                        Command="{x:Bind ViewModel.BackCommand}"
                        Content="Back"
                        MinWidth="80"
                        MinHeight="36"
                        IsEnabled="{x:Bind ViewModel.CanGoBack, Mode=OneWay}"
                        AutomationProperties.AutomationId="OnboardingBackButton"
                        AutomationProperties.Name="Previous setup step">
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Key="Left" Modifiers="Menu" />
                        </Button.KeyboardAccelerators>
                    </Button>
                    <StackPanel
                        x:Name="FooterActions"
                        Grid.Column="2"
                        Orientation="Horizontal"
                        Spacing="10"
                        HorizontalAlignment="Right">
                        <Button
                            x:Name="SkipButton"
                            Style="{StaticResource MuesliGhostButtonStyle}"
                            Command="{x:Bind ViewModel.SkipCommand}"
                            Content="Set up later"
                            MinHeight="36"
                            AutomationProperties.AutomationId="OnboardingSkipButton"
                            AutomationProperties.Name="Pause setup and resume later" />
                        <Button
                            x:Name="NextButton"
                            Style="{StaticResource MuesliSecondaryButtonStyle}"
                            Command="{x:Bind ViewModel.NextCommand}"
                            Content="Next"
                            MinWidth="88"
                            MinHeight="36"
                            Visibility="{x:Bind local:OnboardingWindow.ToVisibility(ViewModel.CanGoNext), Mode=OneWay}"
                            AutomationProperties.AutomationId="OnboardingNextButton"
                            AutomationProperties.Name="Next setup step">
                            <Button.KeyboardAccelerators>
                                <KeyboardAccelerator Key="Right" Modifiers="Menu" />
                            </Button.KeyboardAccelerators>
                        </Button>
                        <Button
                            x:Name="FinishButton"
                            Style="{StaticResource MuesliPrimaryButtonStyle}"
                            Command="{x:Bind ViewModel.FinishCommand}"
                            Content="Finish setup"
                            MinHeight="36"
                            Visibility="{x:Bind local:OnboardingWindow.ToVisibility(ViewModel.CanFinish), Mode=OneWay}"
                            AutomationProperties.AutomationId="OnboardingFinishButton"
                            AutomationProperties.Name="Finish setup" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>

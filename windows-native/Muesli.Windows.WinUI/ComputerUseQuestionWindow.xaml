<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Muesli.Windows.WinUI.ComputerUseQuestionWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Muesli has a question">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>
    <Border
        x:Name="RootBorder"
        Padding="24"
        Background="{ThemeResource LayerFillColorDefaultBrush}"
        KeyboardAcceleratorPlacementMode="Hidden">
        <Border.KeyboardAccelerators>
            <KeyboardAccelerator Key="Escape" Invoked="CancelAccelerator_Invoked" />
        </Border.KeyboardAccelerators>
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" RowSpacing="14">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <Border
                    Width="38"
                    Height="38"
                    Background="{ThemeResource MuesliAccentMutedBrush}"
                    CornerRadius="19">
                    <FontIcon
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontFamily="{ThemeResource SymbolThemeFontFamily}"
                        FontSize="18"
                        Foreground="{ThemeResource MuesliAccentBrush}"
                        Glyph="&#xE9CE;" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock
                        FontSize="22"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource MuesliTextPrimaryBrush}"
                        Text="Computer Use has a question"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Style="{StaticResource MuesliBodyStyle}"
                        Text="The run is paused until you answer." />
                </StackPanel>
            </Grid>

            <TextBlock
                x:Name="QuestionText"
                Grid.Row="1"
                FontSize="16"
                Foreground="{ThemeResource MuesliTextPrimaryBrush}"
                TextWrapping="Wrap"
                AutomationProperties.AutomationId="ComputerUseQuestionText" />

            <StackPanel
                x:Name="OptionsPanel"
                Grid.Row="2"
                Spacing="8"
                AutomationProperties.AutomationId="ComputerUseQuestionOptions" />

            <Grid Grid.Row="3" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <TextBox
                    x:Name="AnswerBox"
                    PlaceholderText="Or type an answer"
                    KeyDown="AnswerBox_KeyDown"
                    AutomationProperties.AutomationId="ComputerUseAnswerBox"
                    AutomationProperties.Name="Type an answer" />
                <Button
                    Grid.Column="1"
                    Style="{StaticResource MuesliPrimaryButtonStyle}"
                    Click="Answer_Click"
                    Content="Answer"
                    AutomationProperties.AutomationId="ComputerUseAnswerButton" />
            </Grid>

            <Grid Grid.Row="4" VerticalAlignment="Bottom" ColumnDefinitions="*,Auto">
                <TextBlock
                    VerticalAlignment="Center"
                    Style="{StaticResource MuesliBodyStyle}"
                    FontSize="12"
                    Text="Escape stops the run." />
                <Button
                    Grid.Column="1"
                    Style="{StaticResource MuesliGhostButtonStyle}"
                    Click="Cancel_Click"
                    Content="Stop"
                    AutomationProperties.AutomationId="ComputerUseQuestionStopButton"
                    AutomationProperties.Name="Stop Computer Use" />
            </Grid>
        </Grid>
    </Border>
</Window>

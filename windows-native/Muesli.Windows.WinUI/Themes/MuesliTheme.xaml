                <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#83B3F8" />
                <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#FFFFFF" />
                <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#FFFFFF" />
                <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="#FFFFFF" />
                <SolidColorBrush x:Key="ProgressBarForeground" Color="#6BA3F7" />
                <!-- macOS secondary button: surfacePrimary, textPrimary 6% hover / 11% pressed overlay, 1pt surfaceBorder. -->
                <SolidColorBrush x:Key="ButtonBackground" Color="#262830" />
                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#33353C" />
                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#3E4047" />
                <SolidColorBrush x:Key="ButtonBorderBrush" Color="#12FFFFFF" />

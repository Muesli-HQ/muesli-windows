                <SolidColorBrush x:Key="MuesliJoinActionSecondaryBrush" Color="#26946B" />
                <SolidColorBrush x:Key="MuesliOnJoinActionBrush" Color="#000000" />
                <SolidColorBrush x:Key="MuesliSuccessTextBrush" Color="#34D399" />
                <SolidColorBrush x:Key="MuesliWarningTextBrush" Color="#F59E0B" />
                <SolidColorBrush x:Key="MuesliDestructiveTextBrush" Color="#F87171" />
                <SolidColorBrush x:Key="MuesliDestructiveTintHoverBrush" Color="#21EF4444" />
                <SolidColorBrush x:Key="MuesliDestructiveTintPressedBrush" Color="#29EF4444" />
                <SolidColorBrush x:Key="MuesliStateHoverOverlayBrush" Color="#0FFFFFFF" />
                <SolidColorBrush x:Key="MuesliStatePressedOverlayBrush" Color="#1CFFFFFF" />
                <!-- Control leaves for accent buttons, toggles and progress, retinted by AccentPalette.
                     Leaf keys resolve through app resources first, unlike generic.xaml's StaticResource aliases. -->
                <SolidColorBrush x:Key="AccentButtonBackground" Color="#6BA3F7" />

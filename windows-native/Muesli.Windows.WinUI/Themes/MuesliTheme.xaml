                <SolidColorBrush x:Key="MuesliSuccessBrush" Color="#34D399" />
                <SolidColorBrush x:Key="MuesliSuccessMutedBrush" Color="#2234D399" />
                <SolidColorBrush x:Key="MuesliWarningBrush" Color="#F59E0B" />
                <SolidColorBrush x:Key="MuesliErrorBrush" Color="#F87171" />
                <SolidColorBrush x:Key="MuesliErrorMutedBrush" Color="#1AEF4444" />
                <SolidColorBrush x:Key="MuesliTextDisabledBrush" Color="#40FFFFFF" />
                <SolidColorBrush x:Key="MuesliControlFillBrush" Color="#262830" />
                <SolidColorBrush x:Key="MuesliControlHoverBrush" Color="#2E3340" />
                <SolidColorBrush x:Key="MuesliControlPressedBrush" Color="#232528" />
                <SolidColorBrush x:Key="MuesliControlDisabledBrush" Color="#1C1D20" />

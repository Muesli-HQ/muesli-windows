<?xml version="1.0" encoding="utf-8"?>
<!--
    Product palette and platform brush overrides.

    SHARED RESOURCE CONTRACT — FROZEN.
    Light, Dark, and HighContrast dictionaries below are the semantic color contract for every
    WinUI page. Do not add, rename, or retune keys here from a page change. Request a new token
    from the shell owner if a surface has no existing brush.

    This dictionary is merged AFTER XamlControlsResources. Merged dictionaries resolve
    last-wins, which is what actually lets these keys override WinUI's own control chrome —
    declaring the same keys in Application.Resources.ThemeDictionaries does not, and the
    controls silently keep their stock brushes.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
        <ResourceDictionary.ThemeDictionaries>


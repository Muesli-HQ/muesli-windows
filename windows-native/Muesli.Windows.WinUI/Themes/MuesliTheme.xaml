                <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#E8EBF0" />
                <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="#DEE8F8" />

                <!--
                    Accent ramp — Light. A light dictionary derives from the Dark* ramp:
                    generic.xaml uses SystemAccentColorDark1 for AccentFillColorDefaultBrush and
                    the TextBox focus underline, and SystemAccentColorDark2/3 for accent text.
                    See the note in the Default dictionary for why the ramp, not the brushes,
                    is the override point.
                -->
                <Color x:Key="SystemAccentColor">#2364C9</Color>
                <Color x:Key="SystemAccentColorLight1">#4C86DE</Color>
                <Color x:Key="SystemAccentColorLight2">#7BA9EC</Color>
                <Color x:Key="SystemAccentColorLight3">#A9C8F4</Color>
                <Color x:Key="SystemAccentColorDark1">#1F62D6</Color>
                <Color x:Key="SystemAccentColorDark2">#2364C9</Color>
                <Color x:Key="SystemAccentColorDark3">#1D55AD</Color>
                <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#1F62D6" />
                <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#1B58C0" />
                <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#174CA6" />
                <SolidColorBrush x:Key="AccentFillColorDisabledBrush" Color="#E8EBF0" />
                <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FFFFFFFF" />
                <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#C8FFFFFF" />

                <!-- navigation: macOS-style filled pill, no left indicator bar -->
                <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#DEE8F8" />
                <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Color="#DEE8F8" />
                <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPressed" Color="#DEE8F8" />
                <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="#E6000000" />
                <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPointerOver" Color="#E6000000" />
                <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPressed" Color="#E6000000" />
                <SolidColorBrush x:Key="NavigationViewItemForeground" Color="#99000000" />
                <SolidColorBrush x:Key="NavigationViewItemForegroundPointerOver" Color="#E6000000" />
                <SolidColorBrush x:Key="NavigationViewItemForegroundPressed" Color="#E6000000" />
                <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="#E8EBF0" />
                <SolidColorBrush x:Key="NavigationViewItemBackgroundPressed" Color="#DEE8F8" />
                <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="Transparent" />

                <!-- segmented control: filled selected segment, no underline pill -->
                <SolidColorBrush x:Key="SelectorBarItemBackgroundSelected" Color="#1F62D6" />
                <SolidColorBrush x:Key="SelectorBarItemForegroundSelected" Color="#FFFFFFFF" />
                <SolidColorBrush x:Key="SelectorBarItemBackground" Color="Transparent" />
                <SolidColorBrush x:Key="SelectorBarItemForeground" Color="#99000000" />
                <SolidColorBrush x:Key="SelectorBarItemBackgroundPointerOver" Color="#E8EBF0" />
                <SolidColorBrush x:Key="SelectorBarItemForegroundPointerOver" Color="#E6000000" />
                <SolidColorBrush x:Key="SelectorBarItemBackgroundPressed" Color="#DEE8F8" />
                <SolidColorBrush x:Key="SelectorBarItemForegroundPressed" Color="#E6000000" />
                <SolidColorBrush x:Key="SelectorBarItemPillFill" Color="Transparent" />
                <SolidColorBrush x:Key="SelectorBarItemDisabledPillFill" Color="Transparent" />
            </ResourceDictionary>

            <!--
                High Contrast maps the product names onto system colours only. The platform
                brushes already behave correctly in Contrast themes, so nothing else is
                redefined here; overriding them would break the system's own adjustment.
            -->
            <ResourceDictionary x:Key="HighContrast">
                <!-- Contrast dictionaries use system brush resources directly so Windows owns
                     the foreground/background pairing and no product colour is baked in. -->
                <StaticResource x:Key="MuesliBackgroundBrush" ResourceKey="SystemColorWindowColorBrush" />
                <StaticResource x:Key="MuesliBackgroundDeepBrush" ResourceKey="SystemColorWindowColorBrush" />
                <StaticResource x:Key="MuesliSidebarBrush" ResourceKey="SystemColorWindowColorBrush" />
                <StaticResource x:Key="MuesliSurfaceBrush" ResourceKey="SystemColorWindowColorBrush" />
                <StaticResource x:Key="MuesliSurfaceRaisedBrush" ResourceKey="SystemColorWindowColorBrush" />
                <StaticResource x:Key="MuesliRaisedBrush" ResourceKey="SystemColorWindowColorBrush" />
                <StaticResource x:Key="MuesliRaisedSurfaceBrush" ResourceKey="SystemColorWindowColorBrush" />
                <StaticResource x:Key="MuesliHoverBrush" ResourceKey="SystemColorHighlightColorBrush" />
                <StaticResource x:Key="MuesliSelectedBrush" ResourceKey="SystemColorHighlightColorBrush" />
                <StaticResource x:Key="MuesliBorderBrush" ResourceKey="SystemColorWindowTextColorBrush" />
                <StaticResource x:Key="MuesliBorderSoftBrush" ResourceKey="SystemColorWindowTextColorBrush" />
                <StaticResource x:Key="MuesliTextPrimaryBrush" ResourceKey="SystemColorWindowTextColorBrush" />
                <StaticResource x:Key="MuesliTextSecondaryBrush" ResourceKey="SystemColorWindowTextColorBrush" />
                <StaticResource x:Key="MuesliTextTertiaryBrush" ResourceKey="SystemColorGrayTextColorBrush" />
                <StaticResource x:Key="MuesliAccentBrush" ResourceKey="SystemColorHotlightColorBrush" />
                <StaticResource x:Key="MuesliAccentMutedBrush" ResourceKey="SystemColorWindowColorBrush" />
                <StaticResource x:Key="MuesliAccentStrongBrush" ResourceKey="SystemColorHighlightColorBrush" />
                <StaticResource x:Key="MuesliSuccessBrush" ResourceKey="SystemColorWindowTextColorBrush" />
                <StaticResource x:Key="MuesliSuccessMutedBrush" ResourceKey="SystemColorWindowColorBrush" />
                <StaticResource x:Key="MuesliWarningBrush" ResourceKey="SystemColorWindowTextColorBrush" />
                <StaticResource x:Key="MuesliErrorBrush" ResourceKey="SystemColorWindowTextColorBrush" />
                <StaticResource x:Key="MuesliErrorMutedBrush" ResourceKey="SystemColorWindowColorBrush" />
                <StaticResource x:Key="MuesliTextDisabledBrush" ResourceKey="SystemColorGrayTextColorBrush" />
                <StaticResource x:Key="MuesliControlFillBrush" ResourceKey="SystemColorButtonFaceColorBrush" />
                <StaticResource x:Key="MuesliControlHoverBrush" ResourceKey="SystemColorHighlightColorBrush" />
                <StaticResource x:Key="MuesliControlPressedBrush" ResourceKey="SystemColorHighlightColorBrush" />
                <StaticResource x:Key="MuesliControlDisabledBrush" ResourceKey="SystemColorButtonFaceColorBrush" />
                <StaticResource x:Key="MuesliBorderStrongBrush" ResourceKey="SystemColorButtonTextColorBrush" />
                <StaticResource x:Key="MuesliFocusOuterBrush" ResourceKey="SystemColorHighlightColorBrush" />
                <StaticResource x:Key="MuesliFocusInnerBrush" ResourceKey="SystemColorHighlightTextColorBrush" />
                <!--
                    High Contrast may only alias SystemColor* and cannot set Opacity. A full-window
                    text-colored overlay would hide the page, so the feature-tour scrim is cleared
                    to transparent in MainPage when Contrast themes are active.
                -->
                <StaticResource x:Key="MuesliOverlayBrush" ResourceKey="SystemColorWindowTextColorBrush" />
                <StaticResource x:Key="FocusStrokeColorOuterBrush" ResourceKey="SystemColorHighlightColorBrush" />
                <StaticResource x:Key="FocusStrokeColorInnerBrush" ResourceKey="SystemColorHighlightTextColorBrush" />
            </ResourceDictionary>
        </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>

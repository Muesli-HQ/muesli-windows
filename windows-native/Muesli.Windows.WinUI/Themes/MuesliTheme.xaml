                <!--
                    platform accent.

                    Overriding SystemAccentColor alone is NOT enough. WinUI derives its accent
                    chrome from the *ramp* colours, not from SystemAccentColor: in a dark
                    dictionary generic.xaml declares
                        AccentFillColorDefaultBrush   Color="{ThemeResource SystemAccentColorLight2}"
                        AccentTextFillColorPrimary…   Color="{ThemeResource SystemAccentColorLight3}"
                        TextControlElevationBorderFocusedBrush  stop Color="{ThemeResource SystemAccentColorLight2}"
                    and then aliases every control leaf with *StaticResource*, e.g.
                        <StaticResource x:Key="ToggleSwitchFillOn"   ResourceKey="AccentFillColorDefaultBrush" />
                        <StaticResource x:Key="ProgressBarForeground" ResourceKey="AccentFillColorDefaultBrush" />
                    A StaticResource alias binds to generic.xaml's own brush instance, so an app
                    override of AccentFillColorDefaultBrush never reaches the ToggleSwitch, the
                    ProgressBar or the TextBox focus underline — which is why those rendered in the
                    OS accent while buttons rendered Muesli blue. Overriding the ramp colours fixes
                    the whole derived family in one place, so no page needs a local palette.
                    Contrast themes are untouched: generic.xaml maps the same leaves to
                    SystemColor* brushes there and Windows owns that pairing.
                -->
                <Color x:Key="SystemAccentColor">#6BA3F7</Color>
                <Color x:Key="SystemAccentColorLight1">#4A85EC</Color>
                <Color x:Key="SystemAccentColorLight2">#2F6FE0</Color>
                <Color x:Key="SystemAccentColorLight3">#6BA3F7</Color>
                <Color x:Key="SystemAccentColorDark1">#2A63C8</Color>
                <Color x:Key="SystemAccentColorDark2">#24559F</Color>
                <Color x:Key="SystemAccentColorDark3">#1D4680</Color>
                <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#2F6FE0" />
                <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#3F7BE6" />
                <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#2A63C8" />
                <SolidColorBrush x:Key="AccentFillColorDisabledBrush" Color="#262830" />
                <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FFFFFFFF" />
                <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#C8FFFFFF" />

                <!-- navigation: macOS-style filled pill, no left indicator bar -->
                <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#2E3340" />
                <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Color="#2E3340" />
                <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPressed" Color="#2E3340" />
                <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="#EBFFFFFF" />
                <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPointerOver" Color="#EBFFFFFF" />
                <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPressed" Color="#EBFFFFFF" />
                <SolidColorBrush x:Key="NavigationViewItemForeground" Color="#9EFFFFFF" />
                <SolidColorBrush x:Key="NavigationViewItemForegroundPointerOver" Color="#EBFFFFFF" />
                <SolidColorBrush x:Key="NavigationViewItemForegroundPressed" Color="#EBFFFFFF" />
                <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="#232528" />
                <SolidColorBrush x:Key="NavigationViewItemBackgroundPressed" Color="#2E3340" />
                <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="Transparent" />

                <!-- segmented control: filled selected segment, no underline pill -->
                <SolidColorBrush x:Key="SelectorBarItemBackgroundSelected" Color="#2F6FE0" />
                <SolidColorBrush x:Key="SelectorBarItemForegroundSelected" Color="#FFFFFFFF" />
                <SolidColorBrush x:Key="SelectorBarItemBackground" Color="Transparent" />
                <SolidColorBrush x:Key="SelectorBarItemForeground" Color="#9EFFFFFF" />

<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Muesli.Windows.WinUI.ComputerUseConfirmationWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Review Computer Use action">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>
    <Border
        x:Name="RootBorder"
        Padding="24"
        Background="{ThemeResource LayerFillColorDefaultBrush}"
        KeyDown="RootBorder_KeyDown"
        IsTabStop="True"
        KeyboardAcceleratorPlacementMode="Hidden">
        <!-- P8-06: suppress the accelerator tooltip; a non-Control owner strands its popup host. -->
        <Border.KeyboardAccelerators>
            <KeyboardAccelerator Key="Escape" Invoked="DeclineAccelerator_Invoked" />
        </Border.KeyboardAccelerators>
        <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="14">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <Border
                    x:Name="HeaderGlyph"
                    Width="38"
                    Height="38"
                    Background="{ThemeResource MuesliAccentMutedBrush}"
                    CornerRadius="19">
                    <FontIcon
                        x:Name="HeaderIcon"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontFamily="{ThemeResource SymbolThemeFontFamily}"
                        FontSize="18"
                        Foreground="{ThemeResource MuesliAccentBrush}"
                        Glyph="&#xE72E;" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock
                        FontSize="22"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource MuesliTextPrimaryBrush}"
                        Text="Review Computer Use action"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Style="{StaticResource MuesliBodyStyle}"
                        Text="Muesli is ready to interact with another app." />
                </StackPanel>
            </Grid>

            <Grid
                Grid.Row="1"
                ColumnDefinitions="Auto,*"
                ColumnSpacing="8">
                <Border x:Name="RiskBadge" Style="{StaticResource MuesliAccentBadgeStyle}">
                    <TextBlock
                        x:Name="RiskBadgeText"
                        Style="{StaticResource MuesliAccentBadgeTextStyle}"
                        Text="STANDARD" />
                </Border>
                <TextBlock
                    x:Name="RiskSummaryText"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Style="{StaticResource MuesliBodyStyle}"
                    FontSize="13"
                    Text="Risk: None. Review the exact action below. This preview stays local and is not saved." />
            </Grid>

            <StackPanel Grid.Row="2" Spacing="8">
                <InfoBar
                    x:Name="RiskBar"
                    IsClosable="False"
                    IsOpen="True"
                    Severity="Informational"
                    Title="Your approval is required" />
                <TextBlock
                    x:Name="NoticeText"
                    Style="{StaticResource MuesliBodyStyle}"
                    TextWrapping="Wrap"
                    AutomationProperties.AutomationId="ComputerUseConfirmationNotice" />
            </StackPanel>

            <StackPanel Grid.Row="3" Spacing="8">
                <TextBlock Style="{StaticResource MuesliSectionLabelStyle}" Text="PLANNED ACTION PREVIEW" />
                <Border
                    Padding="14"
                    Background="{ThemeResource MuesliSurfaceBrush}"
                    BorderBrush="{ThemeResource MuesliBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10">
                    <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                        <TextBox
                            x:Name="PreviewText"
                            Padding="0"
                            AcceptsReturn="True"
                            Background="{ThemeResource ControlFillColorTransparentBrush}"
                            BorderThickness="0"
                            FontFamily="Consolas, Cascadia Mono, monospace"
                            FontSize="13"
                            Foreground="{ThemeResource MuesliTextPrimaryBrush}"
                            IsReadOnly="True"
                            IsTabStop="True"
                            TextWrapping="Wrap"
                            AutomationProperties.AutomationId="ComputerUseConfirmationPreview"
                            AutomationProperties.Name="Computer Use action preview" />
                    </ScrollViewer>
                </Border>
            </StackPanel>
            <Grid Grid.Row="4" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                <TextBlock
                    VerticalAlignment="Center"
                    Style="{StaticResource MuesliBodyStyle}"
                    FontSize="12"
                    Text="Press Escape or Decline to cancel."
                    TextWrapping="Wrap" />
                <Button
                    x:Name="DeclineButton"
                    Grid.Column="1"
                    Style="{StaticResource MuesliGhostButtonStyle}"
                    AutomationProperties.AutomationId="ComputerUseDeclineButton"
                    AutomationProperties.Name="Decline Computer Use action"
                    Click="Decline_Click"
                    Content="Decline" />
                <Button
                    x:Name="AllowButton"
                    Grid.Column="2"
                    Style="{StaticResource MuesliPrimaryButtonStyle}"
                    AutomationProperties.AutomationId="ComputerUseAllowButton"
                    AutomationProperties.Name="Allow Computer Use action"
                    Click="Allow_Click"
                    Content="Allow action" />
            </Grid>
        </Grid>
    </Border>
</Window>

<?xml version="1.0" encoding="utf-8" ?>
<Window x:Class="Muesli.Windows.WinUI.MeetingLiveTranscriptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Muesli.Windows.WinUI.Controls" Title="Live meeting transcript">
    <Window.SystemBackdrop><DesktopAcrylicBackdrop /></Window.SystemBackdrop>
    <Border x:Name="RootBorder" Background="{ThemeResource MuesliSurfaceRaisedBrush}"
            BorderBrush="{ThemeResource MuesliBorderBrush}" BorderThickness="1" CornerRadius="8"
            PointerEntered="Panel_PointerEntered" PointerExited="Panel_PointerExited"
            KeyboardAcceleratorPlacementMode="Hidden">
        <Border.KeyboardAccelerators><KeyboardAccelerator Key="Escape" Invoked="DismissAccelerator_Invoked" /></Border.KeyboardAccelerators>
        <Grid RowDefinitions="42,Auto,*">
            <Grid ColumnDefinitions="*,Auto,Auto,24,24" ColumnSpacing="8" Padding="16,0">
                <Button Content="Live transcript" FontSize="13" FontWeight="SemiBold" Padding="0" MinHeight="0"
                        HorizontalAlignment="Left" Style="{StaticResource MuesliGhostButtonStyle}"
                        Click="OpenNotes_Click" AutomationProperties.AutomationId="LiveTranscriptOpenNotes"
                        AutomationProperties.Name="Open meeting notes" ToolTipService.ToolTip="Open meeting notes" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                    <Ellipse x:Name="StateDot" Width="6" Height="6" Fill="{ThemeResource MuesliSuccessBrush}" />
                    <TextBlock x:Name="StateLabel" Text="Live" FontSize="11" Foreground="{ThemeResource MuesliTextSecondaryBrush}" />
                </StackPanel>
                <FontIcon x:Name="WarningIcon" Grid.Column="2" Glyph="&#xE7BA;" FontSize="12" Foreground="{ThemeResource MuesliWarningBrush}" Visibility="Collapsed" AutomationProperties.Name="Capture warning" />
                <Button Grid.Column="3" Width="24" Height="24" MinWidth="24" MinHeight="24" Padding="0"
                        Style="{StaticResource MuesliGhostButtonStyle}" Click="Dismiss_Click"
                        AutomationProperties.AutomationId="LiveTranscriptDismiss" AutomationProperties.Name="Hide live transcript"
                        ToolTipService.ToolTip="Hide live transcript"><FontIcon Glyph="&#xE70D;" FontSize="12" /></Button>
                <Button x:Name="CopyButton" Grid.Column="4" Width="24" Height="24" MinWidth="24" MinHeight="24" Padding="0"
                        Style="{StaticResource MuesliGhostButtonStyle}" Click="Copy_Click"
                        AutomationProperties.AutomationId="LiveTranscriptCopy" AutomationProperties.Name="Copy live transcript"
                        ToolTipService.ToolTip="Copy transcript"><FontIcon Glyph="&#xE8C8;" FontSize="12" /></Button>
            </Grid>
            <Border Grid.Row="1" Height="1" Background="{ThemeResource MuesliBorderBrush}" />
            <controls:LiveTranscriptFeed x:Name="TranscriptFeed" Grid.Row="2" AutomationProperties.Name="Live meeting transcript"
                                         AutomationProperties.AutomationId="LiveTranscriptText" />
        </Grid>
    </Border>
</Window>

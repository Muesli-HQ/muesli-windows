<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Muesli.Windows.WinUI.DictionarySuggestionPromptWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Muesli dictionary suggestion">

    <!--
      Geometry and colours are macOS DictionarySuggestionPromptController's: a 356x96 card inset by
      half the 22-point close button (12) from the panel's top and left, the close button centred on
      the card's top-left corner, a 5-point countdown track along the card's bottom.
    -->
    <Canvas x:Name="Root" Background="Transparent">
        <Canvas.Resources>
            <SolidColorBrush x:Key="SuggestionCardBrush" Color="#F71A1A1F" />
            <SolidColorBrush x:Key="SuggestionBorderBrush" Color="#1AFFFFFF" />
            <SolidColorBrush x:Key="SuggestionTrackBrush" Color="#1AFFFFFF" />
            <SolidColorBrush x:Key="SuggestionProgressBrush" Color="#FF3D8FFF" />
            <SolidColorBrush x:Key="SuggestionIconBrush" Color="#DBFFFFFF" />
            <SolidColorBrush x:Key="SuggestionTitleBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="SuggestionDetailBrush" Color="#B8FFFFFF" />
            <SolidColorBrush x:Key="SuggestionPrimaryBrush" Color="#FF3380FF" />
            <SolidColorBrush x:Key="SuggestionSecondaryBrush" Color="#1FFFFFFF" />
            <SolidColorBrush x:Key="SuggestionButtonTextBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="SuggestionCloseBrush" Color="#B3000000" />
            <SolidColorBrush x:Key="SuggestionCloseBorderBrush" Color="#8CFFFFFF" />
            <SolidColorBrush x:Key="SuggestionCloseGlyphBrush" Color="#DBFFFFFF" />
        </Canvas.Resources>

        <Border
            x:Name="Card"
            Width="356"
            Height="96"
            Canvas.Left="12"
            Canvas.Top="12"
            Background="{StaticResource SuggestionCardBrush}"
            BorderBrush="{StaticResource SuggestionBorderBrush}"
            BorderThickness="1"
            CornerRadius="10">
            <Canvas>
                <FontIcon
                    x:Name="BookIcon"
                    Canvas.Left="13"
                    Canvas.Top="17"
                    Width="24"
                    Height="24"
                    FontSize="17"
                    FontWeight="SemiBold"
                    Glyph="&#xE82D;"
                    Foreground="{StaticResource SuggestionIconBrush}"
                    AutomationProperties.AccessibilityView="Raw" />

                <TextBlock
                    x:Name="TitleText"
                    Canvas.Left="49"
                    Canvas.Top="11"
                    Width="292"
                    Text="Add correction?"
                    FontFamily="{StaticResource MuesliFontFamilySemiBold}"
                    FontSize="13"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap"
                    Foreground="{StaticResource SuggestionTitleBrush}" />

                <TextBlock
                    x:Name="DetailText"
                    Canvas.Left="49"
                    Canvas.Top="34"
                    Width="292"
                    FontFamily="{StaticResource MuesliFontFamily}"
                    FontSize="13"
                    TextWrapping="NoWrap"
                    Foreground="{StaticResource SuggestionDetailBrush}" />

                <Button
                    x:Name="AddButton"
                    Canvas.Left="181"
                    Canvas.Top="54"
                    Width="76"
                    Height="28"
                    Padding="0"
                    BorderThickness="0"
                    CornerRadius="6"
                    Background="{StaticResource SuggestionPrimaryBrush}"
                    Foreground="{StaticResource SuggestionButtonTextBrush}"
                    FontFamily="{StaticResource MuesliFontFamilyMedium}"
                    FontSize="12"
                    Content="Add" />

                <Button
                    x:Name="IgnoreButton"
                    Canvas.Left="265"
                    Canvas.Top="54"
                    Width="76"
                    Height="28"
                    Padding="0"
                    BorderThickness="0"
                    CornerRadius="6"
                    Background="{StaticResource SuggestionSecondaryBrush}"
                    Foreground="{StaticResource SuggestionButtonTextBrush}"
                    FontFamily="{StaticResource MuesliFontFamilyMedium}"
                    FontSize="12"
                    Content="Ignore" />

                <!-- Countdown: drains from full width to nothing over 15 seconds, paused on hover. -->
                <Border
                    x:Name="CountdownTrack"
                    Canvas.Left="0"
                    Canvas.Top="89"
                    Width="354"
                    Height="5"
                    Background="{StaticResource SuggestionTrackBrush}">
                    <Border
                        x:Name="CountdownBar"
                        HorizontalAlignment="Left"
                        Width="354"
                        Background="{StaticResource SuggestionProgressBrush}"
                        RenderTransformOrigin="0,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="CountdownScale" ScaleX="1" ScaleY="1" />
                        </Border.RenderTransform>
                    </Border>
                </Border>
            </Canvas>
        </Border>

        <!-- 22-point visual centred on the card's corner; 34-point hit target, as on the meeting notification. -->
        <Button
            x:Name="DismissButton"
            Width="34"
            Height="34"
            Canvas.Left="-5"
            Canvas.Top="-6"
            Padding="0"
            Background="Transparent"
            BorderThickness="0"
            CornerRadius="17">
            <Border
                x:Name="DismissVisual"
                Width="22"
                Height="22"
                Background="{StaticResource SuggestionCloseBrush}"
                BorderBrush="{StaticResource SuggestionCloseBorderBrush}"
                BorderThickness="1"
                CornerRadius="11">
                <TextBlock
                    x:Name="DismissGlyph"
                    Text="&#x2715;"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontFamily="{StaticResource MuesliFontFamilyMedium}"
                    FontSize="11"
                    Foreground="{StaticResource SuggestionCloseGlyphBrush}" />
            </Border>
        </Button>
    </Canvas>
</Window>

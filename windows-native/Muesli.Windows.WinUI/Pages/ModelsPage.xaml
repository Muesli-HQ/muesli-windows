<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Muesli.Windows.WinUI.Pages.ModelsPage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Muesli.Windows.WinUI.Pages"
    xmlns:viewModels="using:Muesli.Windows.WinUI.ViewModels">
    <Page.Resources>
        <local:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <local:BooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" Invert="True" />
        <local:VendorLogoConverter x:Key="VendorLogoConverter" />
        <!-- macOS ModelsView cards: 16pt padding, raised surface, medium corner, 1pt border. -->
        <Style x:Key="ModelCardStyle" TargetType="Border" BasedOn="{StaticResource MuesliCardStyle}">
            <Setter Property="Padding" Value="16" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
        <Style x:Key="ModelStatusChipStyle" TargetType="Border" BasedOn="{StaticResource MuesliBadgeStyle}">
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style x:Key="ModelActiveChipStyle" TargetType="Border" BasedOn="{StaticResource MuesliSuccessBadgeStyle}">
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style x:Key="ModelErrorChipStyle" TargetType="Border" BasedOn="{StaticResource MuesliBadgeStyle}">
            <Setter Property="Background" Value="{ThemeResource MuesliErrorMutedBrush}" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style x:Key="ModelErrorChipTextStyle" TargetType="TextBlock" BasedOn="{StaticResource MuesliBadgeTextStyle}">
            <Setter Property="Foreground" Value="{ThemeResource MuesliErrorBrush}" />
        </Style>
        <!-- The family's default/recommended capsule beside the title. -->
        <Style x:Key="ModelFamilyBadgeStyle" TargetType="Border" BasedOn="{StaticResource MuesliAccentBadgeStyle}">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="8,3" />
        </Style>
        <Style x:Key="ModelTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource MuesliRowTitleStyle}">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="NoWrap" />
        </Style>
        <Style x:Key="ModelCaptionStyle" TargetType="TextBlock" BasedOn="{StaticResource MuesliBodyStyle}">
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style x:Key="ModelMetaLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource MuesliTextTertiaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <!--
            P6-02. The variant is a popup button (macOS ModelsView picker, menu style, 220 wide);
            the WinUI equivalent carries the chevron, pressed state, and UIA ExpandCollapse.
        -->
        <Style x:Key="ModelPickerStyle" TargetType="ComboBox">
            <Setter Property="Width" Value="220" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="CornerRadius" Value="{ThemeResource MuesliControlCornerRadius}" />
        </Style>
        <!-- macOS action buttons are small tinted pills: accent for the next step, neutral otherwise. -->
        <Style x:Key="ModelAccentPillStyle" TargetType="Button" BasedOn="{StaticResource MuesliGhostButtonStyle}">
            <Setter Property="Background" Value="{ThemeResource MuesliAccentMutedBrush}" />
            <Setter Property="Foreground" Value="{ThemeResource MuesliAccentBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="MinWidth" Value="0" />
        </Style>
        <Style x:Key="ModelNeutralPillStyle" TargetType="Button" BasedOn="{StaticResource MuesliGhostButtonStyle}">
            <Setter Property="Background" Value="{ThemeResource MuesliSurfaceRaisedBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="MinWidth" Value="0" />
        </Style>
        <Style x:Key="ModelDeleteButtonStyle" TargetType="Button" BasedOn="{StaticResource MuesliGhostButtonStyle}">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="MinWidth" Value="28" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="{ThemeResource MuesliErrorBrush}" />
            <Setter Property="Opacity" Value="0.75" />
        </Style>
    </Page.Resources>

    <Grid Background="{ThemeResource MuesliBackgroundBrush}">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ContentStack"
                        Padding="{StaticResource MuesliPageContentPadding}"
                        Spacing="20"
                        HorizontalAlignment="Left"
                        MaxWidth="{StaticResource MuesliPageContentMaxWidth}">
                <!-- macOS hierarchy: title, one subtitle, a centred segmented control, then cards. -->
                <StackPanel Spacing="6">
                    <TextBlock Text="Models" Style="{StaticResource MuesliPageTitleStyle}" />
                    <TextBlock Text="Choose the dictation, live meeting, and cleanup models that fit how you speak and work."
                               Style="{StaticResource MuesliPageSubtitleStyle}" />
                </StackPanel>

                <Border Style="{StaticResource MuesliSegmentedContainerStyle}" HorizontalAlignment="Center">
                    <SelectorBar x:Name="CategoryBar"
                                 SelectionChanged="CategoryBar_SelectionChanged"
                                 AutomationProperties.Name="Model category"
                                 AutomationProperties.AutomationId="ModelsRolePicker">
                        <SelectorBarItem Text="Dictation" Tag="0" IsSelected="True" AutomationProperties.Name="Show dictation models" />
                        <SelectorBarItem Text="Live Meetings" Tag="1" AutomationProperties.Name="Show live meeting models" />
                        <SelectorBarItem Text="Cleanup" Tag="2" AutomationProperties.Name="Show cleanup models" />
                    </SelectorBar>
                </Border>

                <InfoBar x:Name="StatusBar"
                         IsOpen="{x:Bind ViewModel.IsStatusOpen, Mode=TwoWay}"
                         Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                         AutomationProperties.AutomationId="ModelsStatus" />

                <StackPanel x:Name="ModelsPanel" Spacing="12">
                    <!-- macOS labels each role's list; the text says what the role actually drives on Windows. -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="{x:Bind ViewModel.RoleSectionTitle, Mode=OneWay}"
                                   Style="{StaticResource MuesliSectionLabelStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.RoleDescription, Mode=OneWay}"
                                   Style="{StaticResource MuesliBodyStyle}"
                                   TextWrapping="WrapWholeWords"
                                   AutomationProperties.AutomationId="ModelsRoleDescription" />
                    </StackPanel>
                    <Border x:Name="EmptyState"
                            Style="{StaticResource ModelCardStyle}"
                            Padding="24"
                            MinHeight="140"
                            Visibility="Collapsed"
                            AutomationProperties.Name="No transcription models">
                        <StackPanel Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="No transcription models to show"
                                       Style="{StaticResource MuesliRowTitleStyle}" />
                            <!-- No card is on screen here, so this must not promise per-card actions. -->
                            <TextBlock Text="The local model catalog could not be loaded."
                                       Style="{StaticResource MuesliBodyStyle}" />
                        </StackPanel>
                    </Border>

                    <!--
                        P6-04 / TEST-03. ItemsRepeater has no automation peer, so the list is an
                        ItemsControl, addressable as ModelFamilyList.
                    -->
                    <ItemsControl x:Name="ModelList"
                                  ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                                  HorizontalContentAlignment="Stretch"
                                  AutomationProperties.AutomationId="ModelFamilyList"
                                  AutomationProperties.Name="Transcription model families">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="12" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="viewModels:ModelFamilyCardItem">
                                <Grid AutomationProperties.Name="{Binding AccessibleName}"
                                      AutomationProperties.AutomationId="{Binding CardAutomationId}">
                                    <Border Style="{StaticResource ModelCardStyle}">
                                        <StackPanel Spacing="12">
                                            <!-- Header: vendor mark, family name + badge, summary, status. -->
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                                <!-- macOS brandLogo: a 32pt white tile for raster marks. -->
                                                <Grid Width="32" Height="32"
                                                      VerticalAlignment="Top"
                                                      ToolTipService.ToolTip="{Binding VendorAccessibleName}"
                                                      AutomationProperties.Name="{Binding VendorAccessibleName}">
                                                    <Border CornerRadius="8"
                                                            Background="White"
                                                            Visibility="{Binding HasTileLogo, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <Image Source="{Binding LogoFile, Converter={StaticResource VendorLogoConverter}}"
                                                               Width="24" Height="24"
                                                               Stretch="Uniform" />
                                                    </Border>
                                                    <!-- macOS draws the OpenAI knot in the primary text colour, untiled. -->
                                                    <Viewbox Width="23" Height="23"
                                                             Visibility="{Binding UsesOpenAiGlyph, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <Path Fill="{ThemeResource MuesliTextPrimaryBrush}"
                                                              Data="F1 M22.2819,9.8211 C22.8248,8.1862 22.6369,6.3967 21.7662,4.9103 C20.4571,2.6316 17.8260,1.4595 15.2564,2.0103 C12.1364,-1.4602 6.4298,-0.2543 4.9807,4.1818 C3.2928,4.5279 1.8360,5.5847 0.9830,7.0818 C-0.3404,9.3568 -0.0401,12.2267 1.7257,14.1784 C1.1808,15.8125 1.3670,17.6022 2.2367,19.0891 C3.5475,21.3686 6.1803,22.5406 8.7513,21.9892 C9.8948,23.2770 11.5377,24.0097 13.2599,24.0000 C15.8937,24.0024 18.2271,22.3021 19.0317,19.7942 C20.7194,19.4475 22.1760,18.3908 23.0294,16.8941 C24.3368,14.6231 24.0351,11.7688 22.2819,9.8212 Z M13.2599,22.4292 C12.2086,22.4309 11.1903,22.0624 10.3835,21.3884 L10.5254,21.3080 L15.3037,18.5498 C15.5456,18.4079 15.6949,18.1490 15.6964,17.8685 L15.6964,11.1316 L17.7164,12.3002 C17.7367,12.3105 17.7508,12.3298 17.7544,12.3522 L17.7544,17.9348 C17.7491,20.4148 15.7399,22.4240 13.2599,22.4292 Z M3.5992,18.3038 C3.0720,17.3934 2.8827,16.3263 3.0646,15.2901 L3.2066,15.3753 L7.9896,18.1335 C8.2306,18.2749 8.5292,18.2749 8.7702,18.1335 L14.6130,14.7650 L14.6130,17.0974 C14.6119,17.1219 14.5997,17.1445 14.5798,17.1589 L9.7400,19.9502 C7.5893,21.1891 4.8416,20.4525 3.5992,18.3038 Z M2.3408,7.8956 C2.8717,6.9794 3.7096,6.2805 4.7063,5.9228 L4.7063,11.6000 C4.7026,11.8793 4.8513,12.1386 5.0942,12.2765 L10.9086,15.6308 L8.8885,16.7993 C8.8663,16.8111 8.8397,16.8111 8.8175,16.7993 L3.9872,14.0128 C1.8408,12.7686 1.1047,10.0230 2.3408,7.8720 Z M18.9371,11.7514 L13.1038,8.3640 L15.1192,7.2000 C15.1414,7.1882 15.1680,7.1882 15.1902,7.2000 L20.0205,9.9913 C23.3136,11.8915 22.9065,16.7676 19.3440,18.0955 L19.3440,12.4183 C19.3355,12.1397 19.1808,11.8863 18.9370,11.7513 Z M20.9478,8.7283 L20.8058,8.6431 L16.0323,5.8613 C15.7898,5.7190 15.4894,5.7190 15.2469,5.8613 L9.4090,9.2297 L9.4090,6.8974 C9.4065,6.8732 9.4174,6.8496 9.4374,6.8359 L14.2677,4.0493 C17.5693,2.1473 21.5928,4.9539 20.9479,8.7093 Z M8.3065,12.8630 L6.2865,11.6992 C6.2660,11.6869 6.2521,11.6661 6.2485,11.6425 L6.2485,6.0742 C6.2535,2.2647 10.6950,0.1849 13.6242,2.6205 L13.4822,2.7010 L8.7040,5.4590 C8.4621,5.6009 8.3128,5.8598 8.3113,6.1403 Z M9.4041,10.4976 L12.0061,8.9978 L14.6130,10.4976 L14.6130,13.4970 L12.0156,14.9967 L9.4089,13.4970 Z" />
                                                    </Viewbox>
                                                    <Border CornerRadius="8"
                                                            Background="{ThemeResource MuesliAccentMutedBrush}"
                                                            Visibility="{Binding HasLogo, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                                        <FontIcon Glyph="{Binding VendorGlyph}"
                                                                  FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                                                  FontSize="16"
                                                                  Foreground="{ThemeResource MuesliAccentBrush}" />
                                                    </Border>
                                                </Grid>
                                                <StackPanel Grid.Column="1" Spacing="4" MinWidth="0">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock Text="{Binding FamilyLabel}" Style="{StaticResource ModelTitleStyle}" />
                                                        <Border Style="{StaticResource ModelFamilyBadgeStyle}"
                                                                Visibility="{Binding HasBadge, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <TextBlock Text="{Binding BadgeLabel}"
                                                                       Style="{StaticResource MuesliAccentBadgeTextStyle}" />
                                                        </Border>
                                                        <!-- A single-variant card has no picker row, so its size sits by the title (macOS modelCard). -->
                                                        <TextBlock Text="{Binding SelectedVariant.SizeCaption}"
                                                                   Style="{StaticResource ModelMetaLabelStyle}"
                                                                   Visibility="{Binding HasVariantPicker, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding FamilySummary}"
                                                               Style="{StaticResource ModelCaptionStyle}" />
                                                </StackPanel>
                                                <Grid Grid.Column="2" VerticalAlignment="Top">
                                                    <Border Style="{StaticResource ModelActiveChipStyle}"
                                                            Visibility="{Binding SelectedVariant.ShowActiveChip, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <TextBlock Text="Active" Style="{StaticResource MuesliSuccessBadgeTextStyle}" />
                                                    </Border>
                                                    <Border Style="{StaticResource ModelStatusChipStyle}"
                                                            Visibility="{Binding SelectedVariant.ShowDownloadedChip, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <TextBlock Text="Downloaded" Style="{StaticResource MuesliBadgeTextStyle}" />
                                                    </Border>
                                                    <Border Style="{StaticResource ModelErrorChipStyle}"
                                                            Visibility="{Binding SelectedVariant.ShowErrorChip, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <TextBlock Text="{Binding SelectedVariant.StatusChipLabel}"
                                                                   Style="{StaticResource ModelErrorChipTextStyle}" />
                                                    </Border>
                                                    <Border Style="{StaticResource ModelStatusChipStyle}"
                                                            Visibility="{Binding SelectedVariant.ShowUnavailableChip, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <TextBlock Text="Unavailable" Style="{StaticResource MuesliBadgeTextStyle}" />
                                                    </Border>
                                                </Grid>
                                            </Grid>

                                            <!-- Variant and language share one label column, as on macOS. -->
                                            <Grid ColumnDefinitions="64,Auto,*" ColumnSpacing="12"
                                                  Visibility="{Binding HasVariantPicker, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock Text="Variant" Style="{StaticResource ModelMetaLabelStyle}" />
                                                <ComboBox Grid.Column="1"
                                                          Style="{StaticResource ModelPickerStyle}"
                                                          ItemsSource="{Binding Variants}"
                                                          SelectedItem="{Binding SelectedVariant, Mode=TwoWay}"
                                                          AutomationProperties.Name="{Binding VariantPickerAccessibleName}"
                                                          AutomationProperties.AutomationId="{Binding VariantPickerAutomationId}">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate x:DataType="viewModels:ModelVariantItem">
                                                            <TextBlock Text="{x:Bind DisplayName}"
                                                                       MaxLines="1"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       AutomationProperties.Name="{x:Bind AccessibleName}" />
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                                <!-- macOS puts the size immediately right of the popup. -->
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding SelectedVariant.SizeCaption}"
                                                           Style="{StaticResource ModelMetaLabelStyle}" />
                                            </Grid>

                                            <!--
                                                Like macOS, the language row appears only when the runtime
                                                offers a real choice; a fixed language is not a control.
                                            -->
                                            <Grid ColumnDefinitions="64,Auto" ColumnSpacing="12"
                                                  Visibility="{Binding SelectedVariant.IsLanguageSelectable, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock Text="Language" Style="{StaticResource ModelMetaLabelStyle}" />
                                                <ComboBox Grid.Column="1"
                                                          Style="{StaticResource ModelPickerStyle}"
                                                          ItemsSource="{Binding SelectedVariant.LanguageOptions}"
                                                          DisplayMemberPath="Label"
                                                          SelectedValuePath="Code"
                                                          SelectedValue="{Binding SelectedVariant.SelectedLanguageCode, Mode=TwoWay}"
                                                          AutomationProperties.Name="{Binding SelectedVariant.LanguageAccessibleName}"
                                                          SelectionChanged="ModelLanguage_SelectionChanged" />
                                            </Grid>

                                            <TextBlock Text="{Binding VariantDescription}"
                                                       Style="{StaticResource ModelCaptionStyle}"
                                                       Visibility="{Binding HasVariantDescription, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                            <StackPanel Spacing="4"
                                                        Visibility="{Binding SelectedVariant.IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <ProgressBar Value="{Binding SelectedVariant.ProgressValue}"
                                                             Maximum="100"
                                                             IsIndeterminate="{Binding SelectedVariant.IsProgressIndeterminate}"
                                                             AutomationProperties.Name="{Binding SelectedVariant.ProgressLabel}"
                                                             AutomationProperties.AutomationId="ModelProgressBar" />
                                                <TextBlock Text="{Binding SelectedVariant.ProgressLabel}"
                                                           Style="{StaticResource ModelMetaLabelStyle}" />
                                            </StackPanel>

                                            <!-- Why an operation is unavailable, derived from the live snapshot. -->
                                            <TextBlock Text="{Binding SelectedVariant.StateNote}"
                                                       Style="{StaticResource ModelMetaLabelStyle}"
                                                       FontSize="12"
                                                       TextWrapping="Wrap"
                                                       AutomationProperties.AutomationId="ModelStateNote"
                                                       Visibility="{Binding SelectedVariant.HasStateNote, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                            <StackPanel Orientation="Horizontal"
                                                        Spacing="8"
                                                        Visibility="{Binding SelectedVariant.HasActions, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <Button Command="{Binding ViewModel.PrepareCommand, ElementName=RootPage}"
                                                        CommandParameter="{Binding SelectedVariant}"
                                                        Style="{StaticResource ModelAccentPillStyle}"
                                                        Visibility="{Binding SelectedVariant.CanPrepare, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                        AutomationProperties.Name="Download model"
                                                        AutomationProperties.AutomationId="ModelDownloadButton"
                                                        Content="Download" />
                                                <Button Command="{Binding ViewModel.SetActiveCommand, ElementName=RootPage}"
                                                        CommandParameter="{Binding SelectedVariant}"
                                                        Style="{StaticResource ModelAccentPillStyle}"
                                                        Visibility="{Binding SelectedVariant.CanSetActive, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                        AutomationProperties.Name="Set model active"
                                                        AutomationProperties.AutomationId="ModelSetActiveButton"
                                                        Content="Set Active" />
                                                <Button Command="{Binding ViewModel.RetryCommand, ElementName=RootPage}"
                                                        CommandParameter="{Binding SelectedVariant}"
                                                        Style="{StaticResource ModelAccentPillStyle}"
                                                        Visibility="{Binding SelectedVariant.CanRetry, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                        AutomationProperties.Name="Retry model operation"
                                                        AutomationProperties.AutomationId="ModelRetryButton"
                                                        Content="Retry" />
                                                <Button Command="{Binding ViewModel.CancelCommand, ElementName=RootPage}"
                                                        CommandParameter="{Binding SelectedVariant}"
                                                        Style="{StaticResource ModelNeutralPillStyle}"
                                                        Visibility="{Binding SelectedVariant.CanCancel, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                        AutomationProperties.Name="Cancel model operation"
                                                        AutomationProperties.AutomationId="ModelCancelButton"
                                                        Content="Cancel" />
                                                <Button Command="{Binding ViewModel.VerifyCommand, ElementName=RootPage}"
                                                        CommandParameter="{Binding SelectedVariant}"
                                                        Style="{StaticResource ModelNeutralPillStyle}"
                                                        Visibility="{Binding SelectedVariant.CanVerify, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                        ToolTipService.ToolTip="Check the downloaded files against their checksums"
                                                        AutomationProperties.Name="Verify model files"
                                                        AutomationProperties.AutomationId="ModelVerifyButton"
                                                        Content="Verify files" />
                                                <Button Command="{Binding ViewModel.DeleteCommand, ElementName=RootPage}"
                                                        CommandParameter="{Binding SelectedVariant}"
                                                        Style="{StaticResource ModelDeleteButtonStyle}"
                                                        Visibility="{Binding SelectedVariant.CanDelete, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                        ToolTipService.ToolTip="Delete local model files"
                                                        AutomationProperties.Name="Delete transcription model"
                                                        AutomationProperties.AutomationId="ModelDeleteButton">
                                                    <FontIcon Glyph="&#xE74D;" FontSize="13" />
                                                </Button>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <!-- macOS: the active card's border is the accent at half strength, 1.5pt. -->
                                    <Border BorderBrush="{ThemeResource MuesliAccentBrush}"
                                            BorderThickness="1.5"
                                            Opacity="0.6"
                                            CornerRadius="10"
                                            IsHitTestVisible="False"
                                            Visibility="{Binding SelectedVariant.IsActive, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!--
                        Windows-only: the ONNX execution provider. macOS has no equivalent (Core ML
                        picks the Neural Engine itself), so it sits after the models as one compact
                        card, with the CUDA pack and diagnostics folded away until asked for.
                    -->
                    <Border x:Name="AccelerationCard"
                            Style="{StaticResource ModelCardStyle}"
                            Margin="0,8,0,0"
                            AutomationProperties.Name="Transcription acceleration"
                            AutomationProperties.AutomationId="ModelsAccelerationCard">
                        <StackPanel Spacing="12">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <Border Width="32" Height="32" CornerRadius="8"
                                        VerticalAlignment="Top"
                                        Background="{ThemeResource MuesliAccentMutedBrush}">
                                    <FontIcon Glyph="&#xE950;"
                                              FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                              FontSize="16"
                                              Foreground="{ThemeResource MuesliAccentBrush}" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="4" MinWidth="0">
                                    <TextBlock Text="Transcription acceleration" Style="{StaticResource ModelTitleStyle}" />
                                    <TextBlock Text="{x:Bind ViewModel.AccelerationStatusLine, Mode=OneWay}"
                                               Style="{StaticResource ModelCaptionStyle}"
                                               AutomationProperties.AutomationId="ModelsAccelerationStatus" />
                                </StackPanel>
                                <ComboBox Grid.Column="2"
                                          Style="{StaticResource ModelPickerStyle}"
                                          VerticalAlignment="Top"
                                          ItemsSource="{x:Bind ViewModel.ProviderOptions}"
                                          SelectedValuePath="Value"
                                          DisplayMemberPath="Label"
                                          SelectedValue="{x:Bind ViewModel.SelectedProviderValue, Mode=TwoWay}"
                                          IsEnabled="{x:Bind ViewModel.CanChangeProvider, Mode=OneWay}"
                                          AutomationProperties.Name="Execution provider"
                                          AutomationProperties.AutomationId="ModelsProviderPicker" />
                            </Grid>

                            <InfoBar IsOpen="{x:Bind ViewModel.IsRestartRequired, Mode=OneWay}"
                                     Severity="Warning"
                                     Title="Restart Muesli to apply this provider"
                                     Message="{x:Bind ViewModel.RestartRequiredMessage, Mode=OneWay}"
                                     AutomationProperties.AutomationId="ModelsRestartRequired">
                                <InfoBar.ActionButton>
                                    <Button Content="Restart Muesli"
                                            Command="{x:Bind ViewModel.RestartCommand}"
                                            Style="{StaticResource MuesliPrimaryButtonStyle}"
                                            AutomationProperties.Name="Restart Muesli" />
                                </InfoBar.ActionButton>
                            </InfoBar>

                            <Expander
                                      Background="Transparent"
                                      BorderThickness="0"
                                      HorizontalAlignment="Stretch"
                                      HorizontalContentAlignment="Left"
                                      IsExpanded="{x:Bind ViewModel.IsAccelerationDetailsOpen, Mode=TwoWay}"
                                      AutomationProperties.AutomationId="ModelsAccelerationDetails">
                                <Expander.Resources>
                                    <SolidColorBrush x:Key="ExpanderHeaderBackground" Color="Transparent" />
                                    <SolidColorBrush x:Key="ExpanderHeaderBorderBrush" Color="Transparent" />
                                    <SolidColorBrush x:Key="ExpanderContentBackground" Color="Transparent" />
                                    <SolidColorBrush x:Key="ExpanderContentBorderBrush" Color="Transparent" />
                                    <Thickness x:Key="ExpanderHeaderPadding">0,0,4,0</Thickness>
                                    <Thickness x:Key="ExpanderContentPadding">0,4,0,0</Thickness>
                                    <x:Double x:Key="ExpanderMinHeight">36</x:Double>
                                </Expander.Resources>
                                <Expander.Header>
                                    <TextBlock Text="Diagnostics and CUDA pack" Style="{StaticResource ModelMetaLabelStyle}" />
                                </Expander.Header>
                                <StackPanel Spacing="10">
                                    <TextBlock Text="{x:Bind ViewModel.CudaPackStatusLine, Mode=OneWay}"
                                               Style="{StaticResource ModelCaptionStyle}"
                                               Foreground="{ThemeResource MuesliTextPrimaryBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.AccelerationDetailText, Mode=OneWay}"
                                               Style="{StaticResource ModelCaptionStyle}"
                                               IsTextSelectionEnabled="True" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="Install CUDA pack"
                                                Command="{x:Bind ViewModel.InstallCudaPackCommand}"
                                                Style="{StaticResource ModelAccentPillStyle}"
                                                AutomationProperties.Name="Install CUDA acceleration pack"
                                                AutomationProperties.AutomationId="ModelsCudaPackInstall" />
                                        <Button Content="Verify"
                                                Command="{x:Bind ViewModel.VerifyCudaPackCommand}"
                                                Style="{StaticResource ModelNeutralPillStyle}"
                                                AutomationProperties.Name="Verify CUDA acceleration pack"
                                                AutomationProperties.AutomationId="ModelsCudaPackVerify" />
                                        <Button Content="Re-run GPU check"
                                                Command="{x:Bind ViewModel.RequalifyGpuCommand}"
                                                Style="{StaticResource ModelNeutralPillStyle}"
                                                AutomationProperties.Name="Re-run GPU qualification"
                                                AutomationProperties.AutomationId="ModelsGpuRequalify" />
                                        <Button Content="Delete pack"
                                                Command="{x:Bind ViewModel.DeleteCudaPackCommand}"
                                                IsEnabled="{x:Bind ViewModel.CanDeleteCudaPack, Mode=OneWay}"
                                                Style="{StaticResource ModelNeutralPillStyle}"
                                                Foreground="{ThemeResource MuesliErrorBrush}"
                                                AutomationProperties.Name="Delete CUDA acceleration pack"
                                                AutomationProperties.AutomationId="ModelsCudaPackDelete" />
                                    </StackPanel>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- macOS postProcessorSection: a small section label and one card per model. -->
                <StackPanel x:Name="CleanupPanel"
                            Spacing="12"
                            Visibility="Collapsed"
                            AutomationProperties.Name="Cleanup models">
                    <StackPanel Spacing="4" Margin="2,0,0,0">
                        <TextBlock Text="CLEANUP" Style="{StaticResource MuesliSectionLabelStyle}" FontSize="11" Foreground="{ThemeResource MuesliTextTertiaryBrush}" />
                        <TextBlock Text="Optional local cleanup after transcription: punctuation, casing, filler words, and repeated fragments. Turn it on in Settings; if a model is unavailable, Muesli keeps the original transcript."
                                   Style="{StaticResource ModelCaptionStyle}" />
                    </StackPanel>

                    <ItemsControl ItemsSource="{x:Bind ViewModel.CleanupItems, Mode=OneWay}"
                                  HorizontalContentAlignment="Stretch"
                                  AutomationProperties.Name="Cleanup model list"
                                  AutomationProperties.AutomationId="CleanupModelList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="12" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="viewModels:CleanupModelItem">
                                <Grid AutomationProperties.Name="{x:Bind AccessibleName}">
                                    <Border Style="{StaticResource ModelCardStyle}">
                                        <StackPanel Spacing="12">
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                                <Border Width="32" Height="32" CornerRadius="8"
                                                        VerticalAlignment="Top"
                                                        Background="{ThemeResource MuesliAccentMutedBrush}">
                                                    <FontIcon Glyph="&#xE8F1;"
                                                              FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                                              FontSize="16"
                                                              Foreground="{ThemeResource MuesliAccentBrush}" />
                                                </Border>
                                                <StackPanel Grid.Column="1" Spacing="4" MinWidth="0">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock Text="{x:Bind DisplayName}" Style="{StaticResource ModelTitleStyle}" />
                                                        <TextBlock Text="{x:Bind SizeCaption}" Style="{StaticResource ModelMetaLabelStyle}" />
                                                    </StackPanel>
                                                    <TextBlock Text="{x:Bind Summary}" Style="{StaticResource ModelCaptionStyle}" />
                                                    <TextBlock Text="{x:Bind License}"
                                                               Style="{StaticResource ModelMetaLabelStyle}"
                                                               FontSize="11"
                                                               TextWrapping="Wrap" />
                                                </StackPanel>
                                                <Border Grid.Column="2"
                                                        Style="{StaticResource ModelActiveChipStyle}"
                                                        Visibility="{x:Bind IsActive, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock Text="Selected" Style="{StaticResource MuesliSuccessBadgeTextStyle}" />
                                                </Border>
                                            </Grid>

                                            <TextBlock Text="{x:Bind StateNote}"
                                                       Style="{StaticResource ModelMetaLabelStyle}"
                                                       FontSize="12"
                                                       TextWrapping="Wrap"
                                                       Visibility="{x:Bind HasStateNote, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                            <StackPanel Spacing="4"
                                                        Visibility="{x:Bind IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <ProgressBar Value="{x:Bind ProgressValue}"
                                                             Maximum="100"
                                                             IsIndeterminate="{x:Bind IsProgressIndeterminate}" />
                                                <TextBlock Text="{x:Bind ProgressLabel}" Style="{StaticResource ModelMetaLabelStyle}" />
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal" Spacing="8"
                                                        Visibility="{x:Bind HasActions, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <Button Content="{x:Bind InstallButtonLabel}"
                                                        Command="{Binding ViewModel.PrepareCleanupCommand, ElementName=RootPage}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource ModelAccentPillStyle}"
                                                        Visibility="{x:Bind CanPrepare, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                        AutomationProperties.Name="Download cleanup model" />
                                                <Button Content="Use for cleanup"
                                                        Command="{Binding ViewModel.SelectCleanupModelCommand, ElementName=RootPage}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource ModelAccentPillStyle}"
                                                        Visibility="{x:Bind CanSelect, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                        AutomationProperties.Name="Use cleanup model" />
                                                <Button Content="Verify files"
                                                        Command="{Binding ViewModel.VerifyCleanupCommand, ElementName=RootPage}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource ModelNeutralPillStyle}"
                                                        Visibility="{x:Bind CanVerify, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                        AutomationProperties.Name="Verify cleanup model" />
                                                <Button Command="{Binding ViewModel.DeleteCleanupCommand, ElementName=RootPage}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource ModelDeleteButtonStyle}"
                                                        Visibility="{x:Bind CanDelete, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                        ToolTipService.ToolTip="Delete local cleanup model files"
                                                        AutomationProperties.Name="Delete cleanup model">
                                                    <FontIcon Glyph="&#xE74D;" FontSize="13" />
                                                </Button>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <Border BorderBrush="{ThemeResource MuesliAccentBrush}"
                                            BorderThickness="1.5"
                                            Opacity="0.6"
                                            CornerRadius="10"
                                            IsHitTestVisible="False"
                                            Visibility="{x:Bind IsActive, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

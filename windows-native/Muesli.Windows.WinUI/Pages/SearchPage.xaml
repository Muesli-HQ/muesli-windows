<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Muesli.Windows.WinUI.Pages.SearchPage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Muesli.Windows.WinUI.Pages"
    xmlns:vm="using:Muesli.Windows.WinUI.ViewModels">
    <Page.Resources>
        <Style x:Key="SearchTimestampStyle" TargetType="TextBlock" BasedOn="{StaticResource MuesliTimestampStyle}">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <!--
            Dictation hits are a run of rows inside one rounded surface, exactly like a Timeline or
            Dictations day group. The outline and the corner radius are applied per row from
            SearchPage.GroupBorders / GroupCorners so the first and last rows close the card and the
            rows in between keep the 1-px divider; without that the block rendered with square
            corners next to the rounded meeting cards in the same list.
        -->
        <Style x:Key="SearchDictationRowStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource MuesliSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource MuesliBorderSoftBrush}" />
            <Setter Property="Padding" Value="18,14" />
        </Style>
        <!-- Same quiet treatment as the Dictations page rows (P2-08). -->
        <Style x:Key="SearchRowActionStyle" TargetType="Button" BasedOn="{StaticResource MuesliGhostButtonStyle}">
            <Setter Property="Padding" Value="7,5" />
            <Setter Property="Foreground" Value="{ThemeResource MuesliTextTertiaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
        </Style>
        <Style x:Key="SearchResultRowStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource MuesliSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource MuesliBorderSoftBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <!-- The shared card radius, so a meeting hit and a Timeline day card match. -->
            <Setter Property="CornerRadius" Value="{StaticResource MuesliCardCornerRadius}" />
            <Setter Property="Padding" Value="16" />
        </Style>
        <Style x:Key="SearchListItemStyle" TargetType="ListViewItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
        </Style>
    </Page.Resources>

    <Grid x:Name="PageRoot" Background="{ThemeResource MuesliBackgroundBrush}" Padding="{StaticResource MuesliPageContentPadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel x:Name="HeaderStack" Spacing="14">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <StackPanel MinWidth="0" Spacing="4">
                    <TextBlock Text="{x:Bind ViewModel.PageTitle, Mode=OneWay}"
                               Style="{StaticResource MuesliPageTitleStyle}"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="ResultCountText"
                               Text="{x:Bind ViewModel.PageSummary, Mode=OneWay}"
                               Style="{StaticResource MuesliPageSubtitleStyle}" />
                </StackPanel>
                <Button x:Name="ClearButton"
                        Grid.Column="1"
                        Style="{StaticResource MuesliGhostButtonStyle}"
                        Content="Clear"
                        VerticalAlignment="Top"
                        Margin="0,8,0,0"
                        Click="Clear_Click"
                        Visibility="{x:Bind local:SearchPage.BoolToVisibility(ViewModel.HasQuery), Mode=OneWay}"
                        AutomationProperties.Name="Clear search"
                        AutomationProperties.AutomationId="SearchClearButton" />
            </Grid>

            <!--
                P2-05: this page had a second search field showing the same query as the
                always-visible sidebar field, so a search rendered two populated inputs at once.
                The shell's field is the single entry point (macOS SearchResultsView has no field
                of its own either) and this page renders only the query, the counts and the
                results. "Clear" clears the shell field, which is what actually owns the query.
            -->
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled"
                          HorizontalScrollMode="Enabled"
                          VerticalScrollMode="Disabled"
                          Padding="0">
                <Border Style="{StaticResource MuesliSegmentedContainerStyle}" HorizontalAlignment="Left">
                    <SelectorBar x:Name="KindFilterBar"
                                 SelectionChanged="KindFilter_SelectionChanged"
                                 AutomationProperties.Name="Search result kind">
                        <SelectorBarItem x:Name="AllTab"
                                         Text="All"
                                         Tag="0"
                                         IsSelected="True"
                                         AutomationProperties.Name="Search all results"
                                         AutomationProperties.AutomationId="SearchAllTab" />
                        <SelectorBarItem x:Name="DictationsTab"
                                         Text="Dictations"
                                         Tag="1"
                                         AutomationProperties.Name="Search dictations tab"
                                         AutomationProperties.AutomationId="SearchDictationsTab" />
                        <SelectorBarItem x:Name="MeetingsTab"
                                         Text="Meetings"
                                         Tag="2"
                                         AutomationProperties.Name="Search meetings tab"
                                         AutomationProperties.AutomationId="SearchMeetingsTab" />
                    </SelectorBar>
                </Border>
            </ScrollViewer>

            <!--
                Visibility as well as IsOpen: a closed InfoBar collapses its template root but
                stays Visible itself, so the header StackPanel still reserved a 14-DIP gap for each
                of these two, pushing the first section label down on every ordinary search.
            -->
            <InfoBar IsOpen="{x:Bind ViewModel.HasPersistenceWarning, Mode=OneWay}"
                     Visibility="{x:Bind local:SearchPage.BoolToVisibility(ViewModel.HasPersistenceWarning), Mode=OneWay}"
                     IsClosable="False"
                     Severity="Warning"
                     Title="Local history warning"
                     Message="{x:Bind ViewModel.PersistenceWarning, Mode=OneWay}"
                     AutomationProperties.AutomationId="SearchPersistenceWarning" />
            <InfoBar IsOpen="{x:Bind ViewModel.IsStatusOpen, Mode=TwoWay}"
                     Visibility="{x:Bind local:SearchPage.BoolToVisibility(ViewModel.IsStatusOpen), Mode=OneWay}"
                     Severity="{x:Bind local:SearchPage.StatusSeverity(ViewModel.IsStatusError), Mode=OneWay}"
                     Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                     AutomationProperties.AutomationId="SearchStatus" />
        </StackPanel>

        <!--
            No reading-width cap here. Stretch + MaxWidth centres the column and breaks the shared
            page gutter (App.xaml:39-41), and search results are a list like Timeline's and
            Dictations' — those run full width, so these do too.
        -->
        <Grid Grid.Row="1"
              Margin="0,16,0,0"
              MinHeight="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Text="{x:Bind ViewModel.SectionHeadline, Mode=OneWay}"
                       Style="{StaticResource MuesliSectionLabelStyle}"
                       Margin="4,0,0,10"
                       Visibility="{x:Bind local:SearchPage.BoolToVisibility(ViewModel.ShowPageSectionLabel), Mode=OneWay}" />

            <ListView x:Name="ResultList"
                      Grid.Row="1"
                      ItemsSource="{x:Bind ViewModel.VisibleResults, Mode=OneWay}"
                      ItemContainerStyle="{StaticResource SearchListItemStyle}"
                      SelectionMode="Single"
                      IsItemClickEnabled="True"
                      ItemClick="ResultList_ItemClick"
                      ContainerContentChanging="ResultList_ContainerContentChanging"
                      Background="Transparent"
                      BorderThickness="0"
                      HorizontalContentAlignment="Stretch"
                      Visibility="{x:Bind local:SearchPage.BoolToVisibility(ViewModel.ShowResults), Mode=OneWay}"
                      AutomationProperties.AutomationId="SearchResultList"
                      AutomationProperties.Name="Search results">
                <ListView.ItemContainerTransitions>
                    <TransitionCollection />
                </ListView.ItemContainerTransitions>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:SearchResultItem">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{x:Bind SectionLabel, Mode=OneTime}"
                                       Style="{StaticResource MuesliSectionLabelStyle}"
                                       Margin="4,4,0,2"
                                       Visibility="{x:Bind local:SearchPage.BoolToVisibility(ShowSectionHeader), Mode=OneTime}" />

                            <Border Style="{StaticResource SearchDictationRowStyle}"
                                    BorderThickness="{x:Bind local:SearchPage.GroupBorders(IsGroupStart), Mode=OneTime}"
                                    CornerRadius="{x:Bind local:SearchPage.GroupCorners(IsGroupStart, IsGroupEnd), Mode=OneTime}"
                                    Visibility="{x:Bind local:SearchPage.BoolToVisibility(IsDictation), Mode=OneTime}"
                                    AutomationProperties.Name="{x:Bind Title, Mode=OneTime}">
                                <Grid ColumnDefinitions="80,*,Auto" ColumnSpacing="12">
                                    <TextBlock Text="{x:Bind TimeLabel, Mode=OneTime}"
                                               Style="{StaticResource SearchTimestampStyle}"
                                               Margin="0,2,0,0" />
                                    <local:SearchHighlightTextBlock Grid.Column="1"
                                                                    SourceText="{x:Bind HighlightSource, Mode=OneTime}"
                                                                    Query="{x:Bind Query, Mode=OneTime}"
                                                                    FontSize="14"
                                                                    MaxLines="3"
                                                                    TextWrapping="Wrap"
                                                                    Foreground="{ThemeResource MuesliTextPrimaryBrush}" />
                                    <StackPanel x:Name="RowActions"
                                                Grid.Column="2"
                                                Orientation="Horizontal"
                                                Margin="8,-4,-6,0"
                                                Opacity="0"
                                                IsHitTestVisible="False">
                                        <Button Style="{StaticResource SearchRowActionStyle}"
                                                Tag="{x:Bind}"
                                                Click="CopyDictation_Click"
                                                ToolTipService.ToolTip="Copy dictation"
                                                AutomationProperties.Name="Copy dictation"
                                                AutomationProperties.AutomationId="SearchCopyButton">
                                            <FontIcon Glyph="&#xE8C8;"
                                                      FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                                      FontSize="14" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource SearchResultRowStyle}"
                                    Visibility="{x:Bind local:SearchPage.BoolToVisibility(IsMeeting), Mode=OneTime}"
                                    AutomationProperties.Name="{x:Bind Title, Mode=OneTime}">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <StackPanel MinWidth="0" Spacing="6">
                                        <local:SearchHighlightTextBlock SourceText="{x:Bind Title, Mode=OneTime}"
                                                                        Query="{x:Bind Query, Mode=OneTime}"
                                                                        FontSize="15"
                                                                        FontWeight="SemiBold"
                                                                        MaxLines="1"
                                                                        TextWrapping="NoWrap"
                                                                        Foreground="{ThemeResource MuesliTextPrimaryBrush}" />
                                        <TextBlock Text="{x:Bind Metadata, Mode=OneTime}"
                                                   Style="{StaticResource MuesliRowSecondaryStyle}" />
                                        <local:SearchHighlightTextBlock SourceText="{x:Bind HighlightSource, Mode=OneTime}"
                                                                        Query="{x:Bind Query, Mode=OneTime}"
                                                                        FontSize="13"
                                                                        MaxLines="2"
                                                                        TextWrapping="Wrap"
                                                                        Foreground="{ThemeResource MuesliTextSecondaryBrush}" />
                                    </StackPanel>
                                    <!--
                                        The same people glyph Timeline uses to mark a meeting row.
                                        This was a folder glyph, which reads as "open folder" and
                                        matched nothing else in the shell. Raw in the accessibility
                                        tree: the row name already says it is a meeting.
                                    -->
                                    <FontIcon Grid.Column="1"
                                              Glyph="&#xE716;"
                                              FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                              FontSize="14"
                                              Foreground="{ThemeResource MuesliAccentBrush}"
                                              Margin="0,2,0,0"
                                              VerticalAlignment="Top"
                                              AutomationProperties.AccessibilityView="Raw" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!--
                Top-aligned, not stretched: in the "*" row a stretched card grew to the full
                remaining height (about 560 DIP for two lines of copy), while the Timeline and
                Dictations empty cards sit at their natural height at the top of the list area.
            -->
            <Border x:Name="EmptyState"
                    Grid.Row="1"
                    Style="{StaticResource MuesliCardStyle}"
                    MinHeight="210"
                    VerticalAlignment="Top"
                    Padding="28"
                    Visibility="{x:Bind local:SearchPage.BoolToVisibility(ViewModel.ShowEmptyState), Mode=OneWay}"
                    AutomationProperties.AutomationId="SearchEmptyState">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="9">
                    <Border Width="44"
                            Height="44"
                            CornerRadius="22"
                            Background="{ThemeResource MuesliSurfaceRaisedBrush}"
                            HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE721;"
                                  FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                  FontSize="20"
                                  Foreground="{ThemeResource MuesliTextTertiaryBrush}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="EmptyTitle"
                               Text="{x:Bind ViewModel.EmptyTitle, Mode=OneWay}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="EmptyDescription"
                               Text="{x:Bind ViewModel.EmptyBody, Mode=OneWay}"
                               Style="{StaticResource MuesliBodyStyle}"
                               TextAlignment="Center"
                               MaxWidth="420" />
                </StackPanel>
            </Border>

            <Border x:Name="ErrorState"
                    Grid.Row="1"
                    Style="{StaticResource MuesliCardStyle}"
                    MinHeight="210"
                    VerticalAlignment="Top"
                    Padding="28"
                    Visibility="{x:Bind local:SearchPage.BoolToVisibility(ViewModel.HasError), Mode=OneWay}"
                    AutomationProperties.Name="Search unavailable"
                    AutomationProperties.AutomationId="SearchErrorState">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" MaxWidth="460">
                    <FontIcon Glyph="&#xE783;"
                              FontFamily="{ThemeResource SymbolThemeFontFamily}"
                              FontSize="24"
                              Foreground="{ThemeResource MuesliErrorBrush}"
                              HorizontalAlignment="Center" />
                    <TextBlock Text="Search is temporarily unavailable"
                               FontSize="18"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                               Style="{StaticResource MuesliBodyStyle}"
                               TextAlignment="Center" />
                    <Button Style="{StaticResource MuesliSecondaryButtonStyle}"
                            HorizontalAlignment="Center"
                            Command="{x:Bind ViewModel.RetryCommand}"
                            Content="Try again"
                            AutomationProperties.Name="Try search again"
                            AutomationProperties.AutomationId="SearchErrorRetryButton" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>

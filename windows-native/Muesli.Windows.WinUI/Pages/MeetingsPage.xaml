<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Muesli.Windows.WinUI.Pages.MeetingsPage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Muesli.Windows.WinUI.Pages"
    xmlns:controls="using:Muesli.Windows.WinUI.Controls"
    xmlns:vm="using:Muesli.Windows.WinUI.ViewModels"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Page.Resources>
        <!-- MeetingsView.swift header buttons: 12pt semibold, 12x8 padding, small corner. -->
        <Style x:Key="MeetingsAccentActionStyle" TargetType="Button" BasedOn="{StaticResource MuesliPrimaryButtonStyle}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="MeetingsActionStyle" TargetType="Button" BasedOn="{StaticResource MuesliSecondaryButtonStyle}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- The sort and date menus: borderless capsules, as MeetingsView.swift sortButton/dateFilterButton. -->
        <Style x:Key="MeetingsPillStyle" TargetType="Button" BasedOn="{StaticResource MuesliGhostButtonStyle}">
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="MeetingRowIconStyle" TargetType="Button" BasedOn="{StaticResource MuesliGhostButtonStyle}">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
    </Page.Resources>
    <Grid x:Name="RootGrid" Background="{ThemeResource MuesliBackgroundBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="ContentStack" Padding="{StaticResource MuesliPageContentPadding}" Spacing="24">
                <TextBlock Text="Meetings" Style="{StaticResource MuesliPageTitleStyle}" MinWidth="0" />

                <!--
                    MeetingsView.swift activeMeetingBanner: a raised strip with a status dot, the meeting
                    title and state, then Open Notes, Pause/Resume and Stop. The notes live on the
                    meeting's own page, as on macOS. An import shows here too, with its progress.
                -->
                <Border x:Name="ActiveMeetingPanel"
                        Background="{ThemeResource MuesliBackgroundRaisedBrush}"
                        BorderBrush="{ThemeResource MuesliBorderBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="12"
                        AutomationProperties.AutomationId="ActiveMeetingPanel">
                    <Grid x:Name="ActiveMeetingGrid" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="8" MinWidth="0" VerticalAlignment="Center">
                            <Ellipse x:Name="ActiveMeetingDot" Width="8" Height="8" VerticalAlignment="Center" />
                            <StackPanel Spacing="2" MinWidth="0">
                                <TextBlock Text="{x:Bind ViewModel.BannerTitle, Mode=OneWay}" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{ThemeResource MuesliTextPrimaryBrush}" TextTrimming="CharacterEllipsis" MaxLines="1" />
                                <TextBlock Text="{x:Bind ViewModel.BannerStatus, Mode=OneWay}" FontSize="12"
                                           Foreground="{ThemeResource MuesliTextSecondaryBrush}" TextTrimming="CharacterEllipsis" MaxLines="1"
                                           AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="MeetingCaptureStatusLabel" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel x:Name="ActiveMeetingActions" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button Style="{StaticResource MeetingsActionStyle}" Click="OpenNotes_Click"
                                    Visibility="{x:Bind local:MeetingsPage.BoolToVisibility(ViewModel.HasActiveMeeting), Mode=OneWay}"
                                    AutomationProperties.Name="Open Notes" AutomationProperties.AutomationId="OpenMeetingNotesButton">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE70F;" FontSize="11" />
                                    <TextBlock Text="Open Notes" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource MeetingsActionStyle}"
                                    Command="{x:Bind ViewModel.PauseRecordingCommand}"
                                    Visibility="{x:Bind local:MeetingsPage.BoolToVisibility(ViewModel.CanPause), Mode=OneWay}"
                                    ToolTipService.ToolTip="Pause recording"
                                    AutomationProperties.Name="Pause meeting recording" AutomationProperties.AutomationId="PauseMeetingButton">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE769;" FontSize="10" />
                                    <TextBlock Text="Pause" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource MeetingsAccentActionStyle}"
                                    Command="{x:Bind ViewModel.ResumeRecordingCommand}"
                                    Visibility="{x:Bind local:MeetingsPage.BoolToVisibility(ViewModel.CanResume), Mode=OneWay}"
                                    ToolTipService.ToolTip="Resume recording"
                                    AutomationProperties.Name="Resume meeting recording" AutomationProperties.AutomationId="ResumeMeetingButton">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE768;" FontSize="10" />
                                    <TextBlock Text="Resume" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource MeetingsAccentActionStyle}" Background="#EF4444" BorderBrush="#EF4444"
                                    Command="{x:Bind ViewModel.StopRecordingCommand}"
                                    Visibility="{x:Bind local:MeetingsPage.BoolToVisibility(ViewModel.CanStop), Mode=OneWay}"
                                    ToolTipService.ToolTip="Stop recording"
                                    AutomationProperties.Name="Stop and save meeting" AutomationProperties.AutomationId="StopMeetingButton">
                                <Button.Resources>
                                    <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#DC2626" />
                                    <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#B91C1C" />
                                    <SolidColorBrush x:Key="AccentButtonBorderBrushPointerOver" Color="#DC2626" />
                                    <SolidColorBrush x:Key="AccentButtonBorderBrushPressed" Color="#B91C1C" />
                                </Button.Resources>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE71A;" FontSize="10" />
                                    <TextBlock Text="Stop" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Value="{x:Bind ViewModel.ImportProgress, Mode=OneWay}" Maximum="100"
                                     Visibility="{x:Bind local:MeetingsPage.BoolToVisibility(ViewModel.IsImporting), Mode=OneWay}" />
                    </Grid>
                </Border>

                <Border x:Name="RecoveryPanel" Style="{StaticResource MuesliCardStyle}" AutomationProperties.AutomationId="MeetingRecoveryPanel">
                    <StackPanel Spacing="10">
                        <TextBlock Text="RECOVERABLE RECORDINGS" Style="{StaticResource MuesliSectionLabelStyle}" />
                        <TextBlock Text="Interrupted captures stay on this PC until you finalize or discard them." TextWrapping="Wrap" Foreground="{ThemeResource MuesliTextSecondaryBrush}" />
                        <ListView ItemsSource="{x:Bind ViewModel.RecoverableSessions, Mode=OneWay}"
                                  SelectionMode="None"
                                  Background="Transparent"
                                  ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                  ScrollViewer.VerticalScrollMode="Disabled"
                                  AutomationProperties.AutomationId="RecoverableMeetingList">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:RecoverableMeetingListItem">
                                    <Grid ColumnDefinitions="*,Auto" Padding="4,6" ColumnSpacing="12">
                                        <StackPanel MinWidth="0">
                                            <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="{x:Bind Detail}" Foreground="{ThemeResource MuesliTextSecondaryBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                            <Button Style="{StaticResource MuesliSecondaryButtonStyle}" Content="Finalize" Command="{Binding ViewModel.FinalizeRecoveryCommand, ElementName=RootPage}" CommandParameter="{Binding}" AutomationProperties.Name="Finalize recovered meeting" AutomationProperties.AutomationId="FinalizeRecoveryButton" />
                                            <Button Style="{StaticResource MuesliGhostButtonStyle}" Content="Discard" Command="{Binding ViewModel.DiscardRecoveryCommand, ElementName=RootPage}" CommandParameter="{Binding}" AutomationProperties.Name="Discard recovered audio" AutomationProperties.AutomationId="DiscardRecoveryButton" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

                <!-- MeetingsView.swift browserHeader: folder name and actions, then the count line. -->
                <StackPanel Spacing="8">
                    <Grid x:Name="HeaderActionsRow" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="16" RowSpacing="12">
                        <TextBlock x:Name="CurrentFolderHeading"
                                   Text="{x:Bind ViewModel.CurrentFolderLabel, Mode=OneWay}"
                                   FontSize="22" FontWeight="SemiBold"
                                   Foreground="{ThemeResource MuesliTextPrimaryBrush}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxLines="1" MinWidth="0"
                                   AutomationProperties.AutomationId="MeetingsCurrentFolderLabel" />
                        <StackPanel x:Name="HeaderActions" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Button Style="{StaticResource MeetingsAccentActionStyle}"
                                    Command="{x:Bind ViewModel.StartQuickNoteCommand}"
                                    ToolTipService.ToolTip="Start a quick meeting note"
                                    AutomationProperties.Name="Start Quick Note recording"
                                    AutomationProperties.AutomationId="QuickNoteButton">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE710;" FontSize="11" />
                                    <TextBlock Text="Quick Note" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource MeetingsActionStyle}"
                                    Command="{x:Bind ViewModel.ImportAudioCommand}"
                                    ToolTipService.ToolTip="Import an audio file for offline transcription"
                                    AutomationProperties.Name="Import meeting audio or video"
                                    AutomationProperties.AutomationId="ImportAudioButton">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE896;" FontSize="11" />
                                    <TextBlock Text="Import Audio" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="MeetingsSortButton"
                                    Style="{StaticResource MeetingsPillStyle}"
                                    AutomationProperties.Name="Sort meetings"
                                    AutomationProperties.AutomationId="MeetingsSort">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <FontIcon x:Name="MeetingsSortIcon" Glyph="&#xE8CB;" FontSize="11" VerticalAlignment="Center" />
                                    <TextBlock x:Name="MeetingsSortLabel" FontSize="11" VerticalAlignment="Center" />
                                </StackPanel>
                                <Button.Flyout>
                                    <MenuFlyout x:Name="MeetingsSortFlyout" Placement="Bottom" Opening="MeetingsSort_Opening" />
                                </Button.Flyout>
                            </Button>
                            <Button x:Name="MeetingsTimeRangeButton"
                                    Style="{StaticResource MeetingsPillStyle}"
                                    AutomationProperties.Name="Date filter"
                                    AutomationProperties.AutomationId="MeetingsTimeRange">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <FontIcon x:Name="MeetingsTimeRangeIcon" Glyph="&#xE71C;" FontSize="11" VerticalAlignment="Center" />
                                    <TextBlock x:Name="MeetingsTimeRangeLabel" FontSize="11" VerticalAlignment="Center" Visibility="Collapsed" />
                                </StackPanel>
                                <Button.Flyout>
                                    <MenuFlyout x:Name="MeetingsTimeRangeFlyout" Placement="Bottom" Opening="MeetingsTimeRange_Opening" />
                                </Button.Flyout>
                            </Button>
                            <Button Style="{StaticResource MeetingsActionStyle}"
                                    Click="ManageTemplates_Click"
                                    AutomationProperties.Name="Manage meeting templates"
                                    AutomationProperties.AutomationId="ManageMeetingTemplatesButton">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE70F;" FontSize="11" />
                                    <TextBlock Text="Manage Templates" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="8" AutomationProperties.AutomationId="MeetingsResultCount">
                        <TextBlock Text="{x:Bind ViewModel.ResultCountLabel, Mode=OneWay}" FontSize="13" Foreground="{ThemeResource MuesliTextSecondaryBrush}" />
                        <TextBlock Text="&#x2022;" FontSize="13" Foreground="{ThemeResource MuesliTextTertiaryBrush}" />
                        <TextBlock Text="Open a meeting to review notes, transcript, and template-driven summaries" FontSize="13"
                                   Foreground="{ThemeResource MuesliTextTertiaryBrush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </StackPanel>

                <!-- Only failures speak up; macOS is silent when an action works. -->
                <InfoBar IsOpen="{x:Bind ViewModel.HasIdleNotice, Mode=OneWay}"
                         IsClosable="False"
                         Severity="Warning"
                         Message="{x:Bind ViewModel.MeetingStatus, Mode=OneWay}"
                         Visibility="{x:Bind local:MeetingsPage.BoolToVisibility(ViewModel.HasIdleNotice), Mode=OneWay}"
                         AutomationProperties.AutomationId="MeetingsIdleNotice" />

                <Grid>
                    <ListView x:Name="MeetingList"
                              ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                              SelectionMode="None"
                              IsItemClickEnabled="True"
                              ItemClick="MeetingList_ItemClick"
                              ContainerContentChanging="MeetingList_ContainerContentChanging"
                              AutomationProperties.Name="Meeting history"
                              Background="Transparent"
                              BorderThickness="0"
                              ScrollViewer.VerticalScrollBarVisibility="Disabled"
                              ScrollViewer.VerticalScrollMode="Disabled"
                              AutomationProperties.AutomationId="MeetingHistoryList">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="CornerRadius" Value="6" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="UseSystemFocusVisuals" Value="True" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemContainerTransitions><TransitionCollection /></ListView.ItemContainerTransitions>
                        <ListView.ItemTemplate>
                            <!--
                                MeetingListItemView.swift: a flat row (16 padding, hover fill, hairline divider
                                inset 16), headline title with the folder menu and a hover-only delete at the
                                right, caption meta "status • time  •  duration" with capsule badges and the
                                folder path, and a two-line preview.
                            -->
                            <DataTemplate x:DataType="vm:MeetingListItem">
                                <Grid PointerEntered="MeetingRow_PointerEntered" PointerExited="MeetingRow_PointerExited" Background="Transparent">
                                    <StackPanel Spacing="8" Padding="16">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                                            <TextBlock Text="{x:Bind Title}" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource MuesliTextPrimaryBrush}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE7AC;" FontSize="11" Width="24" Foreground="{ThemeResource MuesliAccentBrush}"
                                                          Visibility="{x:Bind local:MeetingsPage.BoolToVisibility(IsFollowUp)}"
                                                          ToolTipService.ToolTip="Follow-up meeting" AutomationProperties.Name="Follow-up meeting" />
                                                <FontIcon Glyph="&#xE8F7;" FontSize="11" Width="24" Foreground="{ThemeResource MuesliAccentBrush}"
                                                          Visibility="{x:Bind local:MeetingsPage.BoolToVisibility(HasFollowUps)}"
                                                          ToolTipService.ToolTip="Has follow-up meetings" AutomationProperties.Name="Has follow-up meetings" />
                                                <Button Style="{StaticResource MeetingRowIconStyle}" Tag="{x:Bind Id}" Click="MoveMeeting_Click"
                                                        ToolTipService.ToolTip="Move to folder" AutomationProperties.Name="Move to folder"
                                                        AutomationProperties.AutomationId="MeetingRowFolderButton">
                                                    <FontIcon Glyph="{x:Bind FolderGlyph}" FontSize="11"
                                                              Foreground="{x:Bind local:MeetingsPage.FolderGlyphBrush(ShowFolderBadge)}" />
                                                </Button>
                                                <Button Style="{StaticResource MeetingRowIconStyle}" Tag="{x:Bind Id}" Click="DeleteMeeting_Click" Opacity="0"
                                                        ToolTipService.ToolTip="Delete meeting" AutomationProperties.Name="Delete meeting"
                                                        AutomationProperties.AutomationId="MeetingRowDeleteButton">
                                                    <FontIcon Glyph="&#xE74D;" FontSize="11" Foreground="#D9EF4444" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <Border Background="{x:Bind local:MeetingsPage.StatusFill(StatusTone)}" CornerRadius="8" Padding="6,2" VerticalAlignment="Center" Visibility="{x:Bind local:MeetingsPage.BoolToVisibility(ShowStatusBadge)}">
                                                <TextBlock Text="{x:Bind StatusLabel}" FontSize="10" FontWeight="SemiBold" Foreground="{x:Bind local:MeetingsPage.StatusInk(StatusTone)}" />
                                            </Border>
                                            <TextBlock Text="&#x2022;" FontSize="12" Foreground="{ThemeResource MuesliTextTertiaryBrush}" VerticalAlignment="Center" Visibility="{x:Bind local:MeetingsPage.BoolToVisibility(ShowStatusBadge)}" />
                                            <TextBlock Text="{x:Bind MetaLabel}" FontSize="12" Foreground="{ThemeResource MuesliTextSecondaryBrush}" VerticalAlignment="Center" />
                                            <Border Background="{x:Bind local:MeetingsPage.StatusFill(SourceTone)}" CornerRadius="8" Padding="6,2" VerticalAlignment="Center" Visibility="{x:Bind local:MeetingsPage.BoolToVisibility(ShowSourceBadge)}"
                                                    ToolTipService.ToolTip="{x:Bind SourceBadgeHelp}">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <FontIcon Glyph="{x:Bind SourceBadgeGlyph}" FontSize="10" Foreground="{x:Bind local:MeetingsPage.StatusInk(SourceTone)}" VerticalAlignment="Center" />
                                                    <TextBlock Text="{x:Bind SourceBadgeLabel}" FontSize="10" FontWeight="SemiBold" Foreground="{x:Bind local:MeetingsPage.StatusInk(SourceTone)}" />
                                                </StackPanel>
                                            </Border>
                                            <TextBlock Text="&#x2022;" FontSize="12" Foreground="{ThemeResource MuesliTextTertiaryBrush}" VerticalAlignment="Center" Visibility="{x:Bind local:MeetingsPage.BoolToVisibility(ShowFolderBadge)}" />
                                            <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" Opacity="0.8" Visibility="{x:Bind local:MeetingsPage.BoolToVisibility(ShowFolderBadge)}">
                                                <FontIcon Glyph="&#xE8B7;" FontSize="9" Foreground="{ThemeResource MuesliAccentBrush}" VerticalAlignment="Center" />
                                                <TextBlock Text="{x:Bind FolderName}" FontSize="12" Foreground="{ThemeResource MuesliAccentBrush}" />
                                            </StackPanel>
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind Summary}" FontSize="14" Foreground="{ThemeResource MuesliTextSecondaryBrush}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <Border Height="1" Margin="16,0" VerticalAlignment="Bottom" Background="{ThemeResource MuesliBorderBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <!-- MeetingsView.swift emptyState: a raised, left-aligned card; no button. -->
                    <Border x:Name="EmptyState"
                            Background="{ThemeResource MuesliBackgroundRaisedBrush}"
                            BorderBrush="{ThemeResource MuesliBorderBrush}"
                            BorderThickness="1" CornerRadius="14" Padding="24">
                        <StackPanel Spacing="12" HorizontalAlignment="Left">
                            <FontIcon Glyph="{x:Bind ViewModel.EmptyStateGlyph, Mode=OneWay}" FontSize="30" Foreground="{ThemeResource MuesliTextTertiaryBrush}" HorizontalAlignment="Left" />
                            <TextBlock Text="{x:Bind ViewModel.EmptyStateTitle, Mode=OneWay}" FontSize="18" FontWeight="SemiBold" Foreground="{ThemeResource MuesliTextSecondaryBrush}" TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind ViewModel.EmptyStateInstruction, Mode=OneWay}" FontSize="13" Foreground="{ThemeResource MuesliTextTertiaryBrush}" TextWrapping="Wrap" MaxWidth="320" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Muesli.Windows.WinUI.Pages.MeetingsPage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Muesli.Windows.WinUI.Pages"
    xmlns:controls="using:Muesli.Windows.WinUI.Controls"
    xmlns:vm="using:Muesli.Windows.WinUI.ViewModels"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Page.Resources>
        <ResourceDictionary>
        <!--
            Page-local compact pill menus for the meetings browser. Mirrors MeetingsView.swift's
            borderless Menu pills; kept local so the global Muesli button styles are untouched.
        -->
        <!-- macOS sort/filter pills: borderless capsules, padding 8×3, a quiet surface at rest. -->
        <Style x:Key="MuesliPillMenuButtonStyle" TargetType="Button" BasedOn="{StaticResource MuesliGhostButtonStyle}">
            <Setter Property="Background" Value="{ThemeResource MuesliStateHoverOverlayBrush}" />
            <Setter Property="Foreground" Value="{ThemeResource MuesliTextSecondaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- macOS header actions (Import, Templates): 12 semibold, padding 12×8. -->
        <Style x:Key="MeetingsHeaderButtonStyle" TargetType="Button" BasedOn="{StaticResource MuesliSecondaryButtonStyle}">
            <Setter Property="FontFamily" Value="{StaticResource MuesliFontFamilySemiBold}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="MinHeight" Value="0" />
        </Style>
        <x:Boolean x:Key="ListViewItemSelectionIndicatorVisualEnabled">False</x:Boolean>
        <!-- MeetingDetailView.swift recording controls: 12pt semibold, 12x7 padding, small corner. -->
        <Style x:Key="MuesliRecordingPillButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="MuesliRecordingAccentPillButtonStyle" TargetType="Button" BasedOn="{StaticResource MuesliPrimaryButtonStyle}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="MuesliRecordingIconButtonStyle" TargetType="Button" BasedOn="{StaticResource MuesliGhostButtonStyle}">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <ResourceDictionary.ThemeDictionaries>
            <ResourceDictionary x:Key="Default">
                <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="#232528" />
                <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="#232528" />
            </ResourceDictionary>
            <ResourceDictionary x:Key="Light">
                <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="#E8E8EC" />
                <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="#E8E8EC" />
            </ResourceDictionary>
            <ResourceDictionary x:Key="HighContrast" />
        </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Page.Resources>
    <Grid x:Name="RootGrid" Background="{ThemeResource MuesliBackgroundBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="ContentStack" Padding="{StaticResource MuesliPageContentPadding}" Spacing="24">
                <!--
                    Hierarchy matches the macOS meetings browser (03-meetings.png), which stacks
                    exactly four blocks: page title, then the current folder name sharing one row
                    with the action buttons, then the result caption, then the origin segments.
                    P3-03: the folder name used to sit on a fifth row of its own under the title.
                    Refresh stays a ghost control on the title row (Windows has no iCloud sync glyph).
                -->
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="Meetings" Style="{StaticResource MuesliPageTitleStyle}" MinWidth="0" />
                    <Button Grid.Column="1"
                            Style="{StaticResource MuesliGhostButtonStyle}"
                            VerticalAlignment="Top"
                            Command="{x:Bind ViewModel.RefreshCommand}"
                            AutomationProperties.Name="Refresh meetings"
                            AutomationProperties.AutomationId="MeetingsRefreshButton"
                            ToolTipService.ToolTip="Refresh meetings">
                        <FontIcon Glyph="&#xE72C;" FontSize="15" />
                    </Button>
                </Grid>

                <Grid x:Name="HeaderActionsRow" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="14" RowSpacing="10">
                    <TextBlock x:Name="CurrentFolderHeading"
                               Text="{x:Bind ViewModel.CurrentFolderLabel, Mode=OneWay}"
                               Style="{StaticResource MuesliPageSubtitleStyle}"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource MuesliTextPrimaryBrush}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               MaxLines="1"
                               MinWidth="0"
                               ToolTipService.ToolTip="{x:Bind ViewModel.CurrentFolderLabel, Mode=OneWay}"
                               AutomationProperties.Name="{x:Bind ViewModel.CurrentFolderLabel, Mode=OneWay}"
                               AutomationProperties.AutomationId="MeetingsCurrentFolderLabel" />
                <StackPanel x:Name="HeaderActions" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <StackPanel x:Name="PrimaryActions" Orientation="Horizontal" Spacing="8">
                        <Button Style="{StaticResource MuesliPrimaryButtonStyle}"
                                Command="{x:Bind ViewModel.StartQuickNoteCommand}"
                                AutomationProperties.Name="Start Quick Note recording"
                                AutomationProperties.AutomationId="QuickNoteButton">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE710;" FontSize="14" />
                                <TextBlock Text="Quick Note" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource MeetingsHeaderButtonStyle}"
                                Command="{x:Bind ViewModel.ImportAudioCommand}"
                                AutomationProperties.Name="Import meeting audio or video"
                                AutomationProperties.AutomationId="ImportAudioButton">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <!-- Windows equivalent of macOS square.and.arrow.down (Download). -->
                                <FontIcon Glyph="&#xE896;" FontSize="14" />
                                <TextBlock Text="Import Audio" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <StackPanel x:Name="SecondaryActions" Orientation="Horizontal" Spacing="8">
                        <!-- Compact pill menus matching MeetingsView.swift: sort symbols + label. -->
                        <Button x:Name="MeetingsSortButton"
                                Style="{StaticResource MuesliPillMenuButtonStyle}"
                                Click="MeetingsSort_Click"
                                AutomationProperties.Name="Sort meetings"
                                AutomationProperties.AutomationId="MeetingsSort">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon x:Name="MeetingsSortIcon" Glyph="&#xE8CB;" FontSize="11" VerticalAlignment="Center" />
                                <TextBlock x:Name="MeetingsSortLabel" FontSize="11" VerticalAlignment="Center" />
                            </StackPanel>
                            <Button.Flyout>
                                <MenuFlyout x:Name="MeetingsSortFlyout" Placement="Bottom" />
                            </Button.Flyout>
                        </Button>
                        <Button x:Name="MeetingsTimeRangeButton"
                                Style="{StaticResource MuesliPillMenuButtonStyle}"
                                Click="MeetingsTimeRange_Click"
                                AutomationProperties.Name="Meeting time range"
                                AutomationProperties.AutomationId="MeetingsTimeRange">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon x:Name="MeetingsTimeRangeIcon" Glyph="&#xE71C;" FontSize="11" VerticalAlignment="Center" />
                                <TextBlock x:Name="MeetingsTimeRangeLabel" FontSize="11" VerticalAlignment="Center" />
                            </StackPanel>
                            <Button.Flyout>
                                <MenuFlyout x:Name="MeetingsTimeRangeFlyout" Placement="Bottom" />
                            </Button.Flyout>
                        </Button>
                        <Button Style="{StaticResource MeetingsHeaderButtonStyle}"
                                Click="ManageTemplates_Click"
                                AutomationProperties.Name="Manage meeting templates"
                                AutomationProperties.AutomationId="ManageMeetingTemplatesButton">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8FD;" FontSize="14" />
                                <TextBlock Text="Manage Templates" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
                </Grid>

                <TextBlock Text="{x:Bind ViewModel.ResultCountHint, Mode=OneWay}"
                           Style="{StaticResource MuesliBodyStyle}" FontSize="13"
                           Foreground="{ThemeResource MuesliTextTertiaryBrush}"
                           AutomationProperties.AutomationId="MeetingsResultCount" />

                <InfoBar IsOpen="{x:Bind ViewModel.HasIdleNotice, Mode=OneWay}"
                         IsClosable="False"
                         Severity="Informational"
                         Message="{x:Bind ViewModel.MeetingStatus, Mode=OneWay}"
                         AutomationProperties.AutomationId="MeetingsIdleNotice" />

                <!--
                    MeetingsView.swift activeMeetingBanner / MeetingPreparationBanner: the list only
                    points at the meeting in progress. The meeting itself has its own page
                    (MeetingRecordingPage), opened with "Open Notes". Imports report progress here.
                -->
                <Border x:Name="ActiveMeetingPanel"
                        Background="{ThemeResource MuesliBackgroundRaisedBrush}"
                        CornerRadius="12"
                        Padding="16,12"
                        AutomationProperties.AutomationId="ActiveMeetingBanner">
                    <Grid x:Name="ActiveMeetingGrid" RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*,Auto" RowSpacing="10" ColumnSpacing="12">
                        <Grid Width="18" Height="18" VerticalAlignment="Center">
                            <ProgressRing Width="16" Height="16"
                                          IsActive="{x:Bind ViewModel.ShowBannerProgress, Mode=OneWay}"
                                          Visibility="{x:Bind local:MeetingsPage.BoolToVisibility(ViewModel.ShowBannerProgress), Mode=OneWay}" />
                            <Ellipse Width="8" Height="8" Fill="#EF4444"
                                     Visibility="{x:Bind local:MeetingsPage.BoolToVisibility(ViewModel.CanPause), Mode=OneWay}" />
                            <Ellipse Width="8" Height="8" Fill="#F59E0B"
                                     Visibility="{x:Bind local:MeetingsPage.BoolToVisibility(ViewModel.CanResume), Mode=OneWay}" />
                        </Grid>
                        <StackPanel Grid.Column="1" Spacing="2" MinWidth="0" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind ViewModel.BannerTitle, Mode=OneWay}" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{ThemeResource MuesliTextPrimaryBrush}" TextTrimming="CharacterEllipsis" MaxLines="1"
                                       AutomationProperties.AutomationId="ActiveMeetingBannerTitle" />
                            <TextBlock Text="{x:Bind ViewModel.BannerStatus, Mode=OneWay}" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{ThemeResource MuesliTextSecondaryBrush}"
                                       AutomationProperties.LiveSetting="Polite"
                                       AutomationProperties.AutomationId="ActiveMeetingBannerStatus" />
                        </StackPanel>
                        <StackPanel x:Name="ActiveMeetingActions" Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                                    Visibility="{x:Bind local:MeetingsPage.BoolToVisibility(ViewModel.HasLiveMeeting), Mode=OneWay}">
                            <Button Style="{StaticResource MuesliRecordingPillButtonStyle}"
                                    Background="{ThemeResource MuesliSurfacePrimaryBrush}"
                                    BorderBrush="{ThemeResource MuesliBorderBrush}"
                                    Click="OpenRecording_Click"
                                    AutomationProperties.Name="Open the meeting in progress"
                                    AutomationProperties.AutomationId="OpenRecordingNotesButton">
                                <TextBlock Text="Open Notes" />
                            </Button>
                            <Button Style="{StaticResource MuesliRecordingPillButtonStyle}"
                                    Background="{ThemeResource MuesliSurfacePrimaryBrush}"
                                    BorderBrush="{ThemeResource MuesliBorderBrush}"
                                    Command="{x:Bind ViewModel.PauseRecordingCommand}"
                                    Visibility="{x:Bind local:MeetingsPage.BoolToVisibility(ViewModel.CanPause), Mode=OneWay}"
                                    ToolTipService.ToolTip="Pause recording"
                                    AutomationProperties.Name="Pause recording"
                                    AutomationProperties.AutomationId="BannerPauseMeetingButton">
                                <TextBlock Text="Pause" />
                            </Button>
                            <Button Style="{StaticResource MuesliRecordingPillButtonStyle}"
                                    Background="{ThemeResource MuesliSurfacePrimaryBrush}"
                                    BorderBrush="{ThemeResource MuesliBorderBrush}"
                                    Command="{x:Bind ViewModel.ResumeRecordingCommand}"
                                    Visibility="{x:Bind local:MeetingsPage.BoolToVisibility(ViewModel.CanResume), Mode=OneWay}"
                                    ToolTipService.ToolTip="Resume recording"
                                    AutomationProperties.Name="Resume recording"
                                    AutomationProperties.AutomationId="BannerResumeMeetingButton">
                                <TextBlock Text="Resume" />
                            </Button>
                            <Button Style="{StaticResource MuesliRecordingAccentPillButtonStyle}"
                                    Background="#EF4444"
                                    BorderBrush="#EF4444"
                                    Command="{x:Bind ViewModel.StopRecordingCommand}"
                                    ToolTipService.ToolTip="Stop recording"
                                    AutomationProperties.Name="Stop recording"
                                    AutomationProperties.AutomationId="BannerStopMeetingButton">
                                <Button.Resources>
                                    <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#DC2626" />
                                    <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#B91C1C" />
                                    <SolidColorBrush x:Key="AccentButtonBorderBrushPointerOver" Color="#DC2626" />
                                    <SolidColorBrush x:Key="AccentButtonBorderBrushPressed" Color="#B91C1C" />
                                </Button.Resources>
                                <TextBlock Text="Stop" />
                            </Button>
                        </StackPanel>
                        <ProgressBar Grid.Row="1" Grid.ColumnSpan="3"
                                     Value="{x:Bind ViewModel.ImportProgress, Mode=OneWay}" Maximum="100"
                                     Visibility="{x:Bind local:MeetingsPage.BoolToVisibility(ViewModel.IsImporting), Mode=OneWay}" />
                    </Grid>
                </Border>

                <Border x:Name="RecoveryPanel" Style="{StaticResource MuesliCardStyle}" AutomationProperties.AutomationId="MeetingRecoveryPanel">
                    <StackPanel Spacing="10">
                        <TextBlock Text="RECOVERABLE RECORDINGS" Style="{StaticResource MuesliSectionLabelStyle}" />
                        <TextBlock Text="Interrupted captures stay on this PC until you finalize or discard them." TextWrapping="Wrap" Foreground="{ThemeResource MuesliTextSecondaryBrush}" />
                        <ListView ItemsSource="{x:Bind ViewModel.RecoverableSessions, Mode=OneWay}"
                                  SelectionMode="None"
                                  Background="Transparent"
                                  ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                  ScrollViewer.VerticalScrollMode="Disabled"
                                  AutomationProperties.AutomationId="RecoverableMeetingList">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:RecoverableMeetingListItem">
                                    <Grid ColumnDefinitions="*,Auto" Padding="4,6" ColumnSpacing="12">
                                        <StackPanel MinWidth="0">
                                            <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="{x:Bind Detail}" Foreground="{ThemeResource MuesliTextSecondaryBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                            <Button Style="{StaticResource MuesliSecondaryButtonStyle}" Content="Finalize" Command="{Binding ViewModel.FinalizeRecoveryCommand, ElementName=RootPage}" CommandParameter="{Binding}" AutomationProperties.Name="Finalize recovered meeting" AutomationProperties.AutomationId="FinalizeRecoveryButton" />
                                            <Button Style="{StaticResource MuesliGhostButtonStyle}" Content="Discard" Command="{Binding ViewModel.DiscardRecoveryCommand, ElementName=RootPage}" CommandParameter="{Binding}" AutomationProperties.Name="Discard recovered audio" AutomationProperties.AutomationId="DiscardRecoveryButton" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

                <!--
                    Search stays on this row because the shell search is global history, not this
                    folder's meeting list. The redundant All / This PC source selector is gone: both
                    options resolved to the same local query, so it only added noise.
                -->
                <Grid x:Name="FilterRow" ColumnDefinitions="*">
                    <Border x:Name="SearchWell"
                            Style="{StaticResource MuesliSegmentedContainerStyle}"
                            Padding="8,0"
                            HorizontalAlignment="Stretch"
                            MinWidth="120">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <FontIcon Glyph="&#xE721;" FontSize="14" Foreground="{ThemeResource MuesliTextTertiaryBrush}" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1"
                                     Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     PlaceholderText="Search meetings"
                                     Style="{StaticResource MuesliSearchTextBoxStyle}"
                                     AutomationProperties.Name="Search meetings"
                                     AutomationProperties.AutomationId="MeetingsSearchBox" />
                        </Grid>
                    </Border>
                </Grid>

                <Grid>
                    <ListView x:Name="MeetingList"
                              ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                              SelectionMode="None"
                              IsItemClickEnabled="True"
                              ItemClick="MeetingList_ItemClick"
                              ContainerContentChanging="MeetingList_ContainerContentChanging"
                              AutomationProperties.Name="Meeting history"
                              Background="Transparent"
                              BorderThickness="0"
                              ScrollViewer.VerticalScrollBarVisibility="Disabled"
                              ScrollViewer.VerticalScrollMode="Disabled"
                              AutomationProperties.AutomationId="MeetingHistoryList">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="CornerRadius" Value="6" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="UseSystemFocusVisuals" Value="True" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemContainerTransitions><TransitionCollection /></ListView.ItemContainerTransitions>
                        <ListView.ItemTemplate>
                            <!--
                                MeetingListItemView.swift: a flat row (16 padding, hover fill from the
                                container, hairline divider inset 16), headline title, caption meta
                                "time  •  duration" with capsule badges, and a 14pt two-line preview.
                            -->
                            <DataTemplate x:DataType="vm:MeetingListItem">
                                <Grid>
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4" Padding="16">
                                        <StackPanel Spacing="8" MinWidth="0">
                                            <TextBlock Text="{x:Bind Title}" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource MuesliTextPrimaryBrush}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <Border Background="{x:Bind local:TimelinePage.StatusTint(StatusLabel)}" CornerRadius="9" Padding="6,2" VerticalAlignment="Center" Visibility="{x:Bind local:MeetingsPage.BoolToVisibility(ShowStatusBadge)}">
                                                    <TextBlock Text="{x:Bind StatusLabel}" FontFamily="{StaticResource MuesliFontFamilySemiBold}" FontSize="10" FontWeight="SemiBold" Foreground="{x:Bind local:TimelinePage.StatusBrush(StatusLabel)}" />
                                                </Border>
                                                <TextBlock Text="•" FontSize="12" Foreground="{ThemeResource MuesliTextTertiaryBrush}" VerticalAlignment="Center" Visibility="{x:Bind local:MeetingsPage.BoolToVisibility(ShowStatusBadge)}" />
                                                <TextBlock Text="{x:Bind MetaLabel}" FontSize="12" Foreground="{ThemeResource MuesliTextSecondaryBrush}" VerticalAlignment="Center" />
                                                <Border Background="{x:Bind local:MeetingsPage.SourceTint(SourceBadgeLabel)}" CornerRadius="9" Padding="6,2" VerticalAlignment="Center" Visibility="{x:Bind local:MeetingsPage.BoolToVisibility(ShowSourceBadge)}">
                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                        <FontIcon Glyph="{x:Bind SourceBadgeGlyph}" FontSize="10" Foreground="{x:Bind local:MeetingsPage.SourceForeground(SourceBadgeLabel)}" VerticalAlignment="Center" />
                                                        <TextBlock Text="{x:Bind SourceBadgeLabel}" FontFamily="{StaticResource MuesliFontFamilySemiBold}" FontSize="10" FontWeight="SemiBold" Foreground="{x:Bind local:MeetingsPage.SourceForeground(SourceBadgeLabel)}" />
                                                    </StackPanel>
                                                </Border>
                                                <TextBlock Text="•" FontSize="12" Foreground="{ThemeResource MuesliTextTertiaryBrush}" VerticalAlignment="Center" Visibility="{x:Bind local:MeetingsPage.BoolToVisibility(ShowFolderBadge)}" />
                                                <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" Visibility="{x:Bind local:MeetingsPage.BoolToVisibility(ShowFolderBadge)}">
                                                    <FontIcon Glyph="&#xE8B7;" FontSize="9" Foreground="{ThemeResource MuesliAccentTextBrush}" VerticalAlignment="Center" />
                                                    <TextBlock Text="{x:Bind FolderName}" FontSize="12" Foreground="{ThemeResource MuesliAccentTextBrush}" />
                                                </StackPanel>
                                            </StackPanel>
                                            <TextBlock Text="{x:Bind Summary}" FontSize="13" Foreground="{ThemeResource MuesliTextSecondaryBrush}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <!-- macOS folder.fill in accent when the meeting is filed. -->
                                        <FontIcon Grid.Column="1" Width="24" Height="24"
                                                  Glyph="&#xE8D5;"
                                                  Foreground="{ThemeResource MuesliAccentTextBrush}"
                                                  VerticalAlignment="Top"
                                                  FontSize="11"
                                                  Visibility="{x:Bind local:MeetingsPage.BoolToVisibility(ShowFolderBadge)}"
                                                  ToolTipService.ToolTip="{x:Bind FolderName}" />
                                    </Grid>
                                    <Border Height="1" Margin="16,0" VerticalAlignment="Bottom" Background="{ThemeResource MuesliBorderBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <!-- macOS empty state: a leading-aligned raised card, radius 20, padding 24. -->
                    <Border x:Name="EmptyState"
                            Background="{ThemeResource MuesliBackgroundRaisedBrush}"
                            CornerRadius="20"
                            Padding="24">
                        <StackPanel HorizontalAlignment="Left" Spacing="12">
                            <FontIcon Glyph="&#xE716;" FontSize="30" Foreground="{ThemeResource MuesliTextTertiaryBrush}" HorizontalAlignment="Left" />
                            <TextBlock Text="{x:Bind ViewModel.EmptyStateTitle, Mode=OneWay}" Style="{StaticResource MuesliTitle3Style}" Foreground="{ThemeResource MuesliTextSecondaryBrush}" TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind ViewModel.EmptyStateInstruction, Mode=OneWay}" Style="{StaticResource MuesliCalloutStyle}" Foreground="{ThemeResource MuesliTextTertiaryBrush}" TextWrapping="Wrap" MaxWidth="320" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

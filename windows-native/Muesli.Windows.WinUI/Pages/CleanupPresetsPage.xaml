<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Muesli.Windows.WinUI.Pages.CleanupPresetsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Muesli.Windows.WinUI.Pages"
    KeyboardAcceleratorPlacementMode="Hidden">
    <Page.Resources>
        <!-- macOS TranscriptCleanupPromptsManagerView actionButton: 11pt glyph, 12 semibold, 28 high, cornerSmall. -->
        <Style x:Key="PresetActionStyle" TargetType="Button" BasedOn="{StaticResource MuesliSecondaryButtonStyle}">
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Height" Value="28" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="PresetDestructiveActionStyle" TargetType="Button" BasedOn="{StaticResource PresetActionStyle}">
            <Setter Property="Foreground" Value="{ThemeResource MuesliErrorBrush}" />
            <Setter Property="Background" Value="{ThemeResource MuesliErrorMutedBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style x:Key="PresetFieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource MuesliTextSecondaryBrush}" />
        </Style>
        <Style x:Key="PresetErrorStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource MuesliErrorBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="AutomationProperties.LiveSetting" Value="Polite" />
        </Style>
        <Style x:Key="PresetSectionStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="CharacterSpacing" Value="60" />
            <Setter Property="Foreground" Value="{ThemeResource MuesliTextTertiaryBrush}" />
        </Style>
        <DataTemplate x:Key="PresetRowTemplate" x:DataType="local:CleanupPresetRow">
            <Border Padding="12" CornerRadius="6"
                    Background="{ThemeResource MuesliSurfaceBrush}"
                    BorderBrush="{x:Bind BorderBrush}" BorderThickness="1"
                    AutomationProperties.Name="{x:Bind Name}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <StackPanel Spacing="4" MinWidth="0">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="{x:Bind Glyph}" FontSize="10" Foreground="{ThemeResource MuesliAccentBrush}" />
                            <TextBlock Text="{x:Bind Name}" FontSize="12" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                            <Border Visibility="{x:Bind local:CleanupPresetsPage.BoolToVisibility(IsActive)}"
                                    Padding="6,2" CornerRadius="6" Background="{ThemeResource MuesliAccentMutedBrush}">
                                <TextBlock Text="Active" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource MuesliAccentBrush}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{x:Bind Prompt}" FontSize="12" Foreground="{ThemeResource MuesliTextSecondaryBrush}"
                                   TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                        <Button Style="{StaticResource PresetActionStyle}" Tag="{x:Bind}" Click="Use_Click"
                                IsEnabled="{x:Bind CanUse}" AutomationProperties.Name="Use this preset">
                            <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE73E;" FontSize="11" /><TextBlock Text="Use" /></StackPanel>
                        </Button>
                        <Button Style="{StaticResource PresetActionStyle}" Tag="{x:Bind}" Click="Duplicate_Click"
                                Visibility="{x:Bind local:CleanupPresetsPage.BoolToVisibility(IsBuiltIn)}" AutomationProperties.Name="Duplicate preset">
                            <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE8C8;" FontSize="11" /><TextBlock Text="Duplicate" /></StackPanel>
                        </Button>
                        <Button Style="{StaticResource PresetActionStyle}" Tag="{x:Bind}" Click="Edit_Click"
                                Visibility="{x:Bind local:CleanupPresetsPage.BoolToVisibility(IsCustom)}" AutomationProperties.Name="Edit preset">
                            <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE70F;" FontSize="11" /><TextBlock Text="Edit" /></StackPanel>
                        </Button>
                        <Button Style="{StaticResource PresetDestructiveActionStyle}" Tag="{x:Bind}" Click="Delete_Click"
                                Visibility="{x:Bind local:CleanupPresetsPage.BoolToVisibility(IsCustom)}" AutomationProperties.Name="Delete preset">
                            <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE74D;" FontSize="11" /><TextBlock Text="Delete" /></StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>
    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="S" Modifiers="Control" Invoked="SaveAccelerator_Invoked" />
        <KeyboardAccelerator Key="Escape" Invoked="CancelAccelerator_Invoked" />
    </Page.KeyboardAccelerators>

    <Grid Background="{ThemeResource MuesliBackgroundBrush}">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ContentRoot" Padding="{StaticResource MuesliPageContentPadding}" Spacing="20">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <StackPanel Spacing="4" MinWidth="0">
                        <Button Click="Back_Click" Style="{StaticResource MuesliGhostButtonStyle}"
                                HorizontalAlignment="Left" Padding="8,4" Margin="-8,0,0,8"
                                AutomationProperties.Name="Back to settings"
                                AutomationProperties.AutomationId="CleanupPresetsBackButton">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <FontIcon Glyph="&#xE72B;" FontSize="12" />
                                <TextBlock Text="Back to Settings" FontSize="13" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                        <TextBlock Text="Manage Cleanup Presets" Style="{StaticResource MuesliPageTitleStyle}" TextWrapping="Wrap" />
                        <TextBlock Text="Create reusable prompts for cloud dictation cleanup. The local cleanup model keeps its built-in instructions."
                                   FontSize="13" Foreground="{ThemeResource MuesliTextSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                    <Grid Grid.Column="1" VerticalAlignment="Bottom">
                        <Button x:Name="NewPresetButton" Style="{StaticResource PresetActionStyle}" Click="New_Click"
                                AutomationProperties.Name="New preset" AutomationProperties.AutomationId="NewCleanupPresetButton">
                            <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE710;" FontSize="11" /><TextBlock Text="New preset" /></StackPanel>
                        </Button>
                        <Button x:Name="CancelEditButton" Visibility="Collapsed" Style="{StaticResource PresetActionStyle}" Click="Cancel_Click"
                                AutomationProperties.Name="Cancel preset edits" AutomationProperties.AutomationId="CancelCleanupPresetButton"
                                ToolTipService.ToolTip="Cancel (Esc)">
                            <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE711;" FontSize="11" /><TextBlock Text="Cancel" /></StackPanel>
                        </Button>
                    </Grid>
                </Grid>

                <StackPanel Spacing="8">
                    <TextBlock Text="BUILT-IN PRESETS" Style="{StaticResource PresetSectionStyle}" />
                    <ItemsRepeater x:Name="BuiltInList" ItemTemplate="{StaticResource PresetRowTemplate}"
                                   AutomationProperties.AutomationId="BuiltInCleanupPresets">
                        <ItemsRepeater.Layout><StackLayout Spacing="8" /></ItemsRepeater.Layout>
                    </ItemsRepeater>
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock Text="CUSTOM PRESETS" Style="{StaticResource PresetSectionStyle}" />
                    <Border x:Name="EmptyState" HorizontalAlignment="Left" Padding="12,10" CornerRadius="6"
                            Background="{ThemeResource MuesliSurfaceBrush}" BorderBrush="{ThemeResource MuesliBorderSoftBrush}" BorderThickness="1"
                            AutomationProperties.AutomationId="CleanupPresetsEmptyState">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE710;" FontSize="11" Foreground="{ThemeResource MuesliTextTertiaryBrush}" />
                            <TextBlock Text="No custom cleanup presets yet." FontSize="13" Foreground="{ThemeResource MuesliTextTertiaryBrush}" />
                        </StackPanel>
                    </Border>
                    <ItemsRepeater x:Name="CustomList" ItemTemplate="{StaticResource PresetRowTemplate}"
                                   AutomationProperties.AutomationId="CustomCleanupPresets">
                        <ItemsRepeater.Layout><StackLayout Spacing="8" /></ItemsRepeater.Layout>
                    </ItemsRepeater>
                </StackPanel>

                <!-- macOS promptEditor: shown only while creating or editing. -->
                <Border x:Name="EditorCard" Visibility="Collapsed" Padding="12" CornerRadius="10"
                        Background="{ThemeResource MuesliSurfaceBrush}" BorderBrush="{ThemeResource MuesliBorderSoftBrush}" BorderThickness="1">
                    <StackPanel Spacing="12">
                        <TextBlock x:Name="EditorTitle" Text="New preset" FontSize="12" FontWeight="Medium" />
                        <StackPanel Spacing="6">
                            <TextBlock Text="Name" Style="{StaticResource PresetFieldLabelStyle}" />
                            <TextBox x:Name="NameBox" PlaceholderText="Context-aware cleanup" CornerRadius="6" FontSize="13"
                                     TextChanged="NameBox_TextChanged"
                                     AutomationProperties.Name="Preset name" AutomationProperties.AutomationId="CleanupPresetName" />
                            <TextBlock x:Name="NameError" Visibility="Collapsed" Style="{StaticResource PresetErrorStyle}" />
                        </StackPanel>
                        <StackPanel Spacing="6">
                            <TextBlock Text="Prompt" Style="{StaticResource PresetFieldLabelStyle}" />
                            <TextBox x:Name="PromptBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="180" MaxHeight="420"
                                     FontFamily="Consolas" FontSize="12" CornerRadius="6"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     AutomationProperties.Name="Cleanup prompt" AutomationProperties.AutomationId="CleanupPresetPrompt" />
                            <TextBlock x:Name="PromptError" Text="Enter a prompt." Visibility="Collapsed" Style="{StaticResource PresetErrorStyle}" />
                        </StackPanel>
                        <Button HorizontalAlignment="Right" Style="{StaticResource PresetActionStyle}" Click="Save_Click"
                                AutomationProperties.AutomationId="SaveCleanupPresetButton" ToolTipService.ToolTip="Save (Ctrl+S)">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon x:Name="SaveGlyph" Glyph="&#xE710;" FontSize="11" />
                                <TextBlock x:Name="SaveLabel" Text="Create preset" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

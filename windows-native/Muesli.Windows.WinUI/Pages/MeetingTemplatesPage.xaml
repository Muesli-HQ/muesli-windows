<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Muesli.Windows.WinUI.Pages.MeetingTemplatesPage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Muesli.Windows.WinUI.Pages"
    xmlns:svc="using:Muesli.Windows.Services"
    KeyboardAcceleratorPlacementMode="Hidden">
    <!--
        P8-06 (second site). The Page-level accelerators below have no Control owner, so the
        framework's Auto accelerator-tooltip placement has no anchor rect and strands a visible
        "Pop-upHost" outside the window. MainPage.xaml:9 carries the same suppression for the same
        reason; this page was the remaining Page-level accelerator owner in the shell.
    -->
    <Page.Resources>
        <!-- macOS MeetingTemplatesManagerView actionButton: 11pt glyph, 13 medium, 12,7 padding, cornerSmall. -->
        <Style x:Key="TemplateActionStyle" TargetType="Button" BasedOn="{StaticResource MuesliSecondaryButtonStyle}">
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="TemplateDestructiveActionStyle" TargetType="Button" BasedOn="{StaticResource TemplateActionStyle}">
            <Setter Property="Foreground" Value="{ThemeResource MuesliErrorBrush}" />
            <Setter Property="Background" Value="{ThemeResource MuesliErrorMutedBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style x:Key="TemplateFieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource MuesliTextSecondaryBrush}" />
        </Style>
        <Style x:Key="TemplateErrorStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource MuesliErrorBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="AutomationProperties.LiveSetting" Value="Polite" />
        </Style>
        <Style x:Key="TemplateEditorTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
    </Page.Resources>
    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="S" Modifiers="Control" Invoked="SaveAccelerator_Invoked" />
        <KeyboardAccelerator Key="N" Modifiers="Control" Invoked="NewAccelerator_Invoked" />
        <KeyboardAccelerator Key="Escape" Invoked="CancelAccelerator_Invoked" />
    </Page.KeyboardAccelerators>

    <Grid Background="{ThemeResource MuesliBackgroundBrush}">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ContentRoot"
                        Padding="{StaticResource MuesliPageContentPadding}"
                        Spacing="20">

                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <StackPanel Spacing="4" MinWidth="0">
                        <!-- P4-04: the back glyph starts on the page gutter. -->
                        <Button x:Name="BackButton"
                                Click="Back_Click"
                                Style="{StaticResource MuesliGhostButtonStyle}"
                                HorizontalAlignment="Left"
                                Padding="8,4"
                                Margin="-8,0,0,8"
                                AutomationProperties.Name="Back to meetings"
                                AutomationProperties.AutomationId="MeetingTemplatesBackButton">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <FontIcon Glyph="&#xE72B;" FontSize="12" />
                                <TextBlock Text="Back to Meetings" FontSize="13" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                        <TextBlock Text="Meeting Templates"
                                   Style="{StaticResource MuesliPageTitleStyle}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="Create reusable prompt-based note formats for meetings."
                                   FontSize="13"
                                   Foreground="{ThemeResource MuesliTextSecondaryBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <Grid Grid.Column="1" VerticalAlignment="Bottom">
                        <Button x:Name="NewTemplateButton"
                                Style="{StaticResource TemplateActionStyle}"
                                Click="NewTemplate_Click"
                                AutomationProperties.Name="New meeting template"
                                AutomationProperties.AutomationId="NewMeetingTemplateButton"
                                ToolTipService.ToolTip="New template (Ctrl+N)">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE710;" FontSize="11" />
                                <TextBlock Text="New template" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="CancelEditButton"
                                Visibility="Collapsed"
                                Style="{StaticResource TemplateActionStyle}"
                                Click="CancelEdit_Click"
                                AutomationProperties.Name="Cancel template edits"
                                AutomationProperties.AutomationId="CancelMeetingTemplateButton"
                                ToolTipService.ToolTip="Cancel (Esc)">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE711;" FontSize="11" />
                                <TextBlock Text="Cancel" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>

                <InfoBar x:Name="StatusBar"
                         IsOpen="{x:Bind ViewModel.IsStatusOpen, Mode=TwoWay}"
                         Title="{x:Bind ViewModel.StatusTitle, Mode=OneWay}"
                         Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                         IsClosable="True"
                         Visibility="{x:Bind local:MeetingTemplatesPage.BoolToVisibility(ViewModel.IsStatusOpen), Mode=OneWay}"
                         AutomationProperties.AutomationId="MeetingTemplatesStatus"
                         AutomationProperties.LiveSetting="Polite" />

                <StackPanel Spacing="12">
                    <!-- macOS emptyState: one quiet pill, not a hero card. -->
                    <Border x:Name="EmptyState"
                            HorizontalAlignment="Left"
                            Padding="12,10"
                            CornerRadius="6"
                            Background="{ThemeResource MuesliSurfaceBrush}"
                            BorderBrush="{ThemeResource MuesliBorderSoftBrush}"
                            BorderThickness="1"
                            AutomationProperties.Name="No custom templates yet"
                            AutomationProperties.AutomationId="MeetingTemplatesEmptyState">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE70F;" FontSize="11" Foreground="{ThemeResource MuesliTextTertiaryBrush}" />
                            <TextBlock Text="No custom templates yet." FontSize="13" Foreground="{ThemeResource MuesliTextTertiaryBrush}" />
                        </StackPanel>
                    </Border>

                    <ItemsRepeater x:Name="TemplateList"
                                   ItemsSource="{x:Bind ViewModel.Templates, Mode=OneWay}"
                                   AutomationProperties.Name="Custom meeting templates"
                                   AutomationProperties.AutomationId="MeetingTemplateList">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="8" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="svc:PersistedMeetingTemplate">
                                <Border Padding="12"
                                        CornerRadius="6"
                                        Background="{ThemeResource MuesliSurfaceBrush}"
                                        BorderBrush="{ThemeResource MuesliBorderSoftBrush}"
                                        BorderThickness="1"
                                        AutomationProperties.Name="{x:Bind Name}">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                        <StackPanel Spacing="4" MinWidth="0">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE70F;" FontSize="11" Foreground="{ThemeResource MuesliAccentBrush}" />
                                                <TextBlock Text="{x:Bind Name}"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <TextBlock Text="{x:Bind Prompt}"
                                                       FontSize="12"
                                                       Foreground="{ThemeResource MuesliTextSecondaryBrush}"
                                                       TextWrapping="Wrap"
                                                       MaxLines="2"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                                            <Button Style="{StaticResource TemplateActionStyle}"
                                                    Tag="{x:Bind}"
                                                    Click="EditTemplate_Click"
                                                    AutomationProperties.Name="Edit template">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xE70F;" FontSize="11" />
                                                    <TextBlock Text="Edit" />
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource TemplateDestructiveActionStyle}"
                                                    Tag="{x:Bind}"
                                                    Click="DeleteTemplate_Click"
                                                    AutomationProperties.Name="Delete meeting template">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xE74D;" FontSize="11" />
                                                    <TextBlock Text="Delete" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>

                    <!-- macOS customTemplateEditor: shown only while creating or editing. -->
                    <Border x:Name="TemplateEditorCard"
                            Visibility="Collapsed"
                            Padding="16"
                            CornerRadius="10"
                            Background="{ThemeResource MuesliSurfaceBrush}"
                            BorderBrush="{ThemeResource MuesliBorderSoftBrush}"
                            BorderThickness="1">
                        <StackPanel Spacing="12">
                            <TextBlock Text="{x:Bind ViewModel.EditorTitle, Mode=OneWay}"
                                       FontSize="13"
                                       FontWeight="SemiBold" />

                            <StackPanel Spacing="6">
                                <TextBlock Text="Name" Style="{StaticResource TemplateFieldLabelStyle}" />
                                <TextBox x:Name="NameBox"
                                         PlaceholderText="Customer follow-up"
                                         Style="{StaticResource TemplateEditorTextBoxStyle}"
                                         Text="{x:Bind ViewModel.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         KeyDown="NameBox_KeyDown"
                                         AutomationProperties.Name="Template name"
                                         AutomationProperties.AutomationId="MeetingTemplateName" />
                                <TextBlock Text="{x:Bind ViewModel.NameError, Mode=OneWay}"
                                           Style="{StaticResource TemplateErrorStyle}"
                                           Visibility="{x:Bind local:MeetingTemplatesPage.BoolToVisibility(ViewModel.HasNameError), Mode=OneWay}"
                                           AutomationProperties.AutomationId="MeetingTemplateNameError" />
                            </StackPanel>

                            <StackPanel Spacing="6">
                                <TextBlock Text="Prompt" Style="{StaticResource TemplateFieldLabelStyle}" />
                                <TextBox x:Name="PromptBox"
                                         PlaceholderText="Summarize decisions, owners, risks, and next steps."
                                         Style="{StaticResource TemplateEditorTextBoxStyle}"
                                         Text="{x:Bind ViewModel.Prompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         MinHeight="140"
                                         MaxHeight="360"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         AutomationProperties.Name="Summary instructions"
                                         AutomationProperties.AutomationId="MeetingTemplatePrompt" />
                                <TextBlock Text="{x:Bind ViewModel.PromptError, Mode=OneWay}"
                                           Style="{StaticResource TemplateErrorStyle}"
                                           Visibility="{x:Bind local:MeetingTemplatesPage.BoolToVisibility(ViewModel.HasPromptError), Mode=OneWay}"
                                           AutomationProperties.AutomationId="MeetingTemplatePromptError" />
                            </StackPanel>

                            <Button x:Name="SaveButton"
                                    HorizontalAlignment="Right"
                                    Style="{StaticResource TemplateActionStyle}"
                                    Click="Save_Click"
                                    AutomationProperties.Name="Save meeting template"
                                    AutomationProperties.AutomationId="SaveMeetingTemplateButton"
                                    ToolTipService.ToolTip="Save template (Ctrl+S)">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon x:Name="SaveGlyph" Glyph="&#xE710;" FontSize="11" />
                                    <TextBlock x:Name="SaveLabel" Text="Create template" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

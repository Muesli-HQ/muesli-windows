<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Muesli.Windows.WinUI.Pages.TimelinePage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Muesli.Windows.WinUI.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:svc="using:Muesli.Windows.WinUI.Services"
    xmlns:vm="using:Muesli.Windows.WinUI.ViewModels"
    mc:Ignorable="d">
    <Page.Resources>
        <!--
            P2-04: a timeline row is a real ListViewItem, so it gets the platform hover, selected
            and keyboard-focus visuals and arrow-key navigation within its day. The container is
            stripped back to a flat full-width row with the macOS small-corner hover.
        -->
        <Style x:Key="TimelineRowContainerStyle" TargetType="ListViewItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
        </Style>
    </Page.Resources>

    <Grid Background="{ThemeResource MuesliBackgroundBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="ContentStack" Padding="{StaticResource MuesliPageContentPadding}" Spacing="20">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="Timeline" Style="{StaticResource MuesliPageTitleStyle}" />
                    <Button Grid.Column="1"
                            Style="{StaticResource MuesliGhostButtonStyle}"
                            Command="{x:Bind ViewModel.RefreshCommand}"
                            AutomationProperties.AutomationId="TimelineRefreshButton"
                            AutomationProperties.Name="Refresh timeline"
                            ToolTipService.ToolTip="Refresh timeline">
                        <FontIcon Glyph="&#xE72C;" FontSize="15" />
                    </Button>
                </Grid>

                <!-- macOS StatsHeaderView: four cards, each a button that opens Insights. -->
                <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="16">
                    <Button Grid.Column="0" Style="{StaticResource MuesliStatButtonStyle}" Click="StatCard_Click"
                            ToolTipService.ToolTip="Open streak insights" AutomationProperties.Name="Current streak">
                        <StackPanel Spacing="8">
                            <!-- A flame path: the icon font has none. -->
                            <PathIcon Width="20" Height="20" HorizontalAlignment="Center"
                                      Data="M13.5.67s.74 2.65.74 4.8c0 2.06-1.35 3.73-3.41 3.73-2.07 0-3.63-1.67-3.63-3.73l.03-.36C5.21 7.51 4 10.62 4 14c0 4.42 3.58 8 8 8s8-3.58 8-8C20 8.61 17.41 3.8 13.5.67zM11.71 19c-1.78 0-3.22-1.4-3.22-3.14 0-1.62 1.05-2.76 2.81-3.12 1.77-.36 3.6-1.21 4.62-2.58.39 1.29.59 2.65.59 4.04 0 2.65-2.15 4.8-4.8 4.8z"
                                      Foreground="{ThemeResource MuesliWarningBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.Snapshot.CurrentStreak, Mode=OneWay}" Style="{StaticResource MuesliStatValueStyle}" />
                            <TextBlock Text="day streak" Style="{StaticResource MuesliStatLabelStyle}" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="1" Style="{StaticResource MuesliStatButtonStyle}" Click="StatCard_Click"
                            ToolTipService.ToolTip="Open word activity insights" AutomationProperties.Name="Words dictated">
                        <StackPanel Spacing="8">
                            <FontIcon Glyph="&#xE8D2;" FontSize="20" Foreground="{ThemeResource MuesliAccentBrush}" />
                            <TextBlock Text="{x:Bind local:TimelinePage.CompactCount(ViewModel.Snapshot.DictationWords), Mode=OneWay}" Style="{StaticResource MuesliStatValueStyle}" />
                            <TextBlock Text="words dictated" Style="{StaticResource MuesliStatLabelStyle}" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="2" Style="{StaticResource MuesliStatButtonStyle}" Click="StatCard_Click"
                            ToolTipService.ToolTip="Open speaking pace insights" AutomationProperties.Name="Average pace">
                        <StackPanel Spacing="8">
                            <FontIcon Glyph="&#xEC4A;" FontSize="20" Foreground="{ThemeResource MuesliSuccessBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.AveragePaceLabel, Mode=OneWay}" Style="{StaticResource MuesliStatValueStyle}" />
                            <TextBlock Text="avg WPM" Style="{StaticResource MuesliStatLabelStyle}" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="3" Style="{StaticResource MuesliStatButtonStyle}" Click="StatCard_Click"
                            ToolTipService.ToolTip="Open meeting insights" AutomationProperties.Name="Meetings">
                        <StackPanel Spacing="8">
                            <FontIcon Glyph="&#xE716;" FontSize="20" Foreground="{ThemeResource MuesliAccentBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.Snapshot.MeetingCount, Mode=OneWay}" Style="{StaticResource MuesliStatValueStyle}" />
                            <TextBlock Text="meetings" Style="{StaticResource MuesliStatLabelStyle}" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!--
                    No page-level search (the sidebar owns it). macOS ends the filter row with a
                    borderless funnel menu that becomes an accent pill only when it is not the
                    default; the filter Windows carries there is the sort order.
                -->
                <Grid x:Name="TimelineToolbar" ColumnDefinitions="*,Auto" Margin="0,-4,0,-8">
                    <Button x:Name="SortButton" Grid.Column="1"
                            Style="{StaticResource MuesliGhostButtonStyle}"
                            Padding="8,3" MinHeight="0" CornerRadius="12"
                            ToolTipService.ToolTip="Sort"
                            AutomationProperties.Name="Sort timeline"
                            AutomationProperties.AutomationId="TimelineSort">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <FontIcon x:Name="SortIcon" Glyph="&#xE71C;" FontSize="12" />
                            <TextBlock x:Name="SortLabel" FontSize="11" VerticalAlignment="Center" Visibility="Collapsed" />
                        </StackPanel>
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <RadioMenuFlyoutItem x:Name="NewestFirstItem" Text="Newest first" GroupName="TimelineSort" Click="SortItem_Click" Tag="0" />
                                <RadioMenuFlyoutItem x:Name="OldestFirstItem" Text="Oldest first" GroupName="TimelineSort" Click="SortItem_Click" Tag="1" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </Grid>

                <Grid>
                    <ListView x:Name="TimelineList"
                              ItemsSource="{x:Bind ViewModel.Groups, Mode=OneWay}"
                              SelectionMode="None"
                              IsItemClickEnabled="False"
                              Background="Transparent"
                              BorderThickness="0"
                              ContainerContentChanging="NamedListItem_ContainerContentChanging"
                              AutomationProperties.AutomationId="TimelineList">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,20" />
                                <Setter Property="MinHeight" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Background" Value="Transparent" />
                                <!-- The day group is a heading, not a target: only its rows activate. -->
                                <Setter Property="IsTabStop" Value="False" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemContainerTransitions><TransitionCollection /></ListView.ItemContainerTransitions>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:TimelineGroup">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="{x:Bind Name}" FontFamily="{StaticResource MuesliFontFamilySemiBold}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource MuesliTextTertiaryBrush}" Margin="4,0,0,0" />
                                        <ListView ItemsSource="{x:Bind Items}"
                                                  SelectionMode="Single"
                                                  IsItemClickEnabled="True"
                                                  ItemClick="TimelineRow_ItemClick"
                                                  ContainerContentChanging="TimelineRow_ContainerContentChanging"
                                                  ItemContainerStyle="{StaticResource TimelineRowContainerStyle}"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  Padding="0"
                                                  HorizontalContentAlignment="Stretch"
                                                  AutomationProperties.Name="{x:Bind Name}">
                                            <ListView.ItemContainerTransitions><TransitionCollection /></ListView.ItemContainerTransitions>
                                            <ListView.ItemTemplate>
                                                <DataTemplate x:DataType="svc:WinUiTimelineEntry">
                                                    <!--
                                                        macOS DictationRowView / TimelineMeetingRow: 80pt mono
                                                        time, 20pt gap, 20x16 padding, and a hairline divider
                                                        inset by the row padding. Titles sit in a star column
                                                        so trimming works (P2-03).
                                                    -->
                                                    <Grid>
                                                        <Grid ColumnDefinitions="80,*" ColumnSpacing="20" Padding="20,16">
                                                            <TextBlock Text="{x:Bind TimeLabel}" Style="{StaticResource MuesliTimestampStyle}" FontWeight="Medium" VerticalAlignment="Top" Margin="0,2,0,0" />
                                                            <!-- Dictation: the row is its own text, at reading size, up to three lines. -->
                                                            <TextBlock Grid.Column="1"
                                                                       Text="{x:Bind TitleLabel}"
                                                                       FontSize="15"
                                                                       LineHeight="21"
                                                                       Foreground="{ThemeResource MuesliTextPrimaryBrush}"
                                                                       TextWrapping="Wrap"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       MaxLines="3"
                                                                       Visibility="{x:Bind local:TimelinePage.InvertBoolToVisibility(IsMeeting)}" />
                                                            <StackPanel Grid.Column="1" Spacing="8" MinWidth="0"
                                                                        Visibility="{x:Bind local:TimelinePage.BoolToVisibility(IsMeeting)}">
                                                                <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto" ColumnSpacing="8">
                                                                    <FontIcon Glyph="&#xE716;" FontSize="12"
                                                                              Foreground="{ThemeResource MuesliAccentBrush}"
                                                                              VerticalAlignment="Center"
                                                                              AutomationProperties.AccessibilityView="Raw" />
                                                                    <TextBlock Grid.Column="1"
                                                                               Text="{x:Bind TitleLabel}"
                                                                               FontFamily="{StaticResource MuesliFontFamilySemiBold}"
                                                                               FontWeight="SemiBold"
                                                                               FontSize="14"
                                                                               Foreground="{ThemeResource MuesliTextPrimaryBrush}"
                                                                               TextTrimming="CharacterEllipsis"
                                                                               VerticalAlignment="Center" />
                                                                    <Border Grid.Column="2" CornerRadius="8" Padding="6,2" VerticalAlignment="Center"
                                                                            Background="{x:Bind local:TimelinePage.StatusTint(StatusLabel)}">
                                                                        <TextBlock Text="{x:Bind StatusLabel}" FontSize="10" FontWeight="SemiBold"
                                                                                   Foreground="{x:Bind local:TimelinePage.StatusBrush(StatusLabel)}" />
                                                                    </Border>
                                                                    <!-- The Windows equivalent of the macOS "Mac" origin badge. -->
                                                                    <Border Grid.Column="3" CornerRadius="4" Padding="5,2" VerticalAlignment="Center"
                                                                            Background="{ThemeResource MuesliAccentMutedBrush}"
                                                                            ToolTipService.ToolTip="Recorded on this PC">
                                                                        <TextBlock Text="PC" FontFamily="Consolas" FontSize="10" FontWeight="Bold"
                                                                                   Foreground="{ThemeResource MuesliAccentBrush}" />
                                                                    </Border>
                                                                    <TextBlock Grid.Column="5"
                                                                               Text="{x:Bind local:TimelinePage.MeetingDuration(DurationMs)}"
                                                                               FontSize="12"
                                                                               Foreground="{ThemeResource MuesliTextTertiaryBrush}"
                                                                               VerticalAlignment="Center" />
                                                                </Grid>
                                                                <TextBlock Text="{x:Bind local:TimelinePage.MeetingPreview(Detail)}"
                                                                           FontSize="13"
                                                                           Foreground="{ThemeResource MuesliTextSecondaryBrush}"
                                                                           TextWrapping="Wrap"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           MaxLines="2" />
                                                            </StackPanel>
                                                        </Grid>
                                                        <Rectangle Height="1" Margin="20,0" VerticalAlignment="Bottom"
                                                                   Fill="{ThemeResource MuesliBorderSoftBrush}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Border x:Name="EmptyState" MinHeight="260">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                            <FontIcon Glyph="&#xE823;" FontSize="40" Foreground="{ThemeResource MuesliTextTertiaryBrush}" HorizontalAlignment="Center" />
                            <TextBlock x:Name="EmptyStateTitle" Text="No activity yet" FontSize="18" FontWeight="SemiBold" Foreground="{ThemeResource MuesliTextSecondaryBrush}" HorizontalAlignment="Center" />
                            <TextBlock x:Name="EmptyStateBody" Text="Saved dictations and completed meetings will appear here." FontSize="13" Foreground="{ThemeResource MuesliTextTertiaryBrush}" TextAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

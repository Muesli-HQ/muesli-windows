<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Muesli.Windows.WinUI.Pages.TimelinePage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Muesli.Windows.WinUI.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:svc="using:Muesli.Windows.WinUI.Services"
    xmlns:vm="using:Muesli.Windows.WinUI.ViewModels"
    mc:Ignorable="d">
    <Page.Resources>
        <!--
            P2-04: a timeline row is a real ListViewItem, so it gets the platform hover, selected
            and keyboard-focus visuals and arrow-key navigation within its day. The container is
            stripped back to a flat full-width row; the rounded card comes from the group's Border.
        -->
        <Style x:Key="TimelineRowContainerStyle" TargetType="ListViewItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
        </Style>
    </Page.Resources>

    <Grid Background="{ThemeResource MuesliBackgroundBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="ContentStack" Padding="{StaticResource MuesliPageContentPadding}" Spacing="20">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="Timeline" Style="{StaticResource MuesliPageTitleStyle}" />
                    <Button Grid.Column="1"
                            Style="{StaticResource MuesliGhostButtonStyle}"
                            Command="{x:Bind ViewModel.RefreshCommand}"
                            AutomationProperties.AutomationId="TimelineRefreshButton"
                            AutomationProperties.Name="Refresh timeline"
                            ToolTipService.ToolTip="Refresh timeline">
                        <FontIcon Glyph="&#xE72C;" FontSize="15" />
                    </Button>
                </Grid>

                <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="14">
                    <Border Grid.Column="0" Style="{StaticResource MuesliStatCardStyle}" AutomationProperties.Name="Current streak">
                        <StackPanel Spacing="7">
                            <!--
                                P2-10: a flame, not a speech bubble. Same geometry as the Dictations
                                card so the two pages read as one metric, and a path rather than a
                                Segoe glyph because the icon font has no flame.
                            -->
                            <Grid Height="24">
                                <PathIcon Width="20" Height="20"
                                          Data="M13.5.67s.74 2.65.74 4.8c0 2.06-1.35 3.73-3.41 3.73-2.07 0-3.63-1.67-3.63-3.73l.03-.36C5.21 7.51 4 10.62 4 14c0 4.42 3.58 8 8 8s8-3.58 8-8C20 8.61 17.41 3.8 13.5.67zM11.71 19c-1.78 0-3.22-1.4-3.22-3.14 0-1.62 1.05-2.76 2.81-3.12 1.77-.36 3.6-1.21 4.62-2.58.39 1.29.59 2.65.59 4.04 0 2.65-2.15 4.8-4.8 4.8z"
                                          Foreground="{ThemeResource MuesliWarningBrush}" />
                            </Grid>
                            <TextBlock Text="{x:Bind ViewModel.Snapshot.CurrentStreak, Mode=OneWay}" Style="{StaticResource MuesliStatValueStyle}" />
                            <TextBlock Text="day streak" Style="{StaticResource MuesliStatLabelStyle}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource MuesliStatCardStyle}" AutomationProperties.Name="Words dictated">
                        <StackPanel Spacing="7">
                            <!-- Same "AI" mark as the Dictations card: both print the same figure. -->
                            <Grid Height="24">
                                <TextBlock Text="AI"
                                           FontFamily="{StaticResource MuesliFontFamilySemiBold}"
                                           FontSize="15" FontWeight="SemiBold"
                                           Foreground="{ThemeResource MuesliAccentBrush}"
                                           VerticalAlignment="Center" HorizontalAlignment="Center" />
                            </Grid>
                            <TextBlock Text="{x:Bind ViewModel.DictationWordsLabel, Mode=OneWay}" Style="{StaticResource MuesliStatValueStyle}" />
                            <TextBlock Text="words dictated" Style="{StaticResource MuesliStatLabelStyle}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource MuesliStatCardStyle}" AutomationProperties.Name="Average pace">
                        <StackPanel Spacing="7">
                            <Grid Height="24">
                                <FontIcon Glyph="&#xEC4A;" FontSize="20" Foreground="{ThemeResource MuesliSuccessBrush}" />
                            </Grid>
                            <TextBlock Text="{x:Bind ViewModel.AveragePaceLabel, Mode=OneWay}" Style="{StaticResource MuesliStatValueStyle}" />
                            <TextBlock Text="avg WPM" Style="{StaticResource MuesliStatLabelStyle}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="3" Style="{StaticResource MuesliStatCardStyle}" AutomationProperties.Name="Meetings">
                        <StackPanel Spacing="7">
                            <Grid Height="24">
                                <FontIcon Glyph="&#xE716;" FontSize="20" Foreground="{ThemeResource MuesliAccentBrush}" />
                            </Grid>
                            <TextBlock Text="{x:Bind ViewModel.Snapshot.MeetingCount, Mode=OneWay}" Style="{StaticResource MuesliStatValueStyle}" />
                            <TextBlock Text="meetings" Style="{StaticResource MuesliStatLabelStyle}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!--
                    P2-05: no page-level search field. The sidebar field is the shell's single
                    search entry point (macOS SearchResultsView has no field of its own either),
                    so this row carries only the kind filter, the result count and the sort order
                    and fits on one line at every qualification size.
                    P2-09: the permanently disabled "This PC" label is gone. Windows has exactly
                    one capture source (BACKEND-05), so a source filter would have a single
                    option; the kind filter is the honest Windows taxonomy for a mixed list.
                -->
                <Grid x:Name="TimelineToolbar" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <Border Style="{StaticResource MuesliSegmentedContainerStyle}">
                        <SelectorBar x:Name="TimelineFilterBar"
                                     SelectionChanged="TimelineFilter_SelectionChanged"
                                     AutomationProperties.Name="Filter timeline activity">
                            <SelectorBarItem Text="All" Tag="0" IsSelected="True" AutomationProperties.Name="Show all timeline activity" AutomationProperties.AutomationId="TimelineFilterAll" />
                            <SelectorBarItem Text="Dictations" Tag="1" AutomationProperties.Name="Show dictations" AutomationProperties.AutomationId="TimelineFilterDictations" />
                            <SelectorBarItem Text="Meetings" Tag="2" AutomationProperties.Name="Show meetings" AutomationProperties.AutomationId="TimelineFilterMeetings" />
                        </SelectorBar>
                    </Border>
                    <StackPanel x:Name="ActionsGroup" Grid.Column="2" Orientation="Horizontal" Spacing="12">
                        <TextBlock x:Name="ResultCountText"
                                   Text="{x:Bind ViewModel.ResultCountLabel, Mode=OneWay}"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource MuesliTextSecondaryBrush}" />
                        <ComboBox SelectedIndex="{x:Bind ViewModel.SortIndex, Mode=TwoWay}" MinWidth="145" AutomationProperties.Name="Sort timeline" AutomationProperties.AutomationId="TimelineSort">
                            <ComboBoxItem Content="Newest first" />
                            <ComboBoxItem Content="Oldest first" />
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <Grid>
                    <ListView x:Name="TimelineList"
                              ItemsSource="{x:Bind ViewModel.Groups, Mode=OneWay}"
                              SelectionMode="None"
                              IsItemClickEnabled="False"
                              Background="Transparent"
                              BorderThickness="0"
                              ContainerContentChanging="NamedListItem_ContainerContentChanging"
                              AutomationProperties.AutomationId="TimelineList">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,14" />
                                <Setter Property="MinHeight" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Background" Value="Transparent" />
                                <!-- The day group is a heading, not a target: only its rows activate. -->
                                <Setter Property="IsTabStop" Value="False" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemContainerTransitions><TransitionCollection /></ListView.ItemContainerTransitions>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:TimelineGroup">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="{x:Bind Name}" Style="{StaticResource MuesliSectionLabelStyle}" Margin="4,2,0,0" />
                                    <Border Style="{StaticResource MuesliCardStyle}" Padding="0">
                                        <ListView ItemsSource="{x:Bind Items}"
                                                  SelectionMode="Single"
                                                  IsItemClickEnabled="True"
                                                  ItemClick="TimelineRow_ItemClick"
                                                  ContainerContentChanging="TimelineRow_ContainerContentChanging"
                                                  ItemContainerStyle="{StaticResource TimelineRowContainerStyle}"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  Padding="0"
                                                  HorizontalContentAlignment="Stretch"
                                                  AutomationProperties.Name="{x:Bind Name}">
                                            <ListView.ItemContainerTransitions><TransitionCollection /></ListView.ItemContainerTransitions>
                                            <ListView.ItemTemplate>
                                                <DataTemplate x:DataType="svc:WinUiTimelineEntry">
                                                    <!--
                                                        P2-03: the title lives in a star column of a
                                                        Grid, not in a horizontal StackPanel. A
                                                        StackPanel measures its children with
                                                        infinite width, so TextTrimming could never
                                                        fire and titles were hard-clipped mid-word
                                                        while the secondary line ellipsized
                                                        correctly two lines below.
                                                    -->
                                                    <Border BorderBrush="{ThemeResource MuesliBorderSoftBrush}" BorderThickness="0,0,0,1" Padding="18,14">
                                                        <Grid ColumnDefinitions="86,*,Auto" ColumnSpacing="16">
                                                            <TextBlock Text="{x:Bind TimeLabel}" Style="{StaticResource MuesliTimestampStyle}" VerticalAlignment="Top" Margin="0,1,0,0" />
                                                            <StackPanel Grid.Column="1" Spacing="5" MinWidth="0">
                                                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                                                    <FontIcon Glyph="&#xE716;"
                                                                              FontSize="14"
                                                                              Foreground="{ThemeResource MuesliAccentBrush}"
                                                                              VerticalAlignment="Top"
                                                                              Margin="0,3,0,0"
                                                                              Visibility="{x:Bind local:TimelinePage.BoolToVisibility(IsMeeting)}"
                                                                              AutomationProperties.AccessibilityView="Raw" />
                                                                    <!--
                                                                        A meeting title is a name
                                                                        and reads bold; a dictation
                                                                        row *is* its transcript and
                                                                        reads as body text, exactly
                                                                        as on macOS.
                                                                    -->
                                                                    <TextBlock Grid.Column="1"
                                                                               Text="{x:Bind TitleLabel}"
                                                                               Style="{StaticResource MuesliRowTitleStyle}"
                                                                               FontFamily="{x:Bind local:TimelinePage.TitleFont(IsMeeting)}"
                                                                               FontWeight="{x:Bind local:TimelinePage.TitleWeight(IsMeeting)}"
                                                                               TextWrapping="Wrap"
                                                                               MaxLines="2" />
                                                                    <StackPanel Grid.Column="2"
                                                                                Orientation="Horizontal"
                                                                                Spacing="6"
                                                                                VerticalAlignment="Top"
                                                                                Margin="0,1,0,0"
                                                                                Visibility="{x:Bind local:TimelinePage.BoolToVisibility(IsMeeting)}">
                                                                        <Border Style="{StaticResource MuesliSuccessBadgeStyle}">
                                                                            <TextBlock Text="{x:Bind StatusLabel}" Style="{StaticResource MuesliSuccessBadgeTextStyle}" />
                                                                        </Border>
                                                                        <!-- The Windows equivalent of the macOS "Mac" source badge. -->
                                                                        <Border Style="{StaticResource MuesliAccentBadgeStyle}">
                                                                            <TextBlock Text="PC" Style="{StaticResource MuesliAccentBadgeTextStyle}" />
                                                                        </Border>
                                                                    </StackPanel>
                                                                </Grid>
                                                                <TextBlock Text="{x:Bind DetailLabel}"
                                                                           Style="{StaticResource MuesliRowSecondaryStyle}"
                                                                           TextWrapping="NoWrap"
                                                                           MaxLines="1"
                                                                           Visibility="{x:Bind local:TimelinePage.BoolToVisibility(HasDetail)}" />
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="2" Text="{x:Bind DurationLabel}" Style="{StaticResource MuesliRowSecondaryStyle}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,1,0,0" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Border x:Name="EmptyState" Style="{StaticResource MuesliCardStyle}" MinHeight="160">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                            <FontIcon Glyph="&#xE823;" FontSize="28" Foreground="{ThemeResource MuesliTextTertiaryBrush}" HorizontalAlignment="Center" />
                            <TextBlock x:Name="EmptyStateTitle" Text="No timeline activity yet" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock x:Name="EmptyStateBody" Text="Saved dictations and completed meetings will appear here." Style="{StaticResource MuesliBodyStyle}" TextAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

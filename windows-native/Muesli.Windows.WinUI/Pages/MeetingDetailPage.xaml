<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Muesli.Windows.WinUI.Pages.MeetingDetailPage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Muesli.Windows.WinUI.ViewModels"
    xmlns:local="using:Muesli.Windows.WinUI.Pages"
    xmlns:services="using:Muesli.Windows.Services"
    xmlns:controls="using:Muesli.Windows.WinUI.Controls"
    UseSystemFocusVisuals="True"
    XYFocusKeyboardNavigation="Enabled">
    <Page.Resources>
        <Style x:Key="MeetingTitleEditorStyle" TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
            <Setter Property="FontFamily" Value="{StaticResource MuesliFontFamilySemiBold}" />
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{ThemeResource MuesliTextPrimaryBrush}" />
            <Setter Property="Background" Value="{ThemeResource ControlFillColorTransparentBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource ControlFillColorTransparentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0,2" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="MaxLength" Value="200" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="AcceptsReturn" Value="False" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
        </Style>
        <Style x:Key="MeetingBodyEditorStyle" TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
        </Style>
        <Style x:Key="MeetingSectionCardStyle" TargetType="Border" BasedOn="{StaticResource MuesliCardStyle}">
            <Setter Property="Padding" Value="22,18" />
        </Style>
        <Style x:Key="MeetingToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource MuesliSecondaryButtonStyle}">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
        </Style>
        <Style x:Key="MeetingIconButtonStyle" TargetType="Button" BasedOn="{StaticResource MuesliGhostButtonStyle}">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="32" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
        </Style>
    </Page.Resources>

    <Grid Background="{ThemeResource MuesliBackgroundBrush}">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ContentStack" Padding="{StaticResource MuesliPageContentPadding}" Spacing="16" HorizontalAlignment="Stretch">

                <!-- P4-04: same leading-edge rule as MeetingTemplatesPage's back link. -->
                <Button x:Name="BackButton"
                        Style="{StaticResource MuesliGhostButtonStyle}"
                        HorizontalAlignment="Left"
                        Padding="8,4"
                        Margin="-8,0,0,0"
                        Click="Back_Click"
                        UseSystemFocusVisuals="True"
                        AutomationProperties.Name="Back to meetings"
                        AutomationProperties.AutomationId="MeetingDetailBackButton">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <FontIcon Glyph="&#xE76B;" FontSize="12" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                        <TextBlock Text="Back to Meetings" />
                    </StackPanel>
                </Button>

                <Border x:Name="MissingState"
                        Style="{StaticResource MeetingSectionCardStyle}"
                        Padding="28"
                        MinHeight="180"
                        Visibility="{x:Bind BoolToVisibility(ViewModel.IsMissing), Mode=OneWay}"
                        AutomationProperties.Name="Meeting not found"
                        AutomationProperties.AutomationId="MeetingDetailEmptyState">
                    <StackPanel Spacing="10" VerticalAlignment="Center" MaxWidth="520">
                        <FontIcon Glyph="&#xE8F1;"
                                  FontSize="28"
                                  FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                  Foreground="{ThemeResource MuesliTextTertiaryBrush}"
                                  HorizontalAlignment="Left" />
                        <TextBlock Text="Meeting not found"
                                   Style="{StaticResource MuesliRowTitleStyle}"
                                   FontSize="22"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind ViewModel.Metadata, Mode=OneWay}"
                                   Style="{StaticResource MuesliBodyStyle}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="Go back to Meetings to open another recording from this profile."
                                   Style="{StaticResource MuesliBodyStyle}"
                                   Foreground="{ThemeResource MuesliTextTertiaryBrush}" />
                    </StackPanel>
                </Border>

                <Grid x:Name="MeetingChrome"
                      Visibility="{x:Bind BoolToVisibility(ViewModel.HasMeeting), Mode=OneWay}"
                      ColumnSpacing="16"
                      RowSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel x:Name="TitleBlock" MinWidth="0" Spacing="4">
                        <TextBox Text="{x:Bind ViewModel.Title, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                 Style="{StaticResource MeetingTitleEditorStyle}"
                                 PlaceholderText="Untitled meeting"
                                 ToolTipService.ToolTip="Click to rename this meeting"
                                 AutomationProperties.Name="Meeting title"
                                 AutomationProperties.AutomationId="MeetingTitleEditor" />
                        <TextBlock Text="{x:Bind ViewModel.TitleOwnershipLabel, Mode=OneWay}"
                                   Style="{StaticResource MuesliRowSecondaryStyle}"
                                   FontSize="11"
                                   Foreground="{ThemeResource MuesliTextTertiaryBrush}"
                                   TextWrapping="Wrap"
                                   Visibility="{x:Bind BoolToVisibility(ViewModel.HasManualTitle), Mode=OneWay}"
                                   AutomationProperties.Name="Your title · kept when notes are regenerated" />
                        <!--
                            A horizontal StackPanel measures its children with infinite width, so
                            TextWrapping on the metadata never fired and the "Auto Notes" badge was
                            pushed under the action column and clipped at 1008x800. A two-column
                            Grid lets the metadata wrap and keeps the badge on screen.
                        -->
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBlock Text="{x:Bind ViewModel.Metadata, Mode=OneWay}"
                                       Style="{StaticResource MuesliRowSecondaryStyle}"
                                       TextWrapping="Wrap"
                                       TextTrimming="None"
                                       VerticalAlignment="Center"
                                       AutomationProperties.Name="Meeting metadata" />
                            <Border Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource MuesliAccentBadgeStyle}"
                                    Visibility="{x:Bind BoolToVisibility(ViewModel.HasGeneratedSummary), Mode=OneWay}">
                                <TextBlock Text="Auto Notes" Style="{StaticResource MuesliAccentBadgeTextStyle}" />
                            </Border>
                        </Grid>
                        <!--
                            Nesting is shown the way the shell rail and the Meetings page show it,
                            because the list comes from the same MeetingFolderListItem.BuildTree.
                            UIA trims the leading spaces, so each option announces its parent
                            instead — a "Notes" under Archive and a "Notes" under Research are
                            both legal and are otherwise identical to a screen reader.
                        -->
                        <ComboBox x:Name="FolderPicker"
                                  Header="Folder"
                                  ItemsSource="{x:Bind ViewModel.FolderOptions, Mode=OneWay}"
                                  SelectedItem="{x:Bind ViewModel.SelectedFolder, Mode=TwoWay}"
                                  MinWidth="180"
                                  MaxWidth="280"
                                  HorizontalAlignment="Left"
                                  Margin="0,6,0,0"
                                  AutomationProperties.Name="Folder"
                                  AutomationProperties.AutomationId="MeetingFolderPicker">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:MeetingFolderOption">
                                    <StackPanel Orientation="Horizontal"
                                                Spacing="8"
                                                AutomationProperties.Name="{x:Bind AccessibleName}">
                                        <TextBlock Text="{x:Bind DisplayName}"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxLines="1" />
                                        <TextBlock Text="{x:Bind ParentSuffix}"
                                                   Style="{StaticResource MuesliRowSecondaryStyle}"
                                                   Foreground="{ThemeResource MuesliTextTertiaryBrush}"
                                                   MaxLines="1"
                                                   Visibility="{x:Bind local:MeetingDetailPage.StaticBoolToVisibility(HasParent)}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel x:Name="ChromeActions"
                                Grid.Column="1"
                                Spacing="10"
                                VerticalAlignment="Top"
                                HorizontalAlignment="Right">
                        <Border x:Name="DetailTabWell" Style="{StaticResource MuesliSegmentedContainerStyle}">
                            <SelectorBar x:Name="DetailTabBar"
                                         SelectionChanged="DetailTabBar_SelectionChanged"
                                         AutomationProperties.Name="Meeting notes or transcript">
                                <SelectorBarItem x:Name="NotesTabItem"
                                                 Text="Notes"
                                                 IsSelected="True"
                                                 AutomationProperties.Name="Notes tab"
                                                 AutomationProperties.AutomationId="MeetingNotesTab" />
                                <SelectorBarItem x:Name="TranscriptTabItem"
                                                 Text="Transcript"
                                                 AutomationProperties.Name="Transcript tab"
                                                 AutomationProperties.AutomationId="MeetingTranscriptTab" />
                            </SelectorBar>
                        </Border>
                        <StackPanel x:Name="HeaderCommands" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                            <Button x:Name="SaveButton"
                                    Style="{StaticResource MuesliPrimaryButtonStyle}"
                                    Command="{x:Bind ViewModel.SaveCommand}"
                                    Content="Save"
                                    AutomationProperties.Name="Save meeting"
                                    AutomationProperties.AutomationId="MeetingSaveButton" />
                            <Button x:Name="CopyTranscriptButton"
                                    Style="{StaticResource MeetingToolbarButtonStyle}"
                                    Command="{x:Bind ViewModel.CopyTranscriptCommand}"
                                    AutomationProperties.Name="Copy Transcript"
                                    AutomationProperties.AutomationId="MeetingCopyTranscriptButton">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <FontIcon Glyph="&#xE8C8;" FontSize="14" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                                    <TextBlock Text="Copy Transcript" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="ExportButton"
                                    Style="{StaticResource MeetingToolbarButtonStyle}"
                                    Command="{x:Bind ViewModel.ExportMarkdownCommand}"
                                    AutomationProperties.Name="Export"
                                    AutomationProperties.AutomationId="MeetingExportButton">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <FontIcon Glyph="&#xE74E;" FontSize="14" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                                    <TextBlock Text="Export" />
                                </StackPanel>
                            </Button>
                            <!--
                                P4-03. Delete is not a peer of Save. The macOS detail view keeps
                                it behind the "…" more-actions menu
                                (MeetingDetailView.swift:877-916, `moreActionsMenu`), so the only
                                irreversible action on the page is one deliberate step away from
                                the primary one instead of sitting beside it at the same weight.
                            -->
                            <Button x:Name="MoreActionsButton"
                                    Style="{StaticResource MeetingToolbarButtonStyle}"
                                    AutomationProperties.Name="More actions"
                                    AutomationProperties.AutomationId="MeetingMoreActionsButton"
                                    ToolTipService.ToolTip="More actions">
                                <Button.Flyout>
                                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                                        <MenuFlyoutItem Text="Resume recording" Command="{x:Bind ViewModel.ResumeFinishedCommand}"
                                                        AutomationProperties.AutomationId="MeetingResumeFinishedButton" />
                                        <MenuFlyoutItem Text="Start follow-up" Command="{x:Bind ViewModel.StartFollowUpCommand}"
                                                        AutomationProperties.AutomationId="MeetingStartFollowUpButton" />
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem x:Name="DeleteMenuItem"
                                                        Text="Delete meeting"
                                                        Command="{x:Bind ViewModel.DeleteMeetingCommand}"
                                                        Foreground="{ThemeResource MuesliErrorBrush}"
                                                        AutomationProperties.Name="Delete meeting"
                                                        AutomationProperties.AutomationId="MeetingDeleteButton">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE74D;"
                                                          FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                                          Foreground="{ThemeResource MuesliErrorBrush}" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </Button.Flyout>
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <FontIcon Glyph="&#xE712;" FontSize="14" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                                    <!-- Stacked full-width, a bare "…" bar says nothing; the label is
                                         revealed only where the button is no longer a compact icon. -->
                                    <TextBlock x:Name="MoreActionsLabel" Text="More actions" Visibility="Collapsed" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <StackPanel Spacing="8" Visibility="{x:Bind BoolToVisibility(ViewModel.HasRelatedMeetings), Mode=OneWay}">
                    <TextBlock Text="Related meetings" Style="{StaticResource MuesliSectionLabelStyle}" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.RelatedMeetings, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="services:PersistedMeeting">
                                <Button Content="{x:Bind Title}" Tag="{x:Bind Id}" Click="RelatedMeeting_Click"
                                        HorizontalAlignment="Left" Margin="0,2" AutomationProperties.Name="{x:Bind Title}"
                                        AutomationProperties.AutomationId="{x:Bind Id}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <Border x:Name="WorkingBanner"
                        Style="{StaticResource MeetingSectionCardStyle}"
                        Padding="14,12"
                        Visibility="{x:Bind BoolToVisibility(ViewModel.IsWorking), Mode=OneWay}"
                        AutomationProperties.Name="Meeting operation in progress">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                                   Style="{StaticResource MuesliRowTitleStyle}"
                                   TextWrapping="Wrap"
                                   AutomationProperties.LiveSetting="Polite" />
                        <ProgressBar IsIndeterminate="{x:Bind ViewModel.IsWorking, Mode=OneWay}"
                                     Value="{x:Bind ViewModel.WorkProgress, Mode=OneWay}"
                                     Maximum="100"
                                     AutomationProperties.Name="Meeting operation progress" />
                    </StackPanel>
                </Border>

                <InfoBar x:Name="StatusBar"
                         IsOpen="{x:Bind ViewModel.IsStatusOpen, Mode=TwoWay}"
                         Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                         Severity="Success"
                         AutomationProperties.AutomationId="MeetingDetailStatus"
                         AutomationProperties.LiveSetting="Polite" />

                <Border Style="{StaticResource MeetingSectionCardStyle}"
                        Padding="14"
                        Visibility="{x:Bind BoolToVisibility(ViewModel.HasRecording), Mode=OneWay}"
                        AutomationProperties.Name="Meeting recording"
                        AutomationProperties.AutomationId="MeetingRecordingCard">
                    <StackPanel Spacing="10">
                        <TextBlock Text="RECORDING" Style="{StaticResource MuesliSectionLabelStyle}" />
                        <Grid x:Name="PlaybackToolbar" ColumnSpacing="8" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ComboBox x:Name="TrackPicker"
                                      ItemsSource="{x:Bind ViewModel.PlaybackTracks, Mode=OneWay}"
                                      SelectedItem="{x:Bind ViewModel.SelectedPlaybackTrack, Mode=TwoWay}"
                                      DisplayMemberPath="Label"
                                      HorizontalAlignment="Stretch"
                                      MinWidth="0"
                                      AutomationProperties.Name="Recording track"
                                      AutomationProperties.AutomationId="MeetingRecordingTrack" />
                            <Button x:Name="PlayButton"
                                    Grid.Column="1"
                                    Style="{StaticResource MeetingToolbarButtonStyle}"
                                    Command="{x:Bind ViewModel.PlayCommand}"
                                    Content="Play"
                                    AutomationProperties.Name="Play"
                                    AutomationProperties.AutomationId="MeetingPlaybackPlay" />
                            <Button x:Name="PauseButton"
                                    Grid.Column="2"
                                    Style="{StaticResource MeetingToolbarButtonStyle}"
                                    Command="{x:Bind ViewModel.PauseCommand}"
                                    Content="Pause"
                                    AutomationProperties.Name="Pause"
                                    AutomationProperties.AutomationId="MeetingPlaybackPause" />
                            <Button x:Name="StopButton"
                                    Grid.Column="3"
                                    Style="{StaticResource MeetingToolbarButtonStyle}"
                                    Command="{x:Bind ViewModel.StopPlaybackCommand}"
                                    Content="Stop"
                                    AutomationProperties.Name="Stop"
                                    AutomationProperties.AutomationId="MeetingPlaybackStop" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <Slider x:Name="PlaybackSlider"
                                    Minimum="0"
                                    Maximum="{x:Bind ViewModel.PlaybackSliderMaximum, Mode=OneWay}"
                                    Value="{x:Bind ViewModel.PlaybackSeconds, Mode=OneWay}"
                                    VerticalAlignment="Center"
                                    PointerCaptureLost="PlaybackSlider_PointerCaptureLost"
                                    AutomationProperties.Name="Seek recording"
                                    AutomationProperties.AutomationId="MeetingPlaybackSeek" />
                            <TextBlock Grid.Column="1"
                                       Text="{x:Bind ViewModel.PlaybackTimeLabel, Mode=OneWay}"
                                       Style="{StaticResource MuesliTimestampStyle}"
                                       FontSize="11"
                                       VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock Text="{x:Bind ViewModel.PlaybackStatus, Mode=OneWay}"
                                   Style="{StaticResource MuesliRowSecondaryStyle}"
                                   TextWrapping="Wrap"
                                   AutomationProperties.LiveSetting="Polite" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.WaveformBars, Mode=OneWay}"
                                      Height="48"
                                      Visibility="{x:Bind BoolToVisibility(ViewModel.HasWaveform), Mode=OneWay}"
                                      AutomationProperties.Name="Recording waveform"
                                      AutomationProperties.AutomationId="MeetingWaveform">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="1" VerticalAlignment="Bottom" Height="48" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="3"
                                            Height="{Binding Height}"
                                            CornerRadius="1"
                                            Background="{ThemeResource MuesliAccentBrush}"
                                            VerticalAlignment="Bottom" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource MeetingSectionCardStyle}"
                        Padding="12,10"
                        Background="{ThemeResource MuesliAccentMutedBrush}"
                        BorderBrush="{ThemeResource MuesliWarningBrush}"
                        Visibility="{x:Bind BoolToVisibility(ViewModel.HasHealthWarnings), Mode=OneWay}"
                        AutomationProperties.Name="Recording warnings">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Recording warnings"
                                   Style="{StaticResource MuesliRowTitleStyle}"
                                   FontSize="12"
                                   Foreground="{ThemeResource MuesliWarningBrush}" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.HealthWarnings, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,0,4">
                                        <FontIcon Glyph="&#xE7BA;"
                                                  FontSize="12"
                                                  FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                                  Foreground="{ThemeResource MuesliWarningBrush}"
                                                  VerticalAlignment="Top"
                                                  Margin="0,2,0,0" />
                                        <TextBlock Text="{Binding}"
                                                   Style="{StaticResource MuesliBodyStyle}"
                                                   Foreground="{ThemeResource MuesliWarningBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Post-meeting automation diagnostics (HOOK-01/AUTO-01). Renders the persisted
                     automation result exactly as POST_MEETING_AUTOMATION.md promises; hidden until a
                     run exists so an untouched meeting does not show an empty card. -->
                <Border Style="{StaticResource MeetingSectionCardStyle}"
                        Padding="12,10"
                        Visibility="{x:Bind BoolToVisibility(ViewModel.HasAutomationResult), Mode=OneWay}"
                        AutomationProperties.Name="After-meeting automation">
                    <StackPanel Spacing="6">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="After-meeting automation"
                                       Style="{StaticResource MuesliRowTitleStyle}"
                                       FontSize="12"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Text="{x:Bind ViewModel.AutomationStatusLabel, Mode=OneWay}"
                                       Style="{StaticResource MuesliBodyStyle}"
                                       VerticalAlignment="Center"
                                       AutomationProperties.Name="After-meeting automation status"
                                       AutomationProperties.AutomationId="AutomationStatusLabel" />
                        </Grid>
                        <TextBlock Text="{x:Bind ViewModel.AutomationDiagnostics, Mode=OneWay}"
                                   Style="{StaticResource MuesliBodyStyle}"
                                   TextWrapping="Wrap"
                                   AutomationProperties.Name="After-meeting automation details"
                                   AutomationProperties.AutomationId="AutomationDiagnosticsText" />
                        <Expander Header="Retained hook output (redacted)"
                                  HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Stretch"
                                  Visibility="{x:Bind BoolToVisibility(ViewModel.HasAutomationRawOutput), Mode=OneWay}"
                                  AutomationProperties.Name="Show retained hook output"
                                  AutomationProperties.AutomationId="AutomationRawOutputExpander">
                            <Border Background="{ThemeResource MuesliBackgroundDeepBrush}"
                                    BorderBrush="{ThemeResource MuesliBorderSoftBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="10,8"
                                    MaxHeight="200">
                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <TextBlock Text="{x:Bind ViewModel.AutomationRawOutput, Mode=OneWay}"
                                               FontFamily="Consolas, Cascadia Mono, monospace"
                                               FontSize="12"
                                               LineHeight="18"
                                               TextWrapping="Wrap"
                                               IsTextSelectionEnabled="True"
                                               AutomationProperties.AutomationId="AutomationRawOutputText" />
                                </ScrollViewer>
                            </Border>
                        </Expander>
                    </StackPanel>
                </Border>

                <StackPanel x:Name="NotesPanel"
                            Spacing="12"
                            Visibility="{x:Bind BoolToVisibility(ViewModel.ShowNotesContent), Mode=OneWay}">
                    <Grid x:Name="NotesToolbar" ColumnSpacing="10" RowSpacing="8"
                          Visibility="{x:Bind BoolToVisibility(ViewModel.ShowGeneratedNotes), Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="NOTES"
                                   Style="{StaticResource MuesliSectionLabelStyle}"
                                   VerticalAlignment="Center"
                                   AutomationProperties.Name="Meeting summary heading" />
                        <ComboBox x:Name="SummaryTemplatePicker"
                                  Grid.Column="1"
                                  ItemsSource="{x:Bind ViewModel.TemplateNames}"
                                  SelectedItem="{x:Bind ViewModel.SelectedTemplate, Mode=TwoWay}"
                                  MinWidth="180"
                                  MaxWidth="260"
                                  VerticalAlignment="Center"
                                  AutomationProperties.Name="Meeting summary template"
                                  AutomationProperties.AutomationId="MeetingSummaryTemplate" />
                        <Button x:Name="GenerateNotesButton"
                                Grid.Column="2"
                                Style="{StaticResource MuesliPrimaryButtonStyle}"
                                Command="{x:Bind ViewModel.GenerateSummaryCommand}"
                                ToolTipService.ToolTip="{x:Bind ViewModel.GenerateSummaryHint, Mode=OneWay}"
                                AutomationProperties.Name="Generate Notes"
                                AutomationProperties.HelpText="{x:Bind ViewModel.GenerateSummaryHint, Mode=OneWay}"
                                AutomationProperties.AutomationId="GenerateMeetingSummaryButton">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <FontIcon Glyph="&#xE70F;" FontSize="14" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                                <TextBlock Text="Generate Notes" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Border Style="{StaticResource MeetingSectionCardStyle}"
                            AutomationProperties.Name="Meeting summary"
                            Visibility="{x:Bind BoolToVisibility(ViewModel.ShowGeneratedNotes), Mode=OneWay}"
                            AutomationProperties.AutomationId="MeetingSummaryCard">
                        <StackPanel Spacing="8">
                            <controls:MarkdownNotesEditor Markdown="{x:Bind ViewModel.Summary, Mode=OneWay}"
                                       TextWrapping="Wrap" IsReadOnly="True" BorderThickness="0" Padding="0"
                                       Background="Transparent" MinHeight="80" MaxHeight="560"
                                       Visibility="{x:Bind BoolToVisibility(ViewModel.HasGeneratedSummary), Mode=OneWay}"
                                       AutomationProperties.AutomationId="MeetingSummaryText" />
                            <StackPanel Spacing="6"
                                        Visibility="{x:Bind InvertBoolToVisibility(ViewModel.HasGeneratedSummary), Mode=OneWay}">
                                <TextBlock Text="No summary has been generated."
                                           Style="{StaticResource MuesliRowTitleStyle}"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="Generate Notes writes a summary from this meeting's transcript. Nothing is invented when the transcript is empty."
                                           Style="{StaticResource MuesliBodyStyle}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource MeetingSectionCardStyle}"
                            AutomationProperties.Name="Private meeting notes"
                            AutomationProperties.AutomationId="MeetingNotesCard">
                        <StackPanel Spacing="8">
                            <TextBlock Text="My notes" Style="{StaticResource MuesliRowTitleStyle}" />
                            <TextBlock Text="Your own notes. Kept exactly as written when notes are regenerated."
                                       Style="{StaticResource MuesliBodyStyle}"
                                       Foreground="{ThemeResource MuesliTextTertiaryBrush}"
                                       FontSize="11" />
                            <controls:NotesFormattingBar Editor="{x:Bind ManualNotesEditor}" />
                            <controls:MarkdownNotesEditor x:Name="ManualNotesEditor" Markdown="{x:Bind ViewModel.ManualNotes, Mode=TwoWay}"
                                     FontSize="16" Padding="24,20" TextWrapping="Wrap" AcceptsReturn="True"
                                     MinHeight="180"
                                     PlaceholderText="Add private notes…"
                                     AutomationProperties.Name="Manual meeting notes"
                                     AutomationProperties.AutomationId="MeetingManualNotesEditor" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="TranscriptPanel"
                            Spacing="12"
                            Visibility="{x:Bind BoolToVisibility(ViewModel.ShowTranscriptTab), Mode=OneWay}">
                    <Grid x:Name="TranscriptToolbar" ColumnSpacing="8" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="TRANSCRIPT"
                                   Style="{StaticResource MuesliSectionLabelStyle}"
                                   VerticalAlignment="Center"
                                   AutomationProperties.Name="Transcript heading" />
                        <Button x:Name="SaveTranscriptButton"
                                Grid.Column="1"
                                Style="{StaticResource MeetingToolbarButtonStyle}"
                                Command="{x:Bind ViewModel.SaveTranscriptCommand}"
                                Content="Save Transcript"
                                AutomationProperties.Name="Save Transcript"
                                AutomationProperties.AutomationId="MeetingSaveTranscriptButton" />
                        <Button x:Name="RetranscribeButton"
                                Grid.Column="2"
                                Style="{StaticResource MeetingToolbarButtonStyle}"
                                Command="{x:Bind ViewModel.RetranscribeCommand}"
                                Content="Re-transcribe Audio"
                                AutomationProperties.Name="Re-transcribe Audio"
                                AutomationProperties.AutomationId="MeetingRetranscribeButton" />
                    </Grid>

                    <Border Style="{StaticResource MeetingSectionCardStyle}"
                            AutomationProperties.Name="Meeting transcript"
                            AutomationProperties.AutomationId="MeetingTranscriptCard">
                        <StackPanel Spacing="8">
                            <StackPanel Spacing="6"
                                        Visibility="{x:Bind InvertBoolToVisibility(ViewModel.HasTranscriptText), Mode=OneWay}">
                                <TextBlock Text="This meeting has no transcript yet."
                                           Style="{StaticResource MuesliRowTitleStyle}"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="Re-transcribe Audio uses a retained recording when one exists. The editor stays empty until there is real transcript text."
                                           Style="{StaticResource MuesliBodyStyle}" />
                            </StackPanel>
                            <controls:LiveTranscriptFeed x:Name="SavedTranscriptFeed" MinHeight="120" MaxHeight="560"
                                                         AutomationProperties.AutomationId="MeetingTranscriptReadView" AutomationProperties.Name="Meeting transcript" />
                            <Expander Header="Edit transcript" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                      AutomationProperties.AutomationId="MeetingTranscriptEditExpander">
                                <TextBox x:Name="TranscriptEditor" Text="{x:Bind ViewModel.Transcript, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource MeetingBodyEditorStyle}" MinHeight="120" MaxHeight="560"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Editable meeting transcript"
                                         AutomationProperties.AutomationId="MeetingTranscriptEditor" />
                            </Expander>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource MeetingSectionCardStyle}"
                            BorderBrush="{ThemeResource MuesliAccentBrush}"
                            Visibility="{x:Bind BoolToVisibility(ViewModel.HasCandidate), Mode=OneWay}"
                            AutomationProperties.Name="Re-transcription candidate"
                            AutomationProperties.AutomationId="RetranscriptionCandidateCard">
                        <StackPanel Spacing="10">
                            <TextBlock Text="RE-TRANSCRIPTION CANDIDATE" Style="{StaticResource MuesliSectionLabelStyle}" />
                            <TextBlock Text="Review this candidate before replacing the current transcript. Rejecting it keeps the original."
                                       Style="{StaticResource MuesliBodyStyle}" />
                            <TextBox Text="{x:Bind ViewModel.CandidateTranscript, Mode=OneWay}"
                                     Style="{StaticResource MeetingBodyEditorStyle}"
                                     IsReadOnly="True"
                                     MaxHeight="220"
                                     AutomationProperties.Name="Re-transcription candidate"
                                     AutomationProperties.AutomationId="RetranscriptionCandidateText" />
                            <StackPanel x:Name="CandidateActions" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                <Button Style="{StaticResource MeetingToolbarButtonStyle}"
                                        Command="{x:Bind ViewModel.RejectCandidateCommand}"
                                        Content="Keep Original"
                                        AutomationProperties.Name="Keep Original"
                                        AutomationProperties.AutomationId="RejectRetranscriptionCandidate" />
                                <Button Style="{StaticResource MuesliPrimaryButtonStyle}"
                                        Command="{x:Bind ViewModel.AcceptCandidateCommand}"
                                        Content="Use Candidate"
                                        AutomationProperties.Name="Use Candidate"
                                        AutomationProperties.AutomationId="AcceptRetranscriptionCandidate" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource MeetingSectionCardStyle}"
                            AutomationProperties.Name="Speaker names"
                            AutomationProperties.AutomationId="SpeakerNamesCard">
                        <StackPanel Spacing="12">
                            <TextBlock Text="SPEAKER NAMES" Style="{StaticResource MuesliSectionLabelStyle}" />
                            <Grid x:Name="AliasEditor" ColumnSpacing="8" RowSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBox x:Name="AliasSourceBox"
                                         Text="{x:Bind ViewModel.AliasSource, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         PlaceholderText="Current label, e.g. Speaker 1"
                                         AutomationProperties.Name="Current speaker label"
                                         AutomationProperties.AutomationId="SpeakerAliasSource" />
                                <TextBox x:Name="AliasReplacementBox"
                                         Grid.Column="1"
                                         Text="{x:Bind ViewModel.AliasReplacement, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         PlaceholderText="Person's name"
                                         AutomationProperties.Name="Replacement speaker name"
                                         AutomationProperties.AutomationId="SpeakerAliasReplacement" />
                                <Button x:Name="AddAliasButton"
                                        Grid.Column="2"
                                        Style="{StaticResource MuesliPrimaryButtonStyle}"
                                        Command="{x:Bind ViewModel.AddAliasCommand}"
                                        Content="Add"
                                        VerticalAlignment="Bottom"
                                        AutomationProperties.Name="Add"
                                        AutomationProperties.AutomationId="AddSpeakerAliasButton" />
                            </Grid>
                            <ItemsControl ItemsSource="{x:Bind ViewModel.SpeakerAliases, Mode=OneWay}"
                                          AutomationProperties.AutomationId="SpeakerAliasList"
                                          AutomationProperties.Name="Speaker name list">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="*,Auto,*,Auto" ColumnSpacing="10" Padding="4,6">
                                            <TextBlock Text="{Binding Source}"
                                                       Style="{StaticResource MuesliRowSecondaryStyle}"
                                                       TextWrapping="Wrap"
                                                       VerticalAlignment="Center" />
                                            <FontIcon Grid.Column="1"
                                                      Glyph="&#xE72A;"
                                                      FontSize="12"
                                                      FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                                      Foreground="{ThemeResource MuesliTextTertiaryBrush}"
                                                      VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding Replacement}"
                                                       Style="{StaticResource MuesliRowTitleStyle}"
                                                       TextWrapping="Wrap"
                                                       VerticalAlignment="Center" />
                                            <Button Grid.Column="3"
                                                    Style="{StaticResource MeetingIconButtonStyle}"
                                                    Command="{Binding ViewModel.DeleteAliasCommand, ElementName=RootPage}"
                                                    CommandParameter="{Binding}"
                                                    Foreground="{ThemeResource MuesliErrorBrush}"
                                                    ToolTipService.ToolTip="Remove speaker name"
                                                    AutomationProperties.Name="Remove speaker name">
                                                <FontIcon Glyph="&#xE74D;" FontSize="12" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

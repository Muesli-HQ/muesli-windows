<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Muesli.Windows.WinUI.Pages.MeetingDetailPage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Muesli.Windows.WinUI.ViewModels"
    xmlns:local="using:Muesli.Windows.WinUI.Pages"
    xmlns:services="using:Muesli.Windows.Services"
    xmlns:controls="using:Muesli.Windows.WinUI.Controls"
    UseSystemFocusVisuals="True"
    XYFocusKeyboardNavigation="Enabled">
    <Page.Resources>
        <Style x:Key="MeetingTitleEditorStyle" TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
            <Setter Property="FontFamily" Value="{StaticResource MuesliFontFamilySemiBold}" />
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{ThemeResource MuesliTextPrimaryBrush}" />
            <Setter Property="Background" Value="{ThemeResource ControlFillColorTransparentBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource ControlFillColorTransparentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0,2" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="MaxLength" Value="200" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="AcceptsReturn" Value="False" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
        </Style>
        <Style x:Key="MeetingBodyEditorStyle" TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
        </Style>
        <Style x:Key="MeetingSectionCardStyle" TargetType="Border" BasedOn="{StaticResource MuesliCardStyle}">
            <Setter Property="Padding" Value="22,18" />
        </Style>
        <Style x:Key="MeetingToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource MuesliSecondaryButtonStyle}">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
        </Style>
        <Style x:Key="MeetingIconButtonStyle" TargetType="Button" BasedOn="{StaticResource MuesliGhostButtonStyle}">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="32" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
        </Style>
        <!-- MeetingDetailView.swift header controls: 12pt semibold, 12x7 padding, 6pt corners. -->
        <Style x:Key="MeetingPillButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Background" Value="{ThemeResource MuesliSurfacePrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource MuesliBorderBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="MeetingAccentPillButtonStyle" TargetType="Button" BasedOn="{StaticResource MuesliPrimaryButtonStyle}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- macOS Export and Copy: accent text on an accent tint. -->
        <Style x:Key="MeetingAccentTintButtonStyle" TargetType="Button" BasedOn="{StaticResource MeetingPillButtonStyle}">
            <Setter Property="Foreground" Value="{ThemeResource MuesliAccentBrush}" />
            <Setter Property="Background" Value="{ThemeResource MuesliAccentMutedBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource MuesliAccentMutedBrush}" />
        </Style>
        <Style x:Key="MeetingFolderPillStyle" TargetType="Button" BasedOn="{StaticResource MeetingPillButtonStyle}">
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
        </Style>
        <Style x:Key="MeetingThreadLinkStyle" TargetType="Button" BasedOn="{StaticResource MuesliGhostButtonStyle}">
            <Setter Property="Foreground" Value="{ThemeResource MuesliAccentBrush}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
    </Page.Resources>

    <Grid Background="{ThemeResource MuesliBackgroundBrush}">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ContentStack" Padding="{StaticResource MuesliPageContentPadding}" Spacing="16" HorizontalAlignment="Stretch">

                <!-- P4-04: same leading-edge rule as MeetingTemplatesPage's back link. -->
                <Button x:Name="BackButton"
                        Style="{StaticResource MuesliGhostButtonStyle}"
                        HorizontalAlignment="Left"
                        Padding="8,4"
                        Margin="-8,0,0,0"
                        Click="Back_Click"
                        UseSystemFocusVisuals="True"
                        AutomationProperties.Name="Back to meetings"
                        AutomationProperties.AutomationId="MeetingDetailBackButton">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <FontIcon Glyph="&#xE76B;" FontSize="12" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                        <TextBlock Text="Back to Meetings" />
                    </StackPanel>
                </Button>


                <!--
                    MeetingDetailView.swift compactQuickNotesHeader: the meeting being recorded opens as
                    its notes document. Title and capture status left; a 7pt dot (red recording, amber
                    paused), Pause/Resume, a red Stop, the live window and Discard right.
                -->
                <StackPanel x:Name="RecordingView" Spacing="14" Visibility="Collapsed" AutomationProperties.AutomationId="MeetingRecordingView">
                    <Grid x:Name="RecordingHeader" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="10">
                        <StackPanel Spacing="4" MinWidth="0">
                            <TextBlock Text="{x:Bind Recording.BannerTitle, Mode=OneWay}" FontSize="26" FontWeight="SemiBold" TextWrapping="Wrap"
                                       Foreground="{ThemeResource MuesliTextPrimaryBrush}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ProgressRing Width="14" Height="14" IsActive="{x:Bind Recording.IsBusy, Mode=OneWay}"
                                              Visibility="{x:Bind BoolToVisibility(Recording.IsBusy), Mode=OneWay}" />
                                <TextBlock Text="{x:Bind Recording.BannerStatus, Mode=OneWay}" FontSize="13" Foreground="{ThemeResource MuesliTextSecondaryBrush}" />
                            </StackPanel>
                            <TextBlock Text="{x:Bind Recording.CaptureStatus, Mode=OneWay}" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{ThemeResource MuesliTextTertiaryBrush}" AutomationProperties.AutomationId="MeetingCaptureStatusLabel" />
                        </StackPanel>
                        <StackPanel x:Name="RecordingActions" Grid.Column="1" Orientation="Horizontal" Spacing="5" VerticalAlignment="Top" HorizontalAlignment="Right">
                            <Ellipse Width="7" Height="7" Fill="#EF4444" VerticalAlignment="Center" ToolTipService.ToolTip="Recording"
                                     Visibility="{x:Bind BoolToVisibility(Recording.CanPause), Mode=OneWay}" />
                            <Ellipse Width="7" Height="7" Fill="#F59E0B" VerticalAlignment="Center" ToolTipService.ToolTip="Recording paused"
                                     Visibility="{x:Bind BoolToVisibility(Recording.CanResume), Mode=OneWay}" />
                            <Button Style="{StaticResource MeetingPillButtonStyle}"
                                    Command="{x:Bind Recording.PauseRecordingCommand, Mode=OneWay}"
                                    Visibility="{x:Bind BoolToVisibility(Recording.CanPause), Mode=OneWay}"
                                    ToolTipService.ToolTip="Pause recording"
                                    AutomationProperties.Name="Pause meeting recording"
                                    AutomationProperties.AutomationId="PauseMeetingButton">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE769;" FontSize="10" />
                                    <TextBlock Text="Pause" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource MeetingAccentPillButtonStyle}"
                                    Command="{x:Bind Recording.ResumeRecordingCommand, Mode=OneWay}"
                                    Visibility="{x:Bind BoolToVisibility(Recording.CanResume), Mode=OneWay}"
                                    ToolTipService.ToolTip="Resume recording"
                                    AutomationProperties.Name="Resume meeting recording"
                                    AutomationProperties.AutomationId="ResumeMeetingButton">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE768;" FontSize="10" />
                                    <TextBlock Text="Resume" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource MeetingAccentPillButtonStyle}"
                                    Background="#EF4444"
                                    BorderBrush="#EF4444"
                                    Command="{x:Bind Recording.StopRecordingCommand, Mode=OneWay}"
                                    ToolTipService.ToolTip="Stop recording and save"
                                    AutomationProperties.Name="Stop and save meeting"
                                    AutomationProperties.AutomationId="StopMeetingButton">
                                <Button.Resources>
                                    <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#DC2626" />
                                    <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#B91C1C" />
                                    <SolidColorBrush x:Key="AccentButtonBorderBrushPointerOver" Color="#DC2626" />
                                    <SolidColorBrush x:Key="AccentButtonBorderBrushPressed" Color="#B91C1C" />
                                </Button.Resources>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE71A;" FontSize="10" />
                                    <TextBlock Text="Stop" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource MeetingIconButtonStyle}"
                                    Command="{x:Bind Recording.ShowLiveTranscriptCommand, Mode=OneWay}"
                                    ToolTipService.ToolTip="Show live transcript window"
                                    AutomationProperties.Name="Show live transcript window"
                                    AutomationProperties.AutomationId="ShowLiveTranscriptButton">
                                <FontIcon Glyph="&#xE8A7;" FontSize="12" />
                            </Button>
                            <Button Style="{StaticResource MeetingIconButtonStyle}"
                                    Command="{x:Bind Recording.DiscardRecordingCommand, Mode=OneWay}"
                                    ToolTipService.ToolTip="Discard"
                                    AutomationProperties.Name="Discard meeting recording"
                                    AutomationProperties.AutomationId="DiscardMeetingButton">
                                <FontIcon Glyph="&#xE711;" FontSize="12" />
                            </Button>
                        </StackPanel>
                    </Grid>
                    <InfoBar IsOpen="{x:Bind Recording.IsSourceMissing, Mode=OneWay}" IsClosable="False" Severity="Warning"
                             Title="Meeting signal lost" Message="Recording continues. Stop if the meeting ended."
                             AutomationProperties.AutomationId="MeetingSignalLostNotice">
                        <InfoBar.ActionButton>
                            <Button Content="Keep recording" Command="{x:Bind Recording.KeepRecordingCommand, Mode=OneWay}"
                                    AutomationProperties.AutomationId="KeepMeetingRecordingButton" />
                        </InfoBar.ActionButton>
                    </InfoBar>
                    <Border Background="{ThemeResource MuesliSurfacePrimaryBrush}" BorderBrush="{ThemeResource MuesliBorderBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="8">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                            <controls:NotesFormattingBar Editor="{x:Bind RecordingNotesEditor}" VerticalAlignment="Center"
                                                         Visibility="{x:Bind BoolToVisibility(Recording.ShowRecordingNotes), Mode=OneWay}" />
                            <TextBlock Grid.Column="1" Text="{x:Bind Recording.NotesSaveStatus, Mode=OneWay}" FontSize="12"
                                       Foreground="{ThemeResource MuesliTextTertiaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                       Visibility="{x:Bind BoolToVisibility(Recording.ShowRecordingNotes), Mode=OneWay}"
                                       AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="MeetingNotesSaveStatus" />
                            <Border Grid.Column="2" Style="{StaticResource MuesliSegmentedContainerStyle}">
                                <SelectorBar x:Name="RecordingModeBar" SelectionChanged="RecordingMode_SelectionChanged"
                                             AutomationProperties.AutomationId="MeetingRecordingTabs"
                                             AutomationProperties.Name="Meeting recording content">
                                    <SelectorBarItem x:Name="RecordingNotesTab" Text="Notes" IsSelected="True" AutomationProperties.AutomationId="MeetingRecordingNotesTab" />
                                    <SelectorBarItem x:Name="RecordingLiveTab" Text="Live" AutomationProperties.AutomationId="MeetingRecordingLiveTab" />
                                </SelectorBar>
                            </Border>
                        </Grid>
                    </Border>
                    <StackPanel Spacing="8" Visibility="{x:Bind BoolToVisibility(Recording.ShowRecordingNotes), Mode=OneWay}">
                        <controls:MarkdownNotesEditor x:Name="PreviousNotes" IsReadOnly="True" MaxHeight="200" Padding="16"
                                                      Visibility="Collapsed" BorderThickness="1" AutomationProperties.Name="Previous meeting notes" />
                        <controls:MarkdownNotesEditor x:Name="RecordingNotesEditor" Markdown="{x:Bind Recording.ManualNotes, Mode=TwoWay}"
                                 IsEnabled="{x:Bind Recording.CanEditRecordingNotes, Mode=OneWay}" AcceptsReturn="True" TextWrapping="Wrap"
                                 MinHeight="320" FontSize="16" Padding="24,20" VerticalContentAlignment="Top"
                                 PlaceholderText="Write notes here…"
                                 AutomationProperties.Name="My meeting notes" AutomationProperties.AutomationId="MeetingRecordingNotesEditor" />
                    </StackPanel>
                    <Grid Height="420" Visibility="{x:Bind BoolToVisibility(Recording.ShowLiveTab), Mode=OneWay}">
                        <controls:LiveTranscriptFeed x:Name="LiveFeed" Margin="0,36,0,0"
                                                     AutomationProperties.AutomationId="MeetingLiveCaptionList" AutomationProperties.Name="Live meeting captions" />
                        <Button x:Name="LiveCopyButton" Content="Copy" Click="CopyLive_Click"
                                Style="{StaticResource MeetingAccentTintButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                AutomationProperties.Name="Copy live transcript" AutomationProperties.AutomationId="MeetingLiveCopyButton" />
                    </Grid>
                </StackPanel>

                <StackPanel x:Name="StandardView" Spacing="16">
                <Border x:Name="MissingState"
                        Style="{StaticResource MeetingSectionCardStyle}"
                        Padding="28"
                        MinHeight="180"
                        Visibility="{x:Bind BoolToVisibility(ViewModel.IsMissing), Mode=OneWay}"
                        AutomationProperties.Name="Meeting not found"
                        AutomationProperties.AutomationId="MeetingDetailEmptyState">
                    <StackPanel Spacing="10" VerticalAlignment="Center" MaxWidth="520">
                        <FontIcon Glyph="&#xE8F1;"
                                  FontSize="28"
                                  FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                  Foreground="{ThemeResource MuesliTextTertiaryBrush}"
                                  HorizontalAlignment="Left" />
                        <TextBlock Text="Meeting not found"
                                   Style="{StaticResource MuesliRowTitleStyle}"
                                   FontSize="22"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind ViewModel.Metadata, Mode=OneWay}"
                                   Style="{StaticResource MuesliBodyStyle}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="Go back to Meetings to open another recording from this profile."
                                   Style="{StaticResource MuesliBodyStyle}"
                                   Foreground="{ThemeResource MuesliTextTertiaryBrush}" />
                    </StackPanel>
                </Border>
                <Grid x:Name="MeetingChrome"
                      Visibility="{x:Bind BoolToVisibility(ViewModel.HasMeeting), Mode=OneWay}"
                      ColumnSpacing="16"
                      RowSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel x:Name="TitleBlock" MinWidth="0" Spacing="6">
                        <TextBox x:Name="TitleEditor"
                                 Text="{x:Bind ViewModel.Title, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                 Style="{StaticResource MeetingTitleEditorStyle}"
                                 PlaceholderText="Untitled meeting"
                                 KeyDown="TitleEditor_KeyDown"
                                 ToolTipService.ToolTip="Click to rename this meeting"
                                 AutomationProperties.Name="Meeting title"
                                 AutomationProperties.AutomationId="MeetingTitleEditor" />
                        <!-- macOS meetingIdentity metadata: 10pt icons, callout text, tertiary "·" dividers. -->
                        <StackPanel Orientation="Horizontal" Spacing="8" AutomationProperties.Name="Meeting metadata">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <FontIcon Glyph="&#xE787;" FontSize="10" Foreground="{ThemeResource MuesliTextSecondaryBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{x:Bind ViewModel.MetadataDate, Mode=OneWay}" FontSize="13" Foreground="{ThemeResource MuesliTextSecondaryBrush}" />
                            </StackPanel>
                            <TextBlock Text="·" FontSize="13" Foreground="{ThemeResource MuesliTextTertiaryBrush}" />
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <FontIcon Glyph="&#xE823;" FontSize="10" Foreground="{ThemeResource MuesliTextSecondaryBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{x:Bind ViewModel.MetadataDuration, Mode=OneWay}" FontSize="13" Foreground="{ThemeResource MuesliTextSecondaryBrush}" />
                            </StackPanel>
                            <TextBlock Text="·" FontSize="13" Foreground="{ThemeResource MuesliTextTertiaryBrush}" />
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <FontIcon Glyph="&#xE8A5;" FontSize="10" Foreground="{ThemeResource MuesliTextSecondaryBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{x:Bind ViewModel.MetadataWords, Mode=OneWay}" FontSize="13" Foreground="{ThemeResource MuesliTextSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                        <!-- macOS threadBreadcrumb. -->
                        <StackPanel Spacing="4" Visibility="{x:Bind BoolToVisibility(ViewModel.HasThread), Mode=OneWay}"
                                    AutomationProperties.AutomationId="MeetingThreadBreadcrumb">
                            <Button Style="{StaticResource MeetingThreadLinkStyle}"
                                    Tag="{x:Bind ViewModel.ThreadPredecessor.Id, Mode=OneWay, FallbackValue=''}"
                                    Click="RelatedMeeting_Click"
                                    Visibility="{x:Bind BoolToVisibility(ViewModel.HasThreadPredecessor), Mode=OneWay}"
                                    ToolTipService.ToolTip="Open this meeting">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <FontIcon Glyph="&#xE7A7;" FontSize="9" />
                                    <TextBlock Text="{x:Bind ViewModel.ThreadPredecessor.Text, Mode=OneWay, FallbackValue=''}" FontSize="11" FontWeight="Medium" MaxLines="1" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Button>
                            <TextBlock Text="{x:Bind ViewModel.ThreadCountLabel, Mode=OneWay}" FontSize="11" FontWeight="Medium" Foreground="{ThemeResource MuesliTextTertiaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.FollowUpsHeading, Mode=OneWay}" FontSize="11" FontWeight="Medium" Foreground="{ThemeResource MuesliTextTertiaryBrush}"
                                       Visibility="{x:Bind BoolToVisibility(ViewModel.HasManySuccessors), Mode=OneWay}" />
                            <ItemsControl ItemsSource="{x:Bind ViewModel.ThreadSuccessors, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:MeetingThreadLink">
                                        <Button Style="{StaticResource MeetingThreadLinkStyle}" Tag="{x:Bind Id}" Click="RelatedMeeting_Click"
                                                ToolTipService.ToolTip="Open this meeting" AutomationProperties.Name="{x:Bind Text}">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <FontIcon Glyph="&#xE7A6;" FontSize="9" />
                                                <TextBlock Text="{x:Bind Text}" FontSize="11" FontWeight="Medium" MaxLines="1" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel x:Name="ChromeActions"
                                Grid.Column="1"
                                VerticalAlignment="Top"
                                HorizontalAlignment="Right">
                        <StackPanel x:Name="HeaderCommands" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                            <ProgressRing Width="16" Height="16" IsActive="{x:Bind ViewModel.IsWorking, Mode=OneWay}"
                                          Visibility="{x:Bind BoolToVisibility(ViewModel.IsWorking), Mode=OneWay}"
                                          AutomationProperties.Name="Working" />
                            <!-- macOS resume split button: Resume, with Start a follow-up behind the chevron. -->
                            <SplitButton x:Name="ResumeButton"
                                         Command="{x:Bind ViewModel.ResumeFinishedCommand}"
                                         Visibility="{x:Bind BoolToVisibility(ViewModel.CanContinueMeeting), Mode=OneWay}"
                                         Background="{ThemeResource MuesliAccentBrush}"
                                         Foreground="White"
                                         FontSize="12"
                                         CornerRadius="6"
                                         Padding="12,6"
                                         ToolTipService.ToolTip="Resume recording into this meeting"
                                         AutomationProperties.Name="Resume recording"
                                         AutomationProperties.AutomationId="MeetingResumeFinishedButton">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE768;" FontSize="10" />
                                    <TextBlock Text="Resume" FontWeight="SemiBold" />
                                </StackPanel>
                                <SplitButton.Flyout>
                                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                                        <MenuFlyoutItem Text="Resume recording" Command="{x:Bind ViewModel.ResumeFinishedCommand}" />
                                        <MenuFlyoutItem Text="Start a follow-up" Command="{x:Bind ViewModel.StartFollowUpCommand}"
                                                        AutomationProperties.AutomationId="MeetingStartFollowUpButton" />
                                    </MenuFlyout>
                                </SplitButton.Flyout>
                            </SplitButton>
                            <Button x:Name="ExportButton"
                                    Style="{StaticResource MeetingAccentTintButtonStyle}"
                                    AutomationProperties.Name="Export"
                                    AutomationProperties.AutomationId="MeetingExportButton">
                                <Button.Flyout>
                                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                                        <MenuFlyoutItem Text="{x:Bind ViewModel.ExportCurrentLabel, Mode=OneWay}" Command="{x:Bind ViewModel.ExportCurrentCommand}"
                                                        AutomationProperties.AutomationId="MeetingExportCurrentButton">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8A5;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="Export Full Meeting" Command="{x:Bind ViewModel.ExportFullCommand}"
                                                        AutomationProperties.AutomationId="MeetingExportFullButton">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </Button.Flyout>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE72D;" FontSize="11" />
                                    <TextBlock Text="Export" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                            <!-- macOS moreActionsMenu: template, re-summarize, re-transcribe, edit, then the recording and delete. -->
                            <Button x:Name="MoreActionsButton"
                                    Style="{StaticResource MeetingPillButtonStyle}"
                                    Width="34"
                                    Padding="0,6"
                                    AutomationProperties.Name="More actions"
                                    AutomationProperties.AutomationId="MeetingMoreActionsButton"
                                    ToolTipService.ToolTip="More actions">
                                <Button.Flyout>
                                    <MenuFlyout x:Name="MoreActionsMenu" Placement="BottomEdgeAlignedRight" Opening="MoreActionsMenu_Opening">
                                        <MenuFlyoutSubItem x:Name="TemplateMenu" Text="Template">
                                            <MenuFlyoutSubItem.Icon><FontIcon Glyph="&#xE8A5;" /></MenuFlyoutSubItem.Icon>
                                        </MenuFlyoutSubItem>
                                        <MenuFlyoutItem Text="{x:Bind ViewModel.SummaryActionLabel, Mode=OneWay}" Command="{x:Bind ViewModel.GenerateSummaryCommand}"
                                                        AutomationProperties.AutomationId="GenerateMeetingSummaryButton">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE72C;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="Re-transcribe" Command="{x:Bind ViewModel.RetranscribeCommand}"
                                                        AutomationProperties.AutomationId="MeetingRetranscribeButton">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE9D9;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="{x:Bind ViewModel.EditLabel, Mode=OneWay}" Command="{x:Bind ViewModel.ToggleEditingCommand}"
                                                        AutomationProperties.AutomationId="MeetingEditButton">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE70F;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem Text="Show Recording" Command="{x:Bind ViewModel.ShowRecordingCommand}"
                                                        Visibility="{x:Bind BoolToVisibility(ViewModel.HasRecordingFile), Mode=OneWay}"
                                                        AutomationProperties.AutomationId="MeetingShowRecordingButton">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8B7;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem x:Name="DeleteMenuItem"
                                                        Text="Delete Meeting"
                                                        Command="{x:Bind ViewModel.DeleteMeetingCommand}"
                                                        Foreground="{ThemeResource MuesliErrorBrush}"
                                                        AutomationProperties.Name="Delete meeting"
                                                        AutomationProperties.AutomationId="MeetingDeleteButton">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE74D;" Foreground="{ThemeResource MuesliErrorBrush}" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </Button.Flyout>
                                <FontIcon Glyph="&#xE712;" FontSize="12" Foreground="{ThemeResource MuesliTextSecondaryBrush}" />
                            </Button>
                        </StackPanel>
                    </StackPanel>
                    <!-- macOS responsiveContextControls: folder pill left, Notes/Transcript right. -->
                    <Border x:Name="ContextStrip"
                            Grid.Row="2"
                            Grid.ColumnSpan="2"
                            Background="{ThemeResource MuesliSurfacePrimaryBrush}"
                            BorderBrush="{ThemeResource MuesliBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="8">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                            <Button x:Name="FolderPill"
                                    Style="{StaticResource MeetingFolderPillStyle}"
                                    Click="FolderPill_Click"
                                    VerticalAlignment="Center"
                                    ToolTipService.ToolTip="Move to folder"
                                    AutomationProperties.Name="{x:Bind ViewModel.FolderLabel, Mode=OneWay}"
                                    AutomationProperties.AutomationId="MeetingFolderPicker">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <FontIcon x:Name="FolderPillIcon" Glyph="&#xE8F4;" FontSize="10" />
                                    <TextBlock Text="{x:Bind ViewModel.FolderLabel, Mode=OneWay}" FontSize="12" FontWeight="Medium" MaxLines="1" TextTrimming="CharacterEllipsis" MaxWidth="240" />
                                    <FontIcon Glyph="&#xE70D;" FontSize="8" />
                                </StackPanel>
                            </Button>
                            <!-- macOS MeetingParticipantsView: "Add people", or the first name and +N. -->
                            <Border Width="1" Height="20" Background="{ThemeResource MuesliBorderBrush}" VerticalAlignment="Center" />
                            <Button x:Name="PeopleButton"
                                    Style="{StaticResource MeetingPillButtonStyle}"
                                    Padding="10,0" Height="28" MaxWidth="220" CornerRadius="6"
                                    Foreground="{ThemeResource MuesliTextSecondaryBrush}"
                                    AutomationProperties.AutomationId="MeetingPeopleButton">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE716;" FontSize="12" />
                                    <TextBlock x:Name="PeopleLabel" Text="Add people" FontSize="12" MaxLines="1" TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="PeopleMore" FontSize="12" Foreground="{ThemeResource MuesliTextTertiaryBrush}" Visibility="Collapsed" />
                                </StackPanel>
                                <Button.Flyout>
                                    <Flyout x:Name="PeopleFlyout" Placement="BottomEdgeAlignedLeft" Closed="PeopleFlyout_Closed">
                                        <StackPanel Width="316" Spacing="12">
                                            <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8">
                                                <TextBlock Text="People" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                <TextBlock x:Name="PeopleCount" Grid.Column="1" FontSize="12" VerticalAlignment="Center"
                                                           Foreground="{ThemeResource MuesliTextTertiaryBrush}" />
                                                <Button x:Name="AddPersonButton" Grid.Column="3"
                                                        Style="{StaticResource MeetingPillButtonStyle}"
                                                        Padding="9,0" Height="28" CornerRadius="6"
                                                        Foreground="{ThemeResource MuesliTextSecondaryBrush}"
                                                        Click="AddPerson_Click"
                                                        AutomationProperties.AutomationId="MeetingAddPersonButton">
                                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                                        <FontIcon Glyph="&#xE8FA;" FontSize="12" />
                                                        <TextBlock Text="Add person" FontSize="12" />
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                            <Border Height="1" Background="{ThemeResource MuesliBorderBrush}" />
                                            <StackPanel x:Name="AddPersonForm" Spacing="8" Visibility="Collapsed">
                                                <TextBox x:Name="PersonNameBox" PlaceholderText="Name" KeyDown="PersonBox_KeyDown"
                                                         AutomationProperties.Name="Person name" AutomationProperties.AutomationId="MeetingPersonNameBox" />
                                                <TextBox x:Name="PersonEmailBox" PlaceholderText="Email (optional)" InputScope="EmailSmtpAddress" KeyDown="PersonBox_KeyDown"
                                                         AutomationProperties.Name="Person email" AutomationProperties.AutomationId="MeetingPersonEmailBox" />
                                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                                    <Button Content="Cancel" Style="{StaticResource MuesliSecondaryButtonStyle}" Click="CancelPerson_Click" />
                                                    <Button Content="Add" Style="{StaticResource MuesliPrimaryButtonStyle}" Click="SavePerson_Click"
                                                            AutomationProperties.AutomationId="MeetingSavePersonButton" />
                                                </StackPanel>
                                            </StackPanel>
                                            <TextBlock x:Name="PeopleEmpty" Text="No one has been added yet." FontSize="13" Margin="0,8"
                                                       Foreground="{ThemeResource MuesliTextSecondaryBrush}" />
                                            <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
                                                <ItemsControl x:Name="PeopleList">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate><StackPanel Spacing="8" /></ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="services:MeetingParticipant">
                                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                                                <FontIcon Glyph="&#xE77B;" FontSize="18" VerticalAlignment="Center"
                                                                          Foreground="{ThemeResource MuesliTextTertiaryBrush}" />
                                                                <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                                                    <TextBlock Text="{x:Bind DisplayName}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Text="{x:Bind Email}" FontSize="12" TextTrimming="CharacterEllipsis"
                                                                               Foreground="{ThemeResource MuesliTextTertiaryBrush}"
                                                                               Visibility="{x:Bind local:MeetingDetailPage.EmailVisibility(Email, DisplayName)}" />
                                                                </StackPanel>
                                                                <Button Grid.Column="2" Width="24" Height="24" Padding="0" MinWidth="0" MinHeight="0"
                                                                        Style="{StaticResource MuesliGhostButtonStyle}"
                                                                        Tag="{x:Bind Id}" Click="RemovePerson_Click"
                                                                        ToolTipService.ToolTip="{x:Bind local:MeetingDetailPage.RemoveLabel(DisplayName)}"
                                                                        AutomationProperties.Name="{x:Bind local:MeetingDetailPage.RemoveLabel(DisplayName)}">
                                                                    <FontIcon Glyph="&#xE711;" FontSize="9" />
                                                                </Button>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                            </StackPanel>
                            <Border x:Name="DetailTabWell" Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource MuesliSegmentedContainerStyle}">
                                <SelectorBar x:Name="DetailTabBar"
                                             SelectionChanged="DetailTabBar_SelectionChanged"
                                             AutomationProperties.Name="Meeting notes or transcript">
                                    <SelectorBarItem x:Name="NotesTabItem"
                                                     Text="Notes"
                                                     IsSelected="True"
                                                     AutomationProperties.Name="Notes tab"
                                                     AutomationProperties.AutomationId="MeetingNotesTab" />
                                    <SelectorBarItem x:Name="TranscriptTabItem"
                                                     Text="Transcript"
                                                     AutomationProperties.Name="Transcript tab"
                                                     AutomationProperties.AutomationId="MeetingTranscriptTab" />
                                </SelectorBar>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <StackPanel x:Name="WorkingBanner"
                            Spacing="6"
                            Visibility="{x:Bind BoolToVisibility(ViewModel.IsWorking), Mode=OneWay}"
                            AutomationProperties.Name="Meeting operation in progress">
                    <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                               FontSize="12"
                               Foreground="{ThemeResource MuesliTextSecondaryBrush}"
                               TextWrapping="Wrap"
                               AutomationProperties.LiveSetting="Polite" />
                    <ProgressBar IsIndeterminate="{x:Bind IsIndeterminate(ViewModel.IsWorking, ViewModel.WorkProgress), Mode=OneWay}"
                                 Value="{x:Bind ViewModel.WorkProgress, Mode=OneWay}"
                                 Maximum="100"
                                 AutomationProperties.Name="Meeting operation progress" />
                </StackPanel>

                <InfoBar x:Name="StatusBar"
                         IsOpen="{x:Bind ViewModel.IsStatusOpen, Mode=TwoWay}"
                         Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                         Severity="Warning"
                         AutomationProperties.AutomationId="MeetingDetailStatus"
                         AutomationProperties.LiveSetting="Polite" />

                <!--
                    MeetingRecordingPlayerView.swift: one raised row with a round play/pause button,
                    the waveform as the seek bar, and a monospaced time readout. Windows adds its
                    You/Others track picker when a meeting kept both tracks.
                -->
                <Border Background="{ThemeResource MuesliBackgroundRaisedBrush}"
                        BorderBrush="{ThemeResource MuesliBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="12,8"
                        Visibility="{x:Bind BoolToVisibility(ViewModel.HasRecording), Mode=OneWay}"
                        AutomationProperties.Name="Meeting recording"
                        AutomationProperties.AutomationId="MeetingRecordingCard">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
                        <Button Width="34" Height="34" MinWidth="34" MinHeight="34" Padding="0"
                                CornerRadius="17"
                                Background="{ThemeResource MuesliSurfacePrimaryBrush}"
                                BorderBrush="{ThemeResource MuesliBorderBrush}"
                                BorderThickness="1"
                                VerticalAlignment="Center"
                                Command="{x:Bind ViewModel.TogglePlaybackCommand}"
                                ToolTipService.ToolTip="{x:Bind ViewModel.PlayPauseLabel, Mode=OneWay}"
                                AutomationProperties.Name="{x:Bind ViewModel.PlayPauseLabel, Mode=OneWay}"
                                AutomationProperties.AutomationId="MeetingPlaybackToggle">
                            <FontIcon Glyph="{x:Bind ViewModel.PlayPauseGlyph, Mode=OneWay}" FontSize="13"
                                      Foreground="{ThemeResource MuesliTextPrimaryBrush}" />
                        </Button>
                        <controls:RecordingWaveform Grid.Column="1"
                                                    Height="44"
                                                    Peaks="{x:Bind ViewModel.WaveformPeaks, Mode=OneWay}"
                                                    Progress="{x:Bind ViewModel.PlaybackProgress, Mode=OneWay}"
                                                    Seeked="Waveform_Seeked"
                                                    AutomationProperties.AutomationId="MeetingPlaybackSeek" />
                        <TextBlock Grid.Column="2"
                                   Text="{x:Bind ViewModel.PlaybackTimeLabel, Mode=OneWay}"
                                   FontFamily="Consolas"
                                   FontSize="12"
                                   FontWeight="Medium"
                                   Foreground="{ThemeResource MuesliTextSecondaryBrush}"
                                   MinWidth="88"
                                   TextAlignment="Right"
                                   VerticalAlignment="Center" />
                        <ComboBox x:Name="TrackPicker"
                                  Grid.Column="3"
                                  ItemsSource="{x:Bind ViewModel.PlaybackTracks, Mode=OneWay}"
                                  SelectedItem="{x:Bind ViewModel.SelectedPlaybackTrack, Mode=TwoWay}"
                                  Visibility="{x:Bind BoolToVisibility(ViewModel.HasTrackChoice), Mode=OneWay}"
                                  VerticalAlignment="Center"
                                  AutomationProperties.Name="Recording track"
                                  AutomationProperties.AutomationId="MeetingRecordingTrack">
                            <!-- DisplayMemberPath reflects over a plain C# record, which WinUI 3 cannot bind. -->
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="services:MeetingPlaybackTrack">
                                    <TextBlock Text="{x:Bind Label}" AutomationProperties.Name="{x:Bind Label}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>
                </Border>

                <!-- macOS audio warning banner: orange 12% fill, 35% outline, a filled triangle. -->
                <Border Background="#1FFF9F43"
                        BorderBrush="#59FF9F43"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12"
                        Visibility="{x:Bind BoolToVisibility(ViewModel.HasHealthWarnings), Mode=OneWay}"
                        AutomationProperties.Name="Recording warnings">
                    <ItemsControl ItemsSource="{x:Bind ViewModel.HealthWarnings, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="0,0,0,2">
                                    <FontIcon Glyph="&#xE7BA;" FontSize="13" Foreground="#FF9F43" VerticalAlignment="Top" Margin="0,2,0,0" />
                                    <TextBlock Grid.Column="1" Text="{Binding}" FontSize="13"
                                               Foreground="{ThemeResource MuesliTextPrimaryBrush}" TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <Border Style="{StaticResource MeetingSectionCardStyle}"
                        Padding="12,10"
                        Visibility="{x:Bind BoolToVisibility(ViewModel.HasAutomationResult), Mode=OneWay}"
                        AutomationProperties.Name="After-meeting automation">
                    <StackPanel Spacing="6">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="After-meeting automation"
                                       Style="{StaticResource MuesliRowTitleStyle}"
                                       FontSize="12"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Text="{x:Bind ViewModel.AutomationStatusLabel, Mode=OneWay}"
                                       Style="{StaticResource MuesliBodyStyle}"
                                       VerticalAlignment="Center"
                                       AutomationProperties.Name="After-meeting automation status"
                                       AutomationProperties.AutomationId="AutomationStatusLabel" />
                        </Grid>
                        <TextBlock Text="{x:Bind ViewModel.AutomationDiagnostics, Mode=OneWay}"
                                   Style="{StaticResource MuesliBodyStyle}"
                                   TextWrapping="Wrap"
                                   AutomationProperties.Name="After-meeting automation details"
                                   AutomationProperties.AutomationId="AutomationDiagnosticsText" />
                        <Expander Header="Retained hook output (redacted)"
                                  HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Stretch"
                                  Visibility="{x:Bind BoolToVisibility(ViewModel.HasAutomationRawOutput), Mode=OneWay}"
                                  AutomationProperties.Name="Show retained hook output"
                                  AutomationProperties.AutomationId="AutomationRawOutputExpander">
                            <Border Background="{ThemeResource MuesliBackgroundDeepBrush}"
                                    BorderBrush="{ThemeResource MuesliBorderSoftBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="10,8"
                                    MaxHeight="200">
                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <TextBlock Text="{x:Bind ViewModel.AutomationRawOutput, Mode=OneWay}"
                                               FontFamily="Consolas, Cascadia Mono, monospace"
                                               FontSize="12"
                                               LineHeight="18"
                                               TextWrapping="Wrap"
                                               IsTextSelectionEnabled="True"
                                               AutomationProperties.AutomationId="AutomationRawOutputText" />
                                </ScrollViewer>
                            </Border>
                        </Expander>
                    </StackPanel>
                </Border>

                <!-- The document row: the raw-transcript call to action left, Copy (current tab, with the metadata header) right. -->
                <Grid x:Name="DocumentToolbar" ColumnDefinitions="*,Auto" ColumnSpacing="12"
                      Visibility="{x:Bind BoolToVisibility(ViewModel.HasMeeting), Mode=OneWay}">
                    <Border Background="{ThemeResource MuesliAccentMutedBrush}" CornerRadius="6" Padding="12"
                            Visibility="{x:Bind CtaVisibility(ViewModel.ShowTranscriptCta, ViewModel.ShowNotesTab), Mode=OneWay}"
                            AutomationProperties.AutomationId="MeetingTranscriptCta">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <FontIcon Glyph="&#xE945;" FontSize="13" Foreground="{ThemeResource MuesliAccentBrush}" VerticalAlignment="Top" Margin="0,2,0,0" />
                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.TranscriptCta, Mode=OneWay}" FontSize="13"
                                       Foreground="{ThemeResource MuesliTextSecondaryBrush}" TextWrapping="Wrap" />
                        </Grid>
                    </Border>
                    <Button Grid.Column="1"
                            Style="{StaticResource MeetingAccentTintButtonStyle}"
                            VerticalAlignment="Top"
                            Command="{x:Bind ViewModel.CopyCurrentCommand}"
                            ToolTipService.ToolTip="Copy with the meeting details"
                            AutomationProperties.Name="Copy"
                            AutomationProperties.AutomationId="MeetingCopyButton">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8C8;" FontSize="11" />
                            <TextBlock Text="Copy" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                </Grid>

                <StackPanel x:Name="NotesPanel"
                            Spacing="16"
                            Visibility="{x:Bind BoolToVisibility(ViewModel.ShowNotesContent), Mode=OneWay}">
                    <controls:MarkdownNotesEditor Markdown="{x:Bind ViewModel.NotesMarkdown, Mode=OneWay}"
                               TextWrapping="Wrap" IsReadOnly="True" BorderThickness="0" Padding="0"
                               Background="Transparent" FontSize="15"
                               Visibility="{x:Bind BoolToVisibility(ViewModel.ShowNotesDocument), Mode=OneWay}"
                               AutomationProperties.Name="Meeting notes"
                               AutomationProperties.AutomationId="MeetingSummaryText" />
                    <StackPanel Spacing="8" Visibility="{x:Bind BoolToVisibility(ViewModel.ShowSummaryEditor), Mode=OneWay}">
                        <controls:NotesFormattingBar Editor="{x:Bind SummaryEditor}" />
                        <controls:MarkdownNotesEditor x:Name="SummaryEditor" Markdown="{x:Bind ViewModel.Summary, Mode=TwoWay}"
                                 FontSize="15" Padding="24,20" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="240"
                                 AutomationProperties.Name="Edit meeting notes"
                                 AutomationProperties.AutomationId="MeetingSummaryEditor" />
                    </StackPanel>
                    <StackPanel Spacing="8"
                                Visibility="{x:Bind BoolToVisibility(ViewModel.ShowManualNotes), Mode=OneWay}"
                                AutomationProperties.Name="Private meeting notes"
                                AutomationProperties.AutomationId="MeetingNotesCard">
                        <TextBlock Text="My notes" Style="{StaticResource MuesliRowTitleStyle}" />
                        <controls:NotesFormattingBar Editor="{x:Bind ManualNotesEditor}"
                                                     Visibility="{x:Bind BoolToVisibility(ViewModel.IsEditing), Mode=OneWay}" />
                        <controls:MarkdownNotesEditor x:Name="ManualNotesEditor" Markdown="{x:Bind ViewModel.ManualNotes, Mode=TwoWay}"
                                 FontSize="15" Padding="24,20" TextWrapping="Wrap" AcceptsReturn="True"
                                 IsReadOnly="{x:Bind Not(ViewModel.IsEditing), Mode=OneWay}"
                                 PlaceholderText="Add private notes…"
                                 AutomationProperties.Name="Manual meeting notes"
                                 AutomationProperties.AutomationId="MeetingManualNotesEditor" />
                    </StackPanel>
                </StackPanel>

                <StackPanel x:Name="TranscriptPanel"
                            Spacing="12"
                            Visibility="{x:Bind BoolToVisibility(ViewModel.ShowTranscriptTab), Mode=OneWay}">
                    <StackPanel Spacing="6"
                                Visibility="{x:Bind InvertBoolToVisibility(ViewModel.HasTranscriptText), Mode=OneWay}">
                        <TextBlock Text="This meeting has no transcript yet."
                                   Style="{StaticResource MuesliRowTitleStyle}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="Re-transcribe in the … menu uses the saved recording when there is one."
                                   Style="{StaticResource MuesliBodyStyle}" />
                    </StackPanel>
                    <!-- MeetingTranscriptView: You on the right in accent bubbles, others on the left. -->
                    <controls:LiveTranscriptFeed x:Name="SavedTranscriptFeed" MinHeight="120" MaxHeight="720"
                                                 Visibility="{x:Bind BoolToVisibility(ViewModel.ShowTranscriptFeed), Mode=OneWay}"
                                                 AutomationProperties.AutomationId="MeetingTranscriptReadView" AutomationProperties.Name="Meeting transcript" />
                    <TextBox x:Name="TranscriptEditor" Text="{x:Bind ViewModel.Transcript, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource MeetingBodyEditorStyle}" MinHeight="240" MaxHeight="720"
                             Visibility="{x:Bind BoolToVisibility(ViewModel.IsEditingTranscript), Mode=OneWay}"
                             ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Editable meeting transcript"
                             AutomationProperties.AutomationId="MeetingTranscriptEditor" />

                    <Border Style="{StaticResource MeetingSectionCardStyle}"
                            BorderBrush="{ThemeResource MuesliAccentBrush}"
                            Visibility="{x:Bind BoolToVisibility(ViewModel.HasCandidate), Mode=OneWay}"
                            AutomationProperties.Name="Re-transcription candidate"
                            AutomationProperties.AutomationId="RetranscriptionCandidateCard">
                        <StackPanel Spacing="10">
                            <TextBlock Text="RE-TRANSCRIPTION CANDIDATE" Style="{StaticResource MuesliSectionLabelStyle}" />
                            <TextBlock Text="Review this candidate before replacing the current transcript. Rejecting it keeps the original."
                                       Style="{StaticResource MuesliBodyStyle}" />
                            <TextBox Text="{x:Bind ViewModel.CandidateTranscript, Mode=OneWay}"
                                     Style="{StaticResource MeetingBodyEditorStyle}"
                                     IsReadOnly="True"
                                     MaxHeight="220"
                                     AutomationProperties.Name="Re-transcription candidate"
                                     AutomationProperties.AutomationId="RetranscriptionCandidateText" />
                            <StackPanel x:Name="CandidateActions" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                <Button Style="{StaticResource MeetingToolbarButtonStyle}"
                                        Command="{x:Bind ViewModel.RejectCandidateCommand}"
                                        Content="Keep Original"
                                        AutomationProperties.Name="Keep Original"
                                        AutomationProperties.AutomationId="RejectRetranscriptionCandidate" />
                                <Button Style="{StaticResource MuesliPrimaryButtonStyle}"
                                        Command="{x:Bind ViewModel.AcceptCandidateCommand}"
                                        Content="Use Candidate"
                                        AutomationProperties.Name="Use Candidate"
                                        AutomationProperties.AutomationId="AcceptRetranscriptionCandidate" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource MeetingSectionCardStyle}"
                            AutomationProperties.Name="Speaker names"
                            AutomationProperties.AutomationId="SpeakerNamesCard">
                        <StackPanel Spacing="12">
                            <TextBlock Text="SPEAKER NAMES" Style="{StaticResource MuesliSectionLabelStyle}" />
                            <Grid x:Name="AliasEditor" ColumnSpacing="8" RowSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBox x:Name="AliasSourceBox"
                                         Text="{x:Bind ViewModel.AliasSource, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         PlaceholderText="Current label, e.g. Speaker 1"
                                         AutomationProperties.Name="Current speaker label"
                                         AutomationProperties.AutomationId="SpeakerAliasSource" />
                                <TextBox x:Name="AliasReplacementBox"
                                         Grid.Column="1"
                                         Text="{x:Bind ViewModel.AliasReplacement, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         PlaceholderText="Person's name"
                                         AutomationProperties.Name="Replacement speaker name"
                                         AutomationProperties.AutomationId="SpeakerAliasReplacement" />
                                <Button x:Name="AddAliasButton"
                                        Grid.Column="2"
                                        Style="{StaticResource MuesliPrimaryButtonStyle}"
                                        Command="{x:Bind ViewModel.AddAliasCommand}"
                                        Content="Add"
                                        VerticalAlignment="Bottom"
                                        AutomationProperties.Name="Add"
                                        AutomationProperties.AutomationId="AddSpeakerAliasButton" />
                            </Grid>
                            <ItemsControl ItemsSource="{x:Bind ViewModel.SpeakerAliases, Mode=OneWay}"
                                          AutomationProperties.AutomationId="SpeakerAliasList"
                                          AutomationProperties.Name="Speaker name list">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="*,Auto,*,Auto" ColumnSpacing="10" Padding="4,6">
                                            <TextBlock Text="{Binding Source}"
                                                       Style="{StaticResource MuesliRowSecondaryStyle}"
                                                       TextWrapping="Wrap"
                                                       VerticalAlignment="Center" />
                                            <FontIcon Grid.Column="1"
                                                      Glyph="&#xE72A;"
                                                      FontSize="12"
                                                      FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                                      Foreground="{ThemeResource MuesliTextTertiaryBrush}"
                                                      VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding Replacement}"
                                                       Style="{StaticResource MuesliRowTitleStyle}"
                                                       TextWrapping="Wrap"
                                                       VerticalAlignment="Center" />
                                            <Button Grid.Column="3"
                                                    Style="{StaticResource MeetingIconButtonStyle}"
                                                    Command="{Binding ViewModel.DeleteAliasCommand, ElementName=RootPage}"
                                                    CommandParameter="{Binding}"
                                                    Foreground="{ThemeResource MuesliErrorBrush}"
                                                    ToolTipService.ToolTip="Remove speaker name"
                                                    AutomationProperties.Name="Remove speaker name">
                                                <FontIcon Glyph="&#xE74D;" FontSize="12" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

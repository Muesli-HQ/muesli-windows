<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Muesli.Windows.WinUI.Pages.DictationsPage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Muesli.Windows.WinUI.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:svc="using:Muesli.Windows.WinUI.Services"
    xmlns:vm="using:Muesli.Windows.WinUI.ViewModels"
    mc:Ignorable="d">
    <Page.Resources>
        <Style x:Key="DictationRowContainerStyle" TargetType="ListViewItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
        </Style>
        <!--
            P2-08: row actions are quiet. Both buttons are transparent until the row is hovered,
            selected or holding keyboard focus (wired in DictationRow_ContainerContentChanging), so
            the red delete glyph is no longer painted on every row at rest — it is drawn only on the
            one row the user is actually pointing at, where the destructive colour is the correct
            signal rather than the loudest thing in the list.
        -->
        <Style x:Key="DictationRowActionStyle" TargetType="Button" BasedOn="{StaticResource MuesliGhostButtonStyle}">
            <Setter Property="Padding" Value="7,5" />
            <Setter Property="Foreground" Value="{ThemeResource MuesliTextTertiaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
        </Style>
    </Page.Resources>

    <Grid Background="{ThemeResource MuesliBackgroundBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" ViewChanged="PageScroller_ViewChanged">
            <StackPanel x:Name="ContentStack" Padding="{StaticResource MuesliPageContentPadding}" Spacing="20">
                <TextBlock Text="Dictations" Style="{StaticResource MuesliPageTitleStyle}" VerticalAlignment="Center" />

                <!--
                    Visibility is bound as well as IsOpen: a closed InfoBar collapses its own
                    template root but stays Visible itself, so the parent StackPanel keeps
                    allocating a 20-DIP gap for each one. Two of them put 40 DIP of dead space
                    above the list on a page that shows no status at all most of the time.
                -->
                <InfoBar IsOpen="{x:Bind ViewModel.HasActiveRuntimeStatus, Mode=OneWay}"
                         Visibility="{x:Bind local:DictationsPage.BoolToVisibility(ViewModel.HasActiveRuntimeStatus), Mode=OneWay}"
                         IsClosable="False"
                         Severity="Informational"
                         Title="Dictation"
                         Message="{x:Bind ViewModel.DictationStatus, Mode=OneWay}"
                         AutomationProperties.AutomationId="DictationRuntimeStatus" />

                <!-- macOS StatsHeaderView without the meeting card: each card opens Insights. -->
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="16">
                    <Button Grid.Column="0" Style="{StaticResource MuesliStatButtonStyle}" Click="StatCard_Click" Tag="streak"
                            ToolTipService.ToolTip="Open streak insights" AutomationProperties.Name="Current dictation streak">
                        <StackPanel Spacing="8">
                            <PathIcon Width="20" Height="20" HorizontalAlignment="Center"
                                      Data="M13.5.67s.74 2.65.74 4.8c0 2.06-1.35 3.73-3.41 3.73-2.07 0-3.63-1.67-3.63-3.73l.03-.36C5.21 7.51 4 10.62 4 14c0 4.42 3.58 8 8 8s8-3.58 8-8C20 8.61 17.41 3.8 13.5.67zM11.71 19c-1.78 0-3.22-1.4-3.22-3.14 0-1.62 1.05-2.76 2.81-3.12 1.77-.36 3.6-1.21 4.62-2.58.39 1.29.59 2.65.59 4.04 0 2.65-2.15 4.8-4.8 4.8z"
                                      Foreground="{ThemeResource MuesliWarningBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.CurrentStreakLabel, Mode=OneWay}" Style="{StaticResource MuesliStatValueStyle}" />
                            <TextBlock Text="day streak" Style="{StaticResource MuesliStatLabelStyle}" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="1" Style="{StaticResource MuesliStatButtonStyle}" Click="StatCard_Click" Tag="words"
                            ToolTipService.ToolTip="Open word activity insights" AutomationProperties.Name="Words dictated">
                        <StackPanel Spacing="8">
                            <FontIcon Glyph="&#xE8D2;" FontSize="20" Foreground="{ThemeResource MuesliAccentBrush}" />
                            <TextBlock Text="{x:Bind local:DictationsPage.CompactCount(ViewModel.DictationWordsLabel), Mode=OneWay}" Style="{StaticResource MuesliStatValueStyle}" />
                            <TextBlock Text="words dictated" Style="{StaticResource MuesliStatLabelStyle}" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="2" Style="{StaticResource MuesliStatButtonStyle}" Click="StatCard_Click" Tag="pace"
                            ToolTipService.ToolTip="Open speaking pace insights" AutomationProperties.Name="Average dictation pace">
                        <StackPanel Spacing="8">
                            <FontIcon Glyph="&#xEC4A;" FontSize="20" Foreground="{ThemeResource MuesliSuccessBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.AveragePaceLabel, Mode=OneWay}" Style="{StaticResource MuesliStatValueStyle}" />
                            <TextBlock Text="avg WPM" Style="{StaticResource MuesliStatLabelStyle}" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- macOS voiceNoteButton: right-aligned under the stats, 30pt, accent, red while recording. -->
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,-8,0,-8">
                    <Button Style="{StaticResource MuesliGhostButtonStyle}"
                            Visibility="{x:Bind local:DictationsPage.BoolToVisibility(ViewModel.IsRecording), Mode=OneWay}"
                            Command="{x:Bind ViewModel.CancelDictationCommand}"
                            AutomationProperties.Name="Cancel voice note"
                            AutomationProperties.AutomationId="DictationCancelButton"
                            ToolTipService.ToolTip="Cancel voice note">
                        <FontIcon Glyph="&#xE711;" FontSize="14" />
                    </Button>
                    <Button Style="{StaticResource MuesliPrimaryButtonStyle}"
                            Height="30" MinHeight="30" Padding="12,0" CornerRadius="6"
                            Background="{x:Bind local:DictationsPage.RecordBackground(ViewModel.IsRecording), Mode=OneWay}"
                            Command="{x:Bind ViewModel.ToggleDictationCommand}"
                            AutomationProperties.Name="{x:Bind ViewModel.RecordButtonLabel, Mode=OneWay}"
                            AutomationProperties.AutomationId="DictationRecordButton">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="{x:Bind local:DictationsPage.RecordGlyph(ViewModel.IsRecording), Mode=OneWay}" FontSize="12" />
                            <TextBlock Text="{x:Bind ViewModel.RecordButtonLabel, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!--
                    macOS dictationFilterBar: the destination-app menu (once any app is known) and
                    the date menu on the right. P2-05: no page-level search field. P2-09: no
                    "This Mac / From iPhone" source picker; Windows has one capture source, so a
                    second option would be invented.
                -->
                <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,-4,0,-8">
                    <Button x:Name="AppFilterButton"
                            Style="{StaticResource MuesliGhostButtonStyle}"
                            Padding="8,4" MinHeight="0" CornerRadius="12"
                            Visibility="{x:Bind local:DictationsPage.BoolToVisibility(ViewModel.ShowAppFilter), Mode=OneWay}"
                            AutomationProperties.Name="Destination application filter"
                            AutomationProperties.AutomationId="DictationsAppFilter">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <Image x:Name="AppFilterIcon" Width="16" Height="16" Visibility="Collapsed" />
                            <FontIcon x:Name="AppFilterGlyph" Glyph="&#xF0E2;" FontSize="11" />
                            <TextBlock x:Name="AppFilterLabel" Text="Apps" FontSize="11" FontWeight="Medium" VerticalAlignment="Center" MaxWidth="180" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Button.Flyout>
                            <MenuFlyout x:Name="AppFilterMenu" Placement="BottomEdgeAlignedLeft" Opening="AppFilterMenu_Opening" />
                        </Button.Flyout>
                    </Button>
                    <Button x:Name="DateFilterButton" Grid.Column="2"
                            Style="{StaticResource MuesliGhostButtonStyle}"
                            Padding="0,3" MinHeight="0" CornerRadius="12"
                            AutomationProperties.Name="Date filter"
                            AutomationProperties.AutomationId="DictationsDateFilter">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon x:Name="DateFilterIcon" Glyph="&#xE71C;" FontSize="11" />
                            <TextBlock x:Name="DateFilterLabel" FontSize="11" VerticalAlignment="Center" Visibility="Collapsed" />
                        </StackPanel>
                        <Button.Flyout>
                            <MenuFlyout x:Name="DateFilterMenu" Placement="BottomEdgeAlignedRight" Opening="DateFilterMenu_Opening" />
                        </Button.Flyout>
                    </Button>
                </Grid>

                <!--
                    Action feedback (copy/delete/refresh) opens directly above the list it refers
                    to. Anchoring it here keeps the confirmation inside the viewport; the previous
                    placement below the list rendered it off-screen whenever history was long.
                -->
                <InfoBar x:Name="StatusBar"
                         IsOpen="{x:Bind ViewModel.IsStatusOpen, Mode=TwoWay}"
                         Visibility="{x:Bind local:DictationsPage.BoolToVisibility(ViewModel.IsStatusOpen), Mode=OneWay}"
                         Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                         Severity="Informational"
                         AutomationProperties.AutomationId="DictationsStatus" />

                <Grid>
                    <ListView x:Name="DictationList"
                              ItemsSource="{x:Bind ViewModel.Groups, Mode=OneWay}"
                              SelectionMode="None"
                              IsItemClickEnabled="False"
                              Background="Transparent"
                              BorderThickness="0"
                              ContainerContentChanging="NamedListItem_ContainerContentChanging"
                              AutomationProperties.AutomationId="DictationHistoryList">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,20" />
                                <Setter Property="MinHeight" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="IsTabStop" Value="False" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemContainerTransitions><TransitionCollection /></ListView.ItemContainerTransitions>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:DictationGroup">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="{x:Bind Name}" FontFamily="{StaticResource MuesliFontFamilySemiBold}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource MuesliTextTertiaryBrush}" Margin="4,0,0,0" />
                                        <ListView ItemsSource="{x:Bind Items}"
                                                  SelectionMode="Single"
                                                  IsItemClickEnabled="False"
                                                  ContainerContentChanging="DictationRow_ContainerContentChanging"
                                                  ItemContainerStyle="{StaticResource DictationRowContainerStyle}"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  Padding="0"
                                                  HorizontalContentAlignment="Stretch"
                                                  AutomationProperties.Name="{x:Bind Name}">
                                            <ListView.ItemContainerTransitions><TransitionCollection /></ListView.ItemContainerTransitions>
                                            <ListView.ItemTemplate>
                                                <DataTemplate x:DataType="vm:DictationListItem">
                                                    <!--
                                                        macOS DictationRowView: 80pt monospaced time, a 20pt
                                                        gap, the text at reading size over three lines, and
                                                        copy/delete revealed on hover. No duration column:
                                                        macOS never prints one on a dictation row.
                                                    -->
                                                    <Grid Background="Transparent" Tapped="Row_Tapped">
                                                        <!-- macOS DictationsView context menu. -->
                                                        <Grid.ContextFlyout>
                                                            <MenuFlyout>
                                                                <MenuFlyoutItem Text="Copy" Tag="{x:Bind}" Click="CopyDictation_Click">
                                                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                                                                </MenuFlyoutItem>
                                                                <MenuFlyoutItem Text="Copy CUA Trace" Tag="{x:Bind}" Click="CopyTrace_Click"
                                                                                Visibility="{x:Bind local:ComputerUseRowStyle.Show(HasRun)}">
                                                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8FD;" /></MenuFlyoutItem.Icon>
                                                                </MenuFlyoutItem>
                                                            </MenuFlyout>
                                                        </Grid.ContextFlyout>
                                                        <Grid ColumnDefinitions="80,*,Auto" ColumnSpacing="20" Padding="20,16">
                                                            <TextBlock Text="{x:Bind TimeLabel}" Style="{StaticResource MuesliTimestampStyle}" FontWeight="Medium" VerticalAlignment="Top" Margin="0,2,0,0" />
                                                            <!-- macOS DictationRowView: a CUA tag before a Computer Use command, its final
                                                                 status after it, and the step trail below when expanded. -->
                                                            <StackPanel Grid.Column="1" Spacing="8" MinWidth="0">
                                                                <Grid ColumnDefinitions="Auto,*,Auto">
                                                                    <Border Margin="0,3,8,0" VerticalAlignment="Top" CornerRadius="4" Padding="5,2"
                                                                            Background="{ThemeResource MuesliAccentMutedBrush}"
                                                                            Visibility="{x:Bind local:ComputerUseRowStyle.Show(IsComputerUse)}">
                                                                        <TextBlock Text="CUA" FontFamily="Consolas" FontSize="10" FontWeight="Bold"
                                                                                   Foreground="{ThemeResource MuesliAccentBrush}" />
                                                                    </Border>
                                                                    <TextBlock Grid.Column="1"
                                                                               Text="{x:Bind Body.Shown, Mode=OneWay}"
                                                                               FontFamily="{StaticResource MuesliFontFamily}"
                                                                               FontSize="15"
                                                                               LineHeight="21"
                                                                               Foreground="{ThemeResource MuesliTextPrimaryBrush}"
                                                                               TextWrapping="Wrap"
                                                                               MaxLines="{x:Bind Body.MaxLines, Mode=OneWay}"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Grid.Column="2" Margin="8,3,0,0" VerticalAlignment="Top"
                                                                               FontFamily="{StaticResource MuesliFontFamilySemiBold}" FontSize="12"
                                                                               Text="{x:Bind Run.StatusLabel}"
                                                                               Foreground="{x:Bind local:ComputerUseRowStyle.StatusBrush(Run.Status)}" />
                                                                </Grid>
                                                                <!-- macOS "Show more" / "Show less" under long text. -->
                                                                <Button Style="{StaticResource MuesliGhostButtonStyle}" Padding="0" MinHeight="0" MinWidth="0"
                                                                        HorizontalAlignment="Left" Background="Transparent" BorderThickness="0"
                                                                        Tag="{x:Bind}" Click="ToggleText_Click"
                                                                        Visibility="{x:Bind local:ComputerUseRowStyle.Show(Body.CanExpand)}"
                                                                        AutomationProperties.Name="{x:Bind Body.ToggleName, Mode=OneWay}"
                                                                        AutomationProperties.AutomationId="DictationExpandButton">
                                                                    <TextBlock Text="{x:Bind Body.ToggleLabel, Mode=OneWay}" FontSize="12" FontWeight="Medium"
                                                                               Foreground="{ThemeResource MuesliAccentBrush}" />
                                                                </Button>
                                                                <StackPanel Spacing="8"
                                                                            Visibility="{x:Bind local:ComputerUseRowStyle.Show(Run.IsExpanded), Mode=OneWay, FallbackValue=Collapsed}">
                                                                    <Rectangle Height="1" Opacity="0.5" Fill="{ThemeResource MuesliBorderSoftBrush}" />
                                                                    <ItemsControl ItemsSource="{x:Bind Run.Steps}" IsTabStop="False">
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate x:DataType="svc:ComputerUseStep">
                                                                                <StackPanel Spacing="4" Margin="0,0,0,8">
                                                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                                                        <TextBlock Text="{x:Bind StepLabel}" Width="48" FontFamily="Consolas" FontSize="11"
                                                                                                   Foreground="{ThemeResource MuesliTextTertiaryBrush}" />
                                                                                        <TextBlock Text="{x:Bind Title}" FontSize="12" FontWeight="Medium"
                                                                                                   Foreground="{ThemeResource MuesliTextSecondaryBrush}" />
                                                                                    </StackPanel>
                                                                                    <TextBlock Text="{x:Bind Body}" Margin="56,0,0,0" FontSize="12"
                                                                                               Foreground="{ThemeResource MuesliTextPrimaryBrush}"
                                                                                               TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                                                                </StackPanel>
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                </StackPanel>
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="20" VerticalAlignment="Top">
                                                            <!-- macOS TargetApplicationIconView: where the dictation was pasted. -->
                                                            <Grid Width="20" Height="20" VerticalAlignment="Top" Margin="0,1,0,0"
                                                                  Visibility="{x:Bind local:ComputerUseRowStyle.Show(HasTargetApp)}"
                                                                  ToolTipService.ToolTip="{x:Bind local:ComputerUseRowStyle.DictatedInto(TargetApp)}"
                                                                  AutomationProperties.Name="{x:Bind local:ComputerUseRowStyle.DictatedInto(TargetApp)}">
                                                                <Image Source="{x:Bind local:ComputerUseRowStyle.AppIcon(TargetApp)}" Stretch="Uniform" />
                                                                <Border CornerRadius="4" Background="{ThemeResource MuesliSurfacePrimaryBrush}"
                                                                        Visibility="{x:Bind local:ComputerUseRowStyle.AppIconFallback(TargetApp)}">
                                                                    <FontIcon Glyph="&#xECAA;" FontSize="14" Foreground="{ThemeResource MuesliTextTertiaryBrush}" />
                                                                </Border>
                                                            </Grid>
                                                            <StackPanel x:Name="RowActions"
                                                                        Orientation="Horizontal"
                                                                        Spacing="2"
                                                                        Margin="-8,-4,-8,0"
                                                                        Opacity="{x:Bind local:ComputerUseRowStyle.ActionsOpacity(HasRun)}"
                                                                        IsHitTestVisible="{x:Bind HasRun}">
                                                                <!--
                                                                    Tag + Click, not
                                                                    {Binding ElementName=RootPage}:
                                                                    an ElementName binding inside a
                                                                    nested DataTemplate resolves
                                                                    against the template namescope,
                                                                    which does not contain the page
                                                                    root. The tagged item is the
                                                                    record the action must operate
                                                                    on, verified by the delete
                                                                    confirmation naming it.
                                                                -->
                                                                <Button Style="{StaticResource DictationRowActionStyle}"
                                                                        Tag="{x:Bind}"
                                                                        Click="ToggleRun_Click"
                                                                        Visibility="{x:Bind local:ComputerUseRowStyle.Show(HasRun)}"
                                                                        ToolTipService.ToolTip="{x:Bind local:ComputerUseRowStyle.ChevronName(Run.IsExpanded), Mode=OneWay}"
                                                                        AutomationProperties.Name="{x:Bind local:ComputerUseRowStyle.ChevronName(Run.IsExpanded), Mode=OneWay}"
                                                                        AutomationProperties.AutomationId="DictationStepsToggle">
                                                                    <FontIcon Glyph="{x:Bind local:ComputerUseRowStyle.Chevron(Run.IsExpanded), Mode=OneWay}" FontSize="12" />
                                                                </Button>
                                                                <Button Style="{StaticResource DictationRowActionStyle}"
                                                                        Tag="{x:Bind}"
                                                                        Click="CopyTrace_Click"
                                                                        Visibility="{x:Bind local:ComputerUseRowStyle.Show(HasRun)}"
                                                                        ToolTipService.ToolTip="Copy CUA trace"
                                                                        AutomationProperties.Name="Copy CUA trace"
                                                                        AutomationProperties.AutomationId="DictationCopyTraceButton">
                                                                    <FontIcon Glyph="&#xE8FD;" FontSize="12" />
                                                                </Button>
                                                                <Button Style="{StaticResource DictationRowActionStyle}"
                                                                        Tag="{x:Bind}"
                                                                        Click="CopyDictation_Click"
                                                                        ToolTipService.ToolTip="Copy dictation"
                                                                        AutomationProperties.Name="Copy dictation"
                                                                        AutomationProperties.AutomationId="DictationCopyButton">
                                                                    <FontIcon Glyph="&#xE8C8;" FontSize="12" />
                                                                </Button>
                                                                <Button Style="{StaticResource DictationRowActionStyle}"
                                                                        Tag="{x:Bind}"
                                                                        Click="DeleteDictation_Click"
                                                                        ToolTipService.ToolTip="Delete dictation"
                                                                        AutomationProperties.Name="Delete dictation"
                                                                        AutomationProperties.AutomationId="DictationDeleteButton">
                                                                    <FontIcon Glyph="&#xE74D;" FontSize="12" Foreground="{ThemeResource MuesliErrorBrush}" Opacity="0.6" />
                                                                </Button>
                                                            </StackPanel>
                                                            </StackPanel>
                                                        </Grid>
                                                        <Rectangle Height="1" Margin="20,0" VerticalAlignment="Bottom"
                                                                   Fill="{ThemeResource MuesliBorderSoftBrush}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Border x:Name="EmptyState" MinHeight="260">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                            <FontIcon Glyph="&#xE720;" FontSize="40" Foreground="{ThemeResource MuesliTextTertiaryBrush}" HorizontalAlignment="Center" />
                            <TextBlock x:Name="EmptyStateTitle" Text="No dictations yet" FontSize="18" FontWeight="SemiBold" Foreground="{ThemeResource MuesliTextSecondaryBrush}" HorizontalAlignment="Center" />
                            <TextBlock x:Name="EmptyStateBody" Text="Your first completed dictation will be stored here." FontSize="13" Foreground="{ThemeResource MuesliTextTertiaryBrush}" TextAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

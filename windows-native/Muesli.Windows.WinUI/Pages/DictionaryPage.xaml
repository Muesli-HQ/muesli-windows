<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Muesli.Windows.WinUI.Pages.DictionaryPage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Muesli.Windows.WinUI.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:svc="using:Muesli.Windows.Services"
    xmlns:vm="using:Muesli.Windows.WinUI.ViewModels"
    mc:Ignorable="d">
    <Page.Resources>
        <!-- Disabled icon buttons stay bare, as macOS draws them, instead of the filled disabled chip. -->
        <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
        <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="Transparent" />
        <!-- macOS DictionaryIconButton: a bare 24pt glyph button, 11pt symbol. -->
        <Style x:Key="DictionaryIconButtonStyle" TargetType="Button" BasedOn="{StaticResource MuesliGhostButtonStyle}">
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
        </Style>
        <!-- macOS header buttons: surface fill, 1pt border, 12pt medium, 12x8 padding, cornerSmall. -->
        <Style x:Key="DictionaryHeaderButtonStyle" TargetType="Button" BasedOn="{StaticResource MuesliSecondaryButtonStyle}">
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="DictionaryFieldStyle" TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
        <!-- macOS ThresholdEditor pill: 11pt monospaced, 8x4 padding, surface fill. -->
        <Style x:Key="DictionaryThresholdPillStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="{ThemeResource MuesliSurfaceRaisedBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource MuesliBorderSoftBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{ThemeResource MuesliTextSecondaryBrush}" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="DictionaryRowItemStyle" TargetType="ListViewItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
        </Style>
    </Page.Resources>

    <Grid Background="{ThemeResource MuesliBackgroundBrush}">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ContentStack" Padding="{StaticResource MuesliPageContentPadding}" Spacing="24">

                <!-- macOS header: title, then the suggestions switch and Import / Export / Add new. -->
                <StackPanel Spacing="8">
                    <Grid x:Name="TitleRow" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="16" RowSpacing="12">
                        <TextBlock Text="Dictionary" Style="{StaticResource MuesliPageTitleStyle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <StackPanel x:Name="HeaderBar" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,4,0"
                                        ToolTipService.ToolTip="Briefly reads focused app text after dictation to detect corrections.">
                                <TextBlock Text="Dictionary suggestions" FontSize="12" Foreground="{ThemeResource MuesliTextSecondaryBrush}" VerticalAlignment="Center" />
                                <ToggleSwitch IsOn="{x:Bind ViewModel.SuggestionsEnabled, Mode=TwoWay}"
                                              OnContent="" OffContent="" MinWidth="0" Width="44" VerticalAlignment="Center"
                                              AutomationProperties.Name="Dictionary suggestions"
                                              AutomationProperties.AutomationId="DictionarySuggestionsToggle" />
                            </StackPanel>
                            <Button Style="{StaticResource DictionaryHeaderButtonStyle}"
                                    Command="{x:Bind ViewModel.ImportCommand}"
                                    AutomationProperties.Name="Import dictionary"
                                    AutomationProperties.AutomationId="DictionaryImportButton"
                                    ToolTipService.ToolTip="Import dictionary entries from a JSON file">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE896;" FontSize="12" />
                                    <TextBlock Text="Import" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource DictionaryHeaderButtonStyle}"
                                    Command="{x:Bind ViewModel.ExportCommand}"
                                    AutomationProperties.Name="Export dictionary"
                                    AutomationProperties.AutomationId="DictionaryExportButton"
                                    ToolTipService.ToolTip="Export the current dictionary as JSON">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE898;" FontSize="12" />
                                    <TextBlock Text="Export" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource DictionaryHeaderButtonStyle}"
                                    Click="AddNew_Click"
                                    AutomationProperties.Name="Add dictionary entry"
                                    AutomationProperties.AutomationId="DictionaryAddButton">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <FontIcon Glyph="&#xE710;" FontSize="11" FontWeight="Bold" />
                                    <TextBlock Text="Add new" FontSize="13" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="Add custom words for names, brands, and domain terms, and tune how aggressively each entry should fuzzy-match transcription errors."
                               FontSize="14" Foreground="{ThemeResource MuesliTextSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>

                <InfoBar x:Name="StatusBar"
                         IsOpen="{x:Bind ViewModel.IsStatusOpen, Mode=TwoWay}"
                         Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                         AutomationProperties.AutomationId="DictionaryStatus" />

                <!-- macOS suggestionList: headline + caption, then one hairline-separated row per correction. -->
                <Border x:Name="SuggestionPanel" Style="{StaticResource MuesliCardStyle}" CornerRadius="10" Padding="0">
                    <StackPanel>
                        <StackPanel Padding="16,12" Spacing="3">
                            <TextBlock Text="Suggested Corrections" FontFamily="{StaticResource MuesliFontFamilySemiBold}" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Text="Corrections Muesli noticed by briefly reading focused app text after dictation."
                                       FontSize="12" Foreground="{ThemeResource MuesliTextTertiaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ListView ItemsSource="{x:Bind ViewModel.Suggestions, Mode=OneWay}"
                                  SelectionMode="None"
                                  Background="Transparent"
                                  ScrollViewer.VerticalScrollMode="Disabled"
                                  ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                  ItemContainerStyle="{StaticResource DictionaryRowItemStyle}"
                                  ContainerContentChanging="NamedListItem_ContainerContentChanging"
                                  AutomationProperties.AutomationId="DictionarySuggestionList">
                            <ListView.ItemContainerTransitions>
                                <TransitionCollection />
                            </ListView.ItemContainerTransitions>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="svc:DictionarySuggestion">
                                    <Border BorderBrush="{ThemeResource MuesliBorderSoftBrush}" BorderThickness="0,1,0,0" Padding="16,12">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" AutomationProperties.Name="{x:Bind Display}">
                                            <StackPanel Spacing="3" VerticalAlignment="Center">
                                                <TextBlock FontSize="14" MaxLines="1" TextTrimming="CharacterEllipsis"
                                                           ToolTipService.ToolTip="{x:Bind Display}">
                                                    <Run Text="{x:Bind Observed}" />
                                                    <Run Text="  →  " Foreground="{ThemeResource MuesliTextTertiaryBrush}" />
                                                    <Run Text="{x:Bind Replacement}" />
                                                </TextBlock>
                                                <!-- macOS detail: "Seen 2x | App". -->
                                                <TextBlock Text="{x:Bind Detail}" FontSize="12" MaxLines="1" TextTrimming="CharacterEllipsis"
                                                           Foreground="{ThemeResource MuesliTextTertiaryBrush}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                                <Button Command="{Binding ViewModel.AcceptSuggestionCommand, ElementName=RootPage}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource DictionaryIconButtonStyle}"
                                                        AutomationProperties.Name="Add correction"
                                                        AutomationProperties.AutomationId="DictionaryAcceptSuggestionButton"
                                                        ToolTipService.ToolTip="Add correction">
                                                    <FontIcon Glyph="&#xE73E;" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource MuesliAccentBrush}" />
                                                </Button>
                                                <Button Command="{Binding ViewModel.DismissSuggestionCommand, ElementName=RootPage}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource DictionaryIconButtonStyle}"
                                                        AutomationProperties.Name="Dismiss correction"
                                                        AutomationProperties.AutomationId="DictionaryDismissSuggestionButton"
                                                        ToolTipService.ToolTip="Dismiss correction">
                                                    <FontIcon Glyph="&#xE711;" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource MuesliTextTertiaryBrush}" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <!-- macOS suggestionPaginationControls: range caption and chevrons, only past one page. -->
                        <Grid x:Name="PaginationBar" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4" Padding="16,8"
                              BorderBrush="{ThemeResource MuesliBorderSoftBrush}" BorderThickness="0,1,0,0"
                              Visibility="{x:Bind local:DictionaryPage.BoolToVisibility(ViewModel.HasSuggestionPages), Mode=OneWay}">
                            <TextBlock Text="{x:Bind ViewModel.SuggestionRangeText, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource MuesliTextTertiaryBrush}" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Command="{x:Bind ViewModel.PreviousPageCommand}"
                                    IsEnabled="{x:Bind ViewModel.HasPreviousPage, Mode=OneWay}"
                                    Style="{StaticResource DictionaryIconButtonStyle}"
                                    AutomationProperties.Name="Previous suggestions"
                                    AutomationProperties.AutomationId="DictionaryPreviousPage">
                                <FontIcon Glyph="&#xE76B;" FontSize="11" Foreground="{ThemeResource MuesliTextSecondaryBrush}" />
                            </Button>
                            <Button Grid.Column="2" Command="{x:Bind ViewModel.NextPageCommand}"
                                    IsEnabled="{x:Bind ViewModel.HasNextPage, Mode=OneWay}"
                                    Style="{StaticResource DictionaryIconButtonStyle}"
                                    AutomationProperties.Name="Next suggestions"
                                    AutomationProperties.AutomationId="DictionaryNextPage">
                                <FontIcon Glyph="&#xE76C;" FontSize="11" Foreground="{ThemeResource MuesliTextSecondaryBrush}" />
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <!--
                    macOS wordList: one table with Match → Replace / Threshold columns, an add row on
                    top while adding, and every entry editable in place with save and delete at
                    the end of the row.
                -->
                <StackPanel Spacing="12">

                    <Border Style="{StaticResource MuesliCardStyle}" CornerRadius="10" Padding="0">
                        <StackPanel>
                            <Grid ColumnDefinitions="*,14,*,76,64" ColumnSpacing="8" Padding="16,8">
                                <TextBlock Text="Match" FontSize="12" Foreground="{ThemeResource MuesliTextTertiaryBrush}" />
                                <TextBlock Grid.Column="2" Text="Replace" FontSize="12" Foreground="{ThemeResource MuesliTextTertiaryBrush}" />
                                <TextBlock Grid.Column="3" Text="Threshold" FontSize="12" Foreground="{ThemeResource MuesliTextTertiaryBrush}" />
                            </Grid>

                            <!-- Add row: bound to the view model's draft, shown only while adding. -->
                            <Border x:Name="AddRow" BorderBrush="{ThemeResource MuesliBorderSoftBrush}" BorderThickness="0,1,0,0" Padding="16,12" Visibility="Collapsed">
                                <StackPanel Spacing="6">
                                    <Grid ColumnDefinitions="*,14,*,76,64" ColumnSpacing="8">
                                        <TextBox x:Name="AddWordBox"
                                                 PlaceholderText="Word"
                                                 Style="{StaticResource DictionaryFieldStyle}"
                                                 Text="{x:Bind ViewModel.Phrase, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 KeyDown="AddRow_KeyDown"
                                                 AutomationProperties.Name="New dictionary word"
                                                 AutomationProperties.AutomationId="DictionaryPhraseEditor" />
                                        <FontIcon Grid.Column="1" Glyph="&#xE72A;" FontSize="10" Foreground="{ThemeResource MuesliTextTertiaryBrush}" />
                                        <TextBox Grid.Column="2"
                                                 PlaceholderText="Replace with"
                                                 Style="{StaticResource DictionaryFieldStyle}"
                                                 Text="{x:Bind ViewModel.Replacement, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 KeyDown="AddRow_KeyDown"
                                                 AutomationProperties.Name="New dictionary replacement"
                                                 AutomationProperties.AutomationId="DictionaryReplacementEditor" />
                                        <Button Grid.Column="3" Style="{StaticResource DictionaryThresholdPillStyle}"
                                                AutomationProperties.Name="Matching threshold"
                                                ToolTipService.ToolTip="{x:Bind ViewModel.ThresholdHelp}">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <TextBlock Text="{x:Bind local:DictionaryPage.Percent(ViewModel.MatchingThreshold), Mode=OneWay}" FontFamily="Consolas" FontSize="11" />
                                                <FontIcon Glyph="&#xE70D;" FontSize="8" />
                                            </StackPanel>
                                            <Button.Flyout>
                                                <Flyout Placement="Bottom">
                                                    <StackPanel Width="220" Spacing="10">
                                                        <Grid ColumnDefinitions="*,Auto">
                                                            <TextBlock Text="Threshold" FontSize="12" Foreground="{ThemeResource MuesliTextTertiaryBrush}" />
                                                            <TextBlock Grid.Column="1" Text="{x:Bind local:DictionaryPage.Percent(ViewModel.MatchingThreshold), Mode=OneWay}" FontFamily="Consolas" FontSize="12" />
                                                        </Grid>
                                                        <Slider Minimum="{x:Bind ViewModel.ThresholdMinimum}" Maximum="{x:Bind ViewModel.ThresholdMaximum}"
                                                                StepFrequency="0.01" IsThumbToolTipEnabled="False"
                                                                Value="{x:Bind ViewModel.MatchingThreshold, Mode=TwoWay}"
                                                                AutomationProperties.Name="Matching threshold"
                                                                AutomationProperties.AutomationId="DictionaryThresholdSlider" />
                                                        <Grid ColumnDefinitions="*,Auto">
                                                            <TextBlock Text="{x:Bind local:DictionaryPage.Percent(ViewModel.ThresholdMinimum)}" FontFamily="Consolas" FontSize="10" Foreground="{ThemeResource MuesliTextTertiaryBrush}" />
                                                            <TextBlock Grid.Column="1" Text="{x:Bind local:DictionaryPage.Percent(ViewModel.ThresholdMaximum)}" FontFamily="Consolas" FontSize="10" Foreground="{ThemeResource MuesliTextTertiaryBrush}" />
                                                        </Grid>
                                                    </StackPanel>
                                                </Flyout>
                                            </Button.Flyout>
                                        </Button>
                                        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
                                            <Button Style="{StaticResource DictionaryIconButtonStyle}" Click="AddSave_Click"
                                                    AutomationProperties.Name="Add word" AutomationProperties.AutomationId="DictionarySaveButton"
                                                    ToolTipService.ToolTip="Add word">
                                                <FontIcon Glyph="&#xE73E;" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource MuesliAccentBrush}" />
                                            </Button>
                                            <Button Style="{StaticResource DictionaryIconButtonStyle}" Click="AddCancel_Click"
                                                    AutomationProperties.Name="Cancel" ToolTipService.ToolTip="Cancel">
                                                <FontIcon Glyph="&#xE711;" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource MuesliTextTertiaryBrush}" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="{x:Bind ViewModel.ValidationMessage, Mode=OneWay}"
                                               Visibility="{x:Bind local:DictionaryPage.BoolToVisibility(ViewModel.HasValidationMessage), Mode=OneWay}"
                                               Foreground="{ThemeResource MuesliErrorBrush}" FontSize="12" TextWrapping="Wrap"
                                               AutomationProperties.AutomationId="DictionaryValidationMessage" />
                                </StackPanel>
                            </Border>

                            <ListView x:Name="DictionaryList"
                                      ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                                      SelectionMode="None"
                                      Background="Transparent"
                                      ScrollViewer.VerticalScrollMode="Disabled"
                                      ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                      ItemContainerStyle="{StaticResource DictionaryRowItemStyle}"
                                      ContainerContentChanging="NamedListItem_ContainerContentChanging"
                                      AutomationProperties.AutomationId="DictionaryEntryList">
                                <ListView.ItemContainerTransitions>
                                    <TransitionCollection />
                                </ListView.ItemContainerTransitions>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:DictionaryListItem">
                                        <Border x:Name="RowRoot" Tag="{x:Bind}" BorderBrush="{ThemeResource MuesliBorderSoftBrush}" BorderThickness="0,1,0,0" Padding="16,12">
                                            <Grid ColumnDefinitions="*,14,*,76,64" ColumnSpacing="8">
                                                <TextBox x:Name="RowWord" Tag="{x:Bind}" Text="{x:Bind Phrase}" PlaceholderText="Word"
                                                         Style="{StaticResource DictionaryFieldStyle}"
                                                         TextChanged="RowDraft_Changed" KeyDown="Row_KeyDown"
                                                         AutomationProperties.Name="Dictionary word" />
                                                <FontIcon Grid.Column="1" Glyph="&#xE72A;" FontSize="10" Foreground="{ThemeResource MuesliTextTertiaryBrush}" />
                                                <TextBox x:Name="RowReplacement" Grid.Column="2" Tag="{x:Bind}" Text="{x:Bind Replacement}" PlaceholderText="Replace with"
                                                         Style="{StaticResource DictionaryFieldStyle}"
                                                         TextChanged="RowDraft_Changed" KeyDown="Row_KeyDown"
                                                         AutomationProperties.Name="Dictionary replacement" />
                                                <Button Grid.Column="3" Style="{StaticResource DictionaryThresholdPillStyle}"
                                                        AutomationProperties.Name="Matching threshold"
                                                        ToolTipService.ToolTip="Matching threshold">
                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                        <TextBlock x:Name="RowThresholdLabel" Text="{x:Bind local:DictionaryPage.Percent(MatchingThreshold)}" FontFamily="Consolas" FontSize="11" />
                                                        <FontIcon Glyph="&#xE70D;" FontSize="8" />
                                                    </StackPanel>
                                                    <Button.Flyout>
                                                        <Flyout Placement="Bottom">
                                                            <StackPanel Width="220" Spacing="10">
                                                                <TextBlock Text="Threshold" FontSize="12" Foreground="{ThemeResource MuesliTextTertiaryBrush}" />
                                                                <Slider Tag="{x:Bind}" Minimum="{x:Bind local:DictionaryPage.MinimumThreshold}" Maximum="{x:Bind local:DictionaryPage.MaximumThreshold}" StepFrequency="0.01" IsThumbToolTipEnabled="False"
                                                                        Value="{x:Bind MatchingThreshold}" ValueChanged="RowThreshold_Changed"
                                                                        AutomationProperties.Name="Matching threshold" />
                                                                <Grid ColumnDefinitions="*,Auto">
                                                                    <TextBlock Text="{x:Bind local:DictionaryPage.Percent(local:DictionaryPage.MinimumThreshold)}" FontFamily="Consolas" FontSize="10" Foreground="{ThemeResource MuesliTextTertiaryBrush}" />
                                                                    <TextBlock Grid.Column="1" Text="{x:Bind local:DictionaryPage.Percent(local:DictionaryPage.MaximumThreshold)}" FontFamily="Consolas" FontSize="10" Foreground="{ThemeResource MuesliTextTertiaryBrush}" />
                                                                </Grid>
                                                            </StackPanel>
                                                        </Flyout>
                                                    </Button.Flyout>
                                                </Button>
                                                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
                                                    <Button x:Name="RowSave" Tag="{x:Bind}" Style="{StaticResource DictionaryIconButtonStyle}" Click="RowSave_Click"
                                                            IsEnabled="False"
                                                            AutomationProperties.Name="Save word" ToolTipService.ToolTip="Save word">
                                                        <FontIcon x:Name="RowSaveIcon" Glyph="&#xE73E;" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource MuesliTextTertiaryBrush}" />
                                                    </Button>
                                                    <Button Tag="{x:Bind}" Style="{StaticResource DictionaryIconButtonStyle}" Click="RowDelete_Click"
                                                            AutomationProperties.Name="Delete word" AutomationProperties.AutomationId="DictionaryDeleteButton"
                                                            ToolTipService.ToolTip="Delete word">
                                                        <FontIcon Glyph="&#xE74D;" FontSize="11" Foreground="{ThemeResource MuesliErrorBrush}" />
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <!-- macOS emptyState: character.book.closed, body secondary, caption tertiary. -->
                            <StackPanel x:Name="EmptyState" Spacing="8" Padding="32" HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE82D;" FontSize="28" Foreground="{ThemeResource MuesliTextTertiaryBrush}" HorizontalAlignment="Center" />
                                <TextBlock x:Name="EmptyStateTitle" Text="No custom words yet" FontSize="14"
                                           Foreground="{ThemeResource MuesliTextSecondaryBrush}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                                <TextBlock x:Name="EmptyStateBody" Text="Add words that transcription frequently gets wrong" FontSize="12"
                                           Foreground="{ThemeResource MuesliTextTertiaryBrush}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                            </StackPanel>

                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Muesli.Windows.WinUI.Pages.DictionaryPage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Muesli.Windows.WinUI.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:svc="using:Muesli.Windows.Services"
    xmlns:vm="using:Muesli.Windows.WinUI.ViewModels"
    mc:Ignorable="d">
    <Page.Resources>
        <Style x:Key="DictionaryRowButtonStyle" TargetType="Button" BasedOn="{StaticResource MuesliGhostButtonStyle}">
            <Setter Property="Padding" Value="8" />
            <Setter Property="MinWidth" Value="36" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
        </Style>
        <Style x:Key="DictionaryEditorTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="11,8" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
        <Style x:Key="DictionaryCardListItemStyle" TargetType="ListViewItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
        </Style>
    </Page.Resources>

    <Grid Background="{ThemeResource MuesliBackgroundBrush}">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ContentStack" Padding="{StaticResource MuesliPageContentPadding}" Spacing="18" HorizontalAlignment="Stretch">

                <!--
                    macOS places the page title and the suggestion toggle / Import / Export /
                    Add new cluster on one row, with the description underneath. Windows keeps
                    those same commands; compact widths move the cluster under the title so
                    nothing clips.
                -->
                <Grid x:Name="TitleRow" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="16" RowSpacing="8">
                    <TextBlock Text="Dictionary"
                               Style="{StaticResource MuesliPageTitleStyle}"
                               VerticalAlignment="Center"
                               MinWidth="0"
                               TextTrimming="CharacterEllipsis" />
                    <StackPanel x:Name="HeaderBar"
                                Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="12"
                                VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <TextBlock Text="Dictionary suggestions"
                                       Foreground="{ThemeResource MuesliTextSecondaryBrush}"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap" />
                            <ToggleSwitch IsOn="{x:Bind ViewModel.SuggestionsEnabled, Mode=TwoWay}"
                                          OnContent=""
                                          OffContent=""
                                          MinWidth="0"
                                          Width="44"
                                          VerticalAlignment="Center"
                                          AutomationProperties.Name="Dictionary suggestions"
                                          AutomationProperties.AutomationId="DictionarySuggestionsToggle" />
                        </StackPanel>
                        <StackPanel x:Name="HeaderCommands" Orientation="Horizontal" Spacing="8">
                            <Button Style="{StaticResource MuesliSecondaryButtonStyle}"
                                    Command="{x:Bind ViewModel.ImportCommand}"
                                    AutomationProperties.Name="Import dictionary"
                                    AutomationProperties.AutomationId="DictionaryImportButton"
                                    ToolTipService.ToolTip="Import a versioned JSON dictionary">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <FontIcon Glyph="&#xE896;" FontSize="14" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                                    <TextBlock Text="Import" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource MuesliSecondaryButtonStyle}"
                                    Command="{x:Bind ViewModel.ExportCommand}"
                                    AutomationProperties.Name="Export dictionary"
                                    AutomationProperties.AutomationId="DictionaryExportButton"
                                    ToolTipService.ToolTip="Export the dictionary as JSON">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <FontIcon Glyph="&#xE74E;" FontSize="14" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                                    <TextBlock Text="Export" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource MuesliPrimaryButtonStyle}"
                                    Command="{x:Bind ViewModel.NewEntryCommand}"
                                    AutomationProperties.Name="Add dictionary entry"
                                    AutomationProperties.AutomationId="DictionaryAddButton">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <FontIcon Glyph="&#xE710;" FontSize="14" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                                    <TextBlock Text="Add new" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Grid.Row="1"
                               Grid.ColumnSpan="2"
                               Text="Add custom words for names, brands, and domain terms, and tune how aggressively each entry should fuzzy-match transcription errors."
                               Style="{StaticResource MuesliPageSubtitleStyle}" />
                </Grid>

                <InfoBar x:Name="StatusBar"
                         IsOpen="{x:Bind ViewModel.IsStatusOpen, Mode=TwoWay}"
                         Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                         AutomationProperties.AutomationId="DictionaryStatus" />

                <Border x:Name="SuggestionPanel" Style="{StaticResource MuesliCardStyle}" Padding="0">
                    <StackPanel>
                        <StackPanel Padding="20,17,20,14" Spacing="4">
                            <TextBlock Text="Suggested Corrections"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       FontFamily="{StaticResource MuesliFontFamilySemiBold}" />
                            <TextBlock Text="Corrections Muesli noticed after you edited a dictation. Add them to apply on future transcripts."
                                       Style="{StaticResource MuesliBodyStyle}"
                                       Foreground="{ThemeResource MuesliTextTertiaryBrush}" />
                        </StackPanel>
                        <ListView ItemsSource="{x:Bind ViewModel.Suggestions, Mode=OneWay}"
                                  SelectionMode="None"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                  ScrollViewer.VerticalScrollMode="Disabled"
                                  ItemContainerStyle="{StaticResource DictionaryCardListItemStyle}"
                                  ContainerContentChanging="NamedListItem_ContainerContentChanging"
                                  AutomationProperties.AutomationId="DictionarySuggestionList">
                            <ListView.ItemContainerTransitions>
                                <TransitionCollection />
                            </ListView.ItemContainerTransitions>
                            <!--
                                P7-05. macOS prints per-suggestion provenance here ("Seen 1x |
                                ChatGPT") from DictionarySuggestion.occurrenceCount and
                                appDisplayName. The Windows record is
                                DictionarySuggestionDetector's `DictionarySuggestion(Observed,
                                Replacement)` - no count, no source app - and QueueDictionarySuggestion
                                de-duplicates, so a count would always read "1x". Rather than invent
                                provenance, the constant "Pending dictionary correction" line is
                                dropped and the card's subtitle carries the one true statement about
                                where these came from. Per-suggestion provenance is a data-collection
                                change and is recorded as core work, not built here.

                                The pair is also one trimming TextBlock rather than two fixed-width
                                ones inside a horizontal StackPanel: a StackPanel hands its children
                                infinite width, so the old MaxWidth="240" cut long phrases at a fixed
                                point regardless of how much room the row actually had.
                            -->
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="svc:DictionarySuggestion">
                                    <Border BorderBrush="{ThemeResource MuesliBorderSoftBrush}"
                                            BorderThickness="0,1,0,0"
                                            Padding="20,13">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" AutomationProperties.Name="{x:Bind Display}">
                                            <TextBlock VerticalAlignment="Center"
                                                       MinWidth="0"
                                                       Style="{StaticResource MuesliRowTitleStyle}"
                                                       FontSize="15"
                                                       MaxLines="1"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTipService.ToolTip="{x:Bind Display}">
                                                <Run Text="{x:Bind Observed}" />
                                                <Run Text=" → " Foreground="{ThemeResource MuesliTextTertiaryBrush}" />
                                                <Run Text="{x:Bind Replacement}" />
                                            </TextBlock>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                                <Button Command="{Binding ViewModel.AcceptSuggestionCommand, ElementName=RootPage}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource DictionaryRowButtonStyle}"
                                                        Foreground="{ThemeResource MuesliAccentBrush}"
                                                        AutomationProperties.Name="Accept dictionary suggestion"
                                                        AutomationProperties.AutomationId="DictionaryAcceptSuggestionButton"
                                                        ToolTipService.ToolTip="Add this correction to the dictionary">
                                                    <FontIcon Glyph="&#xE73E;"
                                                              FontSize="15"
                                                              FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                                              Foreground="{ThemeResource MuesliAccentBrush}" />
                                                </Button>
                                                <Button Command="{Binding ViewModel.DismissSuggestionCommand, ElementName=RootPage}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource DictionaryRowButtonStyle}"
                                                        Foreground="{ThemeResource MuesliTextSecondaryBrush}"
                                                        AutomationProperties.Name="Dismiss dictionary suggestion"
                                                        AutomationProperties.AutomationId="DictionaryDismissSuggestionButton"
                                                        ToolTipService.ToolTip="Dismiss this suggestion">
                                                    <FontIcon Glyph="&#xE711;"
                                                              FontSize="15"
                                                              FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                                              Foreground="{ThemeResource MuesliTextSecondaryBrush}" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

                <Grid x:Name="DictionaryColumns"
                      ColumnDefinitions="1.22*,1*"
                      RowDefinitions="Auto,Auto"
                      ColumnSpacing="18"
                      RowSpacing="18"
                      HorizontalAlignment="Stretch">
                    <Border x:Name="DictionaryListCard" Style="{StaticResource MuesliCardStyle}" Padding="0">
                        <StackPanel>
                            <Grid RowDefinitions="Auto,Auto" RowSpacing="10" Padding="20,17,20,12">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="Your dictionary"
                                               FontSize="17"
                                               FontWeight="SemiBold"
                                               FontFamily="{StaticResource MuesliFontFamilySemiBold}" />
                                    <TextBlock Text="{x:Bind ViewModel.PageLabel, Mode=OneWay}"
                                               FontSize="12"
                                               Foreground="{ThemeResource MuesliTextTertiaryBrush}" />
                                </StackPanel>
                                <Border x:Name="SearchWell"
                                        Grid.Row="1"
                                        Style="{StaticResource MuesliSegmentedContainerStyle}"
                                        Padding="8,0"
                                        HorizontalAlignment="Stretch"
                                        MinWidth="120">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                        <FontIcon Glyph="&#xE721;"
                                                  FontSize="14"
                                                  FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                                  Foreground="{ThemeResource MuesliTextTertiaryBrush}"
                                                  VerticalAlignment="Center" />
                                        <TextBox Grid.Column="1"
                                                 Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 PlaceholderText="Search..."
                                                 Style="{StaticResource MuesliSearchTextBoxStyle}"
                                                 AutomationProperties.Name="Search dictionary"
                                                 AutomationProperties.AutomationId="DictionarySearchBox" />
                                    </Grid>
                                </Border>
                            </Grid>
                            <Border Height="1" Background="{ThemeResource MuesliBorderSoftBrush}" />
                            <Grid>
                                <ListView x:Name="DictionaryList"
                                          ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                                          IsItemClickEnabled="True"
                                          ItemClick="DictionaryList_ItemClick"
                                          SelectionMode="Single"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                          ScrollViewer.VerticalScrollMode="Disabled"
                                          ItemContainerStyle="{StaticResource DictionaryCardListItemStyle}"
                                          ContainerContentChanging="NamedListItem_ContainerContentChanging"
                                          AutomationProperties.AutomationId="DictionaryEntryList">
                                    <ListView.ItemContainerTransitions>
                                        <TransitionCollection />
                                    </ListView.ItemContainerTransitions>
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="vm:DictionaryListItem">
                                            <Border BorderBrush="{ThemeResource MuesliBorderSoftBrush}"
                                                    BorderThickness="0,0,0,1"
                                                    Padding="20,13">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                                    <StackPanel Spacing="4" MinWidth="0">
                                                        <TextBlock Text="{x:Bind Phrase}"
                                                                   Style="{StaticResource MuesliRowTitleStyle}"
                                                                   FontSize="15" />
                                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                                            <TextBlock Text="{x:Bind ReplacementLabel}"
                                                                       Style="{StaticResource MuesliRowSecondaryStyle}" />
                                                            <Border Style="{StaticResource MuesliAccentBadgeStyle}">
                                                                <TextBlock Text="{x:Bind ThresholdLabel}"
                                                                           Style="{StaticResource MuesliAccentBadgeTextStyle}" />
                                                            </Border>
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <FontIcon Grid.Column="1"
                                                              Glyph="&#xE76C;"
                                                              FontSize="12"
                                                              FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                                              Foreground="{ThemeResource MuesliTextTertiaryBrush}"
                                                              VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <Border x:Name="EmptyState" MinHeight="230" Background="Transparent">
                                    <StackPanel HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Spacing="8"
                                                MaxWidth="360"
                                                Padding="20">
                                        <FontIcon Glyph="&#xE82D;"
                                                  FontSize="30"
                                                  FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                                  Foreground="{ThemeResource MuesliTextTertiaryBrush}"
                                                  HorizontalAlignment="Center" />
                                        <TextBlock x:Name="EmptyStateTitle"
                                                   Text="{x:Bind ViewModel.EmptyStateTitle, Mode=OneWay}"
                                                   FontSize="17"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap" />
                                        <TextBlock x:Name="EmptyStateBody"
                                                   Text="{x:Bind ViewModel.EmptyStateInstruction, Mode=OneWay}"
                                                   Style="{StaticResource MuesliBodyStyle}"
                                                   TextAlignment="Center" />
                                        <Button Style="{StaticResource MuesliPrimaryButtonStyle}"
                                                HorizontalAlignment="Center"
                                                Margin="0,6,0,0"
                                                Command="{x:Bind ViewModel.NewEntryCommand}"
                                                Visibility="{x:Bind local:DictionaryPage.BoolToVisibility(ViewModel.ShowEmptyAddAction), Mode=OneWay}"
                                                AutomationProperties.Name="Add a dictionary entry from the empty state">
                                            <StackPanel Orientation="Horizontal" Spacing="7">
                                                <FontIcon Glyph="&#xE710;" FontSize="14" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                                                <TextBlock Text="Add new" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border x:Name="DictionaryEditorPanel"
                            Grid.Column="1"
                            Style="{StaticResource MuesliCardStyle}"
                            VerticalAlignment="Top"
                            Padding="22">
                        <StackPanel Spacing="15">
                            <StackPanel Spacing="3">
                                <TextBlock Text="{x:Bind ViewModel.EditorTitle, Mode=OneWay}"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           FontFamily="{StaticResource MuesliFontFamilySemiBold}" />
                                <TextBlock Text="A dictionary entry applies to future transcripts on this PC."
                                           FontSize="12"
                                           Foreground="{ThemeResource MuesliTextTertiaryBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Spacing="5">
                                <TextBox Header="Word or phrase"
                                         Style="{StaticResource DictionaryEditorTextBoxStyle}"
                                         Text="{x:Bind ViewModel.Phrase, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.AutomationId="DictionaryPhraseEditor" />
                                <!-- The same text the page status bar announces, kept next to the
                                     field that caused it so a refused Save is legible at 720 DIP,
                                     where the editor sits well below the bar. -->
                                <TextBlock Text="{x:Bind ViewModel.ValidationMessage, Mode=OneWay}"
                                           Visibility="{x:Bind local:DictionaryPage.BoolToVisibility(ViewModel.HasValidationMessage), Mode=OneWay}"
                                           Foreground="{ThemeResource MuesliErrorBrush}"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           AutomationProperties.AutomationId="DictionaryValidationMessage" />
                            </StackPanel>
                            <TextBox Header="Replace with (optional)"
                                     Style="{StaticResource DictionaryEditorTextBoxStyle}"
                                     Text="{x:Bind ViewModel.Replacement, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.AutomationId="DictionaryReplacementEditor" />
                            <!--
                                P7-04. The thumb sits hard left at the default because 85 % is the
                                *minimum* the matcher accepts - DictionaryCorrectionService.
                                ClampThreshold pins every stored value into 0.85-0.98, so widening
                                the slider would offer settings the engine silently discards. The
                                slider is therefore left alone and the scale is made visible
                                instead: the two end labels show where 85 % actually sits, and the
                                technical detail (short words are held to a stricter score whatever
                                this says) stays on the tooltip rather than in the row, so it costs
                                no extra tab stop.
                            -->
                            <StackPanel Spacing="6">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <TextBlock Text="Matching threshold"
                                                   Foreground="{ThemeResource MuesliTextSecondaryBrush}"
                                                   VerticalAlignment="Center" />
                                        <FontIcon Glyph="&#xE946;"
                                                  FontSize="{StaticResource MuesliIconSizeSmall}"
                                                  FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                                  Foreground="{ThemeResource MuesliTextTertiaryBrush}"
                                                  VerticalAlignment="Center"
                                                  AutomationProperties.AccessibilityView="Raw" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Text="{x:Bind ViewModel.ThresholdLabel, Mode=OneWay}"
                                               Foreground="{ThemeResource MuesliAccentBrush}"
                                               FontWeight="SemiBold" />
                                </Grid>
                                <Slider x:Name="ThresholdSlider"
                                        Minimum="{x:Bind ViewModel.ThresholdMinimum}"
                                        Maximum="{x:Bind ViewModel.ThresholdMaximum}"
                                        StepFrequency="0.01"
                                        Margin="0,-2,0,-6"
                                        Value="{x:Bind ViewModel.MatchingThreshold, Mode=TwoWay}"
                                        ToolTipService.ToolTip="{x:Bind ViewModel.ThresholdHelp}"
                                        AutomationProperties.Name="Matching threshold"
                                        AutomationProperties.HelpText="{x:Bind ViewModel.ThresholdHelp}"
                                        AutomationProperties.AutomationId="DictionaryThresholdSlider" />
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="{x:Bind ViewModel.ThresholdMinimumLabel}"
                                               FontSize="11"
                                               Foreground="{ThemeResource MuesliTextTertiaryBrush}" />
                                    <TextBlock Grid.Column="1"
                                               Text="{x:Bind ViewModel.ThresholdMaximumLabel}"
                                               FontSize="11"
                                               Foreground="{ThemeResource MuesliTextTertiaryBrush}" />
                                </Grid>
                            </StackPanel>
                            <Border Height="1" Background="{ThemeResource MuesliBorderSoftBrush}" />
                            <StackPanel x:Name="EditorActions" Orientation="Horizontal" Spacing="8">
                                <Button Command="{x:Bind ViewModel.SaveEntryCommand}"
                                        Style="{StaticResource MuesliPrimaryButtonStyle}"
                                        AutomationProperties.Name="Save dictionary entry"
                                        AutomationProperties.AutomationId="DictionarySaveButton">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <FontIcon Glyph="&#xE74E;" FontSize="13" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                                        <TextBlock Text="Save entry" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{x:Bind ViewModel.DeleteEntryCommand}"
                                        Style="{StaticResource MuesliDestructiveButtonStyle}"
                                        AutomationProperties.Name="Delete dictionary entry"
                                        AutomationProperties.AutomationId="DictionaryDeleteButton">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <FontIcon Glyph="&#xE74D;" FontSize="13" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                                        <TextBlock Text="Delete" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid x:Name="PaginationBar" ColumnDefinitions="Auto,*,Auto" HorizontalAlignment="Stretch">
                    <Button Command="{x:Bind ViewModel.PreviousPageCommand}"
                            IsEnabled="{x:Bind ViewModel.HasPreviousPage, Mode=OneWay}"
                            Style="{StaticResource MuesliGhostButtonStyle}"
                            AutomationProperties.Name="Previous dictionary page"
                            AutomationProperties.AutomationId="DictionaryPreviousPage">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon Glyph="&#xE72B;" FontSize="12" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                            <TextBlock Text="Previous" />
                        </StackPanel>
                    </Button>
                    <TextBlock Grid.Column="1"
                               Text="{x:Bind ViewModel.PageLabel, Mode=OneWay}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource MuesliTextSecondaryBrush}" />
                    <Button Grid.Column="2"
                            Command="{x:Bind ViewModel.NextPageCommand}"
                            IsEnabled="{x:Bind ViewModel.HasNextPage, Mode=OneWay}"
                            Style="{StaticResource MuesliGhostButtonStyle}"
                            AutomationProperties.Name="Next dictionary page"
                            AutomationProperties.AutomationId="DictionaryNextPage">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <TextBlock Text="Next" />
                            <FontIcon Glyph="&#xE72A;" FontSize="12" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Muesli.Windows.WinUI.Pages.ShortcutsPage"
    x:Name="RootPage"
    IsTabStop="True"
    XYFocusKeyboardNavigation="Enabled"
    UseSystemFocusVisuals="True"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Muesli.Windows.WinUI.Pages">
    <Page.Resources>
        <!-- macOS section card: 16pt padding, cornerMedium, raised fill, 1pt border, 16pt rhythm. -->
        <Style x:Key="ShortcutSectionStyle" TargetType="Border" BasedOn="{StaticResource MuesliCardStyle}">
            <Setter Property="Padding" Value="16" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
        <Style x:Key="ShortcutTitleStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource MuesliFontFamilySemiBold}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{ThemeResource MuesliTextPrimaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="ShortcutCaptionStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource MuesliTextSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- macOS hotkeyBadge: 12pt medium, 12x4 padding, surface fill, cornerSmall. -->
        <Style x:Key="ShortcutBadgeStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource MuesliSurfaceRaisedBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource MuesliBorderSoftBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="ShortcutBadgeTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource MuesliFontFamilyMedium}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource MuesliTextPrimaryBrush}" />
        </Style>
        <!-- macOS compactChangeButton: plain accent text at body size. -->
        <Style x:Key="ShortcutLinkStyle" TargetType="Button" BasedOn="{StaticResource MuesliGhostButtonStyle}">
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{ThemeResource MuesliAccentBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="ShortcutToggleStyle" TargetType="ToggleSwitch">
            <Setter Property="OnContent" Value="" />
            <Setter Property="OffContent" Value="" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Width" Value="44" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
        <Style x:Key="ShortcutDividerStyle" TargetType="Rectangle">
            <Setter Property="Height" Value="1" />
            <Setter Property="Fill" Value="{ThemeResource MuesliBorderSoftBrush}" />
        </Style>
    </Page.Resources>

    <Grid x:Name="PageRoot" Background="{ThemeResource MuesliBackgroundBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="ContentRoot"
                        Padding="{StaticResource MuesliPageContentPadding}"
                        Spacing="24">
                <TextBlock Text="Shortcuts" Style="{StaticResource MuesliPageTitleStyle}" />
                <TextBlock Text="Choose your preferred shortcuts for dictation and computer use commands."
                           FontSize="14" Foreground="{ThemeResource MuesliTextSecondaryBrush}" TextWrapping="Wrap" Margin="0,-12,0,0" />

                <!-- Dictation: the configurable push-to-talk shortcut and its activation delay. -->
                <Border Style="{StaticResource ShortcutSectionStyle}" AutomationProperties.Name="Dictation shortcut">
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Dictation" Style="{StaticResource ShortcutTitleStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.PushToTalkDescription, Mode=OneWay}" Style="{StaticResource ShortcutCaptionStyle}" />
                        </StackPanel>
                        <Rectangle Style="{StaticResource ShortcutDividerStyle}" />
                        <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="12" RowDefinitions="Auto,Auto" RowSpacing="8">
                            <Border x:Name="PushKeycapWell" Style="{StaticResource ShortcutBadgeStyle}"
                                    AutomationProperties.Name="Current push-to-talk shortcut"
                                    AutomationProperties.LiveSetting="Polite">
                                <TextBlock Text="{x:Bind local:ShortcutsPage.Keys(ViewModel.HotkeyParts), Mode=OneWay}" Style="{StaticResource ShortcutBadgeTextStyle}" />
                            </Border>
                            <Button x:Name="ChangePushToTalkButton" Grid.Column="1"
                                    Click="ChangeShortcut_Click"
                                    Content="{x:Bind ViewModel.CapturePrompt, Mode=OneWay}"
                                    Style="{StaticResource ShortcutLinkStyle}"
                                    AutomationProperties.Name="Change push-to-talk shortcut"
                                    AutomationProperties.AutomationId="ChangePushToTalkButton"
                                    ToolTipService.ToolTip="Press to capture a new Windows shortcut. Escape cancels." />
                            <StackPanel x:Name="PttHoldRow" Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                                        ToolTipService.ToolTip="How long to hold the shortcut before it activates.">
                                <TextBlock Text="Activation delay" Style="{StaticResource ShortcutCaptionStyle}" />
                                <NumberBox Width="76" Minimum="50" Maximum="2000" SmallChange="25" LargeChange="50"
                                           SpinButtonPlacementMode="Hidden"
                                           FontFamily="Consolas" FontSize="13" FontWeight="SemiBold"
                                           Value="{x:Bind ViewModel.HoldThresholdMs, Mode=TwoWay}"
                                           IsEnabled="{x:Bind local:ShortcutsPage.Not(ViewModel.IsCapturing), Mode=OneWay}"
                                           ValueChanged="HoldThreshold_ValueChanged"
                                           AutomationProperties.Name="Activation delay in milliseconds"
                                           AutomationProperties.AutomationId="ShortcutHoldThreshold" />
                                <TextBlock Text="ms" Style="{StaticResource ShortcutCaptionStyle}" />
                            </StackPanel>
                            <TextBlock Grid.Row="1" Grid.ColumnSpan="4"
                                       Text="Press a key or a modifier + key. Escape cancels; your current shortcut stays unchanged."
                                       Style="{StaticResource ShortcutCaptionStyle}"
                                       Visibility="{x:Bind local:ShortcutsPage.BoolToVisibility(ViewModel.IsCapturing), Mode=OneWay}"
                                       AutomationProperties.LiveSetting="Assertive" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Computer Use: its own configurable shortcut, enabled once ChatGPT is signed in. -->
                <Border Style="{StaticResource ShortcutSectionStyle}" AutomationProperties.Name="Computer Use Command shortcut">
                    <StackPanel Spacing="16">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Computer Use Command" Style="{StaticResource ShortcutTitleStyle}" />
                                <TextBlock Text="Press to record a command, press again to plan and run it" Style="{StaticResource ShortcutCaptionStyle}" />
                            </StackPanel>
                            <ToggleSwitch x:Name="ComputerUseToggle" Grid.Column="1"
                                          Style="{StaticResource ShortcutToggleStyle}"
                                          IsOn="{x:Bind ViewModel.ComputerUseEnabled, Mode=OneWay}"
                                          IsEnabled="{x:Bind ViewModel.ComputerUseConfigured, Mode=OneWay}"
                                          Toggled="ComputerUse_Toggled"
                                          AutomationProperties.Name="Computer Use shortcut enabled"
                                          AutomationProperties.HelpText="Enable the Computer Use shortcut." />
                        </Grid>
                        <Rectangle Style="{StaticResource ShortcutDividerStyle}" />
                        <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="12">
                            <Border x:Name="ComputerUseKeycapWell" Style="{StaticResource ShortcutBadgeStyle}"
                                    AutomationProperties.Name="Current Computer Use shortcut"
                                    AutomationProperties.LiveSetting="Polite">
                                <TextBlock Text="{x:Bind local:ShortcutsPage.Keys(ViewModel.ComputerUseHotkeyParts), Mode=OneWay}" Style="{StaticResource ShortcutBadgeTextStyle}" />
                            </Border>
                            <Button x:Name="ChangeComputerUseButton" Grid.Column="1"
                                    Click="ChangeComputerUseShortcut_Click"
                                    Content="{x:Bind ViewModel.ComputerUseCapturePrompt, Mode=OneWay}"
                                    Style="{StaticResource ShortcutLinkStyle}"
                                    AutomationProperties.Name="Change Computer Use shortcut"
                                    AutomationProperties.AutomationId="ChangeComputerUseShortcutButton"
                                    ToolTipService.ToolTip="Press to capture a new Windows shortcut. Escape cancels." />
                            <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.ComputerUseShortcutState, Mode=OneWay}" Style="{StaticResource ShortcutCaptionStyle}" VerticalAlignment="Center" />
                            <Button Grid.Column="3" Content="Configure…" Click="ComputerUseConfigure_Click"
                                    Style="{StaticResource ShortcutLinkStyle}"
                                    Visibility="{x:Bind local:ShortcutsPage.BoolToVisibility(ViewModel.ComputerUseNeedsConfiguration), Mode=OneWay}"
                                    AutomationProperties.Name="Configure Computer Use in Settings" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Quill: no Windows runtime yet, so the card says so instead of offering a dead control. -->
                <Border Style="{StaticResource ShortcutSectionStyle}" AutomationProperties.Name="Quill shortcut">
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE70F;" FontSize="15" Foreground="{ThemeResource MuesliAccentBrush}" AutomationProperties.AccessibilityView="Raw" />
                                <TextBlock Text="Quill" Style="{StaticResource ShortcutTitleStyle}" />
                            </StackPanel>
                            <TextBlock Text="Highlight text, hold to speak an editing instruction, then release to replace" Style="{StaticResource ShortcutCaptionStyle}" />
                        </StackPanel>
                        <Rectangle Style="{StaticResource ShortcutDividerStyle}" />
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Opacity="0.7">
                            <Border Style="{StaticResource ShortcutBadgeStyle}">
                                <TextBlock Text="None" Style="{StaticResource ShortcutBadgeTextStyle}" Foreground="{ThemeResource MuesliTextTertiaryBrush}" />
                            </Border>
                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.QuillUnavailableReason, Mode=OneWay}" Style="{StaticResource ShortcutCaptionStyle}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Meeting Recording: no dedicated Windows global shortcut yet. -->
                <Border Style="{StaticResource ShortcutSectionStyle}" AutomationProperties.Name="Meeting Recording shortcut">
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Meeting Recording" Style="{StaticResource ShortcutTitleStyle}" />
                            <TextBlock Text="Toggle meeting recording on/off" Style="{StaticResource ShortcutCaptionStyle}" />
                        </StackPanel>
                        <Rectangle Style="{StaticResource ShortcutDividerStyle}" />
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Border Style="{StaticResource ShortcutBadgeStyle}" Opacity="0.7">
                                <TextBlock Text="None" Style="{StaticResource ShortcutBadgeTextStyle}" Foreground="{ThemeResource MuesliTextTertiaryBrush}" />
                            </Border>
                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.MeetingRecordingUnavailableReason, Mode=OneWay}" Style="{StaticResource ShortcutCaptionStyle}" />
                            <Button Grid.Column="2" Content="Open Meetings" Click="OpenMeetings_Click"
                                    Style="{StaticResource ShortcutLinkStyle}"
                                    AutomationProperties.Name="Open the Meetings page to start or stop recording" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- macOS Hands-Free Mode: header and switch only. -->
                <Border Style="{StaticResource ShortcutSectionStyle}" AutomationProperties.Name="Hands-Free Mode">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Hands-Free Mode" Style="{StaticResource ShortcutTitleStyle}" />
                            <TextBlock Text="Double-tap the dictation shortcut to start; tap again to stop" Style="{StaticResource ShortcutCaptionStyle}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="HandsFreeToggle" Grid.Column="1"
                                      Style="{StaticResource ShortcutToggleStyle}"
                                      IsOn="{x:Bind ViewModel.HandsFreeEnabled, Mode=OneWay}"
                                      Toggled="HandsFree_Toggled"
                                      AutomationProperties.Name="Hands-free dictation enabled"
                                      AutomationProperties.AutomationId="HandsFreeToggle"
                                      AutomationProperties.HelpText="Double-tap the dictation shortcut to lock recording hands-free." />
                    </Grid>
                </Border>
                <InfoBar x:Name="StatusBar"
                         IsOpen="{x:Bind ViewModel.IsStatusOpen, Mode=TwoWay}"
                         Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                         IsClosable="True"
                         AutomationProperties.LiveSetting="Polite"
                         AutomationProperties.AutomationId="ShortcutsStatus" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

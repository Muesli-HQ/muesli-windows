                                    <TextBlock Text="The model identifier used to write meeting notes." Style="{StaticResource RowHelpStyle}" />
                                </StackPanel>
                                <TextBox Grid.Column="1"
                                         Style="{StaticResource ValueBoxStyle}"
                                         Text="{x:Bind ViewModel.OpenRouterModel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="OpenRouter model"
                                         AutomationProperties.AutomationId="OpenRouterModelBox" />
                            </Grid>
                            <Border Style="{StaticResource DividerStyle}" Visibility="{x:Bind local:SettingsPage.BoolToVisibility(ViewModel.ShowOpenRouterSettings), Mode=OneWay}" />
                            <StackPanel Padding="20,14" Spacing="8" Visibility="{x:Bind local:SettingsPage.BoolToVisibility(ViewModel.ShowOpenRouterSettings), Mode=OneWay}">
                                <PasswordBox Header="OpenRouter API key"
                                             Password="{x:Bind ViewModel.OpenRouterApiKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             PasswordRevealMode="Hidden"
                                             AutomationProperties.Name="OpenRouter API key"
                                             AutomationProperties.AutomationId="OpenRouterApiKeyBox" />
                                <TextBlock Text="Protected by Windows Credential Manager. Clear the field and save to remove the key." Style="{StaticResource RowHelpStyle}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="AFTER A MEETING" Style="{StaticResource MuesliSectionLabelStyle}" />
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel>
                            <Grid ColumnDefinitions="*,Auto" Padding="20,14" ColumnSpacing="16">
                                <StackPanel MinWidth="0">
                                    <TextBlock Text="Automatically export Markdown" Style="{StaticResource RowTitleStyle}" />
                                    <TextBlock Text="Save a copy of completed notes. Existing edited files are kept." Style="{StaticResource RowHelpStyle}" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" Style="{StaticResource SettingsToggleStyle}"
                                              IsOn="{x:Bind ViewModel.AutoExportMarkdownEnabled, Mode=TwoWay}"
                                              AutomationProperties.Name="Automatically export Markdown"
                                              AutomationProperties.AutomationId="AutoExportMarkdownToggle" />
                            </Grid>
                            <Border Style="{StaticResource DividerStyle}" />
                            <!-- P5-11: the export folder was an unexplained empty field with no way to
                                 choose one. It now states where the copy goes and offers Browse. -->
                            <Grid ColumnDefinitions="*,Auto" Padding="20,14" ColumnSpacing="16">
                                <StackPanel MinWidth="0">
                                    <TextBlock Text="Export folder" Style="{StaticResource RowTitleStyle}" />
                                    <TextBlock Text="{x:Bind ViewModel.AutoExportFolderHelp, Mode=OneWay}" Style="{StaticResource RowHelpStyle}" />
                                </StackPanel>
                                <StackPanel x:Name="ExportFolderHost" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <TextBox Style="{StaticResource ValueBoxStyle}"
                                             Text="{x:Bind ViewModel.AutoExportMarkdownDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             IsEnabled="{x:Bind ViewModel.AutoExportMarkdownEnabled, Mode=OneWay}"
                                             PlaceholderText="Choose a folder"
                                             AutomationProperties.Name="Export folder"
                                             AutomationProperties.HelpText="Enable Automatically export Markdown to change this folder."
                                             AutomationProperties.AutomationId="AutoExportMarkdownDirectory" />
                                    <Button Content="Browse…"
                                            Style="{StaticResource MuesliSecondaryButtonStyle}"
                                            VerticalAlignment="Center"
                                            IsEnabled="{x:Bind ViewModel.AutoExportMarkdownEnabled, Mode=OneWay}"
                                            Click="BrowseExportFolder_Click"
                                            AutomationProperties.Name="Browse for an export folder"
                                            AutomationProperties.HelpText="Enable Automatically export Markdown to choose a folder."
                                            AutomationProperties.AutomationId="AutoExportMarkdownBrowseButton" />
                                </StackPanel>
                            </Grid>
                            <Border Style="{StaticResource DividerStyle}" />
                            <Grid ColumnDefinitions="*,Auto" Padding="20,14" ColumnSpacing="16">
                                <StackPanel MinWidth="0">
                                    <TextBlock Text="Also export PDF" Style="{StaticResource RowTitleStyle}" />
                                    <TextBlock Text="{x:Bind ViewModel.PdfAutoExportHelp, Mode=OneWay}" Style="{StaticResource RowHelpStyle}" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" Style="{StaticResource SettingsToggleStyle}"
                                              IsOn="{x:Bind ViewModel.AutoExportPdfEnabled, Mode=TwoWay}"
                                              IsEnabled="{x:Bind ViewModel.PdfAutoExportAvailable, Mode=OneWay}"
                                              AutomationProperties.Name="Also export PDF"
                                              AutomationProperties.AutomationId="AutoExportPdfToggle" />
                            </Grid>
                            <Border Style="{StaticResource DividerStyle}" />
                            <Grid ColumnDefinitions="*,Auto" Padding="20,14" ColumnSpacing="16">
                                <StackPanel MinWidth="0">
                                    <TextBlock Text="Run a post-meeting program" Style="{StaticResource RowTitleStyle}" />
                                    <TextBlock Text="Runs after notes are saved, using your configured payload (meeting metadata by default). Changes apply to the next meeting." Style="{StaticResource RowHelpStyle}" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" Style="{StaticResource SettingsToggleStyle}"
                                              IsOn="{x:Bind ViewModel.PostMeetingHookEnabled, Mode=TwoWay}"
                                              AutomationProperties.Name="Run a post-meeting program"
                                              AutomationProperties.AutomationId="PostMeetingHookToggle" />
                            </Grid>
                            <Border Style="{StaticResource DividerStyle}" />
                            <Grid ColumnDefinitions="*,Auto" Padding="20,14" ColumnSpacing="16">
                                <StackPanel MinWidth="0">
                                    <TextBlock Text="Program path" Style="{StaticResource RowTitleStyle}" />
                                    <TextBlock Text="Full path to an .exe on this PC." Style="{StaticResource RowHelpStyle}" />
                                </StackPanel>
                                <TextBox Grid.Column="1"
                                         Style="{StaticResource ValueBoxStyle}"
                                         Text="{x:Bind ViewModel.PostMeetingHookExecutablePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{x:Bind ViewModel.PostMeetingHookEnabled, Mode=OneWay}"
                                         PlaceholderText="C:\Tools\publish-notes.exe"
                                         AutomationProperties.Name="Post-meeting program path"
                                         AutomationProperties.HelpText="Enable Run a post-meeting program to set a path."
                                         AutomationProperties.AutomationId="PostMeetingHookPath" />
                            </Grid>
                            <Border Style="{StaticResource DividerStyle}" />
                            <Grid ColumnDefinitions="*,Auto" Padding="20,14" ColumnSpacing="16">
                                <StackPanel MinWidth="0">
                                    <TextBlock Text="Program timeout" Style="{StaticResource RowTitleStyle}" />
                                    <TextBlock Text="Seconds before Muesli stops waiting for the program." Style="{StaticResource RowHelpStyle}" />
                                </StackPanel>
                                <NumberBox Grid.Column="1"
                                           Value="{x:Bind ViewModel.PostMeetingHookTimeoutSeconds, Mode=TwoWay}"
                                           IsEnabled="{x:Bind ViewModel.PostMeetingHookEnabled, Mode=OneWay}"
                                           Minimum="1" Maximum="600" Width="130"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"
                                           SpinButtonPlacementMode="Compact"
                                           AutomationProperties.Name="Post-meeting program timeout in seconds"
                                           AutomationProperties.HelpText="Enable Run a post-meeting program to change the timeout."
                                           AutomationProperties.AutomationId="PostMeetingHookTimeout" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- APPEARANCE -->
                <StackPanel x:Name="AppearancePanel" Spacing="14" Visibility="Collapsed">
                    <TextBlock Text="APPEARANCE" Style="{StaticResource MuesliSectionLabelStyle}" />
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel>
                            <Grid ColumnDefinitions="*,Auto" Padding="20,14" ColumnSpacing="16">
                                <StackPanel MinWidth="0">
                                    <TextBlock Text="App theme" Style="{StaticResource RowTitleStyle}" />
                                    <TextBlock Text="Follow Windows or choose a theme for Muesli." Style="{StaticResource RowHelpStyle}" />
                                </StackPanel>
                                <ComboBox Grid.Column="1"
                                          Style="{StaticResource PickerStyle}"
                                          SelectedIndex="{x:Bind ViewModel.ThemeIndex, Mode=TwoWay}"
                                          AutomationProperties.Name="App theme"
                                          AutomationProperties.AutomationId="ThemePicker">
                                    <ComboBoxItem Content="Use Windows setting" />
                                    <ComboBoxItem Content="Light" />
                                    <ComboBoxItem Content="Dark" />
                                </ComboBox>
                            </Grid>
                            <Border Style="{StaticResource DividerStyle}" />
                            <Grid ColumnDefinitions="*,Auto" Padding="20,13">
                                <StackPanel MinWidth="0">
                                    <TextBlock Text="Floating dictation indicator" Style="{StaticResource RowTitleStyle}" />
                                    <TextBlock Text="Show recording and transcription state above other apps." Style="{StaticResource RowHelpStyle}" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1"
                                              Style="{StaticResource SettingsToggleStyle}"
                                              IsOn="{x:Bind ViewModel.ShowFloatingIndicator, Mode=TwoWay}"
                                              AutomationProperties.Name="Floating dictation indicator"
                                              AutomationProperties.AutomationId="FloatingIndicatorToggle" />
                            </Grid>
                            <Border Style="{StaticResource DividerStyle}" />
                            <Grid ColumnDefinitions="*,Auto" Padding="20,13">
                                <StackPanel MinWidth="0">
                                    <TextBlock Text="Recording sounds" Style="{StaticResource RowTitleStyle}" />
                                    <TextBlock Text="Play a cue when recording starts and stops." Style="{StaticResource RowHelpStyle}" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1"
                                              Style="{StaticResource SettingsToggleStyle}"
                                              IsOn="{x:Bind ViewModel.SoundEnabled, Mode=TwoWay}"
                                              AutomationProperties.Name="Recording sounds"
                                              AutomationProperties.AutomationId="SoundToggle" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

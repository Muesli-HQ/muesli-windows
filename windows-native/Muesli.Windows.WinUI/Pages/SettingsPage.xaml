                                    <TextBlock Text="Browser automation" Style="{StaticResource RowTitleStyle}" />
                                    <TextBlock Text="Loopback DevTools drives a browser you already started with remote debugging enabled." Style="{StaticResource RowHelpStyle}" />
                                </StackPanel>
                                <ComboBox Grid.Column="1"
                                          Style="{StaticResource PickerStyle}"
                                          SelectedIndex="{x:Bind ViewModel.ComputerUseBrowserInterfaceIndex, Mode=TwoWay}"
                                          AutomationProperties.Name="Browser automation"
                                          AutomationProperties.AutomationId="ComputerUseBrowserInterface">
                                    <ComboBoxItem Content="Disabled" />
                                    <ComboBoxItem Content="Loopback DevTools" />
                                </ComboBox>
                            </Grid>
                            <Border Style="{StaticResource DividerStyle}" />
                            <Grid ColumnDefinitions="*,Auto" Padding="20,14" ColumnSpacing="16">
                                <StackPanel MinWidth="0">
                                    <TextBlock Text="Loopback DevTools endpoint" Style="{StaticResource RowTitleStyle}" />
                                    <TextBlock Text="Must stay on this machine's loopback address." Style="{StaticResource RowHelpStyle}" />
                                </StackPanel>
                                <TextBox Grid.Column="1"
                                         Style="{StaticResource ValueBoxStyle}"
                                         Text="{x:Bind ViewModel.ComputerUseBrowserEndpoint, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="Loopback DevTools endpoint"
                                         AutomationProperties.AutomationId="ComputerUseBrowserEndpoint" />
                            </Grid>
                            <Border Style="{StaticResource DividerStyle}" />
                            <Grid ColumnDefinitions="*,Auto" Padding="20,14" ColumnSpacing="16">
                                <StackPanel MinWidth="0">
                                    <TextBlock Text="Allowed HTTPS origins" Style="{StaticResource RowTitleStyle}" />

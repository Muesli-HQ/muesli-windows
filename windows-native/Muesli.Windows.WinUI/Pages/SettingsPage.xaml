                                         AutomationProperties.Name="Allowed HTTPS origins"
                                         AutomationProperties.AutomationId="ComputerUseAllowedDomains" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="EXPLICIT VOICE SESSION" Style="{StaticResource MuesliSectionLabelStyle}" />
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel Spacing="12" Padding="20,18">
                            <TextBlock Text="Press Ctrl + Shift + F8 anywhere in Windows to start or finish a spoken command. The shortcut is registered while Muesli runs and is not configurable."
                                       Style="{StaticResource RowHelpStyle}"
                                       Margin="0"
                                       AutomationProperties.AutomationId="ComputerUseShortcutNotice" />
                            <StackPanel x:Name="ComputerUseActions" Orientation="Horizontal" Spacing="8">
                                <Button Command="{x:Bind ViewModel.SpeakComputerUseCommand}"
                                        Content="{x:Bind ViewModel.ComputerUseVoiceLabel, Mode=OneWay}"
                                        Style="{StaticResource MuesliPrimaryButtonStyle}"
                                        AutomationProperties.AutomationId="ComputerUseSpeakButton" />
                                <Button Command="{x:Bind ViewModel.StopComputerUseCommand}"
                                        Content="Stop"
                                        IsEnabled="{x:Bind ViewModel.ComputerUseStopEnabled, Mode=OneWay}"
                                        AutomationProperties.AutomationId="ComputerUseStopButton" />
                                <Button Command="{x:Bind ViewModel.OpenComputerUseDiagnosticsCommand}"
                                        Content="Open trace diagnostics"
                                        AutomationProperties.AutomationId="ComputerUseDiagnosticsButton" />
                                <Button Command="{x:Bind ViewModel.PreviewComputerUseConfirmationCommand}"
                                        Content="Preview confirmation"
                                        AutomationProperties.AutomationId="ComputerUsePreviewConfirmationButton" />
                            </StackPanel>
                            <TextBlock Text="{x:Bind ViewModel.ComputerUseStatus, Mode=OneWay}"
                                       Style="{StaticResource RowHelpStyle}"
                                       AutomationProperties.LiveSetting="Polite"
                                       AutomationProperties.AutomationId="ComputerUseStatusText" />
                            <!-- Redacted trace text; technical by nature, so it is kept inside an
                                 explicitly opened expander rather than in the normal flow (P5-06). -->
                            <Expander HorizontalAlignment="Stretch"
                                      HorizontalContentAlignment="Stretch"
                                      Header="Redacted run trace"
                                      AutomationProperties.AutomationId="ComputerUseDiagnosticsExpander">
                                <TextBlock Text="{x:Bind ViewModel.ComputerUseDiagnostics, Mode=OneWay}"
                                           FontFamily="Consolas"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           IsTextSelectionEnabled="True"
                                           AutomationProperties.AutomationId="ComputerUseDiagnosticsText" />
                            </Expander>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- MEETINGS -->
                <StackPanel x:Name="MeetingsPanel" Spacing="14" Visibility="Collapsed">
                    <TextBlock Text="TRANSCRIPTION" Style="{StaticResource MuesliSectionLabelStyle}" />
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel>
                            <Grid ColumnDefinitions="*,Auto" Padding="20,14" ColumnSpacing="16">
                                <StackPanel MinWidth="0">
                                    <TextBlock Text="Microphone" Style="{StaticResource RowTitleStyle}" />
                                    <TextBlock Text="Only affects Muesli. Automatic uses the Windows default input." Style="{StaticResource RowHelpStyle}" />
                                </StackPanel>
                                <ComboBox Grid.Column="1"
                                          Style="{StaticResource PickerStyle}"
                                          ItemsSource="{x:Bind ViewModel.Microphones, Mode=OneWay}"
                                          SelectedItem="{x:Bind ViewModel.SelectedMicrophone, Mode=TwoWay}"
                                          AutomationProperties.Name="Meeting microphone"
                                          AutomationProperties.AutomationId="MeetingMicrophonePicker" />
                            </Grid>
                            <Border Style="{StaticResource DividerStyle}" />
                            <Grid ColumnDefinitions="*,Auto" Padding="20,13">
                                <StackPanel MinWidth="0">
                                    <TextBlock Text="Show transcript on hover" Style="{StaticResource RowTitleStyle}" />
                                    <TextBlock Text="Show the recent transcript beside the live waveform." Style="{StaticResource RowHelpStyle}" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1"
                                              Style="{StaticResource SettingsToggleStyle}"
                                              IsOn="{x:Bind ViewModel.ShowLiveWaveformOnHover, Mode=TwoWay}"
                                              AutomationProperties.Name="Show transcript on hover"
                                              AutomationProperties.AutomationId="LiveWaveformToggle" />
                            </Grid>
                            <Border Style="{StaticResource DividerStyle}" />
                            <Grid ColumnDefinitions="*,Auto" Padding="20,14" ColumnSpacing="16">
                                <StackPanel MinWidth="0">
                                    <TextBlock Text="Live preview model" Style="{StaticResource RowTitleStyle}" />
                                    <TextBlock Text="Creates the live transcript while recording." Style="{StaticResource RowHelpStyle}" />
                                </StackPanel>
                                <ComboBox Grid.Column="1"
                                          Style="{StaticResource PickerStyle}"
                                          ItemsSource="{x:Bind ViewModel.LiveModels, Mode=OneWay}"
                                          SelectedItem="{x:Bind ViewModel.SelectedLiveModel, Mode=TwoWay}"
                                          PlaceholderText="Off"
                                          AutomationProperties.Name="Live preview model"
                                          AutomationProperties.AutomationId="LiveMeetingModelPicker" />
                            </Grid>
                            <Border Style="{StaticResource DividerStyle}" />
                            <Grid ColumnDefinitions="*,Auto" Padding="20,14" ColumnSpacing="16">
                                <StackPanel MinWidth="0">
                                    <TextBlock Text="Final transcript" Style="{StaticResource RowTitleStyle}" />
                                    <TextBlock Text="Used after recorded meetings and for imported audio." Style="{StaticResource RowHelpStyle}" />
                                </StackPanel>
                                <ComboBox Grid.Column="1"
                                          Style="{StaticResource PickerStyle}"
                                          ItemsSource="{x:Bind ViewModel.MeetingModels, Mode=OneWay}"
                                          SelectedItem="{x:Bind ViewModel.SelectedMeetingModel, Mode=TwoWay}"
                                          AutomationProperties.Name="Final transcript model"
                                          AutomationProperties.AutomationId="MeetingModelPicker" />
                            </Grid>
                            <Border Style="{StaticResource DividerStyle}" />
                            <Grid ColumnDefinitions="*,Auto" Padding="20,14" ColumnSpacing="16">
                                <StackPanel MinWidth="0">
                                    <TextBlock Text="Final transcript ownership" Style="{StaticResource RowTitleStyle}" />
                                    <TextBlock Text="Preview-only saves the final model. Unified keeps live output and uses the final model for measured gaps." Style="{StaticResource RowHelpStyle}" />
                                </StackPanel>
                                <ComboBox Grid.Column="1"
                                          Style="{StaticResource PickerStyle}"
                                          SelectedIndex="{x:Bind ViewModel.LiveOwnershipIndex, Mode=TwoWay}"
                                          AutomationProperties.Name="Final transcript ownership"
                                          AutomationProperties.AutomationId="LiveOwnershipPicker">
                                    <ComboBoxItem Content="Preview-only" />
                                    <ComboBoxItem Content="Unified live + final" />
                                </ComboBox>
                            </Grid>
                            <Border Style="{StaticResource DividerStyle}" />
                            <Grid ColumnDefinitions="*,Auto" Padding="20,13">
                                <StackPanel MinWidth="0">
                                    <TextBlock Text="Detect supported meetings" Style="{StaticResource RowTitleStyle}" />
                                    <TextBlock Text="Offer to record when a supported meeting app becomes active." Style="{StaticResource RowHelpStyle}" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1"
                                              Style="{StaticResource SettingsToggleStyle}"
                                              IsOn="{x:Bind ViewModel.AutoMeetingDetectionEnabled, Mode=TwoWay}"
                                              AutomationProperties.Name="Detect supported meetings"
                                              AutomationProperties.AutomationId="MeetingDetectionToggle" />
                            </Grid>
                            <Border Style="{StaticResource DividerStyle}" />
                            <Grid ColumnDefinitions="*,Auto" Padding="20,13">
                                <StackPanel MinWidth="0">
                                    <TextBlock Text="Save meeting recordings" Style="{StaticResource RowTitleStyle}" />
                                    <TextBlock Text="Keep source audio for playback and retranscription." Style="{StaticResource RowHelpStyle}" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1"
                                              Style="{StaticResource SettingsToggleStyle}"
                                              IsOn="{x:Bind ViewModel.SaveMeetingRecordings, Mode=TwoWay}"
                                              AutomationProperties.Name="Save meeting recordings"
                                              AutomationProperties.AutomationId="SaveMeetingRecordingsToggle" />
                            </Grid>
                            <!-- P5-11: capture and detection state used to float between the cards as
                                 two loose lines. They belong to this card, so they render as its
                                 final row with a live region for screen readers. -->

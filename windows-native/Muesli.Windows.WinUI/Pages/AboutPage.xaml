<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Muesli.Windows.WinUI.Pages.AboutPage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Muesli.Windows.WinUI.Pages"
    IsTabStop="True"
    XYFocusKeyboardNavigation="Enabled"
    UseSystemFocusVisuals="True">
    <Page.Resources>
        <!-- macOS AboutView: aboutCard (padding 20, cornerMedium), sectionHeader (11 semibold caps). -->
        <Style x:Key="AboutCardStyle" TargetType="Border" BasedOn="{StaticResource MuesliSettingsGroupStyle}">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="20,12" />
        </Style>
        <Style x:Key="AboutSectionLabelStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource MuesliFontFamilySemiBold}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="CharacterSpacing" Value="40" />
            <Setter Property="Foreground" Value="{ThemeResource MuesliTextTertiaryBrush}" />
            <Setter Property="Margin" Value="2,8,0,-4" />
        </Style>
        <Style x:Key="AboutRowStyle" TargetType="Grid">
            <Setter Property="Padding" Value="0,8" />
            <Setter Property="ColumnSpacing" Value="16" />
            <Setter Property="MinHeight" Value="44" />
        </Style>
        <Style x:Key="AboutRowTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{ThemeResource MuesliTextPrimaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="AboutCaptionStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource MuesliTextTertiaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="AboutPathStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas, Cascadia Mono, monospace" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource MuesliTextTertiaryBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="IsTextSelectionEnabled" Value="True" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="AboutDividerStyle" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{ThemeResource MuesliBorderSoftBrush}" />
        </Style>
        <!-- macOS actionButton: fixed 136 wide, 13 medium, cornerSmall. -->
        <Style x:Key="AboutActionStyle" TargetType="Button" BasedOn="{StaticResource MuesliSecondaryButtonStyle}">
            <Setter Property="Width" Value="136" />
            <Setter Property="Height" Value="32" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="AboutPrimaryActionStyle" TargetType="Button" BasedOn="{StaticResource MuesliPrimaryButtonStyle}">
            <Setter Property="Width" Value="136" />
            <Setter Property="Height" Value="32" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Page.Resources>

    <Grid Background="{ThemeResource MuesliBackgroundBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      TabNavigation="Cycle">
            <StackPanel x:Name="ContentRoot"
                        Padding="{StaticResource MuesliPageContentPadding}"
                        Spacing="12">

                <TextBlock Text="About" Style="{StaticResource MuesliPageTitleStyle}" />

                <!-- App info -->
                <TextBlock Text="APP INFO" Style="{StaticResource AboutSectionLabelStyle}" />
                <Border Style="{StaticResource AboutCardStyle}"
                        AutomationProperties.Name="Application information">
                    <StackPanel>
                        <Grid Style="{StaticResource AboutRowStyle}" ColumnDefinitions="*,Auto">
                            <TextBlock Text="Version" Style="{StaticResource AboutRowTitleStyle}" />
                            <TextBlock Grid.Column="1"
                                       Text="{x:Bind ViewModel.Version, Mode=OneWay}"
                                       FontFamily="Consolas, Cascadia Mono, monospace"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       IsTextSelectionEnabled="True"
                                       ToolTipService.ToolTip="{x:Bind ViewModel.VersionTooltip, Mode=OneWay}"
                                       AutomationProperties.Name="Product version"
                                       AutomationProperties.AutomationId="AboutVersionValue" />
                        </Grid>
                        <Border Style="{StaticResource AboutDividerStyle}" />
                        <Grid Style="{StaticResource AboutRowStyle}" ColumnDefinitions="Auto,*,Auto">
                            <TextBlock Text="Updates" Style="{StaticResource AboutRowTitleStyle}" />
                            <TextBlock Grid.Column="1"
                                       Text="{x:Bind ViewModel.UpdateStatus, Mode=OneWay}"
                                       FontSize="13"
                                       Foreground="{ThemeResource MuesliTextSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       TextAlignment="Right"
                                       VerticalAlignment="Center"
                                       AutomationProperties.Name="Update status"
                                       AutomationProperties.AutomationId="UpdateStatusText" />
                            <Button Grid.Column="2"
                                    Style="{StaticResource AboutActionStyle}"
                                    Command="{x:Bind ViewModel.CheckForUpdatesCommand}"
                                    IsEnabled="{x:Bind local:AboutPage.Not(ViewModel.IsBusy), Mode=OneWay}"
                                    AutomationProperties.Name="Check for updates"
                                    AutomationProperties.AutomationId="CheckForUpdatesButton">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE895;" FontSize="11" />
                                    <TextBlock Text="Check now" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Support -->
                <TextBlock Text="SUPPORT" Style="{StaticResource AboutSectionLabelStyle}" />
                <Border Style="{StaticResource AboutCardStyle}"
                        AutomationProperties.Name="Support">
                    <StackPanel>
                        <Grid Style="{StaticResource AboutRowStyle}" ColumnDefinitions="*,Auto">
                            <TextBlock Text="Support Development" Style="{StaticResource AboutRowTitleStyle}" />
                            <Button Grid.Column="1"
                                    Style="{StaticResource AboutPrimaryActionStyle}"
                                    Background="{ThemeResource MuesliSuccessBrush}"
                                    Foreground="White"
                                    HorizontalContentAlignment="Center"
                                    Click="Donate_Click"
                                    AutomationProperties.Name="Donate"
                                    AutomationProperties.AutomationId="DonateButton">
                                <Button.Resources>
                                    <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="MuesliSuccessBrush" />
                                    <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="MuesliSuccessBrush" />
                                    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White" />
                                    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="White" />
                                </Button.Resources>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xEB52;" FontSize="11" />
                                    <TextBlock Text="Donate" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <Border Style="{StaticResource AboutDividerStyle}" />
                        <Grid Style="{StaticResource AboutRowStyle}" ColumnDefinitions="*,Auto">
                            <TextBlock Text="Source Code" Style="{StaticResource AboutRowTitleStyle}" />
                            <Button Grid.Column="1"
                                    Style="{StaticResource AboutActionStyle}"
                                    Click="GitHub_Click"
                                    AutomationProperties.Name="Open source code on GitHub"
                                    AutomationProperties.AutomationId="GitHubButton">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8A7;" FontSize="11" />
                                    <TextBlock Text="GitHub" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <Border Style="{StaticResource AboutDividerStyle}" />
                        <Grid Style="{StaticResource AboutRowStyle}" ColumnDefinitions="*,Auto">
                            <TextBlock Text="Report a Problem" Style="{StaticResource AboutRowTitleStyle}" />
                            <Button x:Name="ExportSupportBundleButton"
                                    Grid.Column="1"
                                    Style="{StaticResource AboutActionStyle}"
                                    Click="OpenReport_Click"
                                    IsEnabled="{x:Bind local:AboutPage.Not(ViewModel.IsBusy), Mode=OneWay}"
                                    ToolTipService.ToolTip="Prepare an anonymized GitHub issue, or preview a support bundle. Transcripts and secrets are never included."
                                    AutomationProperties.Name="Report a problem"
                                    AutomationProperties.AutomationId="ExportSupportBundleButton">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8BD;" FontSize="11" />
                                    <TextBlock Text="Open Report" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <Border Style="{StaticResource AboutDividerStyle}" />
                        <Grid Style="{StaticResource AboutRowStyle}" ColumnDefinitions="*,Auto">
                            <TextBlock Text="Automatic issue reporting prompts" Style="{StaticResource AboutRowTitleStyle}" />
                            <ToggleSwitch x:Name="AutoReportToggle"
                                          Grid.Column="1"
                                          OnContent="" OffContent="" MinWidth="0"
                                          Toggled="AutoReportToggle_Toggled"
                                          ToolTipService.ToolTip="Suggest an anonymized GitHub issue after an app error"
                                          AutomationProperties.Name="Automatic issue reporting prompts"
                                          AutomationProperties.AutomationId="AutoReportToggle" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Spread the Word: macOS shows it once a 1,000-word dictation milestone is reached -->
                <TextBlock Text="SPREAD THE WORD"
                           Style="{StaticResource AboutSectionLabelStyle}"
                           Visibility="{x:Bind local:AboutPage.BoolToVisibility(ViewModel.CanShare), Mode=OneWay}" />
                <Border Style="{StaticResource AboutCardStyle}"
                        Visibility="{x:Bind local:AboutPage.BoolToVisibility(ViewModel.CanShare), Mode=OneWay}"
                        AutomationProperties.Name="Spread the word">
                    <Grid Style="{StaticResource AboutRowStyle}" ColumnDefinitions="*,Auto">
                        <TextBlock Text="Share Muesli" Style="{StaticResource AboutRowTitleStyle}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <HyperlinkButton Content="Post on X"
                                             Padding="0"
                                             FontSize="13"
                                             Click="PostOnX_Click"
                                             AutomationProperties.AutomationId="ShareOnXButton" />
                            <HyperlinkButton Content="LinkedIn"
                                             Padding="0"
                                             FontSize="13"
                                             Click="PostOnLinkedIn_Click"
                                             AutomationProperties.AutomationId="ShareOnLinkedInButton" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Data -->
                <TextBlock Text="DATA" Style="{StaticResource AboutSectionLabelStyle}" />
                <Border Style="{StaticResource AboutCardStyle}"
                        AutomationProperties.Name="Local profile paths">
                    <StackPanel Spacing="12" Padding="0,8">
                        <TextBlock Text="App Data Directory" Style="{StaticResource AboutRowTitleStyle}" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                            <TextBlock Text="{x:Bind ViewModel.ProfilePath, Mode=OneWay}"
                                       Style="{StaticResource AboutPathStyle}"
                                       ToolTipService.ToolTip="{x:Bind ViewModel.ProfilePath, Mode=OneWay}"
                                       AutomationProperties.Name="Local profile path"
                                       AutomationProperties.AutomationId="LocalProfilePath" />
                            <Button Grid.Column="1"
                                    Style="{StaticResource AboutActionStyle}"
                                    Command="{x:Bind ViewModel.OpenDataDirectoryCommand}"
                                    AutomationProperties.Name="Open app data directory"
                                    AutomationProperties.AutomationId="OpenDataDirectoryButton">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE838;" FontSize="11" />
                                    <TextBlock Text="Open" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Acknowledgements: the libraries the Windows build actually runs on -->
                <TextBlock Text="ACKNOWLEDGEMENTS" Style="{StaticResource AboutSectionLabelStyle}" />
                <Border Style="{StaticResource AboutCardStyle}"
                        AutomationProperties.Name="Acknowledgements">
                    <StackPanel>
                        <StackPanel Spacing="4" Padding="0,10">
                            <TextBlock Text="sherpa-onnx by k2-fsa" Style="{StaticResource AboutRowTitleStyle}" FontWeight="SemiBold" FontSize="13" />
                            <TextBlock Text="ONNX speech stack powering Parakeet, Whisper and the other local models, voice activity detection, and speaker diarization."
                                       Style="{StaticResource AboutCaptionStyle}" />
                        </StackPanel>
                        <Border Style="{StaticResource AboutDividerStyle}" />
                        <StackPanel Spacing="4" Padding="0,10">
                            <TextBlock Text="LLamaSharp and llama.cpp" Style="{StaticResource AboutRowTitleStyle}" FontWeight="SemiBold" FontSize="13" />
                            <TextBlock Text="On-device GGUF inference powering local dictation cleanup."
                                       Style="{StaticResource AboutCaptionStyle}" />
                        </StackPanel>
                        <Border Style="{StaticResource AboutDividerStyle}" />
                        <StackPanel Spacing="4" Padding="0,10">
                            <TextBlock Text="NAudio by Mark Heath" Style="{StaticResource AboutRowTitleStyle}" FontWeight="SemiBold" FontSize="13" />
                            <TextBlock Text="Windows audio capture for the microphone and meeting system audio."
                                       Style="{StaticResource AboutCaptionStyle}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <InfoBar IsOpen="{x:Bind ViewModel.IsStatusOpen, Mode=TwoWay}"
                         Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                         Severity="{x:Bind local:AboutPage.StatusSeverity(ViewModel.IsStatusError), Mode=OneWay}"
                         IsClosable="True"
                         AutomationProperties.AutomationId="AboutStatus" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

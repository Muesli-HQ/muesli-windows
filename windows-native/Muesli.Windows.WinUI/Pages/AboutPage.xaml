<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Muesli.Windows.WinUI.Pages.AboutPage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Muesli.Windows.WinUI.Pages"
    IsTabStop="True"
    XYFocusKeyboardNavigation="Enabled"
    UseSystemFocusVisuals="True">
    <Page.Resources>
        <!-- macOS AboutView: aboutCard (padding 20, cornerMedium), sectionHeader (11 semibold caps). -->
        <Style x:Key="AboutCardStyle" TargetType="Border" BasedOn="{StaticResource MuesliSettingsGroupStyle}">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="20,12" />
        </Style>
        <Style x:Key="AboutSectionLabelStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource MuesliFontFamilySemiBold}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="CharacterSpacing" Value="40" />
            <Setter Property="Foreground" Value="{ThemeResource MuesliTextTertiaryBrush}" />
            <Setter Property="Margin" Value="2,8,0,-4" />
        </Style>
        <Style x:Key="AboutRowStyle" TargetType="Grid">
            <Setter Property="Padding" Value="0,8" />
            <Setter Property="ColumnSpacing" Value="16" />
            <Setter Property="MinHeight" Value="44" />
        </Style>
        <Style x:Key="AboutRowTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{ThemeResource MuesliTextPrimaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="AboutCaptionStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource MuesliTextTertiaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="AboutPathStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas, Cascadia Mono, monospace" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource MuesliTextTertiaryBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="IsTextSelectionEnabled" Value="True" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="AboutDividerStyle" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{ThemeResource MuesliBorderSoftBrush}" />
        </Style>
        <!-- macOS actionButton: fixed 136 wide, 13 medium, cornerSmall. -->
        <Style x:Key="AboutActionStyle" TargetType="Button" BasedOn="{StaticResource MuesliSecondaryButtonStyle}">
            <Setter Property="Width" Value="136" />
            <Setter Property="Height" Value="32" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="AboutPrimaryActionStyle" TargetType="Button" BasedOn="{StaticResource MuesliPrimaryButtonStyle}">
            <Setter Property="Width" Value="136" />
            <Setter Property="Height" Value="32" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- The diagnostics disclosure reads as a card row, not a filled Fluent expander. -->
        <SolidColorBrush x:Key="ExpanderHeaderBackground" Color="Transparent" />
        <SolidColorBrush x:Key="ExpanderHeaderBorderBrush" Color="Transparent" />
        <SolidColorBrush x:Key="ExpanderContentBackground" Color="Transparent" />
        <SolidColorBrush x:Key="ExpanderContentBorderBrush" Color="Transparent" />
        <Style x:Key="AboutIconButtonStyle" TargetType="Button" BasedOn="{StaticResource MuesliGhostButtonStyle}">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Page.Resources>

    <Grid Background="{ThemeResource MuesliBackgroundBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      TabNavigation="Cycle">
            <StackPanel x:Name="ContentRoot"
                        Padding="{StaticResource MuesliPageContentPadding}"
                        Spacing="12">

                <TextBlock Text="About" Style="{StaticResource MuesliPageTitleStyle}" />

                <!-- App info -->
                <TextBlock Text="APP INFO" Style="{StaticResource AboutSectionLabelStyle}" />
                <Border Style="{StaticResource AboutCardStyle}"
                        AutomationProperties.Name="Application information">
                    <StackPanel>
                        <Grid Style="{StaticResource AboutRowStyle}" ColumnDefinitions="*,Auto">
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Version" Style="{StaticResource AboutRowTitleStyle}" />
                                <TextBlock Style="{StaticResource AboutCaptionStyle}"
                                           AutomationProperties.AutomationId="AboutRuntimeVersionValue">
                                    <Run Text="Assembly" />
                                    <Run Text="{x:Bind ViewModel.AssemblyVersion, Mode=OneWay}" />
                                    <Run Text="·" />
                                    <Run Text="{x:Bind ViewModel.RuntimeVersion, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                            <TextBlock Grid.Column="1"
                                       Text="{x:Bind ViewModel.Version, Mode=OneWay}"
                                       FontFamily="Consolas, Cascadia Mono, monospace"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       IsTextSelectionEnabled="True"
                                       ToolTipService.ToolTip="{x:Bind ViewModel.VersionTooltip, Mode=OneWay}"
                                       AutomationProperties.Name="Product version"
                                       AutomationProperties.AutomationId="AboutVersionValue" />
                        </Grid>
                        <Border Style="{StaticResource AboutDividerStyle}" />
                        <Grid Style="{StaticResource AboutRowStyle}" ColumnDefinitions="Auto,*,Auto">
                            <TextBlock Text="Updates" Style="{StaticResource AboutRowTitleStyle}" />
                            <TextBlock Grid.Column="1"
                                       Text="{x:Bind ViewModel.UpdateStatus, Mode=OneWay}"
                                       FontSize="13"
                                       Foreground="{ThemeResource MuesliTextSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       TextAlignment="Right"
                                       VerticalAlignment="Center"
                                       AutomationProperties.Name="Update status"
                                       AutomationProperties.AutomationId="UpdateStatusText" />
                            <Button Grid.Column="2"
                                    Style="{StaticResource AboutActionStyle}"
                                    Command="{x:Bind ViewModel.CheckForUpdatesCommand}"
                                    IsEnabled="{x:Bind local:AboutPage.Not(ViewModel.IsBusy), Mode=OneWay}"
                                    AutomationProperties.Name="Check for updates"
                                    AutomationProperties.AutomationId="CheckForUpdatesButton">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE895;" FontSize="11" />
                                    <TextBlock Text="Check now" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Setup and tour (Windows only; macOS keeps these in the menu bar) -->
                <TextBlock Text="SETUP" Style="{StaticResource AboutSectionLabelStyle}" />
                <Border Style="{StaticResource AboutCardStyle}"
                        AutomationProperties.Name="Setup and feature tour">
                    <StackPanel>
                        <Grid Style="{StaticResource AboutRowStyle}" ColumnDefinitions="*,Auto">
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Setup" Style="{StaticResource AboutRowTitleStyle}" />
                                <TextBlock Text="Microphone, models and shortcuts."
                                           Style="{StaticResource AboutCaptionStyle}" />
                            </StackPanel>
                            <Button x:Name="ResumeSetupButton"
                                    Grid.Column="1"
                                    Style="{StaticResource AboutPrimaryActionStyle}"
                                    Command="{x:Bind ViewModel.ResumeSetupCommand}"
                                    Content="Resume setup"
                                    AutomationProperties.Name="Resume Muesli setup"
                                    AutomationProperties.AutomationId="ResumeSetupButton" />
                        </Grid>
                        <Border Style="{StaticResource AboutDividerStyle}" />
                        <Grid Style="{StaticResource AboutRowStyle}" ColumnDefinitions="*,Auto">
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Feature tour" Style="{StaticResource AboutRowTitleStyle}" />
                                <TextBlock Text="Dashboard, dictation and meetings in a minute."
                                           Style="{StaticResource AboutCaptionStyle}" />
                            </StackPanel>
                            <Button x:Name="ReplayFeatureTourButton"
                                    Grid.Column="1"
                                    Style="{StaticResource AboutActionStyle}"
                                    Command="{x:Bind ViewModel.ReplayFeatureTourCommand}"
                                    AutomationProperties.Name="Open feature tour"
                                    AutomationProperties.AutomationId="ReplayFeatureTourButton">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE768;" FontSize="11" />
                                    <TextBlock Text="Replay tour" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Data: macOS "App Data Directory" row, plus the other folders this process uses -->
                <TextBlock Text="DATA" Style="{StaticResource AboutSectionLabelStyle}" />
                <Border Style="{StaticResource AboutCardStyle}"
                        AutomationProperties.Name="Local profile paths">
                    <StackPanel>
                        <Grid Style="{StaticResource AboutRowStyle}" ColumnDefinitions="*,Auto">
                            <StackPanel VerticalAlignment="Center" Spacing="4" MinWidth="0">
                                <TextBlock Text="App Data Directory" Style="{StaticResource AboutRowTitleStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.ProfilePath, Mode=OneWay}"
                                           Style="{StaticResource AboutPathStyle}"
                                           ToolTipService.ToolTip="{x:Bind ViewModel.ProfilePath, Mode=OneWay}"
                                           AutomationProperties.Name="Local profile path"
                                           AutomationProperties.AutomationId="LocalProfilePath" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Style="{StaticResource AboutActionStyle}"
                                    Command="{x:Bind ViewModel.OpenDataDirectoryCommand}"
                                    AutomationProperties.Name="Open app data directory"
                                    AutomationProperties.AutomationId="OpenDataDirectoryButton">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE838;" FontSize="11" />
                                    <TextBlock Text="Open" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <Border Style="{StaticResource AboutDividerStyle}" />
                        <Grid Padding="0,10,0,4" ColumnSpacing="12" RowSpacing="2" ColumnDefinitions="96,*,Auto">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="28" />
                                <RowDefinition Height="28" />
                                <RowDefinition Height="28" />
                                <RowDefinition Height="28" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Data" Style="{StaticResource AboutCaptionStyle}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Text="{x:Bind ViewModel.DataDirectory, Mode=OneWay}"
                                       Style="{StaticResource AboutPathStyle}"
                                       ToolTipService.ToolTip="{x:Bind ViewModel.DataDirectory, Mode=OneWay}"
                                       AutomationProperties.Name="Data directory path"
                                       AutomationProperties.AutomationId="DataDirectoryPath" />

                            <TextBlock Grid.Row="1" Text="Settings" Style="{StaticResource AboutCaptionStyle}" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="1"
                                       Grid.Column="1"
                                       Text="{x:Bind ViewModel.SettingsFilePath, Mode=OneWay}"
                                       Style="{StaticResource AboutPathStyle}"
                                       ToolTipService.ToolTip="{x:Bind ViewModel.SettingsFilePath, Mode=OneWay}"
                                       AutomationProperties.Name="Settings file path"
                                       AutomationProperties.AutomationId="SettingsFilePath" />

                            <TextBlock Grid.Row="2" Text="Logs" Style="{StaticResource AboutCaptionStyle}" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="2"
                                       Grid.Column="1"
                                       Text="{x:Bind ViewModel.LogDirectory, Mode=OneWay}"
                                       Style="{StaticResource AboutPathStyle}"
                                       ToolTipService.ToolTip="{x:Bind ViewModel.LogDirectory, Mode=OneWay}"
                                       AutomationProperties.Name="Log directory path"
                                       AutomationProperties.AutomationId="LogDirectoryPath" />
                            <Button Grid.Row="2"
                                    Grid.Column="2"
                                    Style="{StaticResource AboutIconButtonStyle}"
                                    Command="{x:Bind ViewModel.OpenLogsCommand}"
                                    ToolTipService.ToolTip="Open logs"
                                    AutomationProperties.Name="Open Muesli logs"
                                    AutomationProperties.AutomationId="OpenLogsButton">
                                <FontIcon Glyph="&#xE838;" FontSize="12" />
                            </Button>

                            <!--
                                Model weights resolve MUESLI_NATIVE_ASR_CACHE, then the user profile -
                                never the profile-root command line argument the rows above come from.
                            -->
                            <TextBlock Grid.Row="3" Text="Model cache" Style="{StaticResource AboutCaptionStyle}" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="3"
                                       Grid.Column="1"
                                       Text="{x:Bind ViewModel.ModelCachePath, Mode=OneWay}"
                                       Style="{StaticResource AboutPathStyle}"
                                       ToolTipService.ToolTip="Shared between profiles. Set MUESLI_NATIVE_ASR_CACHE to move downloaded model weights."
                                       AutomationProperties.HelpText="Shared between profiles. Set MUESLI_NATIVE_ASR_CACHE to move downloaded model weights."
                                       AutomationProperties.Name="Model cache path"
                                       AutomationProperties.AutomationId="ModelCachePath" />
                            <Button Grid.Row="3"
                                    Grid.Column="2"
                                    Style="{StaticResource AboutIconButtonStyle}"
                                    Command="{x:Bind ViewModel.OpenModelCacheCommand}"
                                    ToolTipService.ToolTip="Open model cache"
                                    AutomationProperties.Name="Open model cache"
                                    AutomationProperties.AutomationId="OpenModelCacheButton">
                                <FontIcon Glyph="&#xE838;" FontSize="12" />
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Diagnostics: the Windows counterpart of macOS "Report a Problem" -->
                <TextBlock Text="DIAGNOSTICS" Style="{StaticResource AboutSectionLabelStyle}" />
                <Border Style="{StaticResource AboutCardStyle}"
                        AutomationProperties.Name="Runtime diagnostics">
                    <StackPanel>
                        <Grid Style="{StaticResource AboutRowStyle}" ColumnDefinitions="*,Auto">
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Report a problem" Style="{StaticResource AboutRowTitleStyle}" />
                                <TextBlock Text="Preview a support bundle before saving it. Transcripts and secrets are never included."
                                           Style="{StaticResource AboutCaptionStyle}" />
                            </StackPanel>
                            <Button x:Name="ExportSupportBundleButton"
                                    Grid.Column="1"
                                    Style="{StaticResource AboutActionStyle}"
                                    Command="{x:Bind ViewModel.ExportSupportBundleCommand}"
                                    IsEnabled="{x:Bind local:AboutPage.Not(ViewModel.IsBusy), Mode=OneWay}"
                                    AutomationProperties.Name="Preview and export a support bundle"
                                    AutomationProperties.AutomationId="ExportSupportBundleButton">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8BD;" FontSize="11" />
                                    <TextBlock Text="Open report" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <Border Style="{StaticResource AboutDividerStyle}" />
                        <!-- The raw environment dump stays one disclosure away. -->
                        <Expander x:Name="DiagnosticsDetail"
                                  Margin="-16,4,-8,4"
                                  HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Stretch"
                                  AutomationProperties.Name="Show runtime diagnostics detail"
                                  AutomationProperties.AutomationId="RuntimeDiagnosticsExpander">
                            <Expander.Header>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <StackPanel VerticalAlignment="Center" Spacing="2" Padding="0,6">
                                        <TextBlock Text="Runtime diagnostics" Style="{StaticResource AboutRowTitleStyle}" />
                                        <TextBlock Text="Environment, package, model and service details."
                                                   Style="{StaticResource AboutCaptionStyle}" />
                                    </StackPanel>
                                    <ProgressRing Grid.Column="1"
                                                  IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                                                  Width="16"
                                                  Height="16"
                                                  AutomationProperties.Name="Refreshing diagnostics" />
                                </Grid>
                            </Expander.Header>
                            <StackPanel Spacing="10">
                                <Border Background="{ThemeResource MuesliBackgroundDeepBrush}"
                                        BorderBrush="{ThemeResource MuesliBorderSoftBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="12,10"
                                        MaxHeight="240">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <TextBlock Text="{x:Bind ViewModel.RuntimeSummary, Mode=OneWay}"
                                                   FontFamily="Consolas, Cascadia Mono, monospace"
                                                   FontSize="12"
                                                   LineHeight="18"
                                                   TextWrapping="Wrap"
                                                   IsTextSelectionEnabled="True"
                                                   AutomationProperties.AutomationId="RuntimeDiagnosticsText" />
                                    </ScrollViewer>
                                </Border>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="RefreshDiagnosticsButton"
                                            Style="{StaticResource AboutActionStyle}"
                                            Command="{x:Bind ViewModel.RefreshCommand}"
                                            IsEnabled="{x:Bind local:AboutPage.Not(ViewModel.IsBusy), Mode=OneWay}"
                                            AutomationProperties.Name="Refresh diagnostics"
                                            AutomationProperties.AutomationId="RefreshDiagnosticsButton">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE72C;" FontSize="11" />
                                            <TextBlock Text="Refresh" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="CopyDiagnosticsButton"
                                            Style="{StaticResource AboutActionStyle}"
                                            Command="{x:Bind ViewModel.CopyDiagnosticsCommand}"
                                            AutomationProperties.Name="Copy diagnostics"
                                            AutomationProperties.AutomationId="CopyDiagnosticsButton">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE8C8;" FontSize="11" />
                                            <TextBlock Text="Copy" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </Border>

                <InfoBar IsOpen="{x:Bind ViewModel.IsStatusOpen, Mode=TwoWay}"
                         Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                         Severity="{x:Bind local:AboutPage.StatusSeverity(ViewModel.IsStatusError), Mode=OneWay}"
                         IsClosable="True"
                         AutomationProperties.AutomationId="AboutStatus" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

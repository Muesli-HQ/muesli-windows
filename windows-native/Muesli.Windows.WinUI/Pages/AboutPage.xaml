<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Muesli.Windows.WinUI.Pages.AboutPage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Muesli.Windows.WinUI.Pages"
    IsTabStop="True"
    XYFocusKeyboardNavigation="Enabled"
    UseSystemFocusVisuals="True">
    <Page.Resources>
        <Style x:Key="AboutRowTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource MuesliRowTitleStyle}">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextTrimming" Value="None" />
        </Style>
        <Style x:Key="AboutRowHelpStyle" TargetType="TextBlock" BasedOn="{StaticResource MuesliBodyStyle}">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,3,0,0" />
        </Style>
        <Style x:Key="AboutMonoValueStyle" TargetType="TextBlock" BasedOn="{StaticResource MuesliTimestampStyle}">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{ThemeResource MuesliTextPrimaryBrush}" />
            <Setter Property="TextWrapping" Value="WrapWholeWords" />
            <Setter Property="IsTextSelectionEnabled" Value="True" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="AboutPathStyle" TargetType="TextBlock" BasedOn="{StaticResource MuesliTimestampStyle}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource MuesliTextPrimaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="IsTextSelectionEnabled" Value="True" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="MinWidth" Value="0" />
        </Style>
        <Style x:Key="AboutDividerStyle" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{ThemeResource MuesliBorderSoftBrush}" />
            <Setter Property="Margin" Value="16,0" />
        </Style>
        <Style x:Key="AboutRowButtonStyle" TargetType="Button" BasedOn="{StaticResource MuesliSecondaryButtonStyle}">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Page.Resources>

    <Grid Background="{ThemeResource MuesliBackgroundBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      TabNavigation="Cycle">
            <!-- P7-07: one shared reading-width cap instead of this page's private 760/720 pair.
                 HorizontalAlignment must stay Left - Stretch + MaxWidth centres the column and
                 breaks the shared page gutter (P1-04). -->
            <StackPanel x:Name="ContentRoot"
                        Padding="{StaticResource MuesliPageContentPadding}"
                        Spacing="12"
                        MaxWidth="{StaticResource MuesliPageContentMaxWidth}"
                        HorizontalAlignment="Left">

                <StackPanel Spacing="4">
                    <TextBlock Text="About" Style="{StaticResource MuesliPageTitleStyle}" />
                    <TextBlock Text="Muesli keeps dictation and meeting transcription close to your Windows workspace."
                               Style="{StaticResource MuesliPageSubtitleStyle}" />
                </StackPanel>

                <!-- Branding -->
                <Border Style="{StaticResource MuesliCardStyle}"
                        Padding="16,14"
                        AutomationProperties.Name="Muesli branding">
                    <Grid x:Name="BrandGrid">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="BrandMark"
                                Width="72"
                                Height="72"
                                CornerRadius="18"
                                Background="{ThemeResource MuesliAccentMutedBrush}"
                                VerticalAlignment="Top">
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Spacing="4">
                                <Border Width="5" Height="18" CornerRadius="3" Background="{ThemeResource MuesliAccentBrush}" />
                                <Border Width="5" Height="30" CornerRadius="3" Background="{ThemeResource MuesliAccentBrush}" />
                                <Border Width="5" Height="24" CornerRadius="3" Background="{ThemeResource MuesliAccentBrush}" />
                                <Border Width="5" Height="14" CornerRadius="3" Background="{ThemeResource MuesliAccentBrush}" />
                            </StackPanel>
                        </Border>
                        <StackPanel x:Name="BrandCopy"
                                    Grid.Column="1"
                                    Spacing="6"
                                    VerticalAlignment="Center"
                                    MinWidth="0">
                            <TextBlock Text="Muesli"
                                       FontSize="26"
                                       FontWeight="SemiBold"
                                       FontFamily="{StaticResource MuesliFontFamilySemiBold}" />
                            <TextBlock Text="Windows-native dictation and meeting transcription"
                                       Style="{StaticResource MuesliBodyStyle}"
                                       FontSize="14" />
                            <Border Style="{StaticResource MuesliAccentBadgeStyle}"
                                    HorizontalAlignment="Left"
                                    Margin="0,2,0,0"
                                    ToolTipService.ToolTip="{x:Bind ViewModel.VersionTooltip, Mode=OneWay}">
                                <TextBlock Text="{x:Bind ViewModel.Version, Mode=OneWay}"
                                           Style="{StaticResource MuesliAccentBadgeTextStyle}"
                                           AutomationProperties.Name="Application version"
                                           AutomationProperties.AutomationId="AboutVersionBadge" />
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- App info: truthful assembly / runtime identity -->
                <TextBlock Text="APP INFO" Style="{StaticResource MuesliSectionLabelStyle}" />
                <Border Style="{StaticResource MuesliSettingsGroupStyle}"
                        AutomationProperties.Name="Application information">
                    <StackPanel>
                        <Grid Padding="16,10" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Version"
                                       Style="{StaticResource AboutRowTitleStyle}"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Text="{x:Bind ViewModel.Version, Mode=OneWay}"
                                       Style="{StaticResource AboutMonoValueStyle}"
                                       ToolTipService.ToolTip="{x:Bind ViewModel.VersionTooltip, Mode=OneWay}"
                                       AutomationProperties.Name="Product version"
                                       AutomationProperties.AutomationId="AboutVersionValue" />
                        </Grid>
                        <Border Style="{StaticResource AboutDividerStyle}" />
                        <Grid Padding="16,10" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Assembly" Style="{StaticResource AboutRowTitleStyle}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Text="{x:Bind ViewModel.AssemblyVersion, Mode=OneWay}"
                                       Style="{StaticResource AboutMonoValueStyle}"
                                       AutomationProperties.Name="Assembly version"
                                       AutomationProperties.AutomationId="AboutAssemblyVersionValue" />
                        </Grid>
                        <Border Style="{StaticResource AboutDividerStyle}" />
                        <Grid Padding="16,10" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Runtime" Style="{StaticResource AboutRowTitleStyle}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Text="{x:Bind ViewModel.RuntimeVersion, Mode=OneWay}"
                                       Style="{StaticResource AboutMonoValueStyle}"
                                       TextWrapping="Wrap"
                                       AutomationProperties.Name="Runtime version"
                                       AutomationProperties.AutomationId="AboutRuntimeVersionValue" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Setup and tour: existing commands only -->
                <TextBlock Text="SETUP AND TOUR" Style="{StaticResource MuesliSectionLabelStyle}" />
                <Border Style="{StaticResource MuesliSettingsGroupStyle}"
                        AutomationProperties.Name="Setup and feature tour">
                    <StackPanel>
                        <Grid Padding="16,10" ColumnSpacing="16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel x:Name="ResumeSetupCopy" MinWidth="0">
                                <TextBlock Text="Resume setup" Style="{StaticResource AboutRowTitleStyle}" />
                                <TextBlock Text="Review microphone, models, shortcuts, and the main Muesli workflow."
                                           Style="{StaticResource AboutRowHelpStyle}" />
                            </StackPanel>
                            <Button x:Name="ResumeSetupButton"
                                    Grid.Column="1"
                                    Style="{StaticResource MuesliPrimaryButtonStyle}"
                                    Command="{x:Bind ViewModel.ResumeSetupCommand}"
                                    Content="Resume setup"
                                    AutomationProperties.Name="Resume Muesli setup"
                                    AutomationProperties.AutomationId="ResumeSetupButton" />
                        </Grid>
                        <Border Style="{StaticResource AboutDividerStyle}" />
                        <Grid Padding="16,10" ColumnSpacing="16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel x:Name="ReplayTourCopy" MinWidth="0">
                                <TextBlock Text="Feature tour" Style="{StaticResource AboutRowTitleStyle}" />
                                <TextBlock Text="Replay the in-app tour of the dashboard, dictation, and meetings."
                                           Style="{StaticResource AboutRowHelpStyle}" />
                            </StackPanel>
                            <Button x:Name="ReplayFeatureTourButton"
                                    Grid.Column="1"
                                    Style="{StaticResource AboutRowButtonStyle}"
                                    Command="{x:Bind ViewModel.ReplayFeatureTourCommand}"
                                    Content="Replay tour"
                                    AutomationProperties.Name="Open feature tour"
                                    AutomationProperties.AutomationId="ReplayFeatureTourButton" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Isolated profile paths: wrap in-card, tooltip carries the full string -->
                <StackPanel Spacing="4">
                    <TextBlock Text="LOCAL PROFILE" Style="{StaticResource MuesliSectionLabelStyle}" />
                    <!--
                        The old copy claimed "Model cache follows the active profile", which is not
                        true of the profile this page reports. TranscriptionModelCatalog.
                        ModelCacheDirectory resolves MUESLI_NATIVE_ASR_CACHE, then
                        MuesliPathService.UserProfileDirectory - which reads only the
                        MUESLI_PROFILE_ROOT environment variable, never the profile-root command
                        line argument the rest of these rows come from. So a profile passed on the
                        command line moves the library but leaves the weights where they were.
                    -->
                    <TextBlock Text="Directories this process is using. Model weights sit outside the profile and are shared between profiles."
                               Style="{StaticResource MuesliBodyStyle}" />
                </StackPanel>
                <Border Style="{StaticResource MuesliSettingsGroupStyle}"
                        AutomationProperties.Name="Local profile paths">
                    <StackPanel>
                        <Grid Padding="16,8" ColumnSpacing="16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ProfileLabel"
                                       Text="Profile"
                                       Style="{StaticResource AboutRowTitleStyle}" />
                            <TextBlock x:Name="ProfileValue"
                                       Grid.Column="1"
                                       Text="{x:Bind ViewModel.ProfilePath, Mode=OneWay}"
                                       Style="{StaticResource AboutPathStyle}"
                                       ToolTipService.ToolTip="{x:Bind ViewModel.ProfilePath, Mode=OneWay}"
                                       AutomationProperties.Name="Local profile path"
                                       AutomationProperties.AutomationId="LocalProfilePath" />
                        </Grid>
                        <Border Style="{StaticResource AboutDividerStyle}" />
                        <Grid Padding="16,8" ColumnSpacing="16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="LogsLabel"
                                       Text="Logs"
                                       Style="{StaticResource AboutRowTitleStyle}" />
                            <TextBlock x:Name="LogsValue"
                                       Grid.Column="1"
                                       Text="{x:Bind ViewModel.LogDirectory, Mode=OneWay}"
                                       Style="{StaticResource AboutPathStyle}"
                                       ToolTipService.ToolTip="{x:Bind ViewModel.LogDirectory, Mode=OneWay}"
                                       AutomationProperties.Name="Log directory path"
                                       AutomationProperties.AutomationId="LogDirectoryPath" />
                        </Grid>
                        <Border Style="{StaticResource AboutDividerStyle}" />
                        <Grid Padding="16,8" ColumnSpacing="16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="DataLabel"
                                       Text="Data"
                                       Style="{StaticResource AboutRowTitleStyle}" />
                            <TextBlock x:Name="DataValue"
                                       Grid.Column="1"
                                       Text="{x:Bind ViewModel.DataDirectory, Mode=OneWay}"
                                       Style="{StaticResource AboutPathStyle}"
                                       ToolTipService.ToolTip="{x:Bind ViewModel.DataDirectory, Mode=OneWay}"
                                       AutomationProperties.Name="Data directory path"
                                       AutomationProperties.AutomationId="DataDirectoryPath" />
                        </Grid>
                        <Border Style="{StaticResource AboutDividerStyle}" />
                        <Grid Padding="16,8" ColumnSpacing="16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="SettingsLabel"
                                       Text="Settings"
                                       Style="{StaticResource AboutRowTitleStyle}" />
                            <TextBlock x:Name="SettingsValue"
                                       Grid.Column="1"
                                       Text="{x:Bind ViewModel.SettingsFilePath, Mode=OneWay}"
                                       Style="{StaticResource AboutPathStyle}"
                                       ToolTipService.ToolTip="{x:Bind ViewModel.SettingsFilePath, Mode=OneWay}"
                                       AutomationProperties.Name="Settings file path"
                                       AutomationProperties.AutomationId="SettingsFilePath" />
                        </Grid>
                        <Border Style="{StaticResource AboutDividerStyle}" />
                        <Grid Padding="16,8" ColumnSpacing="16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="CacheLabel"
                                       Text="Model cache"
                                       Style="{StaticResource AboutRowTitleStyle}" />
                            <TextBlock x:Name="CacheValue"
                                       Grid.Column="1"
                                       Text="{x:Bind ViewModel.ModelCachePath, Mode=OneWay}"
                                       Style="{StaticResource AboutPathStyle}"
                                       ToolTipService.ToolTip="Set MUESLI_NATIVE_ASR_CACHE to move downloaded model weights. The profile passed on the command line does not move them."
                                       AutomationProperties.HelpText="Set MUESLI_NATIVE_ASR_CACHE to move downloaded model weights. The profile passed on the command line does not move them."
                                       AutomationProperties.Name="Model cache path"
                                       AutomationProperties.AutomationId="ModelCachePath" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Diagnostics -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <TextBlock Text="DIAGNOSTICS" Style="{StaticResource MuesliSectionLabelStyle}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Text="Local-only details"
                               Style="{StaticResource MuesliBadgeTextStyle}"
                               VerticalAlignment="Center" />
                </Grid>
                <Border Style="{StaticResource MuesliCardStyle}"
                        Padding="16,14"
                        AutomationProperties.Name="Runtime diagnostics">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <StackPanel Spacing="3" MinWidth="0">
                                <TextBlock Text="Runtime diagnostics" Style="{StaticResource AboutRowTitleStyle}" />
                                <TextBlock Text="Environment, package, model, and service information for troubleshooting. Transcripts and secrets are not included."
                                           Style="{StaticResource AboutRowHelpStyle}" />
                            </StackPanel>
                            <ProgressRing Grid.Column="1"
                                          IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                                          Width="22"
                                          Height="22"
                                          VerticalAlignment="Top"
                                          AutomationProperties.Name="Refreshing diagnostics" />
                        </Grid>
                        <!--
                            "Keep technical diagnostics accessible but secondary": the raw
                            environment dump used to sit open in the page flow, making the largest
                            block on About a wall of monospace. It is one keyboard-reachable
                            disclosure away now, while Refresh / Copy / Open logs / Open model cache
                            stay in the flow, so nothing became harder to reach.
                        -->
                        <Expander x:Name="DiagnosticsDetail"
                                  HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Stretch"
                                  Header="Environment, package and model detail"
                                  AutomationProperties.Name="Show runtime diagnostics detail"
                                  AutomationProperties.AutomationId="RuntimeDiagnosticsExpander">
                            <Border Background="{ThemeResource MuesliBackgroundDeepBrush}"
                                    BorderBrush="{ThemeResource MuesliBorderSoftBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="12,10"
                                    MaxHeight="240">
                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <TextBlock Text="{x:Bind ViewModel.RuntimeSummary, Mode=OneWay}"
                                               FontFamily="Consolas, Cascadia Mono, monospace"
                                               FontSize="12"
                                               LineHeight="18"
                                               TextWrapping="Wrap"
                                               IsTextSelectionEnabled="True"
                                               AutomationProperties.AutomationId="RuntimeDiagnosticsText" />
                                </ScrollViewer>
                            </Border>
                        </Expander>
                        <StackPanel x:Name="DiagnosticActions" Orientation="Horizontal" Spacing="8">
                            <Button x:Name="RefreshDiagnosticsButton"
                                    Style="{StaticResource MuesliSecondaryButtonStyle}"
                                    Command="{x:Bind ViewModel.RefreshCommand}"
                                    Content="Refresh"
                                    IsEnabled="{x:Bind local:AboutPage.Not(ViewModel.IsBusy), Mode=OneWay}"
                                    AutomationProperties.Name="Refresh diagnostics"
                                    AutomationProperties.AutomationId="RefreshDiagnosticsButton" />
                            <Button x:Name="CopyDiagnosticsButton"
                                    Style="{StaticResource MuesliGhostButtonStyle}"
                                    Command="{x:Bind ViewModel.CopyDiagnosticsCommand}"
                                    Content="Copy diagnostics"
                                    AutomationProperties.Name="Copy diagnostics"
                                    AutomationProperties.AutomationId="CopyDiagnosticsButton" />
                            <Button x:Name="OpenLogsButton"
                                    Style="{StaticResource MuesliGhostButtonStyle}"
                                    Command="{x:Bind ViewModel.OpenLogsCommand}"
                                    Content="Open logs"
                                    AutomationProperties.Name="Open Muesli logs"
                                    AutomationProperties.AutomationId="OpenLogsButton" />
                            <Button x:Name="OpenModelCacheButton"
                                    Style="{StaticResource MuesliGhostButtonStyle}"
                                    Command="{x:Bind ViewModel.OpenModelCacheCommand}"
                                    Content="Open model cache"
                                    AutomationProperties.Name="Open model cache"
                                    AutomationProperties.AutomationId="OpenModelCacheButton" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <InfoBar IsOpen="{x:Bind ViewModel.IsStatusOpen, Mode=TwoWay}"
                         Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                         Severity="{x:Bind local:AboutPage.StatusSeverity(ViewModel.IsStatusError), Mode=OneWay}"
                         IsClosable="True"
                         AutomationProperties.AutomationId="AboutStatus" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

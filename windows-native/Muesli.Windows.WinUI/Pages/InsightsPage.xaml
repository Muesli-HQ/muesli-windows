<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Muesli.Windows.WinUI.Pages.InsightsPage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Muesli.Windows.WinUI.Pages"
    xmlns:vm="using:Muesli.Windows.WinUI.ViewModels">
    <Page.Resources>
        <!-- macOS insightsPanel(): 22pt padding, 14pt radius, raised fill, 1pt border. -->
        <Style x:Key="InsightPanelStyle" TargetType="Border" BasedOn="{StaticResource MuesliCardStyle}">
            <Setter Property="Padding" Value="22" />
            <Setter Property="CornerRadius" Value="14" />
        </Style>
        <!-- macOS panelTitle: 11pt bold, 1.8pt tracking, primary; 12pt secondary subtitle. -->
        <Style x:Key="InsightPanelTitleStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource MuesliFontFamilySemiBold}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="CharacterSpacing" Value="160" />
            <Setter Property="Foreground" Value="{ThemeResource MuesliTextPrimaryBrush}" />
        </Style>
        <Style x:Key="InsightPanelSubtitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource MuesliTextSecondaryBrush}" />
        </Style>
        <!-- macOS heroDatum: 18pt semibold value over a 9pt bold tracked tertiary label. -->
        <Style x:Key="InsightDatumValueStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource MuesliFontFamilySemiBold}" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{ThemeResource MuesliTextPrimaryBrush}" />
        </Style>
        <Style x:Key="InsightDatumLabelStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource MuesliFontFamilySemiBold}" />
            <Setter Property="FontSize" Value="9" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="CharacterSpacing" Value="140" />
            <Setter Property="Foreground" Value="{ThemeResource MuesliTextTertiaryBrush}" />
        </Style>
        <Style x:Key="InsightDividerStyle" TargetType="Rectangle">
            <Setter Property="Width" Value="1" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Fill" Value="{ThemeResource MuesliBorderSoftBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- macOS streakDatum: 32pt bold accent count, a caption unit, and a caption label. -->
        <Style x:Key="InsightStreakValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="32" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{ThemeResource MuesliAccentBrush}" />
        </Style>
        <Style x:Key="InsightCaptionStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource MuesliTextSecondaryBrush}" />
        </Style>
        <Style x:Key="InsightReadoutLabelStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource MuesliFontFamilyMedium}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource MuesliTextTertiaryBrush}" />
        </Style>
        <Style x:Key="InsightReadoutValueStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource MuesliFontFamilyMedium}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Foreground" Value="{ThemeResource MuesliTextPrimaryBrush}" />
        </Style>
    </Page.Resources>

    <Grid Background="{ThemeResource MuesliBackgroundBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ContentStack" Padding="{StaticResource MuesliPageContentPadding}" Spacing="24" MaxWidth="1240">
                <!--
                    macOS header: back link, a hairline, the INSIGHTS identity, then the range
                    picker, refresh and Share on the right. Below ~1000 DIP the controls drop to a
                    second row, as the macOS ViewThatFits fallback does.
                -->
                <Grid x:Name="HeaderGrid" ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" RowSpacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                        <Button Click="BackToTimeline_Click"
                                Style="{StaticResource MuesliGhostButtonStyle}"
                                Padding="6,4" Margin="-6,0,0,0"
                                AutomationProperties.Name="Back to Timeline"
                                AutomationProperties.AutomationId="InsightsBackButton">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE76B;" FontSize="11" Foreground="{ThemeResource MuesliTextSecondaryBrush}" />
                                <TextBlock Text="Back to Timeline" FontFamily="{StaticResource MuesliFontFamilySemiBold}" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource MuesliTextSecondaryBrush}" />
                            </StackPanel>
                        </Button>
                        <Rectangle Width="1" Height="18" Fill="{ThemeResource MuesliBorderSoftBrush}" VerticalAlignment="Center" />
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="INSIGHTS" FontFamily="{StaticResource MuesliFontFamilySemiBold}" FontSize="11" FontWeight="Bold" CharacterSpacing="160" Foreground="{ThemeResource MuesliAccentBrush}" />
                            <TextBlock Text="Private and on-device" FontFamily="{StaticResource MuesliFontFamilyMedium}" FontSize="13" Foreground="{ThemeResource MuesliTextSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel x:Name="RangeControls" Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <Border Style="{StaticResource MuesliSegmentedContainerStyle}" VerticalAlignment="Center">
                            <SelectorBar x:Name="RangeBar" SelectionChanged="RangeBar_SelectionChanged"
                                         AutomationProperties.Name="Insights time range"
                                         AutomationProperties.AutomationId="InsightsRangePicker">
                                <SelectorBarItem Text="30 days" Tag="0" AutomationProperties.Name="Last 30 days" />
                                <SelectorBarItem Text="90 days" Tag="1" IsSelected="True" AutomationProperties.Name="Last 90 days" />
                                <SelectorBarItem Text="12 months" Tag="2" AutomationProperties.Name="Last 12 months" />
                                <SelectorBarItem Text="All time" Tag="3" AutomationProperties.Name="All time" />
                            </SelectorBar>
                        </Border>
                        <Button Command="{x:Bind ViewModel.RefreshCommand}" Style="{StaticResource MuesliGhostButtonStyle}"
                                Width="32" Height="32" Padding="0" VerticalAlignment="Center"
                                AutomationProperties.Name="Refresh insights" AutomationProperties.AutomationId="InsightsRefreshButton"
                                ToolTipService.ToolTip="Refresh local insights">
                            <FontIcon Glyph="&#xE72C;" FontSize="14" Foreground="{ThemeResource MuesliTextSecondaryBrush}" />
                        </Button>
                        <!--
                            macOS borderedProminent accent Share. Windows keeps preview / copy /
                            save on the split menu: they are the same transcript-free image, and
                            Windows sharing has no built-in copy or save target.
                        -->
                        <SplitButton Command="{x:Bind ViewModel.ShareCommand}"
                                     CornerRadius="6"
                                     Padding="12,6"
                                     VerticalAlignment="Center"
                                     Background="{ThemeResource MuesliAccentBrush}"
                                     Foreground="White"
                                     BorderThickness="0"
                                     AutomationProperties.Name="Share activity image"
                                     AutomationProperties.AutomationId="InsightsShareButton"
                                     ToolTipService.ToolTip="Share an anonymous activity image">
                            <SplitButton.Resources>
                                <StaticResource x:Key="SplitButtonBackgroundPointerOver" ResourceKey="MuesliAccentBrush" />
                                <StaticResource x:Key="SplitButtonBackgroundPressed" ResourceKey="MuesliAccentBrush" />
                                <SolidColorBrush x:Key="SplitButtonForegroundPointerOver" Color="White" />
                                <SolidColorBrush x:Key="SplitButtonForegroundPressed" Color="#DDFFFFFF" />
                            </SplitButton.Resources>
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <FontIcon Glyph="&#xE72D;" FontSize="13" />
                                <TextBlock Text="Share" FontFamily="{StaticResource MuesliFontFamilySemiBold}" FontSize="13" FontWeight="SemiBold" />
                            </StackPanel>
                            <SplitButton.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedRight">
                                    <MenuFlyoutItem Text="Preview activity image"
                                                    Command="{x:Bind ViewModel.PreviewShareCommand}"
                                                    AutomationProperties.AutomationId="InsightsPreviewShareButton"
                                                    AutomationProperties.Name="Preview activity image">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8A4;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="Copy activity image"
                                                    Command="{x:Bind ViewModel.CopyShareCommand}"
                                                    AutomationProperties.AutomationId="InsightsCopyShareButton"
                                                    AutomationProperties.Name="Copy activity image">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="Save activity image…"
                                                    Command="{x:Bind ViewModel.SaveShareCommand}"
                                                    AutomationProperties.AutomationId="InsightsSaveShareButton"
                                                    AutomationProperties.Name="Save activity image">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74E;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </SplitButton.Flyout>
                        </SplitButton>
                    </StackPanel>
                </Grid>

                <Border Style="{StaticResource InsightPanelStyle}" Visibility="{x:Bind BoolToVisibility(ViewModel.IsLoading), Mode=OneWay}" AutomationProperties.Name="Loading insights">
                    <StackPanel Orientation="Horizontal" Spacing="14">
                        <ProgressRing IsActive="True" Width="16" Height="16" AutomationProperties.Name="Loading" />
                        <StackPanel Spacing="4">
                            <TextBlock Text="Building your Insights" FontFamily="{StaticResource MuesliFontFamilySemiBold}" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock Text="Insights are computed on this PC and never uploaded" FontSize="12" Foreground="{ThemeResource MuesliTextSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource InsightPanelStyle}" MinHeight="320" Visibility="{x:Bind BoolToVisibility(ViewModel.IsEmpty), Mode=OneWay}" AutomationProperties.Name="No insights yet" AutomationProperties.AutomationId="InsightsEmptyState">
                    <StackPanel Spacing="14" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE9D9;" FontSize="34" Foreground="{ThemeResource MuesliAccentBrush}" />
                        <TextBlock Text="Your activity will appear here" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Text="Record a dictation or finish a meeting to start building your private Insights history." FontSize="13" Foreground="{ThemeResource MuesliTextSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="420" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource InsightPanelStyle}" MinHeight="320" Visibility="{x:Bind BoolToVisibility(ViewModel.HasLoadError), Mode=OneWay}" AutomationProperties.Name="Insights unavailable" AutomationProperties.AutomationId="InsightsErrorState">
                    <StackPanel Spacing="14" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE783;" FontSize="34" Foreground="{ThemeResource MuesliAccentBrush}" />
                        <TextBlock Text="Insights could not be calculated" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" FontSize="13" Foreground="{ThemeResource MuesliTextSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="420" />
                        <Button Command="{x:Bind ViewModel.RefreshCommand}" Style="{StaticResource MuesliSecondaryButtonStyle}" HorizontalAlignment="Center" AutomationProperties.Name="Try again" AutomationProperties.AutomationId="InsightsErrorRetryButton"><TextBlock Text="Try Again" /></Button>
                    </StackPanel>
                </Border>

                <!-- macOS hero: lifetime dictated words, meeting words beneath, then four datums. -->
                <Border Style="{StaticResource InsightPanelStyle}" Padding="26" Visibility="{x:Bind BoolToVisibility(ViewModel.HasData), Mode=OneWay}" AutomationProperties.Name="Insights hero" AutomationProperties.AutomationId="InsightsHeroCard">
                    <Grid>
                        <!-- The tint bleeds out over the card padding so it reaches the rounded edge. -->
                        <Border x:Name="HeroTint" Margin="-26" CornerRadius="14" IsHitTestVisible="False">
                            <Border.Background>
                                <LinearGradientBrush x:Name="HeroGradient" StartPoint="0,0" EndPoint="1,1" />
                            </Border.Background>
                        </Border>
                        <StackPanel Spacing="22">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Your time with Muesli" FontFamily="{StaticResource MuesliFontFamilySemiBold}" FontSize="18" FontWeight="SemiBold" CharacterSpacing="-20" />
                                <TextBlock Text="{x:Bind ViewModel.LifetimeDictationWords, Mode=OneWay}" FontSize="58" FontWeight="Bold" CharacterSpacing="-40" AutomationProperties.Name="Words dictated, all time" />
                                <TextBlock Text="Words dictated · all time" FontFamily="{StaticResource MuesliFontFamilyMedium}" FontSize="15" Foreground="{ThemeResource MuesliTextSecondaryBrush}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{x:Bind ViewModel.LifetimeMeetingWords, Mode=OneWay}" FontSize="30" FontWeight="Bold" />
                                <TextBlock Text="Words transcribed in meetings · all time" FontSize="14" Foreground="{ThemeResource MuesliTextSecondaryBrush}" VerticalAlignment="Bottom" Margin="0,0,0,6" />
                            </StackPanel>
                            <Grid ColumnDefinitions="*,Auto,*,Auto,*,Auto,*" Margin="-18,0">
                                <StackPanel Spacing="4" Padding="18,0">
                                    <TextBlock Text="{x:Bind ViewModel.LifetimeMeetings, Mode=OneWay}" Style="{StaticResource InsightDatumValueStyle}" />
                                    <TextBlock Text="MEETINGS" Style="{StaticResource InsightDatumLabelStyle}" />
                                </StackPanel>
                                <Rectangle Grid.Column="1" Style="{StaticResource InsightDividerStyle}" />
                                <StackPanel Grid.Column="2" Spacing="4" Padding="18,0">
                                    <TextBlock Text="{x:Bind ViewModel.LifetimeAveragePace, Mode=OneWay}" Style="{StaticResource InsightDatumValueStyle}" />
                                    <TextBlock Text="DICTATION PACE" Style="{StaticResource InsightDatumLabelStyle}" />
                                </StackPanel>
                                <Rectangle Grid.Column="3" Style="{StaticResource InsightDividerStyle}" />
                                <StackPanel Grid.Column="4" Spacing="4" Padding="18,0">
                                    <TextBlock Text="{x:Bind ViewModel.CurrentStreak, Mode=OneWay}" Style="{StaticResource InsightDatumValueStyle}" />
                                    <TextBlock Text="CURRENT STREAK" Style="{StaticResource InsightDatumLabelStyle}" />
                                </StackPanel>
                                <Rectangle Grid.Column="5" Style="{StaticResource InsightDividerStyle}" />
                                <StackPanel Grid.Column="6" Spacing="4" Padding="18,0">
                                    <TextBlock Text="{x:Bind ViewModel.LongestStreak, Mode=OneWay}" Style="{StaticResource InsightDatumValueStyle}" />
                                    <TextBlock Text="LONGEST STREAK" Style="{StaticResource InsightDatumLabelStyle}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource InsightPanelStyle}" Visibility="{x:Bind BoolToVisibility(ViewModel.HasData), Mode=OneWay}" AutomationProperties.Name="Daily activity" AutomationProperties.AutomationId="InsightsDailyActivityCard">
                    <StackPanel Spacing="18">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="4">
                                <TextBlock Text="DAILY ACTIVITY" Style="{StaticResource InsightPanelTitleStyle}" />
                                <TextBlock x:Name="ActivitySubtitle" Text="Words captured each day" Style="{StaticResource InsightPanelSubtitleStyle}" />
                            </StackPanel>
                            <Border Grid.Column="1" Style="{StaticResource MuesliSegmentedContainerStyle}" VerticalAlignment="Top">
                                <SelectorBar x:Name="ActivityModeBar" SelectionChanged="ActivityModeBar_SelectionChanged" AutomationProperties.Name="Daily activity measure" AutomationProperties.AutomationId="InsightsActivityModePicker">
                                    <SelectorBarItem Text="Words" Tag="0" IsSelected="True" AutomationProperties.Name="Show words activity" />
                                    <SelectorBarItem Text="Meetings" Tag="1" AutomationProperties.Name="Show meetings activity" />
                                </SelectorBar>
                            </Border>
                        </Grid>
                        <!--
                            P7-01/P7-02: the month strip scrolls with the cells, and the code-behind
                            parks the scroller on the newest week. The weekday column's 17 DIP top
                            margin is the 14 DIP month strip plus its 3 DIP gap; its 18 DIP pitch is
                            the grid's own (16 item + 2 spacing).
                        -->
                        <Grid ColumnDefinitions="34,*" HorizontalAlignment="Center">
                            <ItemsRepeater Grid.Column="0"
                                           ItemsSource="{x:Bind ViewModel.WeekdayLabels, Mode=OneWay}"
                                           VerticalAlignment="Top"
                                           Margin="0,17,0,0"
                                           AutomationProperties.AccessibilityView="Raw">
                                <ItemsRepeater.Layout><StackLayout Orientation="Vertical" Spacing="0" /></ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="vm:InsightsWeekdayItem">
                                        <TextBlock Text="{x:Bind Label}" Height="18" Margin="0,0,6,0" FontSize="9" FontWeight="Medium" Foreground="{ThemeResource MuesliTextTertiaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                            <ScrollViewer x:Name="HeatmapScroller"
                                          Grid.Column="1"
                                          HorizontalScrollBarVisibility="Auto"
                                          HorizontalScrollMode="Enabled"
                                          VerticalScrollBarVisibility="Disabled"
                                          VerticalScrollMode="Disabled">
                                <StackPanel Spacing="3" HorizontalAlignment="Left">
                                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.MonthLabels, Mode=OneWay}" AutomationProperties.AccessibilityView="Raw">
                                        <ItemsRepeater.Layout><StackLayout Orientation="Horizontal" /></ItemsRepeater.Layout>
                                        <ItemsRepeater.ItemTemplate>
                                            <DataTemplate x:DataType="vm:InsightsMonthItem">
                                                <TextBlock Text="{x:Bind Label}" Width="{x:Bind Width}" Height="14" FontSize="9" FontWeight="Medium" Foreground="{ThemeResource MuesliTextTertiaryBrush}" />
                                            </DataTemplate>
                                        </ItemsRepeater.ItemTemplate>
                                    </ItemsRepeater>
                                    <ItemsRepeater x:Name="Heatmap"
                                                   ItemsSource="{x:Bind ViewModel.Days, Mode=OneWay}"
                                                   HorizontalAlignment="Left"
                                                   MinHeight="126"
                                                   AutomationProperties.Name="Daily activity heatmap"
                                                   AutomationProperties.AutomationId="InsightsHeatmap">
                                        <ItemsRepeater.Layout>
                                            <UniformGridLayout Orientation="Vertical"
                                                               MinItemWidth="16"
                                                               MinItemHeight="16"
                                                               MaximumRowsOrColumns="7"
                                                               MinRowSpacing="2"
                                                               MinColumnSpacing="2"
                                                               ItemsStretch="None" />
                                        </ItemsRepeater.Layout>
                                        <ItemsRepeater.ItemTemplate>
                                            <DataTemplate x:DataType="vm:InsightsDayItem">
                                                <!-- macOS InsightsPalette.intensity: surface 62% when quiet, then accent at 24/48/72/100%. -->
                                                <Grid Width="14" Height="14" AutomationProperties.Name="{x:Bind AccessibleLabel}">
                                                    <Border CornerRadius="3" Background="{ThemeResource MuesliSurfaceRaisedBrush}" Opacity="{x:Bind local:InsightsPage.HeatEmptyOpacity(Level)}" />
                                                    <Border CornerRadius="3" Background="{ThemeResource MuesliAccentBrush}" Opacity="{x:Bind local:InsightsPage.HeatAccentOpacity(Level)}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsRepeater.ItemTemplate>
                                    </ItemsRepeater>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="34,0,0,0">
                            <TextBlock Text="QUIET" Style="{StaticResource InsightDatumLabelStyle}" CharacterSpacing="120" VerticalAlignment="Center" />
                            <Border Width="15" Height="15" CornerRadius="3" Background="{ThemeResource MuesliSurfaceRaisedBrush}" Opacity="0.62" />
                            <Border Width="15" Height="15" CornerRadius="3" Background="{ThemeResource MuesliAccentBrush}" Opacity="0.24" />
                            <Border Width="15" Height="15" CornerRadius="3" Background="{ThemeResource MuesliAccentBrush}" Opacity="0.48" />
                            <Border Width="15" Height="15" CornerRadius="3" Background="{ThemeResource MuesliAccentBrush}" Opacity="0.72" />
                            <Border Width="15" Height="15" CornerRadius="3" Background="{ThemeResource MuesliAccentBrush}" />
                            <TextBlock Text="LOUD" Style="{StaticResource InsightDatumLabelStyle}" CharacterSpacing="120" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- macOS usagePanel: one panel, the word balance on the left and an inset OVERVIEW box on the right. -->
                <Border Style="{StaticResource InsightPanelStyle}" Visibility="{x:Bind BoolToVisibility(ViewModel.HasData), Mode=OneWay}" AutomationProperties.Name="Dictation and meeting breakdown" AutomationProperties.AutomationId="InsightsBreakdownCard">
                    <Grid x:Name="UsageGrid" ColumnDefinitions="*,300" RowDefinitions="Auto,Auto" ColumnSpacing="20">
                        <StackPanel Spacing="20">
                            <StackPanel Spacing="4">
                                <TextBlock Text="DICTATIONS AND MEETINGS" Style="{StaticResource InsightPanelTitleStyle}" />
                                <TextBlock Text="Activity for the selected time period" Style="{StaticResource InsightPanelSubtitleStyle}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{x:Bind ViewModel.SelectedDictationWords, Mode=OneWay}" FontSize="40" FontWeight="Bold" CharacterSpacing="-30" />
                                <TextBlock Text="words dictated" FontSize="14" Foreground="{ThemeResource MuesliTextTertiaryBrush}" VerticalAlignment="Bottom" Margin="0,0,0,8" />
                            </StackPanel>
                            <Grid x:Name="UsageBar" Height="12" ColumnSpacing="3" AutomationProperties.Name="Dictation and meeting word balance">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Rectangle Grid.Column="0" MinWidth="4" Fill="{ThemeResource MuesliAccentBrush}" RadiusX="4" RadiusY="4" />
                                <Rectangle Grid.Column="1" Fill="{ThemeResource MuesliAccentBrush}" Opacity="0.45" RadiusX="4" RadiusY="4" />
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <Ellipse Width="7" Height="7" Fill="{ThemeResource MuesliAccentBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="Dictated words" FontSize="12" Foreground="{ThemeResource MuesliTextSecondaryBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.SelectedDictationWords, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="7">
                                    <Ellipse Width="7" Height="7" Fill="{ThemeResource MuesliAccentBrush}" Opacity="0.45" VerticalAlignment="Center" />
                                    <TextBlock Text="Meeting words" FontSize="12" Foreground="{ThemeResource MuesliTextSecondaryBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.SelectedMeetingWords, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                        <Border x:Name="OverviewBox" Grid.Column="1" Padding="20" CornerRadius="10"
                                Background="{ThemeResource MuesliBackgroundBrush}"
                                BorderBrush="{ThemeResource MuesliBorderSoftBrush}" BorderThickness="1"
                                AutomationProperties.Name="Insights overview" AutomationProperties.AutomationId="InsightsOverviewCard">
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="16">
                                <TextBlock Grid.ColumnSpan="2" Text="OVERVIEW" FontFamily="{StaticResource MuesliFontFamilySemiBold}" FontSize="10" FontWeight="Bold" CharacterSpacing="150" Foreground="{ThemeResource MuesliTextTertiaryBrush}" />
                                <TextBlock Grid.Row="1" Text="Dictation sessions" Style="{StaticResource InsightReadoutLabelStyle}" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.DictationSessions, Mode=OneWay}" Style="{StaticResource InsightReadoutValueStyle}" />
                                <TextBlock Grid.Row="2" Text="Completed meetings" Style="{StaticResource InsightReadoutLabelStyle}" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.CompletedMeetings, Mode=OneWay}" Style="{StaticResource InsightReadoutValueStyle}" />
                                <TextBlock Grid.Row="3" Text="Dictation pace" Style="{StaticResource InsightReadoutLabelStyle}" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{x:Bind ViewModel.SelectedAveragePace, Mode=OneWay}" Style="{StaticResource InsightReadoutValueStyle}" />
                                <TextBlock Grid.Row="4" Text="Active days" Style="{StaticResource InsightReadoutLabelStyle}" />
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{x:Bind ViewModel.SelectedActiveDays, Mode=OneWay}" Style="{StaticResource InsightReadoutValueStyle}" />
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- macOS streakPanel: three accent counts separated by hairlines. -->
                <Border Style="{StaticResource InsightPanelStyle}" Visibility="{x:Bind BoolToVisibility(ViewModel.HasData), Mode=OneWay}" AutomationProperties.Name="Insights streaks" AutomationProperties.AutomationId="InsightsStreaksCard">
                    <StackPanel Spacing="18">
                        <StackPanel Spacing="4">
                            <TextBlock Text="STREAKS" Style="{StaticResource InsightPanelTitleStyle}" />
                            <TextBlock Text="Your consecutive dictation days" Style="{StaticResource InsightPanelSubtitleStyle}" />
                        </StackPanel>
                        <Grid ColumnDefinitions="*,Auto,*,Auto,*" Margin="-16,0">
                            <StackPanel Spacing="6" Padding="16,0">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="{x:Bind ViewModel.StreakNumber, Mode=OneWay}" Style="{StaticResource InsightStreakValueStyle}" />
                                    <TextBlock Text="{x:Bind ViewModel.CurrentStreakUnit, Mode=OneWay}" Style="{StaticResource InsightCaptionStyle}" VerticalAlignment="Bottom" Margin="0,0,0,7" />
                                </StackPanel>
                                <TextBlock Text="Current streak" Style="{StaticResource InsightCaptionStyle}" />
                            </StackPanel>
                            <Rectangle Grid.Column="1" Style="{StaticResource InsightDividerStyle}" />
                            <StackPanel Grid.Column="2" Spacing="6" Padding="16,0">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="{x:Bind ViewModel.LongestStreakNumber, Mode=OneWay}" Style="{StaticResource InsightStreakValueStyle}" />
                                    <TextBlock Text="{x:Bind ViewModel.LongestStreakUnit, Mode=OneWay}" Style="{StaticResource InsightCaptionStyle}" VerticalAlignment="Bottom" Margin="0,0,0,7" />
                                </StackPanel>
                                <TextBlock Text="Longest streak" Style="{StaticResource InsightCaptionStyle}" />
                            </StackPanel>
                            <Rectangle Grid.Column="3" Style="{StaticResource InsightDividerStyle}" />
                            <StackPanel Grid.Column="4" Spacing="6" Padding="16,0">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="{x:Bind ViewModel.SelectedActiveDays, Mode=OneWay}" Style="{StaticResource InsightStreakValueStyle}" />
                                    <TextBlock Text="{x:Bind ViewModel.ActiveDaysUnit, Mode=OneWay}" Style="{StaticResource InsightCaptionStyle}" VerticalAlignment="Bottom" Margin="0,0,0,7" />
                                </StackPanel>
                                <TextBlock Text="Active in this period" Style="{StaticResource InsightCaptionStyle}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Dictate today to start a new streak." Style="{StaticResource InsightCaptionStyle}" Visibility="{x:Bind BoolToVisibility(ViewModel.IsStreakBroken), Mode=OneWay}" />
                    </StackPanel>
                </Border>

                <StackPanel Spacing="16" Visibility="{x:Bind BoolToVisibility(ViewModel.HasData), Mode=OneWay}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="MOST-USED WORDS" Style="{StaticResource InsightPanelTitleStyle}" />
                        <TextBlock Text="Common words from your dictations and meetings" Style="{StaticResource InsightPanelSubtitleStyle}" />
                    </StackPanel>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                        <Border Style="{StaticResource InsightPanelStyle}">
                            <StackPanel Spacing="16">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE720;" FontSize="11" Foreground="{ThemeResource MuesliTextTertiaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="DICTATIONS" FontFamily="{StaticResource MuesliFontFamilySemiBold}" FontSize="10" FontWeight="Bold" CharacterSpacing="150" Foreground="{ThemeResource MuesliTextTertiaryBrush}" />
                                </StackPanel>
                                <TextBlock Text="No words to show for this time period." FontSize="13" Foreground="{ThemeResource MuesliTextTertiaryBrush}" MinHeight="120" TextAlignment="Center" Padding="0,50,0,0" Visibility="{x:Bind InvertBoolToVisibility(ViewModel.HasDictationWords), Mode=OneWay}" />
                                <ItemsRepeater ItemsSource="{x:Bind ViewModel.DictationWords, Mode=OneWay}" MinHeight="150" Visibility="{x:Bind BoolToVisibility(ViewModel.HasDictationWords), Mode=OneWay}">
                                    <ItemsRepeater.Layout>
                                        <LinedFlowLayout ItemsStretch="None" LineSpacing="4" MinItemSpacing="9" />
                                    </ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="vm:InsightsWordItem">
                                            <TextBlock Margin="2,0" Text="{x:Bind Word}" FontSize="{x:Bind DisplaySize}" FontWeight="{x:Bind local:InsightsPage.WordWeight(IsTop)}" Foreground="{x:Bind local:InsightsPage.WordBrush(IsTop, IsStrong)}" ToolTipService.ToolTip="{x:Bind AccessibleLabel}" AutomationProperties.Name="{x:Bind AccessibleLabel}" />
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource InsightPanelStyle}">
                            <StackPanel Spacing="16">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE716;" FontSize="11" Foreground="{ThemeResource MuesliTextTertiaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="MEETINGS" FontFamily="{StaticResource MuesliFontFamilySemiBold}" FontSize="10" FontWeight="Bold" CharacterSpacing="150" Foreground="{ThemeResource MuesliTextTertiaryBrush}" />
                                </StackPanel>
                                <TextBlock Text="No words to show for this time period." FontSize="13" Foreground="{ThemeResource MuesliTextTertiaryBrush}" MinHeight="120" TextAlignment="Center" Padding="0,50,0,0" Visibility="{x:Bind InvertBoolToVisibility(ViewModel.HasMeetingWords), Mode=OneWay}" />
                                <ItemsRepeater ItemsSource="{x:Bind ViewModel.MeetingWords, Mode=OneWay}" MinHeight="150" Visibility="{x:Bind BoolToVisibility(ViewModel.HasMeetingWords), Mode=OneWay}">
                                    <ItemsRepeater.Layout>
                                        <LinedFlowLayout ItemsStretch="None" LineSpacing="4" MinItemSpacing="9" />
                                    </ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="vm:InsightsWordItem">
                                            <TextBlock Margin="2,0" Text="{x:Bind Word}" FontSize="{x:Bind DisplaySize}" FontWeight="{x:Bind local:InsightsPage.WordWeight(IsTop)}" Foreground="{x:Bind local:InsightsPage.WordBrush(IsTop, IsStrong)}" ToolTipService.ToolTip="{x:Bind AccessibleLabel}" AutomationProperties.Name="{x:Bind AccessibleLabel}" />
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>

                <Border x:Name="SharePreviewCard" Style="{StaticResource InsightPanelStyle}" Visibility="{x:Bind ViewModel.HasPreview, Mode=OneWay}" AutomationProperties.Name="Transcript-free activity share preview">
                    <StackPanel Spacing="10"><TextBlock Text="SHARE PREVIEW · 1200 × 630" Style="{StaticResource InsightPanelTitleStyle}" /><Image Source="{x:Bind ToImageSource(ViewModel.PreviewUri), Mode=OneWay}" Stretch="Uniform" MaxHeight="315" AutomationProperties.Name="Muesli activity image preview" AutomationProperties.AutomationId="InsightsSharePreviewImage" /></StackPanel>
                </Border>
                <InfoBar x:Name="StatusBar" IsOpen="{x:Bind ViewModel.IsStatusOpen, Mode=TwoWay}" Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" AutomationProperties.AutomationId="InsightsStatus" AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
